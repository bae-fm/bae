#!/bin/bash
# Compile check that land.sh runs on a cherry-picked result before pushing it
# (see .land-checks for the static ones): clippy with --all-targets over the
# crates the landed commits touch and the crates that depend on them, warnings
# denied.
# Then the same crates' libraries and binaries without test features, which
# the apps and bridges build them with (a test-only `pub use` without its
# `#[cfg]` gate compiles with `test-utils` and breaks every app build), with
# warnings denied: an import only test code uses is a warning there.
# Two commits that each pass the hook can break each other's tests; this is
# where that shows.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
source scripts/crate-check-plan.sh

CHANGED_FILES=$(git --no-pager diff --name-only origin/main HEAD)
scripts/build-layout.sh

CRATES=$(workspace_crates)
DIRECT=()
while IFS= read -r crate; do
    [ -n "$crate" ] && DIRECT+=("$crate")
done < <(changed_workspace_crates <<< "$CRATES")

ARGS=(clippy --all-targets)
LIBRARY_ARGS=()
if [ "${#DIRECT[@]}" -gt 0 ]; then
    while read -r kind value; do
        case "$kind" in
            crate) ARGS+=(-p "$value") ;;
            feature) ARGS+=(--features "$value") ;;
        esac
    done < <(crate_check_plan "${DIRECT[@]}")
    while IFS= read -r argument; do
        LIBRARY_ARGS+=("$argument")
    done < <(library_check_args < <(crate_check_plan "${DIRECT[@]}"))
elif grep -qxE 'Cargo\.toml|Cargo\.lock' <<< "$CHANGED_FILES"; then
    # A change to the workspace manifest or lockfile reaches every crate.
    ARGS+=(--workspace)
    LIBRARY_ARGS=(check --workspace --lib --bins)
else
    echo "no Rust crate changed; nothing to compile"
    exit 0
fi
scripts/cargo.sh "${ARGS[@]}" -- -D warnings
# clippy, not check: `cargo check` takes no `-- -D warnings`, and RUSTFLAGS would
# change every crate's cache key.
scripts/cargo.sh clippy "${LIBRARY_ARGS[@]:1}" -- -D warnings
