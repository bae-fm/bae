#!/bin/bash

set -e

source "$(git rev-parse --show-toplevel)/scripts/hooks/lib/file-list.sh"
source "$(git rev-parse --show-toplevel)/scripts/hooks/lib/hook-mode.sh"

# Quick mode (`builds mode`, or HOOK_MODE) swaps the heavy compile steps
# (clippy, rustdoc, the mobile check) for one cargo check of the changed
# crates; every cheap step still runs.
MODE=$(hook_mode) || exit 1
echo "Pre-commit hook mode: $MODE"

# Git exports GIT_DIR/GIT_INDEX_FILE to hooks in a linked worktree, which breaks
# SwiftPM's package clones; the hook's own git commands don't need them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# The checks below build into the checkout's build output paths.
"$(git rev-parse --show-toplevel)/scripts/build-layout.sh"

# Every crate of the workspace, read from Cargo so the list can't drift from
# the workspace's members.
WORKSPACE_CRATES=$(workspace_crates)

TMPFILE=$(mktemp)
FORMAT_STATE=$(mktemp)

cleanup() {
    rm -f "$TMPFILE" "$FORMAT_STATE"
}
trap cleanup EXIT

# The files staged for commit.
CHANGED_FILES=$(git --no-pager diff --cached --name-only)

run_check() {
    local name="$1"
    shift
    echo "Running $name..."
    if "$@" > "$TMPFILE" 2>&1; then
        return 0
    else
        echo ""
        echo "❌ $name failed:"
        cat "$TMPFILE"
        return 1
    fi
}

require_command() {
    local command_name="$1"
    local purpose="$2"
    if ! command -v "$command_name" > /dev/null; then
        echo "$command_name is required to $purpose"
        exit 1
    fi
}

# Re-stages what a formatter changed (within the optional path scope) and fails
# the commit so the change is reviewed.
restage_and_fail_if_changed() {
    local tool_name="$1"
    local state_file="$2"
    local scope="${3:-}"
    local status=0
    stage_formatter_changes "$state_file" "$scope" || status=$?
    case "$status" in
        0) return 0 ;;
        1)
            echo ""
            echo "❌ $tool_name reformatted staged files. Changes have been re-staged."
            echo "   Please review the diff and commit again."
            exit 1
            ;;
        2)
            echo ""
            echo "❌ $tool_name reformatted a partially staged file."
            echo "   Existing unstaged hunks were left out of the index; review and stage the intended result."
            exit 1
            ;;
    esac
}

run_check "pre-commit staged path matching" bash scripts/hooks/tests/file-list-test.sh || {
    exit 1
}

run_check "pre-commit hook mode" bash scripts/hooks/tests/hook-mode-test.sh || {
    exit 1
}

run_check "pre-commit hook mode" bash scripts/hooks/tests/hook-mode-test.sh || {
    exit 1
}

# The clippy and rustdoc builds below compile against the local FFmpeg dist
# (.cargo/config.toml's FFMPEG_DIR).
run_check "pinned FFmpeg dist" \
    scripts/check-ffmpeg-dist.sh scripts/setup-ffmpeg.sh "${FFMPEG_DIR:-bae-ffmpeg/dist}" || {
    exit 1
}

# Formats every package; a change fails the commit for review.
record_staged_worktree_state "$FORMAT_STATE"
run_check "cargo fmt" cargo fmt --all || {
    echo "cargo fmt failed"
    exit 1
}
restage_and_fail_if_changed "cargo fmt" "$FORMAT_STATE"

run_check "source file layout" scripts/check-source-file-size.py || {
    exit 1
}

run_check "restricted-path Rust visibility" scripts/check-rust-visibility.sh || {
    echo "Move the item under its owner and use private or pub(super) access"
    exit 1
}

run_check "reqwest error causes" scripts/check-reqwest-error-display.py || {
    echo "Print a held reqwest::Error through bae_util::error_text::CauseChain"
    exit 1
}

run_check "owner dependency boundary" scripts/owner-dependency-boundary.sh || {
    exit 1
}

run_check "UniFFI runtime boundary" scripts/check-uniffi-runtime-boundary.py || {
    exit 1
}

run_check "screen pulls" \
    sh -c 'python3 scripts/check-screen-pulls.py && python3 scripts/tests/check-screen-pulls-test.py' || {
    exit 1
}

run_check "every Rust file compiled" \
    sh -c 'python3 scripts/check-rust-files-compiled.py && python3 scripts/tests/check-rust-files-compiled-test.py' || {
    exit 1
}

run_check "test keychain" \
    sh -c 'python3 scripts/check-test-keychain.py && python3 scripts/tests/check-test-keychain-test.py' || {
    exit 1
}

run_check "macOS native Cargo cache" scripts/check-macos-build-cache.sh || {
    exit 1
}

run_check "mobile host Cargo cache" scripts/check-mobile-build-cache.sh || {
    exit 1
}

run_check "Xcode build trees" scripts/check-xcode-trees.py || {
    exit 1
}

if staged_path_under ".github/workflows" || staged_path_under ".github/actions"; then
    require_command actionlint "lint staged GitHub automation"
    require_command shellcheck "check shell embedded in GitHub workflows"
    run_check "actionlint" \
        env SHELLCHECK_OPTS=--severity=error actionlint -color || {
        exit 1
    }
fi

if staged_file_in_list "scripts/check-bundled-libraries.py" \
    || staged_file_in_list "scripts/tests/check-bundled-libraries-test.py"; then
    run_check "bundled-library checker tests" \
        python3 scripts/tests/check-bundled-libraries-test.py || {
        exit 1
    }
fi

if staged_file_in_list "scripts/xcresult-tests-ran.py" \
    || staged_file_in_list "scripts/tests/xcresult-tests-ran-test.py"; then
    run_check "test-filter checker tests" \
        python3 scripts/tests/xcresult-tests-ran-test.py || {
        exit 1
    }
fi

if staged_file_in_list "bae-bridge/xcframework.py" \
    || staged_file_in_list "scripts/tests/xcframework-test.py"; then
    run_check "bridge xcframework tool tests" \
        python3 scripts/tests/xcframework-test.py || {
        exit 1
    }
fi

RUST_SOURCE_OR_MANIFEST_CHANGED=0
RUST_DEPENDENCY_INPUT_CHANGED=0
while IFS= read -r file; do
    case "$file" in
        *.rs | Cargo.toml | */Cargo.toml)
            RUST_SOURCE_OR_MANIFEST_CHANGED=1
            ;;
    esac
    case "$file" in
        Cargo.toml | */Cargo.toml | Cargo.lock | deny.toml)
            RUST_DEPENDENCY_INPUT_CHANGED=1
            ;;
    esac
done <<< "$CHANGED_FILES"

if [ "$RUST_SOURCE_OR_MANIFEST_CHANGED" -eq 1 ]; then
    require_command cargo-machete "check for unused Rust dependencies"
    run_check "cargo machete" cargo machete || {
        exit 1
    }
fi

if [ "$RUST_DEPENDENCY_INPUT_CHANGED" -eq 1 ]; then
    require_command cargo-deny "check Rust dependency licenses and advisories"
    run_check "cargo deny" cargo deny check || {
        exit 1
    }
fi

DIRECTLY_CHANGED_CRATES=()
while IFS= read -r crate; do
    [ -n "$crate" ] && DIRECTLY_CHANGED_CRATES+=("$crate")
done < <(changed_workspace_crates <<< "$WORKSPACE_CRATES")

if [ "${#DIRECTLY_CHANGED_CRATES[@]}" -gt 0 ]; then
    # The changed crates and every crate a change to them can break: a
    # changed public path or signature breaks a dependent's library or tests,
    # which a check of the changed crates alone never builds.
    COMPILE_ARGS=(clippy --all-targets)
    if [ "$MODE" = quick ]; then
        COMPILE_ARGS=(check --all-targets)
    fi
    # The iOS app's feature set (bae-bridge/build-ios.sh), where the mobile
    # builds' feature-gated code, OAuth sign-in included, is compiled.
    MOBILE_FEATURES=bae-bridge/oauth-providers,bae-bridge/cloudkit,bae-bridge/cast
    MOBILE_CHECK_ARGS=(clippy --lib --target aarch64-apple-ios)
    MOBILE_COVERED=0
    MOBILE_BRIDGE_COVERED=0
    CHECK_PLAN=$(crate_check_plan "${DIRECTLY_CHANGED_CRATES[@]}")
    while read -r kind value; do
        case "$kind" in
            crate) COMPILE_ARGS+=(-p "$value") ;;
            feature) COMPILE_ARGS+=(--features "$value") ;;
            mobile)
                MOBILE_COVERED=1
                MOBILE_CHECK_ARGS+=(-p "$value")
                if [ "$value" = bae-bridge ]; then
                    MOBILE_BRIDGE_COVERED=1
                fi
                ;;
        esac
    done <<< "$CHECK_PLAN"
    if [ "$MODE" = quick ]; then
        # The same crates and features clippy would use, so the build is warm.
        run_check "cargo check (changed crates and their dependents)" scripts/cargo.sh "${COMPILE_ARGS[@]}" || {
            echo "Fix the errors above and try again"
            exit 1
        }
    else
        COMPILE_ARGS+=(-- -D warnings)
        run_check "clippy (changed crates and their dependents)" scripts/cargo.sh "${COMPILE_ARGS[@]}" || {
            echo "Fix the warnings above and try again"
            exit 1
        }
    fi

    if [ "$MODE" = strict ]; then
        # CI documents the workspace with warnings as errors; clippy does not see
        # doc links, so a link to a private item only failed there. Only the
        # changed crates are documented: documenting every dependent again costs
        # more than the rest of the hook, and a dependent's doc link a change
        # breaks fails CI on main, where it is fixed forward.
        DOC_ARGS=(doc --no-deps)
        for crate in "${DIRECTLY_CHANGED_CRATES[@]}"; do
            DOC_ARGS+=(-p "$crate")
        done
        run_check "rustdoc (changed crates)" env RUSTDOCFLAGS="-D warnings" scripts/cargo.sh "${DOC_ARGS[@]}" || {
            echo "Fix the documentation errors above and try again"
            exit 1
        }

        # The mobile apps build bae-library, bae-app, bae-bridge and the crates
        # below them without their desktop-only modules, where anything only
        # those modules use is dead code, and a desktop-only item used ungated
        # fails the build. Clippy denies warnings, since a plain check only
        # warns about dead code. An iOS target stands for both mobile targets
        # here: it sets the same `desktop`-less cfg and needs no Android NDK.
        if [ "$MOBILE_COVERED" -eq 1 ]; then
            if [ "$MOBILE_BRIDGE_COVERED" -eq 1 ]; then
                MOBILE_CHECK_ARGS+=(--features "$MOBILE_FEATURES")
            fi
            MOBILE_CHECK_ARGS+=(-- -D warnings)
            run_check "bae-library, bae-app, bae-bridge and the crates below them for iOS (desktop-only code)" \
                scripts/cargo.sh "${MOBILE_CHECK_ARGS[@]}" || {
                echo "Gate code only desktop modules use with the same cfg and try again"
                exit 1
            }
        fi
    fi
fi

STAGED_SWIFT_FILES=()
while IFS= read -r file; do
    [ -f "$file" ] && STAGED_SWIFT_FILES+=("$file")
done < <(staged_files_with_extension swift)

if [ "${#STAGED_SWIFT_FILES[@]}" -gt 0 ] && xcrun --find swift-format &> /dev/null; then
    record_staged_worktree_state "$FORMAT_STATE"
    run_check "swift-format format (staged files)" \
        xcrun swift-format format -i -p "${STAGED_SWIFT_FILES[@]}" || {
        echo "swift-format format failed"
        exit 1
    }
    restage_and_fail_if_changed "swift-format" "$FORMAT_STATE"

    run_check "swift-format lint (staged files)" \
        xcrun swift-format lint -s "${STAGED_SWIFT_FILES[@]}" || {
        echo "swift-format lint failed — fix the violations above and commit again"
        exit 1
    }

    run_check "swiftlint (staged files)" \
        swiftlint lint --quiet --strict --config .swiftlint.yml \
        "${STAGED_SWIFT_FILES[@]}" || {
        echo "swiftlint failed — fix the violations above and commit again"
        exit 1
    }
fi

STAGED_KOTLIN_FILES=()
while IFS= read -r file; do
    case "$file" in
        bae-android/*.kt)
            [ -f "$file" ] && STAGED_KOTLIN_FILES+=("$file")
            ;;
    esac
done < <(staged_files_with_extension kt)

KOTLIN_STYLE_CONFIG_CHANGED=0
if staged_file_in_list ".editorconfig"; then
    KOTLIN_STYLE_CONFIG_CHANGED=1
fi

if [ "${#STAGED_KOTLIN_FILES[@]}" -gt 0 ]; then
    require_command ktlint "format and lint staged Kotlin files"
    record_staged_worktree_state "$FORMAT_STATE"
    run_check "ktlint format (staged files)" \
        format_ktlint "${STAGED_KOTLIN_FILES[@]}" || {
        echo "ktlint format failed"
        exit 1
    }
    restage_and_fail_if_changed \
        "ktlint" "$FORMAT_STATE" "bae-android/"
    run_check "ktlint (staged files)" \
        ktlint "${STAGED_KOTLIN_FILES[@]}" || {
        exit 1
    }
fi

if [ "$KOTLIN_STYLE_CONFIG_CHANGED" -eq 1 ]; then
    require_command ktlint "verify Kotlin after style configuration changes"
    run_check "ktlint (all hand-written sources)" \
        ktlint "bae-android/app/src/**/*.kt" "bae-android/fastvalues/src/**/*.kt" "bae-android/screensubscription/src/**/*.kt" || {
        exit 1
    }
fi

if [ "${#STAGED_KOTLIN_FILES[@]}" -gt 0 ] \
    || staged_file_in_list "bae-android/detekt.yml" \
    || staged_file_in_list "bae-android/detekt-type-resolved.yml"; then
    require_command detekt "check Kotlin dead code"
    run_check "detekt" detekt \
        --input bae-android/app/src/main/java,bae-android/fastvalues/src/main/java,bae-android/screensubscription/src/main/java \
        --config bae-android/detekt.yml \
        --build-upon-default-config || {
        exit 1
    }
    # The type-resolved rules read the platform jar of the app's compileSdk.
    source bae-android/toolchain.sh
    if [ ! -f "$ANDROID_PLATFORM_JAR" ]; then
        echo "❌ detekt's type-resolved rules need $ANDROID_PLATFORM_JAR; install platforms;android-${ANDROID_COMPILE_SDK}"
        exit 1
    fi
    run_check "detekt (type-resolved rules)" detekt \
        --input bae-android/app/src/main/java,bae-android/fastvalues/src/main/java,bae-android/screensubscription/src/main/java \
        --config bae-android/detekt-type-resolved.yml \
        --classpath "$ANDROID_PLATFORM_JAR" \
        --jvm-target "$ANDROID_JAVA_VERSION" || {
        exit 1
    }
fi

STAGED_CSHARP_FILES=()
while IFS= read -r file; do
    case "$file" in
        bae-avalonia/*.cs)
            [ -f "$file" ] && STAGED_CSHARP_FILES+=("$file")
            ;;
    esac
done < <(staged_files_with_extension cs)

CSHARP_FORMAT_CONFIG_CHANGED=0
if staged_file_in_list ".editorconfig" \
    || staged_file_in_list "bae-avalonia/bae-avalonia.csproj"; then
    CSHARP_FORMAT_CONFIG_CHANGED=1
fi

if [ "${#STAGED_CSHARP_FILES[@]}" -gt 0 ]; then
    require_command dotnet "format staged C# files"
    record_staged_worktree_state "$FORMAT_STATE"
    run_check "dotnet format whitespace (staged C# files)" \
        format_dotnet_whitespace \
        bae-avalonia/bae-avalonia.csproj \
        "${STAGED_CSHARP_FILES[@]}" || {
        echo "dotnet format whitespace failed"
        exit 1
    }
    restage_and_fail_if_changed \
        "dotnet format whitespace" "$FORMAT_STATE" "bae-avalonia/"
fi

if [ "$CSHARP_FORMAT_CONFIG_CHANGED" -eq 1 ]; then
    require_command dotnet "verify C# after formatter configuration changes"
    run_check "dotnet format whitespace (project verification)" \
        dotnet format whitespace bae-avalonia/bae-avalonia.csproj \
        --verify-no-changes || {
        exit 1
    }
fi

run_check "localization orphan check" python3 scripts/loc-chrome-orphans.py || {
    exit 1
}

run_check "localization English-skeleton check" \
    python3 scripts/loc-english-skeleton.py || {
    exit 1
}

run_check "localization words check" \
    sh -c 'python3 scripts/loc-words.py && python3 scripts/tests/loc-words-test.py' || {
    exit 1
}

echo "✅ All checks passed"
exit 0
