#!/bin/bash

set -e

# In a linked worktree, git exports GIT_DIR/GIT_INDEX_FILE to hooks. Child git
# processes inherit them — SwiftPM's package clones then run `git checkout`
# against *this* repo's object store and die with "unable to read tree". The
# hook's own git commands rediscover the repo from cwd, so drop the overrides.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Dependency graph (update when crate dependencies change):
#   bae-core: no local deps; dev-depends on bae-test-support (its tests)
#   bae-test-support: depends on bae-core
#   bae-bridge: depends on bae-core
#   bae-subsonic: depends on bae-core
#   bae-desktop: depends on bae-core, bae-mcp, bae-subsonic
#   bae-macos: depends on bae-bridge (Swift native app)

# Use target-macos to avoid busting iOS/Android caches
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target-macos}"

TMPFILE=$(mktemp)

cleanup() {
    rm -f "$TMPFILE"
}
trap cleanup EXIT

# Get changed files (staged for commit)
CHANGED_FILES=$(git --no-pager diff --cached --name-only)

has_changes_in() {
    if echo "$CHANGED_FILES" | grep -q "^$1/"; then
        echo "Changes detected in $1"
        return 0
    fi
    return 1
}

run_check() {
    local name="$1"
    shift
    echo "Running $name..."
    if "$@" > "$TMPFILE" 2>&1; then
        return 0
    else
        echo ""
        echo "❌ $name failed:"
        cat "$TMPFILE"
        return 1
    fi
}

# Re-stage files the formatter modified (within optional path scope) and
# fail the commit so the dev sees what changed and re-runs `git commit`.
restage_and_fail_if_changed() {
    local tool_name="$1"
    local scope="${2:-}"
    local diff
    if [ -n "$scope" ]; then
        diff=$(git --no-pager diff --name-only -- "$scope")
    else
        diff=$(git --no-pager diff --name-only)
    fi
    if [ -z "$diff" ]; then
        return 0
    fi
    local restaged=0
    while IFS= read -r file; do
        if echo "$CHANGED_FILES" | grep -qF "$file"; then
            git add "$file"
            restaged=1
        fi
    done <<< "$diff"
    if [ "$restaged" -eq 1 ]; then
        echo ""
        echo "❌ $tool_name reformatted staged files. Changes have been re-staged."
        echo "   Please review the diff and commit again."
        exit 1
    fi
}

# Auto-format all packages. If anything changes, re-stage and fail so the
# dev can review the new diff before committing.
run_check "cargo fmt" cargo fmt --all || {
    echo "cargo fmt failed"
    exit 1
}
restage_and_fail_if_changed "cargo fmt"

# bae-core checks. bae-test-support compiles into bae-core's integration tests,
# so a change there has to re-run them even when bae-core itself is untouched.
if has_changes_in "bae-core" || has_changes_in "bae-test-support"; then
    cd bae-core

    run_check "clippy lib (bae-core)" cargo clippy --lib -- -D warnings || {
        echo "Fix the warnings above and try again"
        exit 1
    }

    run_check "clippy tests (bae-core)" cargo clippy --tests --features test-utils -- -D warnings || {
        exit 1
    }

    cd ..

    # The run above builds bae-test-support as a dependency, which enforces the
    # workspace's rustc denies on it but does not run clippy's own lints there.
    run_check "clippy (bae-test-support)" cargo clippy -p bae-test-support -- -D warnings || {
        exit 1
    }
fi

# Every other Rust crate that depends on bae-core, in one sweep rather than a
# list. A bae-core type change breaks its dependents silently otherwise, and
# naming them individually only moves the problem to whichever crate is missing
# from the list: that is how a SaveCodec variant once broke bae-subsonic on
# main, and later how a renamed automation input broke bae-cli and a widened
# struct broke bae-automation's fixtures — three times, three different crates,
# the same gap. `--all-targets` matters as much as the breadth: two of those
# three compiled fine as libraries and only their test targets failed.
if has_changes_in "bae-core" || has_changes_in "bae-subsonic" \
    || has_changes_in "bae-desktop" || has_changes_in "bae-automation" \
    || has_changes_in "bae-cli" || has_changes_in "bae-mcp" \
    || has_changes_in "bae-loc" || has_changes_in "bae-test-support" \
    || has_changes_in "bae-bridge"; then
    run_check "clippy (workspace)" cargo clippy --workspace --all-targets -- -D warnings || {
        echo "Fix the warnings above and try again"
        exit 1
    }
fi

# bae-bridge checks (depends on bae-core)
if has_changes_in "bae-bridge" || has_changes_in "bae-core"; then
    run_check "clippy (bae-bridge)" cargo clippy -p bae-bridge -- -D warnings || {
        echo "Fix the warnings above and try again"
        exit 1
    }

    # Validate the localization catalog (ICU syntax, arg coverage, translation
    # completeness) before any native resource files are emitted from it.
    run_check "loc-gen check" cargo run -q -p bae-loc --bin loc-gen -- check || {
        echo "Localization catalog is invalid"
        exit 1
    }
fi

# bae-macos checks (depends on bae-bridge and the shared BaeKit package)
if has_changes_in "bae-macos" || has_changes_in "bae-bridge" \
    || has_changes_in "BaeKit"; then
    if xcrun --find swift-format &> /dev/null; then
        run_check "swift-format format (bae-macos + BaeKit)" bash -c '
            find bae-macos/bae/bae BaeKit/Sources/BaeKit -name "*.swift" -print0 \
                | xargs -0 xcrun swift-format format -i -p
        ' || {
            echo "swift-format format failed"
            exit 1
        }
        restage_and_fail_if_changed "swift-format" "bae-macos/"
        restage_and_fail_if_changed "swift-format" "BaeKit/"

        # Lint catches structural rules the formatter does not auto-fix
        # (e.g. OnlyOneTrailingClosureArgument, TypeNamesShouldBeCapitalized,
        # EndOfLineComment). These need a manual fix.
        run_check "swift-format lint (bae-macos + BaeKit)" bash -c '
            find bae-macos/bae/bae BaeKit/Sources/BaeKit -name "*.swift" -print0 \
                | xargs -0 xcrun swift-format lint -s
        ' || {
            echo "swift-format lint failed — fix the violations above and commit again"
            exit 1
        }

        # swift-format owns layout; SwiftLint owns code quality, and the two
        # split cleanly (see .swiftlint.yml). Running only the formatter here
        # let two oversized view bodies reach main and fail CI, so the same
        # roots CI lints are linted here — the point of a pre-commit gate is
        # that it is the same gate.
        run_check "swiftlint (bae-macos + BaeKit + bae-ios)" \
            swiftlint lint --quiet --strict --config .swiftlint.yml \
            bae-macos/bae/bae BaeKit/Sources/BaeKit bae-ios/bae/bae || {
            echo "swiftlint failed — fix the violations above and commit again"
            exit 1
        }
    fi

    run_check "build bridge (bae-macos)" ./bae-bridge/build-macos.sh || {
        echo "Bridge build failed"
        exit 1
    }

    ./bae-bridge/install-swift-bindings.sh macos

    if ! command -v xcodegen &> /dev/null; then
        echo "⚠️  xcodegen not installed, skipping macOS build check"
    else
        # The build below disables automatic package resolution, which needs a
        # Package.resolved inside the gitignored generated xcodeproj. The
        # post-checkout prime seeds it on worktree creation, but worktrees
        # created with hooks disabled (lean agent worktrees) never ran it —
        # seed here from the main checkout, same as the prime does.
        resolved="bae-macos/bae/bae.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
        main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
        if [ ! -f "$resolved" ] && [ -f "$main_checkout/$resolved" ]; then
            mkdir -p "$(dirname "$resolved")"
            cp "$main_checkout/$resolved" "$resolved"
            echo "Seeded Package.resolved from $main_checkout"
        fi
        cd bae-macos/bae
        MACOS_DERIVED_DATA_PATH="${BAE_MACOS_DERIVED_DATA_PATH:-.build/derivedData}"
        run_check "xcodegen (bae-macos)" xcodegen || {
            echo "xcodegen failed"
            exit 1
        }
        # Keep xcodebuild and periphery pointed at the same index store.
        run_check "xcodebuild (bae-macos)" xcodebuild -project bae.xcodeproj -scheme bae -configuration Debug \
            CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO \
            -derivedDataPath "$MACOS_DERIVED_DATA_PATH" \
            -scmProvider system -disablePackageRepositoryCache -skipPackageUpdates \
            -disableAutomaticPackageResolution build || {
            echo "macOS app build failed"
            exit 1
        }

        if command -v periphery &> /dev/null; then
            run_check "periphery (bae-macos)" periphery scan --strict \
                --skip-build --skip-schemes-validation \
                --index-store-path "$MACOS_DERIVED_DATA_PATH/Index.noindex/DataStore" || {
                echo "Dead code detected. Remove unused declarations and try again."
                exit 1
            }
        fi

        cd ../..
    fi
fi

# bae-avalonia bridge boundary. The compiler can't see dependency direction, so
# this fails loud if a view or store reaches for NativeBae outside the sanctioned
# composition boundary. Pure Python — runs on the dev host without the bindings.
if has_changes_in "bae-avalonia"; then
    run_check "avalonia bridge boundary" python3 scripts/avalonia-bridge-boundary.py || {
        echo "A view or store reached for NativeBae outside the boundary. See above."
        exit 1
    }
fi

echo "✅ All checks passed"
exit 0
