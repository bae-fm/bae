#!/bin/bash

set -e

source "$(git rev-parse --show-toplevel)/scripts/hooks/lib/file-list.sh"

# In a linked worktree, git exports GIT_DIR/GIT_INDEX_FILE to hooks. Child git
# processes inherit them — SwiftPM's package clones then run `git checkout`
# against *this* repo's object store and die with "unable to read tree". The
# hook's own git commands rediscover the repo from cwd, so drop the overrides.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Use target-macos to avoid busting iOS/Android caches
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target-macos}"

WORKSPACE_CRATES=(
    bae-automation
    bae-bridge
    bae-cast
    bae-core
    bae-desktop
    bae-loc
    bae-mcp
    bae-subsonic
    bae-test-support
)

TMPFILE=$(mktemp)
FORMAT_STATE=$(mktemp)

cleanup() {
    rm -f "$TMPFILE" "$FORMAT_STATE"
}
trap cleanup EXIT

# Get changed files (staged for commit)
CHANGED_FILES=$(git --no-pager diff --cached --name-only)

run_check() {
    local name="$1"
    shift
    echo "Running $name..."
    if "$@" > "$TMPFILE" 2>&1; then
        return 0
    else
        echo ""
        echo "❌ $name failed:"
        cat "$TMPFILE"
        return 1
    fi
}

# Re-stage files the formatter modified (within optional path scope) and
# fail the commit so the dev sees what changed and re-runs `git commit`.
restage_and_fail_if_changed() {
    local tool_name="$1"
    local state_file="$2"
    local scope="${3:-}"
    local status=0
    stage_formatter_changes "$state_file" "$scope" || status=$?
    case "$status" in
        0) return 0 ;;
        1)
            echo ""
            echo "❌ $tool_name reformatted staged files. Changes have been re-staged."
            echo "   Please review the diff and commit again."
            exit 1
            ;;
        2)
            echo ""
            echo "❌ $tool_name reformatted a partially staged file."
            echo "   Existing unstaged hunks were left out of the index; review and stage the intended result."
            exit 1
            ;;
    esac
}

run_check "pre-commit staged path matching" bash scripts/hooks/tests/file-list-test.sh || {
    exit 1
}

# Auto-format all packages. If anything changes, re-stage and fail so the
# dev can review the new diff before committing.
record_staged_worktree_state "$FORMAT_STATE"
run_check "cargo fmt" cargo fmt --all || {
    echo "cargo fmt failed"
    exit 1
}
restage_and_fail_if_changed "cargo fmt" "$FORMAT_STATE"

run_check "source file layout" scripts/check-source-file-size.py || {
    exit 1
}

run_check "restricted-path Rust visibility" scripts/check-rust-visibility.sh || {
    echo "Move the item under its owner and use private or pub(super) access"
    exit 1
}

run_check "UniFFI runtime boundary" scripts/check-uniffi-runtime-boundary.py || {
    exit 1
}

run_check "macOS native Cargo cache" scripts/check-macos-build-cache.sh || {
    exit 1
}

DIRECTLY_CHANGED_CRATES=()
while IFS= read -r crate; do
    [ -n "$crate" ] && DIRECTLY_CHANGED_CRATES+=("$crate")
done < <(changed_workspace_crates "${WORKSPACE_CRATES[@]}")

if [ "${#DIRECTLY_CHANGED_CRATES[@]}" -gt 0 ]; then
    CLIPPY_ARGS=(clippy --all-targets)
    core_changed=0
    for crate in "${DIRECTLY_CHANGED_CRATES[@]}"; do
        CLIPPY_ARGS+=(-p "$crate")
        [ "$crate" = "bae-core" ] && core_changed=1
    done
    if [ "$core_changed" -eq 1 ]; then
        CLIPPY_ARGS+=(--features bae-core/test-utils)
    fi
    CLIPPY_ARGS+=(-- -D warnings)
    run_check "clippy (directly changed crates)" cargo "${CLIPPY_ARGS[@]}" || {
        echo "Fix the warnings above and try again"
        exit 1
    }
fi

STAGED_SWIFT_FILES=()
while IFS= read -r file; do
    [ -f "$file" ] && STAGED_SWIFT_FILES+=("$file")
done < <(staged_files_with_extension swift)

if [ "${#STAGED_SWIFT_FILES[@]}" -gt 0 ] && xcrun --find swift-format &> /dev/null; then
    record_staged_worktree_state "$FORMAT_STATE"
    run_check "swift-format format (staged files)" \
        xcrun swift-format format -i -p "${STAGED_SWIFT_FILES[@]}" || {
        echo "swift-format format failed"
        exit 1
    }
    restage_and_fail_if_changed "swift-format" "$FORMAT_STATE"

    run_check "swift-format lint (staged files)" \
        xcrun swift-format lint -s "${STAGED_SWIFT_FILES[@]}" || {
        echo "swift-format lint failed — fix the violations above and commit again"
        exit 1
    }

    run_check "swiftlint (staged files)" \
        swiftlint lint --quiet --strict --config .swiftlint.yml \
        "${STAGED_SWIFT_FILES[@]}" || {
        echo "swiftlint failed — fix the violations above and commit again"
        exit 1
    }
fi

# bae-avalonia bridge boundary. The compiler can't see dependency direction, so
# this fails loud if a view or store reaches for NativeBae outside the sanctioned
# composition boundary. Pure Python — runs on the dev host without the bindings.
if staged_path_under "bae-avalonia"; then
    run_check "avalonia bridge boundary" python3 scripts/avalonia-bridge-boundary.py || {
        echo "A view or store reached for NativeBae outside the boundary. See above."
        exit 1
    }
fi

echo "✅ All checks passed"
exit 0
