#!/usr/bin/env bash
# post-checkout: fires after `git checkout` and `git worktree add`.
# On new-worktree creation, run per-worktree setup: build output links, the
# CLAUDE.md symlink, shared FFmpeg, xcconfigs, Android local.properties and the
# macOS app's resolved SwiftPM versions. It builds nothing: a side worktree
# builds host Rust only, and app builds stay warm in the app checkout and main
# (projects/bae.md, "Worktrees and build output"). Skip on normal branch
# checkouts.

set -euo pipefail

prev_head="$1"
flag="$3"
null_sha="0000000000000000000000000000000000000000"

# Only fire on initial worktree creation (prev_head == all zeros, branch checkout).
if [ "$prev_head" != "$null_sha" ] || [ "$flag" != "1" ]; then
    exit 0
fi

worktree_root="$(git rev-parse --show-toplevel)"
cd "$worktree_root"

# Link the build output paths before anything below builds into them.
./scripts/build-layout.sh

# Project CLAUDE.md (gitignored). Convention: agent-instructions repo
# at ~/dev/agent-instructions/projects/bae.md.
ln -sf "$HOME/dev/agent-instructions/projects/bae.md" CLAUDE.md

# Share the machine's prebuilt FFmpeg from the main checkout. bae-ffmpeg/ holds
# the libs downloaded from the bae-ffmpeg fork's release -- dist/ (this host's
# macOS/Linux libs) and ios/ + android/ (the cross-compiled mobile libs), via
# scripts/setup-ffmpeg.sh and scripts/build-ffmpeg-{ios,android}.sh. They don't
# come along when git creates a worktree (they're gitignored), so a build here
# would otherwise re-download them. Symlink the main checkout's directory so
# every worktree shares one copy; the whole path is gitignored, so the symlink
# stays out of `git status`.
main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
if [ "$main_checkout" != "$worktree_root" ] \
    && [ -d "$main_checkout/bae-ffmpeg" ] && [ ! -e bae-ffmpeg ]; then
    ln -s "$main_checkout/bae-ffmpeg" bae-ffmpeg
    echo "Linked bae-ffmpeg -> $main_checkout/bae-ffmpeg"
fi

# Per-developer local xcconfigs (gitignored): the signing team and the feature
# set. xcodegen reads them while generating the project, and run.sh signs with
# the team, so a worktree without them generates an unsigned project that fails
# the CloudKit entitlement check. Symlink the main checkout's copies; the paths
# are gitignored, so the links stay out of `git status`.
for cfg in Signing.local.xcconfig Features.xcconfig; do
    if [ -f "$main_checkout/bae-macos/bae/$cfg" ] && [ ! -e "bae-macos/bae/$cfg" ]; then
        ln -s "$main_checkout/bae-macos/bae/$cfg" "bae-macos/bae/$cfg"
        echo "Linked bae-macos/bae/$cfg -> $main_checkout"
    fi
done

# Gradle finds the Android SDK through bae-android/local.properties (gitignored,
# only `sdk.dir`), so a worktree without it fails every Gradle build until
# someone copies it over. Symlink the main checkout's copy.
if [ -f "$main_checkout/bae-android/local.properties" ] \
    && [ ! -e bae-android/local.properties ]; then
    ln -s "$main_checkout/bae-android/local.properties" bae-android/local.properties
    echo "Linked bae-android/local.properties -> $main_checkout"
fi

# The macOS app builds in scripts/check.sh run with
# -disableAutomaticPackageResolution, which requires a Package.resolved. It lives
# inside the gitignored generated xcodeproj, so a new worktree never inherits
# one. Seed it from the main checkout (which keeps building the app), so an app
# build here resolves the same dependency versions as main from cache; xcodegen
# keeps a Package.resolved that is already in place when it generates the
# project.
resolved="bae-macos/bae/bae.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
if [ "$main_checkout" != "$worktree_root" ] \
    && [ -f "$main_checkout/$resolved" ] && [ ! -e "$resolved" ]; then
    mkdir -p "$(dirname "$resolved")"
    cp "$main_checkout/$resolved" "$resolved"
    echo "Seeded Package.resolved from $main_checkout"
fi

echo
echo "Worktree ready: $worktree_root"
