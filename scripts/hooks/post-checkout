#!/usr/bin/env bash
# post-checkout: fires after `git checkout` and `git worktree add`.
# On new-worktree creation, run per-worktree setup (CLAUDE.md symlink, then the
# Rust bridge build + xcodegen + xcodebuild to prime the SPM cache for the
# pre-commit hook). Skip on normal branch checkouts.

set -euo pipefail

prev_head="$1"
flag="$3"
null_sha="0000000000000000000000000000000000000000"

# Only fire on initial worktree creation (prev_head == all zeros, branch checkout).
if [ "$prev_head" != "$null_sha" ] || [ "$flag" != "1" ]; then
    exit 0
fi

worktree_root="$(git rev-parse --show-toplevel)"
cd "$worktree_root"

# Match the pre-commit hook's build environment. A git hook runs without the
# shell profile, so the homebrew native libs the bridge and app link against
# (libdiscid) aren't on the linker path unless we add them. CARGO_TARGET_DIR
# keeps the primed Rust artifacts where the pre-commit hook looks for them.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target-macos}"
if command -v brew &> /dev/null; then
    BREW_PREFIX="$(brew --prefix)"
    export LIBRARY_PATH="${BREW_PREFIX}/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
fi

# Project CLAUDE.md (gitignored). Convention: agent-instructions repo
# at ~/dev/agent-instructions/projects/bae.md.
ln -sf "$HOME/dev/agent-instructions/projects/bae.md" CLAUDE.md

# Share the machine's prebuilt cross-compiled FFmpeg from the main checkout. The
# per-target static libs under third_party/ (ffmpeg-ios, ffmpeg-android, and the
# ffmpeg-src tree they build from) are expensive to compile from source and don't
# come along when git creates a worktree (they're gitignored), so an iOS or
# Android bridge build here would otherwise re-run the whole FFmpeg cross-compile.
# Symlink the main checkout's directory so every worktree shares one build; the
# whole path is gitignored, so the symlink stays out of `git status`.
main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
if [ "$main_checkout" != "$worktree_root" ] \
    && [ -d "$main_checkout/third_party" ] && [ ! -e third_party ]; then
    ln -s "$main_checkout/third_party" third_party
    echo "Linked third_party -> $main_checkout/third_party"
fi

# Build the Rust bridge before generating and building the Xcode project, in the
# same order the pre-commit hook uses. build-macos.sh produces both
# BaeBridgeFFI.xcframework and the generated Swift bindings, and both must exist
# on disk before xcodegen/xcodebuild run: xcodebuild's framework-dependency check
# fails when the xcframework is absent, and xcodegen globs the source tree, so it
# drops bae_bridge.swift if the project is generated before the bindings land.
./bae-bridge/build-macos.sh
cp bae-bridge/swift-bindings-macos/bae_bridge.swift bae-macos/bae/bae/bae_bridge.swift
(cd bae-macos/bae && xcodegen generate)
# xcodegen writes a fresh xcodeproj with no resolved SwiftPM set, but the build
# below runs with -disableAutomaticPackageResolution (matching the pre-commit
# hook), which requires a Package.resolved. It lives inside the gitignored
# generated xcodeproj, so a new worktree never inherits one and the resolve step
# fails. Seed it from the main checkout (which is kept building), so every
# worktree resolves the same dependency versions as main from cache.
resolved="bae-macos/bae/bae.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
if [ -f "$main_checkout/$resolved" ]; then
    mkdir -p "$(dirname "$resolved")"
    cp "$main_checkout/$resolved" "$resolved"
    echo "Seeded Package.resolved from $main_checkout"
fi
# Match the pre-commit hook's xcodebuild flags. Callers may move DerivedData
# outside the worktree by setting BAE_MACOS_DERIVED_DATA_PATH.
macos_derived_data_path="${BAE_MACOS_DERIVED_DATA_PATH:-.build/derivedData}"
(cd bae-macos/bae && xcodebuild -project bae.xcodeproj -scheme bae \
    -configuration Debug CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO \
    -derivedDataPath "$macos_derived_data_path" \
    -scmProvider system -disablePackageRepositoryCache -skipPackageUpdates \
    -disableAutomaticPackageResolution build)

echo
echo "Worktree ready: $worktree_root"
