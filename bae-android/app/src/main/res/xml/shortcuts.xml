<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher long-press shortcuts. Each launches MainActivity with an
     EXTRA_SHORTCUT_ACTION extra the app resolves back to a ShortcutAction
     (see ShortcutActions.kt) and runs once the library is open. targetPackage
     is the build's applicationId, which the baeium flavor suffixes; res/xml
     can't read the manifest ${applicationId} placeholder, so it comes from the
     generated shortcut_target_package string (build.gradle.kts). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="resume"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_resume"
        android:shortcutShortLabel="@string/resume"
        android:shortcutLongLabel="@string/shortcut_resume_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="fm.bae.app.MainActivity"
            android:targetPackage="@string/shortcut_target_package">
            <extra
                android:name="fm.bae.app.SHORTCUT_ACTION"
                android:value="resume" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/search"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="fm.bae.app.MainActivity"
            android:targetPackage="@string/shortcut_target_package">
            <extra
                android:name="fm.bae.app.SHORTCUT_ACTION"
                android:value="search" />
        </intent>
    </shortcut>
</shortcuts>
