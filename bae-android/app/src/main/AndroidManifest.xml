<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ gates the media playback notification (and thus lock-screen /
         Bluetooth / Android Auto controls) on this runtime permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wi-Fi power-save drops multicast and broadcast packets not addressed to
         the device, which is every packet mDNS and SSDP answer with. Holding a
         multicast lock while the device picker browses is what lets bae see the
         answers; the permission is what lets it hold the lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".BaeApp"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bae">

        <!-- Sentry's SDK registers a ContentProvider that auto-initializes at
             process start by reading io.sentry.dsn from the manifest. With no
             DSN that init throws and kills the app before any bae code runs.
             Disable it: BaeCrashReporting.configure() is the only init path,
             and it no-ops (loudly) when no DSN is configured at build time. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- Declares the app as an Android Auto media app so head units surface
             the browsable library. `automotive_app_desc` names the "media" use;
             the PlaybackService's MediaBrowserService intent filter is what Auto
             discovers and binds to. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|locale|layoutDirection|fontScale|uiMode|density"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Bae">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launcher long-press shortcuts (Resume playback, Search). The
                 single activity is singleTop, so a warm shortcut tap re-enters
                 via onNewIntent rather than stacking a second instance. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- The legacy browse action Android Auto and other
                     MediaBrowser clients discover the service by; Media3's
                     MediaLibraryService implements the legacy browser binder. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <!-- Voice search on Android Auto ("play X in bae"): the session
                 resolves the spoken query to a playable track (see
                 BaeLibrarySessionCallback.onAddMediaItems). -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <!-- Serves cover bytes to browse clients over content:// URIs (see
             ArtworkContentProvider). Not exported: Media3 grants the connected
             controller per-URI read access, so no other app can read it. -->
        <provider
            android:name=".playback.ArtworkContentProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Now-playing home-screen widget. Renders the last playback snapshot
             (written from the playback event path) so it shows a track even when
             the app process is dead; taps drive live playback or open the app.
             The label is the app's own ("bae"), so it's not exported. -->
        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>
    </application>
</manifest>
