<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        Generated uniffi Kotlin bindings use java.lang.ref.Cleaner (requires
        API 33) for memory management. These files are generated at build time
        from Rust type definitions and cannot be annotated. Suppress NewApi
        for the generated binding directories; all other source is checked
        against minSdk normally.
    -->
    <issue id="NewApi">
        <ignore path="**/kotlin-bindings*/**" />
    </issue>
    <!--
        Core strings are generated as per-language core_strings.xml files.
        Android chrome translations live in checked-in per-language strings.xml
        files beside the English source.
    -->
    <issue id="MissingTranslation" severity="ignore" />
</lint>
