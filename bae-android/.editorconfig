root = true

# ktlint configuration for the Android app's hand-written Kotlin (the CI step
# runs `ktlint "bae-android/app/src/**/*.kt"` with brew's latest ktlint).
# Jetpack Compose @Composable / @Preview functions use PascalCase by convention;
# the standard function-naming rule would flag every one.
[*.{kt,kts}]
ktlint_function_naming_ignore_when_annotated_with = Composable,Preview
