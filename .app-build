mac build ./bae-macos/run.sh --no-open
mac app bae-macos/bae/.build/runApp/Build/Products/Debug/bae.app
mac bundle fm.bae.desktop
android build ./bae-android/run.sh
step macos ./bae-macos/run.sh --no-open
step macos-tests ./bae-macos/test.sh --build-only
step android-bridge ./bae-bridge/build-android.sh --abi arm64-v8a
step android ./bae-android/compile-all.sh
step notice-shots ./scripts/shots/macos.sh bae-macos/bae/.build/shots --scene notice- --tone midnight
step storage-shots ./scripts/shots/macos.sh bae-macos/bae/.build/shots --scene storage-manager --tone midnight
step android-shots ./scripts/shots/android.sh /Volumes/Builds/bae/shots/android
step library-shots ./scripts/shots/macos.sh bae-macos/bae/.build/shots --scene library-browse-list --tone midnight
step welcome-shots ./scripts/shots/macos.sh bae-macos/bae/.build/shots --scene welcome- --scene story-1 --tone midnight
step import-shots ./scripts/shots/macos.sh bae-macos/bae/.build/shots --scene import- --tone midnight
step release-shots ./scripts/shots/macos.sh bae-macos/bae/.build/shots --scene release-storage --tone midnight
step release-files-shots ./scripts/shots/macos.sh bae-macos/bae/.build/shots --scene release-files- --tone midnight
step settings-shots ./scripts/shots/macos.sh bae-macos/bae/.build/shots --scene settings- --tone midnight
step activity-shots ./scripts/shots/macos.sh bae-macos/bae/.build/shots --scene activity- --tone midnight
