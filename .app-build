mac build ./bae-macos/run.sh --no-open
mac app bae-macos/bae/.build/runApp/Build/Products/Debug/bae.app
mac bundle fm.bae.desktop
shots-source bae-shots
here macos
results mac shots/mac
results android shots/android bae-android/app/build/test-results
android build ./bae-android/run.sh
# What `builds check` builds for a branch: the steps of each rule whose pattern
# matches a path the branch changes from its merge-base with origin/main. For a
# branch that changes only Rust files, `builds check` builds nothing.
on bae-macos/ macos-tests
on BaeKit/ macos-tests
on bae-android/ android-bridge android
on bae-bridge/ macos-tests android-bridge android
# The shot scenes' scheme compiles the app again in its own tree, so a build
# that compiled both schemes would take twice as long as one that compiles the
# app's. An app build compiles the scenes only for a change to them. bae-shots
# compiles them for a --shots run, and the `test mac:shots` line for a --test
# run of a scenes' class.
on bae-macos/bae/baeShots/ macos-shots-tests
# What a --test or --shots run needs built when the branch changes nothing its
# lane builds.
needs mac macos-tests
needs android android-bridge android
# The folders where builds looks for a test class to find its lane.
sources mac bae-macos BaeKit
# The shot scenes are in their own test bundle, baeShots, which the `test mac`
# line does not run.
sources mac:shots bae-macos/bae/baeShots
# The UI tests are in baeUITests, which the `test mac` line does not run either.
sources mac:ui bae-macos/bae/baeUITests
sources android bae-android

step mac macos ./bae-macos/run.sh --no-open
step mac macos-tests ./bae-macos/test.sh --build-only
step mac macos-shots-tests ./bae-macos/test.sh --build-only --bundle baeShots
step mac macos-tests-run ./bae-macos/test.sh --run-only
step mac macos-tests-all ./bae-macos/test.sh
step android android-bridge ./bae-bridge/build-android.sh --abi arm64-v8a
step android android ./bae-android/compile-all.sh
step android android-tests ./bae-android/test-unit.sh
step mac mac-shots scripts/cargo.sh run -p bae-shots -- run --platform mac
step mac mac-window-shots scripts/cargo.sh run -p bae-shots -- run --platform mac --windows --select mac.welcome. --select mac.settings.
step android android-shots scripts/cargo.sh run -p bae-shots -- run --platform android
# Only CI runs these steps, which run whole test suites or fixed sets of shots.
# builds app-build refuses them: an app build runs only the test classes and
# shots of the screens a change touches.
ci-only macos-tests-run macos-tests-all android-tests mac-shots mac-window-shots android-shots
shots mac scripts/cargo.sh run -p bae-shots -- run --platform mac --windows --select {select}
shots android scripts/cargo.sh run -p bae-shots -- run --platform android --select {select}

limit macos 20m
limit macos-tests 20m
limit macos-shots-tests 20m
limit macos-tests-run 10m
limit android-bridge 15m
limit android 15m
limit android-tests 10m
limit mac-shots 20m
limit mac-window-shots 20m
limit android-shots 20m

test mac ./bae-macos/test.sh --run-only {class}
test mac:shots ./bae-macos/test.sh --bundle baeShots {class}
test mac:ui ./bae-macos/test.sh --run-only --bundle baeUITests {class}
# The UI tests launch the app and drive its windows, so builds runs them only
# on a build host, where no one sits at the screen.
opens-windows mac:ui
test android ./bae-android/test-class.sh {class}
