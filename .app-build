mac build ./bae-macos/run.sh --no-open
mac app bae-macos/bae/.build/runApp/Build/Products/Debug/bae.app
mac bundle fm.bae.desktop
android build ./bae-android/run.sh
step mac macos ./bae-macos/run.sh --no-open
step mac macos-tests ./bae-macos/test.sh --build-only
step mac macos-tests-run ./bae-macos/test.sh --run-only
step mac macos-tests-all ./bae-macos/test.sh
step mac macos-track-tests ./bae-macos/test.sh --run-only TrackTests
step mac macos-detail-tests ./bae-macos/test.sh --run-only ReleaseDetailTests
step android android-bridge ./bae-bridge/build-android.sh --abi arm64-v8a
step android android ./bae-android/compile-all.sh
step android android-tests ./bae-android/test-unit.sh
step android android-album-detail-tests ./bae-android/gradle.sh :app:testFullDebugUnitTest --tests *AlbumDetailPlaceholderTest
step android android-element-list-tests ./bae-android/gradle.sh :app:testFullDebugUnitTest --tests *ElementListTest
step android android-welcome-libraries-tests ./bae-android/gradle.sh :app:testFullDebugUnitTest --tests *WelcomeLibrariesTest
step mac macos-welcome-library-row-tests ./bae-macos/test.sh --run-only WelcomeLibraryRowTests
step mac macos-sort-language-tests ./bae-macos/test.sh --run-only SortLanguageTests
step android android-sort-language-tests ./bae-android/gradle.sh :app:testFullDebugUnitTest --tests *SortLanguageTest
step mac macos-screen-subscription-tests ./bae-macos/test.sh --run-only ScreenSubscriptionTests
step android android-screen-subscription-tests ./bae-android/gradle.sh :screensubscription:testFullDebugUnitTest --tests *ScreenSubscriptionTest
step mac mac-shots scripts/cargo.sh run -p bae-shots -- run --platform mac
step mac mac-welcome-shots scripts/cargo.sh run -p bae-shots -- run --platform mac --select mac.welcome.
step mac mac-component-shots scripts/cargo.sh run -p bae-shots -- run --platform mac --select mac.component.
step mac mac-window-shots scripts/cargo.sh run -p bae-shots -- run --platform mac --windows --select mac.welcome. --select mac.settings.
step android android-shots scripts/cargo.sh run -p bae-shots -- run --platform android
step android android-welcome-shots scripts/cargo.sh run -p bae-shots -- run --platform android --select android.welcome.
step android android-component-shots scripts/cargo.sh run -p bae-shots -- run --platform android --select android.component.

limit macos-tests-run 10m
limit android-tests 10m
limit android-element-list-tests 10m
limit macos-track-tests 10m
limit macos-detail-tests 10m
limit android-album-detail-tests 10m
limit macos-welcome-library-row-tests 10m
limit android-welcome-libraries-tests 10m
limit macos-sort-language-tests 10m
limit android-sort-language-tests 10m
limit macos-screen-subscription-tests 10m
limit android-screen-subscription-tests 10m
limit mac-shots 20m
limit mac-welcome-shots 20m
limit mac-component-shots 20m
limit mac-window-shots 20m
limit android-shots 20m
limit android-welcome-shots 20m
limit android-component-shots 20m
