mac build ./bae-macos/run.sh --no-open
mac app bae-macos/bae/.build/runApp/Build/Products/Debug/bae.app
mac bundle fm.bae.desktop
shots-source bae-shots
here macos
results mac shots/mac
results android shots/android bae-android/app/build/test-results
android build ./bae-android/run.sh
# What `builds check` builds for a branch: the steps of each rule whose pattern
# matches a path the branch changes from its merge-base with origin/main. A
# branch of Rust only builds nothing.
on bae-macos/ macos-tests
on BaeKit/ macos-tests
on bae-android/ android-bridge android
on bae-bridge/ macos-tests android-bridge android
# What a --test or --shots run needs built when the branch changes nothing its
# lane builds.
needs mac macos-tests
needs android android-bridge android
# Where each lane's test classes are declared, to find a class's lane.
sources mac bae-macos BaeKit
sources android bae-android

step mac macos ./bae-macos/run.sh --no-open
step mac macos-tests ./bae-macos/test.sh --build-only
step mac macos-tests-run ./bae-macos/test.sh --run-only
step mac macos-tests-all ./bae-macos/test.sh
step android android-bridge ./bae-bridge/build-android.sh --abi arm64-v8a
step android android ./bae-android/compile-all.sh
step android android-tests ./bae-android/test-unit.sh
step mac mac-shots scripts/cargo.sh run -p bae-shots -- run --platform mac
step mac mac-window-shots scripts/cargo.sh run -p bae-shots -- run --platform mac --windows --select mac.welcome. --select mac.settings.
step android android-shots scripts/cargo.sh run -p bae-shots -- run --platform android
shots mac scripts/cargo.sh run -p bae-shots -- run --platform mac --select {select}
shots android scripts/cargo.sh run -p bae-shots -- run --platform android --select {select}

limit macos-tests-run 10m
limit android-tests 10m
limit mac-shots 20m
limit mac-window-shots 20m
limit android-shots 20m

test mac ./bae-macos/test.sh --run-only {class}
test android ./bae-android/test-class.sh {class}
