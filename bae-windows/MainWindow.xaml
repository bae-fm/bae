<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bae.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bae.Windows"
    Title="bae">
    <!-- Background="Transparent" makes the whole window a hit-testable drop target,
         so a folder can be dropped over empty areas (e.g. the empty-library state),
         not just over the grid. -->
    <Grid x:Name="RootGrid" KeyDown="OnGlobalKeyDown" AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop" Background="Transparent">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFocusSearchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnGoToNowPlaying" />
            <!-- Ctrl+1..9 switch to the Nth discovered library (discovery order,
                 as the libraries dialog lists them). Ctrl+0 stays storage. -->
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number5" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number6" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number7" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number8" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number9" Invoked="OnLibrarySwitchAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- The toolbar: a 56px gradient strip under a bottom hairline (same brushes
             as the docked now-playing bar), holding the search field and the
             icon-only chrome buttons. -->
        <Border Grid.Row="0" Height="56" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorDefault}" Offset="0" />
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorSecondary}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,0,16,0" ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="SearchBox"
                    Grid.Column="0"
                    Width="300"
                    Height="38"
                    CornerRadius="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    PlaceholderText="Search"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchSubmitted">
                    <AutoSuggestBox.Resources>
                        <!-- Border turns accent while focused; the field keeps the
                             framework's recessed control fill. -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}" Opacity="0.7" />
                    </AutoSuggestBox.Resources>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="SearchFlyout" Placement="BottomEdgeAlignedLeft">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="8" />
                                    <Setter Property="CornerRadius" Value="14" />
                                    <Setter Property="MinWidth" Value="468" />
                                    <Setter Property="MaxWidth" Value="572" />
                                    <Setter Property="MaxHeight" Value="728" />
                                    <!-- Hug the results and top-align them: no height
                                         floor, content pinned to the top, and the
                                         presenter's own scroller off so the ListView
                                         (capped below) does the scrolling and keeps
                                         virtualizing. -->
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="VerticalContentAlignment" Value="Top" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{ThemeResource SolidBackgroundFillColorSecondary}" Offset="0" />
                                                <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <ListView
                                x:Name="SearchResultsList"
                                Width="468"
                                MaxHeight="712"
                                VerticalAlignment="Top"
                                SelectionMode="None" />
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </AutoSuggestBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="SyncIndicator" VerticalAlignment="Center"
                               Foreground="Gray" TextWrapping="NoWrap" />
                    <!-- Playback menu: an icon button whose flyout shuffles the whole
                         library. -->
                    <Button x:Name="PlaybackMenuButton" Style="{StaticResource ToolbarIconButtonStyle}">
                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Name="ShuffleLibraryItem"
                                    x:Uid="ShuffleLibraryMenuItem"
                                    Text="shuffle library"
                                    IsEnabled="False"
                                    Click="OnShuffleLibraryClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="LibrariesButton" Style="{StaticResource ToolbarIconButtonStyle}" Click="OnLibrariesClick">
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                    </Button>
                    <!-- x:Uid keeps the distinct localized "close library" tooltip
                         (a destructive action wants the clearer label); the glyph is
                         set in code so x:Uid's Content string doesn't replace it. -->
                    <Button x:Name="CloseLibraryButton" x:Uid="CloseLibraryButton" Style="{StaticResource ToolbarIconButtonStyle}" Click="OnCloseLibraryClick">
                        <Button.KeyboardAccelerators>
                            <!-- Ctrl+Shift+W, not bare Ctrl+W: closing the library is destructive
                                 (tears down to the welcome chooser), and bare Ctrl+W is the reflex
                                 for "close this tab/window". macOS guards it behind Shift too. -->
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="W" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="ImportButton" Style="{StaticResource ToolbarIconButtonStyle}" Click="OnImportClick">
                        <FontIcon Glyph="&#xE8B5;" FontSize="16" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="I" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="StorageButton" Style="{StaticResource ToolbarIconButtonStyle}" Click="OnStorageClick">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Number0" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolbarIconButtonStyle}" Click="OnSettingsClick">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <!-- The library content area's backdrop: a faint top-trailing lift fading
             to the base background. Behind the capped content column. -->
        <Border Grid.Row="1">
            <Border.Background>
                <RadialGradientBrush Center="0.8,-0.1" GradientOrigin="0.8,-0.1" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorDefault}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <!-- The capped, centered content column: a header band above whichever
             browse panel is visible. MaxWidth is lifted to full width by the
             library_full_width preference (set in code). -->
        <Grid x:Name="ContentColumn" Grid.Row="1" MaxWidth="1240" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderBand" Grid.Row="0" Padding="22,56,22,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- The mode heading is the mode switcher: a large heavy label with a
                     chevron whose flyout picks albums / artists / composers. -->
                <Button
                    x:Name="ModeHeadingButton"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
                    <Button.Flyout>
                        <MenuFlyout x:Name="ModeHeadingFlyout" />
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <TextBlock
                            x:Name="ModeHeadingText"
                            FontSize="56"
                            FontWeight="ExtraBold"
                            CharacterSpacing="-25"
                            VerticalAlignment="Bottom" />
                        <FontIcon
                            x:Name="ModeHeadingChevron"
                            Glyph="&#xE70D;"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Bottom" />
                    </StackPanel>
                </Button>
                <StackPanel
                    x:Name="SortControls"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Bottom" />
            </Grid>
            <GridView
                x:Name="AlbumGrid"
                Grid.Row="1"
                ItemsSource="{x:Bind Albums}"
                Padding="16,0,16,24"
                SelectionMode="None"
                IsItemClickEnabled="True"
                CanDragItems="True"
                SizeChanged="OnAlbumGridSizeChanged"
                DragItemsStarting="OnAlbumDragStarting"
                ItemClick="OnAlbumClick"
                RightTapped="OnAlbumGridRightTapped">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:Album">
                        <!-- The cell reserves a trailing gutter and a bottom row gap so
                             ItemsWrapGrid's equal cells read as spaced tiles. -->
                        <Grid Margin="0,0,30,34">
                            <!-- The multi-selection tint: always in the layout tree, toggled
                                 by Opacity (not Visibility), so a selection change never
                                 re-measures the tile — required in a virtualized,
                                 container-recycling GridView. -->
                            <Border
                                CornerRadius="10"
                                Opacity="{x:Bind SelectionTintOpacity, Mode=OneWay}">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.22" />
                                </Border.Background>
                            </Border>
                            <StackPanel Spacing="2" Padding="6">
                                <!-- The art is square: it stretches to the cell width and
                                     matches its height to its width on size change. -->
                                <Border
                                    CornerRadius="12"
                                    HorizontalAlignment="Stretch"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    SizeChanged="OnTileArtSizeChanged"
                                    Translation="0,0,16">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                    <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis"
                                    Margin="0,8,0,0" />
                                <TextBlock
                                    Text="{x:Bind Artist}"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <!-- The year line keeps its height even when absent so tiles
                                     stay uniform. -->
                                <TextBlock
                                    Text="{x:Bind YearText}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Height="16"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <Grid
                x:Name="ComposerBrowser"
                Grid.Row="1"
                Margin="16,0,16,24"
                ColumnSpacing="0"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Master list on the base background: full-width rounded rows,
                     subtle pointer-over fill, soft system-accent tint when selected
                     (the accent pill is suppressed so the fill reads on its own). -->
                <ListView
                    x:Name="ComposerList"
                    Grid.Column="0"
                    Padding="10,4,10,20"
                    ItemsSource="{x:Bind Composers}"
                    IsItemClickEnabled="True"
                    SelectionMode="Single"
                    ItemClick="OnComposerClick">
                    <ListView.Resources>
                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.2" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{ThemeResource TextFillColorPrimary}" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="CornerRadius" Value="7" />
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ComposerSummary">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border
                                    Width="40"
                                    Height="40"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        FontSize="14"
                                        FontWeight="Medium"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind WorkCountText}"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- Detail pane one surface step up, with a hairline on its leading
                     edge; the content column is capped and inset. -->
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <ScrollViewer>
                        <StackPanel
                            x:Name="ComposerDetailPane"
                            Margin="24"
                            MaxWidth="900"
                            HorizontalAlignment="Stretch"
                            Spacing="20" />
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid
                x:Name="ArtistBrowser"
                Grid.Row="1"
                Margin="16,0,16,24"
                ColumnSpacing="16"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListView
                    x:Name="ArtistList"
                    Grid.Column="0"
                    ItemsSource="{x:Bind Artists}"
                    IsItemClickEnabled="True"
                    SelectionMode="Single"
                    ItemClick="OnArtistClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ArtistSummary">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4">
                                <Border
                                    Width="42"
                                    Height="42"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind AlbumCountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ScrollViewer Grid.Column="1">
                    <StackPanel x:Name="ArtistDetailPane" Spacing="10" />
                </ScrollViewer>
            </Grid>
        </Grid>
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="24,8,24,0" Spacing="8">
            <!-- General errors (playback, scan/library). Sync keeps its own
                 banner below so a recovered error can't dismiss a live sync failure. -->
            <InfoBar x:Name="Banner" IsOpen="False" IsClosable="True" />
            <InfoBar x:Name="SyncBanner" IsOpen="False" IsClosable="True" />
        </StackPanel>
        <!-- The non-modal queue pane. A right-aligned in-tree panel (not a Flyout
             or Popup) so the album grid behind it can source a drag while the pane
             stays open; the queue button toggles its visibility. -->
        <Border
            x:Name="QueuePaneHost"
            Grid.Row="1"
            HorizontalAlignment="Right"
            Width="420"
            Visibility="Collapsed"
            BorderThickness="1,0,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorDefault}" Offset="0" />
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorSecondary}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!-- The docked now-playing bar: a full-width strip in its own bottom row
             under a hairline, with a subtle vertical surface gradient for fill.
             The internals stay the redesigned card layout; only the outer chrome
             flattens. -->
        <Border
            x:Name="NowPlayingBar"
            Grid.Row="2"
            Visibility="Collapsed"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorDefault}" Offset="0" />
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorSecondary}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="20,12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: cover + title/artist, truncating. Art and title open
                     the playing album. -->
                <Grid Grid.Column="0" ColumnSpacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="NpCoverFrame"
                        Grid.Column="0"
                        Width="54"
                        Height="54"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Tapped="OnNowPlayingInfoTapped"
                        Translation="0,0,8">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Image x:Name="NpCover" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            x:Name="NpTitle"
                            MaxLines="1"
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Tapped="OnNowPlayingInfoTapped" />
                        <TextBlock
                            x:Name="NpArtist"
                            MaxLines="1"
                            FontSize="13"
                            FontWeight="Medium"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Center: transport row above the scrubber row, fixed width. -->
                <StackPanel Grid.Column="1" Width="460" VerticalAlignment="Center" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center">
                        <Button
                            x:Name="NpShuffle"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            Click="OnShuffle">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                            </Button.KeyboardAccelerators>
                            <FontIcon x:Name="NpShuffleGlyph" Glyph="&#xE8B1;" FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                        <Button
                            x:Name="NpPrev"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnPrevious">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="P" />
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE892;" FontSize="20" />
                        </Button>
                        <Grid Width="48" Height="48">
                            <Button
                                x:Name="NpPlayPause"
                                Width="48"
                                Height="48"
                                Padding="0"
                                CornerRadius="24"
                                BorderThickness="0"
                                Background="{ThemeResource NowPlayingPlayFillBrush}"
                                Click="OnPlayPause"
                                Translation="0,0,12"
                                RenderTransformOrigin="0.5,0.5"
                                PointerEntered="OnPlayPausePointerEntered"
                                PointerExited="OnPlayPausePointerExited">
                                <Button.RenderTransform>
                                    <ScaleTransform x:Name="NpPlayScale" ScaleX="1" ScaleY="1" />
                                </Button.RenderTransform>
                                <Button.Shadow>
                                    <ThemeShadow />
                                </Button.Shadow>
                                <FontIcon x:Name="NpPlayGlyph" Glyph="&#xE768;" FontSize="20"
                                          Foreground="{ThemeResource NowPlayingPlayGlyphBrush}" />
                            </Button>
                            <ProgressRing
                                x:Name="NpLoading"
                                Width="24"
                                Height="24"
                                IsActive="False"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Foreground="{ThemeResource NowPlayingPlayGlyphBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                        <Button
                            x:Name="NpNext"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnNext">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="N" />
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE893;" FontSize="20" />
                        </Button>
                        <Button
                            x:Name="NpRepeat"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRepeat">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="R" />
                            </Button.KeyboardAccelerators>
                            <FontIcon x:Name="NpRepeatGlyph" Glyph="&#xE8EE;" FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                    <Grid ColumnSpacing="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="NpElapsed"
                            Grid.Column="0"
                            Text="0:00"
                            MinWidth="34"
                            TextAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider
                            x:Name="NpProgress"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.001"
                            VerticalAlignment="Center">
                            <Slider.Resources>
                                <x:Double x:Key="SliderTrackThemeHeight">5</x:Double>
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="Transparent" />
                                <!-- Progress fill: a subtle horizontal accent gradient. -->
                                <LinearGradientBrush x:Key="SliderTrackValueFill" StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                                    <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1" />
                                </LinearGradientBrush>
                                <LinearGradientBrush x:Key="SliderTrackValueFillPointerOver" StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                                    <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1" />
                                </LinearGradientBrush>
                                <LinearGradientBrush x:Key="SliderTrackValueFillPressed" StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                                    <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1" />
                                </LinearGradientBrush>
                            </Slider.Resources>
                        </Slider>
                        <TextBlock
                            x:Name="NpDuration"
                            Grid.Column="2"
                            Text="0:00"
                            MinWidth="34"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>

                <!-- Right: queue toggle, mute, volume, trailing-aligned. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="32" Height="32">
                        <Button
                            x:Name="NpQueue"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnQueueClick"
                            AllowDrop="True" DragOver="OnQueueButtonDragOver" Drop="OnQueueButtonDrop">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="Q" />
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE8FD;" FontSize="17" />
                        </Button>
                        <Border
                            x:Name="QueueAddBadge"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="5,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-4,-4,0"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="QueueAddBadgeScale" ScaleX="0.6" ScaleY="0.6" />
                            </Border.RenderTransform>
                            <TextBlock
                                x:Name="QueueAddBadgeText"
                                Text="+1"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="White" />
                        </Border>
                    </Grid>
                    <Button
                        x:Name="NpMute"
                        Width="30"
                        Height="30"
                        Padding="0"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnMute">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="M" />
                        </Button.KeyboardAccelerators>
                        <FontIcon x:Name="NpMuteGlyph" Glyph="&#xE994;" FontSize="16" />
                    </Button>
                    <Slider
                        x:Name="NpVolume"
                        Minimum="0"
                        Maximum="1"
                        StepFrequency="0.01"
                        Width="96"
                        VerticalAlignment="Center"
                        ValueChanged="OnVolumeChanged">
                        <Slider.Resources>
                            <x:Double x:Key="SliderTrackThemeHeight">5</x:Double>
                            <SolidColorBrush x:Key="SliderThumbBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource TextFillColorSecondary}" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource TextFillColorSecondary}" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource TextFillColorSecondary}" />
                        </Slider.Resources>
                    </Slider>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
