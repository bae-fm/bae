<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bae.Windows.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bae.Windows">
    <!-- The page-background fill doubles as the drop-target surface: any painted
         background (this one included) makes the whole window hit-testable, so a
         folder can be dropped over empty areas (e.g. the empty-library state),
         not just over the grid. -->
    <Grid x:Name="RootGrid" KeyDown="OnGlobalKeyDown" AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFocusSearchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnGoToNowPlaying" />
            <!-- Ctrl+1..9 switch to the Nth discovered library (discovery order,
                 as the libraries dialog lists them). Ctrl+0 stays storage. -->
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number5" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number6" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number7" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number8" Invoked="OnLibrarySwitchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number9" Invoked="OnLibrarySwitchAccelerator" />
            <!-- Ctrl+Shift+W, not bare Ctrl+W: closing the library is destructive
                 (tears down to the welcome chooser), and bare Ctrl+W is the reflex
                 for "close this tab/window". macOS guards it behind Shift too. -->
            <KeyboardAccelerator Modifiers="Control,Shift" Key="W" Invoked="OnCloseLibraryAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number0" Invoked="OnStorageAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- The toolbar: a 56px gradient strip under a bottom hairline (same brushes
             as the docked now-playing bar), holding the search field and the
             icon-only chrome buttons. -->
        <Border Grid.Row="0" Height="56" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorDefault}" Offset="0" />
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorSecondary}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,0,16,0" VerticalAlignment="Center">
                <!-- The Library/Import switcher: the big segmented pill centered in
                     the bar, the active segment filled with the accent — the same
                     section switcher the macOS title bar centers. -->
                <Border
                    x:Name="SectionPill"
                    HorizontalAlignment="Center"
                    Margin="0,0,64,0"
                    CornerRadius="11"
                    Padding="4"
                    Background="#101019"
                    BorderThickness="1"
                    BorderBrush="#0FFFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="LibrarySegment"
                            Padding="20,7"
                            CornerRadius="8"
                            BorderThickness="0"
                            FontSize="14.5"
                            FontWeight="Bold"
                            Click="OnLibrarySegmentClick" />
                        <Button
                            x:Name="ImportSegment"
                            Padding="20,7"
                            CornerRadius="8"
                            BorderThickness="0"
                            FontSize="14.5"
                            FontWeight="Bold"
                            Click="OnImportSegmentClick">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="I" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ToolbarButtons" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="SearchBox"
                    Width="300"
                    Height="38"
                    CornerRadius="10"
                    VerticalAlignment="Center"
                    PlaceholderText="Search"
                    QueryIcon="Find">
                    <AutoSuggestBox.Resources>
                        <!-- Border turns accent while focused; the field keeps the
                             framework's recessed control fill. -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}" Opacity="0.7" />
                    </AutoSuggestBox.Resources>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="SearchFlyout" Placement="BottomEdgeAlignedLeft">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="8" />
                                    <Setter Property="CornerRadius" Value="14" />
                                    <Setter Property="MinWidth" Value="468" />
                                    <Setter Property="MaxWidth" Value="572" />
                                    <Setter Property="MaxHeight" Value="728" />
                                    <!-- Hug the results and top-align them: no height
                                         floor, content pinned to the top, and the
                                         presenter's own scroller off so the ListView
                                         (capped below) does the scrolling and keeps
                                         virtualizing. -->
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="VerticalContentAlignment" Value="Top" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{ThemeResource SolidBackgroundFillColorSecondary}" Offset="0" />
                                                <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <ListView
                                x:Name="SearchResultsList"
                                Width="468"
                                MaxHeight="712"
                                VerticalAlignment="Top"
                                SelectionMode="None" />
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </AutoSuggestBox>
                <TextBlock x:Name="SyncIndicator" VerticalAlignment="Center"
                           Foreground="Gray" TextWrapping="NoWrap" />
                <!-- The gear: Settings on click, like macOS. The commands macOS
                     keeps in its menu bar (a chrome Windows doesn't have) live in
                     the gear's right-click flyout; their accelerators are global
                     on the root grid. -->
                <Button x:Name="SettingsButton" Style="{StaticResource ToolbarIconButtonStyle}" Click="OnSettingsClick">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <Button.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="LibrariesMenuItem" Click="OnLibrariesClick" />
                            <MenuFlyoutItem x:Name="StorageMenuItem" Click="OnStorageClick" />
                            <MenuFlyoutItem
                                x:Name="ShuffleLibraryItem"
                                x:Uid="ShuffleLibraryMenuItem"
                                Text="shuffle library"
                                IsEnabled="False"
                                Click="OnShuffleLibraryClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CloseLibraryMenuItem" Click="OnCloseLibraryClick" />
                        </MenuFlyout>
                    </Button.ContextFlyout>
                </Button>
                </StackPanel>
            </Grid>
        </Border>
        <!-- The library content area's backdrop: a faint top-trailing lift fading
             to the base background. Behind the capped content column. -->
        <Border Grid.Row="1">
            <Border.Background>
                <RadialGradientBrush Center="0.8,-0.1" GradientOrigin="0.8,-0.1" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorDefault}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <!-- The capped, centered content column: a header band above whichever
             browse panel is visible. MaxWidth is lifted to full width by the
             library_full_width preference (set in code). -->
        <Grid x:Name="ContentColumn" Grid.Row="1" MaxWidth="1240" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderBand" Grid.Row="0" Padding="22,56,22,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- The mode heading is the mode switcher: a large heavy label with a
                     chevron whose flyout picks albums / artists / composers. -->
                <Button
                    x:Name="ModeHeadingButton"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
                    <Button.Flyout>
                        <MenuFlyout x:Name="ModeHeadingFlyout" />
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <TextBlock
                            x:Name="ModeHeadingText"
                            FontSize="56"
                            FontWeight="ExtraBold"
                            CharacterSpacing="-25"
                            VerticalAlignment="Bottom" />
                        <FontIcon
                            x:Name="ModeHeadingChevron"
                            Glyph="&#xE70D;"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Bottom" />
                    </StackPanel>
                </Button>
                <StackPanel
                    x:Name="SortControls"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Bottom" />
            </Grid>
            <!-- The album grid is a ListView of row items: its ItemsStackPanel
                 virtualizes rows (like the composer/artist lists), so a full-width
                 detail panel can be injected under the row that holds the expanded
                 album. Each row's cards (and, for the host row, that panel) are
                 built in OnAlbumRowChanging; there is no ItemTemplate. Card click,
                 right-tap, and drag are per-card, so the ListView itself takes no
                 clicks/drags. -->
            <ListView
                x:Name="AlbumGrid"
                Grid.Row="1"
                Padding="16,0,16,24"
                SelectionMode="None">
                <ListView.Resources>
                    <!-- The row is layout only; the cards are the interactive
                         elements, so a row container never shows a pointer-over or
                         pressed fill. -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <Grid
                x:Name="ComposerBrowser"
                Grid.Row="1"
                Margin="16,0,16,24"
                ColumnSpacing="0"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Master list on the base background: full-width rounded rows,
                     subtle pointer-over fill, soft system-accent tint when selected
                     (the accent pill is suppressed so the fill reads on its own). -->
                <ListView
                    x:Name="ComposerList"
                    Grid.Column="0"
                    Padding="10,4,10,20"
                    IsItemClickEnabled="True"
                    SelectionMode="Single">
                    <ListView.Resources>
                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.2" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{ThemeResource TextFillColorPrimary}" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="CornerRadius" Value="7" />
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ComposerSummary">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border
                                    Width="40"
                                    Height="40"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        FontSize="14"
                                        FontWeight="Medium"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind WorkCountText}"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- Detail pane one surface step up, with a hairline on its leading
                     edge; the content column is capped and inset. -->
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <ScrollViewer>
                        <StackPanel
                            x:Name="ComposerDetailPane"
                            Margin="24"
                            MaxWidth="900"
                            HorizontalAlignment="Stretch"
                            Spacing="20" />
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid
                x:Name="ArtistBrowser"
                Grid.Row="1"
                Margin="16,0,16,24"
                ColumnSpacing="16"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListView
                    x:Name="ArtistList"
                    Grid.Column="0"
                    IsItemClickEnabled="True"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ArtistSummary">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4">
                                <Border
                                    Width="42"
                                    Height="42"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind AlbumCountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ScrollViewer Grid.Column="1">
                    <StackPanel x:Name="ArtistDetailPane" Spacing="10" />
                </ScrollViewer>
            </Grid>
        </Grid>
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <!-- The library empty state (story 3): a title and a guidance line,
                 text only. Collapsed unless the current browse mode is empty. -->
            <StackPanel x:Name="EmptyStatePanel" Spacing="6" Visibility="Collapsed">
                <TextBlock
                    x:Name="EmptyTitle"
                    HorizontalAlignment="Center"
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="EmptyGuidance"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>
        <!-- The import section: the pill switcher swaps it in for the library
             content. Hosts the import view (folders, tabs, candidates). -->
        <Grid x:Name="ImportSectionHost" Grid.Row="1" Visibility="Collapsed"
              MaxWidth="720" Margin="24,16,24,24" />
        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="24,8,24,0" Spacing="8">
            <!-- General errors (playback, scan/library). Sync keeps its own
                 banner below so a recovered error can't dismiss a live sync failure. -->
            <InfoBar x:Name="Banner" IsOpen="False" IsClosable="True" />
            <InfoBar x:Name="SyncBanner" IsOpen="False" IsClosable="True" />
        </StackPanel>
        <!-- The non-modal queue pane. A right-aligned in-tree panel (not a Flyout
             or Popup) so the album grid behind it can source a drag while the pane
             stays open; the queue button toggles its visibility. -->
        <Border
            x:Name="QueuePaneHost"
            Grid.Row="1"
            HorizontalAlignment="Right"
            Width="420"
            Visibility="Collapsed"
            BorderThickness="1,0,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorDefault}" Offset="0" />
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorSecondary}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!-- The docked now-playing bar: a full-width strip in its own bottom row
             under a hairline, with a subtle vertical surface gradient for fill.
             The internals stay the redesigned card layout; only the outer chrome
             flattens. -->
        <!-- Always docked: idle (empty fields, zeroed transport) when nothing
             plays, per desktop story 3. -->
        <Border
            x:Name="NowPlayingBar"
            Grid.Row="2"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorDefault}" Offset="0" />
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorSecondary}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="20,12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: cover + title/artist, truncating. Art and title open
                     the playing album. -->
                <Grid Grid.Column="0" ColumnSpacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="NpCoverFrame"
                        Grid.Column="0"
                        Width="54"
                        Height="54"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Translation="0,0,8">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Image x:Name="NpCover" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            x:Name="NpTitle"
                            MaxLines="1"
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="NpArtist"
                            MaxLines="1"
                            FontSize="13"
                            FontWeight="Medium"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Center: transport row above the scrubber row, fixed width. -->
                <StackPanel Grid.Column="1" Width="460" VerticalAlignment="Center" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center">
                        <Button
                            x:Name="NpShuffle"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                            </Button.KeyboardAccelerators>
                            <FontIcon x:Name="NpShuffleGlyph" Glyph="&#xE8B1;" FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                        <Button
                            x:Name="NpPrev"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="P" />
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE892;" FontSize="20" />
                        </Button>
                        <Grid Width="48" Height="48">
                            <Button
                                x:Name="NpPlayPause"
                                Width="48"
                                Height="48"
                                Padding="0"
                                CornerRadius="24"
                                BorderThickness="0"
                                Background="{ThemeResource NowPlayingPlayFillBrush}"
                                Translation="0,0,12"
                                RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <ScaleTransform x:Name="NpPlayScale" ScaleX="1" ScaleY="1" />
                                </Button.RenderTransform>
                                <Button.Shadow>
                                    <ThemeShadow />
                                </Button.Shadow>
                                <FontIcon x:Name="NpPlayGlyph" Glyph="&#xE768;" FontSize="20"
                                          Foreground="{ThemeResource NowPlayingPlayGlyphBrush}" />
                            </Button>
                            <ProgressRing
                                x:Name="NpLoading"
                                Width="24"
                                Height="24"
                                IsActive="False"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Foreground="{ThemeResource NowPlayingPlayGlyphBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                        <Button
                            x:Name="NpNext"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="N" />
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE893;" FontSize="20" />
                        </Button>
                        <Button
                            x:Name="NpRepeat"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="R" />
                            </Button.KeyboardAccelerators>
                            <FontIcon x:Name="NpRepeatGlyph" Glyph="&#xE8EE;" FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                    <Grid ColumnSpacing="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="NpElapsed"
                            Grid.Column="0"
                            Text="0:00"
                            MinWidth="34"
                            TextAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider
                            x:Name="NpProgress"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.001"
                            VerticalAlignment="Center">
                            <Slider.Resources>
                                <x:Double x:Key="SliderTrackThemeHeight">5</x:Double>
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="Transparent" />
                                <!-- Progress fill: a subtle horizontal accent gradient. -->
                                <LinearGradientBrush x:Key="SliderTrackValueFill" StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                                    <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1" />
                                </LinearGradientBrush>
                                <LinearGradientBrush x:Key="SliderTrackValueFillPointerOver" StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                                    <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1" />
                                </LinearGradientBrush>
                                <LinearGradientBrush x:Key="SliderTrackValueFillPressed" StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                                    <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1" />
                                </LinearGradientBrush>
                            </Slider.Resources>
                        </Slider>
                        <TextBlock
                            x:Name="NpDuration"
                            Grid.Column="2"
                            Text="0:00"
                            MinWidth="34"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>

                <!-- Right: cast, queue toggle, mute, volume, trailing-aligned. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button
                        x:Name="NpCast"
                        Width="30"
                        Height="30"
                        Padding="0"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderThickness="0">
                        <FontIcon x:Name="NpCastGlyph" Glyph="&#xEC15;" FontSize="16" />
                    </Button>
                    <Grid Width="32" Height="32">
                        <Button
                            x:Name="NpQueue"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="Q" />
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE8FD;" FontSize="17" />
                        </Button>
                        <Border
                            x:Name="QueueAddBadge"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="5,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-4,-4,0"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="QueueAddBadgeScale" ScaleX="0.6" ScaleY="0.6" />
                            </Border.RenderTransform>
                            <TextBlock
                                x:Name="QueueAddBadgeText"
                                Text="+1"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="White" />
                        </Border>
                    </Grid>
                    <Button
                        x:Name="NpMute"
                        Width="30"
                        Height="30"
                        Padding="0"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderThickness="0">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="M" />
                        </Button.KeyboardAccelerators>
                        <FontIcon x:Name="NpMuteGlyph" Glyph="&#xE994;" FontSize="16" />
                    </Button>
                    <Slider
                        x:Name="NpVolume"
                        Minimum="0"
                        Maximum="1"
                        StepFrequency="0.01"
                        Width="96"
                        VerticalAlignment="Center">
                        <Slider.Resources>
                            <x:Double x:Key="SliderTrackThemeHeight">5</x:Double>
                            <SolidColorBrush x:Key="SliderThumbBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource TextFillColorSecondary}" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource TextFillColorSecondary}" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource TextFillColorSecondary}" />
                        </Slider.Resources>
                    </Slider>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
