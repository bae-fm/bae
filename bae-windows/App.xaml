<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Bae.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The now-playing play/pause circle inverts between themes: a light
                 fill with a dark glyph in dark theme, the reverse in light theme.
                 The "Default" dictionary is the dark-theme look. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="NowPlayingPlayFillBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="NowPlayingPlayGlyphBrush" Color="#1E1E1E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NowPlayingPlayFillBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="NowPlayingPlayGlyphBrush" Color="#F7F7F7" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
