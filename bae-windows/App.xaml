<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Bae.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The now-playing play/pause circle inverts between themes: a light
                 fill with a dark glyph in dark theme, the reverse in light theme.
                 The "Default" dictionary is the dark-theme look. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="NowPlayingPlayFillBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="NowPlayingPlayGlyphBrush" Color="#1E1E1E" />
                    <!-- The bae surfaces, mapped onto the framework resource
                         names the app's XAML uses: base window fill is the
                         macOS Theme.background, cards/strips step up through
                         surface and surfaceElevated. -->
                    <Color x:Key="SolidBackgroundFillColorBase">#0F0F17</Color>
                    <Color x:Key="SolidBackgroundFillColorSecondary">#171721</Color>
                    <Color x:Key="CardBackgroundFillColorDefault">#1C1C28</Color>
                    <Color x:Key="CardBackgroundFillColorSecondary">#171721</Color>
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0F0F17" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1C1C28" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#14141F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NowPlayingPlayFillBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="NowPlayingPlayGlyphBrush" Color="#F7F7F7" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- bae's fixed look: the macOS Theme palette (BaeKit Theme.swift),
                 not the OS light/dark setting — deep blue-black surfaces and the
                 terracotta accent. RequestedTheme=Dark on the Application pins
                 the base theme; the colors here restyle the framework resources
                 the app's XAML consumes. -->
            <Color x:Key="SystemAccentColor">#D97857</Color>
            <Color x:Key="SystemAccentColorLight1">#E08B6C</Color>
            <Color x:Key="SystemAccentColorLight2">#E89E82</Color>
            <Color x:Key="SystemAccentColorLight3">#F0B198</Color>
            <Color x:Key="SystemAccentColorDark1">#C26A4C</Color>
            <Color x:Key="SystemAccentColorDark2">#AB5D42</Color>
            <Color x:Key="SystemAccentColorDark3">#945038</Color>

            <!-- Icon-only chrome buttons: a 34x34 rounded slot, transparent at rest
                 with the framework's subtle pointer-over fill. Shared by the toolbar
                 and any other icon button that wants the now-playing bar's treatment. -->
            <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
