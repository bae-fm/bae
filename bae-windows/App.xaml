<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Bae.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The now-playing play/pause circle inverts between themes: a light
                 fill with a dark glyph in dark theme, the reverse in light theme.
                 The "Default" dictionary is the dark-theme look. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="NowPlayingPlayFillBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="NowPlayingPlayGlyphBrush" Color="#1E1E1E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NowPlayingPlayFillBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="NowPlayingPlayGlyphBrush" Color="#F7F7F7" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Icon-only chrome buttons: a 34x34 rounded slot, transparent at rest
                 with the framework's subtle pointer-over fill. Shared by the toolbar
                 and any other icon button that wants the now-playing bar's treatment. -->
            <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
