{
  "sourceLanguage": "en",
  "strings": {
    "core.artwork_cache.cancelled": {
      "comment": "Post-open library status: the user stopped artwork downloads.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف تنزيل صور الأغلفة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтеглянето на обложки е спряно."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আর্টওয়ার্ক ডাউনলোড বন্ধ করা হয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahování obalů bylo zastaveno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden der Coverbilder wurde gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Artwork download stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo la descarga del material gráfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement des illustrations est arrêté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આર્ટવર્ક ડાઉનલોડ અટકાવાયું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הורדת תמונות העטיפה הופסקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आर्टवर्क डाउनलोड रोक दिया गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanje omota je zaustavljeno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download delle copertine è stato interrotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アートワークのダウンロードを停止しました。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಖಪುಟ ಚಿತ್ರಗಳ ಡೌನ್‌ಲೋಡ್ ನಿಲ್ಲಿಸಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아트워크 다운로드가 중지되었습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കവർ ചിത്രങ്ങളുടെ ഡൗൺലോഡ് നിർത്തി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कलाकृती डाउनलोड थांबवले."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het downloaden van illustraties is gestopt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਵਰ ਤਸਵੀਰਾਂ ਦਾ ਡਾਊਨਲੋਡ ਰੋਕਿਆ ਗਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie okładek zatrzymano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download das imagens foi interrompido."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அட்டைப்படப் பதிவிறக்கம் நிறுத்தப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కవర్ చిత్రాల డౌన్‌లోడ్ ఆపివేయబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดดาวน์โหลดภาพปกแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak görsellerinin indirilmesi durduruldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження обкладинок зупинено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرورق کی تصاویر کا ڈاؤن لوڈ روک دیا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dừng tải ảnh bìa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封面图下载已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封面圖片下載已停止。"
          }
        }
      }
    },
