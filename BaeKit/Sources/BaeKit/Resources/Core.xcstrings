    "core.import.evidence.barcode_in_image": {
      "comment": "Import pane, hover over an artwork thumbnail: identification matched the release on a barcode read off this image ({value} is the barcode digits).",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرى التعرّف على الإصدار تلقائيًا من الرمز الشريطي %@ في هذه الصورة"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изданието е разпознато автоматично по баркода %@ в това изображение"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ছবির বারকোড %@ থেকে রিলিজটি স্বয়ংক্রিয়ভাবে শনাক্ত হয়েছে"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vydání bylo rozpoznáno automaticky podle čárového kódu %@ na tomto obrázku"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Veröffentlichung wurde automatisch anhand des Barcodes %@ auf diesem Bild erkannt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release was auto-identified from barcode %@ in this image"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edición se identificó automáticamente por el código de barras %@ de esta imagen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'édition a été identifiée automatiquement grâce au code-barres %@ de cette image"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ચિત્રમાંના બારકોડ %@ પરથી રિલીઝ આપમેળે ઓળખાઈ"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגרסה זוהתה אוטומטית לפי הברקוד %@ בתמונה הזו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिलीज़ की पहचान इस चित्र के बारकोड %@ से स्वतः हुई"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izdanje je automatski prepoznato po crtičnom kodu %@ na ovoj slici"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'edizione è stata identificata automaticamente dal codice a barre %@ in questa immagine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリースは、この画像のバーコード %@ から自動的に識別されました"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಚಿತ್ರದಲ್ಲಿನ ಬಾರ್‌ಕೋಡ್ %@ ಮೂಲಕ ಬಿಡುಗಡೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಗುರುತಿಸಲಾಗಿದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴리스는 이 이미지의 바코드 %@에서 자동으로 식별되었습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ചിത്രത്തിലെ ബാർകോഡ് %@ ഉപയോഗിച്ച് റിലീസ് സ്വയമേവ തിരിച്ചറിഞ്ഞു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या चित्रातील बारकोड %@ वरून प्रकाशन आपोआप ओळखले गेले"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgave is automatisch herkend aan de barcode %@ op deze afbeelding"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਤਸਵੀਰ ਦੇ ਬਾਰਕੋਡ %@ ਤੋਂ ਰਿਲੀਜ਼ ਆਪਣੇ-ਆਪ ਪਛਾਣੀ ਗਈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydanie zostało rozpoznane automatycznie po kodzie kreskowym %@ na tym obrazie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lançamento foi identificado automaticamente pelo código de barras %@ nesta imagem"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் படத்தில் உள்ள பார்கோடு %@ மூலம் வெளியீடு தானாக அடையாளம் காணப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ చిత్రంలోని బార్‌కోడ్ %@ ద్వారా విడుదల స్వయంచాలకంగా గుర్తించబడింది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุรุ่นนี้โดยอัตโนมัติจากบาร์โค้ด %@ ในภาพนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürüm, bu görseldeki %@ barkodundan otomatik olarak tanındı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видання визначено автоматично за штрихкодом %@ на цьому зображенні"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس تصویر کے بارکوڈ %@ سے ریلیز خودکار طور پر شناخت ہوئی"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản phát hành được nhận dạng tự động từ mã vạch %@ trong ảnh này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该版本是根据此图片中的条码 %@ 自动识别的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本是根據這張圖片中的條碼 %@ 自動辨識的"
          }
        }
      }
    },
    "core.import.evidence.disc_id_from_file": {
