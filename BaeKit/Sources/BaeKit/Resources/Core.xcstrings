    "core.import.folder.network_watch": {
      "comment": "Import folder list, hover over a network folder's indicator: the folder is on a network volume. Writes made on this computer are reported at once, but a watch on such a volume never sees what another computer does to the share, so bae re-checks for those on a schedule ({minutes} is how often, in whole minutes).",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجلد على الشبكة. يجري التحقق من التغييرات التي تُجرى على أجهزة أخرى كل %lld دقيقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мрежова папка. Промените, направени на други компютри, се проверяват на всеки %lld минути."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্ক ফোল্ডার। অন্য কম্পিউটারে করা পরিবর্তন প্রতি %lld মিনিটে যাচাই করা হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síťová složka. Změny provedené na jiných počítačích se kontrolují každých %lld minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkordner. Änderungen von anderen Computern werden alle %lld Minuten geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network folder. Changes made on other computers are checked every %lld minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta en red. Los cambios hechos en otros equipos se comprueban cada %lld minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier réseau. Les modifications faites sur d'autres ordinateurs sont vérifiées toutes les %lld minutes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નેટવર્ક ફોલ્ડર. અન્ય કમ્પ્યુટર પર કરેલા ફેરફારો દર %lld મિનિટે તપાસાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיקייה ברשת. שינויים שבוצעו במחשבים אחרים נבדקים כל %lld דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क फ़ोल्डर। दूसरे कंप्यूटरों पर किए गए बदलाव हर %lld मिनट में जाँचे जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mrežna mapa. Promjene napravljene na drugim računalima provjeravaju se svakih %lld minuta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella di rete. Le modifiche fatte su altri computer vengono controllate ogni %lld minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークフォルダです。他のコンピュータで加えられた変更は %lld 分ごとに確認されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೆಟ್‌ವರ್ಕ್ ಫೋಲ್ಡರ್. ಇತರ ಕಂಪ್ಯೂಟರ್‌ಗಳಲ್ಲಿ ಮಾಡಿದ ಬದಲಾವಣೆಗಳನ್ನು ಪ್ರತಿ %lld ನಿಮಿಷಗಳಿಗೊಮ್ಮೆ ಪರಿಶೀಲಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 폴더입니다. 다른 컴퓨터에서 변경한 내용은 %lld분마다 확인합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നെറ്റ്‌വർക്ക് ഫോൾഡർ. മറ്റ് കമ്പ്യൂട്ടറുകളിൽ വരുത്തിയ മാറ്റങ്ങൾ ഓരോ %lld മിനിറ്റിലും പരിശോധിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क फोल्डर. इतर संगणकांवर केलेले बदल दर %lld मिनिटांनी तपासले जातात."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerkmap. Wijzigingen op andere computers worden elke %lld minuten gecontroleerd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੈੱਟਵਰਕ ਫੋਲਡਰ। ਹੋਰ ਕੰਪਿਊਟਰਾਂ 'ਤੇ ਕੀਤੀਆਂ ਤਬਦੀਲੀਆਂ ਹਰ %lld ਮਿੰਟ ਬਾਅਦ ਜਾਂਚੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder sieciowy. Zmiany wprowadzone na innych komputerach są sprawdzane co %lld minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta em rede. As alterações feitas em outros computadores são verificadas a cada %lld minutos."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நெட்வொர்க் கோப்புறை. பிற கணினிகளில் செய்யப்பட்ட மாற்றங்கள் ஒவ்வொரு %lld நிமிடத்திற்கும் சரிபார்க்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నెట్‌వర్క్ ఫోల్డర్. ఇతర కంప్యూటర్లలో చేసిన మార్పులు ప్రతి %lld నిమిషాలకు తనిఖీ చేయబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์บนเครือข่าย การเปลี่ยนแปลงที่ทำจากคอมพิวเตอร์เครื่องอื่นจะถูกตรวจสอบทุก %lld นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ klasörü. Başka bilgisayarlarda yapılan değişiklikler %lld dakikada bir denetlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережева тека. Зміни, зроблені на інших комп'ютерах, перевіряються кожні %lld хв."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیٹ ورک فولڈر۔ دوسرے کمپیوٹرز پر کی گئی تبدیلیاں ہر %lld منٹ بعد جانچی جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục mạng. Các thay đổi thực hiện trên máy tính khác được kiểm tra mỗi %lld phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络文件夹。其他电脑上所做的更改每 %lld 分钟检查一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路資料夾。其他電腦上所做的變更每 %lld 分鐘檢查一次。"
          }
        }
      }
    },
