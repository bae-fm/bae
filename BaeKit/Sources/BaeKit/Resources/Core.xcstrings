    "core.import.sheet.refused_codec": {
      "comment": "Import file pane: a track sheet names an audio file bae can't carve tracks out of, because the codec can't back single-file CUE playback ({codec} is the codec name, e.g. MP3). The audio still imports, as one track.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تقسيم صوت %@ بواسطة ملف CUE"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудиото %@ не може да се раздели чрез CUE"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ অডিও CUE দিয়ে ভাগ করা যায় না"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk %@ nelze rozdělit pomocí CUE"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Audio lässt sich nicht per CUE aufteilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ audio can't be split by a sheet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio %@ no se puede dividir con un CUE"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio %@ ne peut pas être découpé par un CUE"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ઑડિયોને CUE વડે વિભાજિત કરી શકાતું નથી"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לפצל שמע %@ באמצעות CUE"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ऑडियो को CUE से विभाजित नहीं किया जा सकता"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk %@ nije moguće podijeliti pomoću CUE-a"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio %@ non può essere diviso da un CUE"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の音声はCUEで分割できません"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಆಡಿಯೋವನ್ನು CUE ಮೂಲಕ ವಿಭಜಿಸಲಾಗುವುದಿಲ್ಲ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 오디오는 CUE로 나눌 수 없습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഓഡിയോ CUE ഉപയോഗിച്ച് വിഭജിക്കാനാകില്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ऑडिओ CUE ने विभागता येत नाही"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-audio kan niet met een CUE worden opgesplitst"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਆਡੀਓ ਨੂੰ CUE ਨਾਲ ਵੰਡਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięku %@ nie można podzielić za pomocą CUE"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio %@ não pode ser dividido por um CUE"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஆடியோவை CUE மூலம் பிரிக்க முடியாது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఆడియోను CUE ద్వారా విభజించలేం"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถแบ่งเสียง %@ ด้วย CUE ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sesi bir CUE ile bölünemez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо %@ не можна поділити за допомогою CUE"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ آڈیو کو CUE سے تقسیم نہیں کیا جا سکتا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh %@ không thể chia bằng CUE"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 音频无法用 CUE 分轨"
          }
        },
        "zh-Hant": {
