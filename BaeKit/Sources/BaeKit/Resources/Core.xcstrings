    "core.sync.cloud_only_releases": {
      "comment": "Disconnect-sync confirmation: how many releases are stored only in the cloud and will become unplayable. The UI appends this to its own base 'this will stop syncing' sentence.",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld إصدارات مخزّنة في السحابة فقط. سيتعذّر تشغيلها حتى تعيد الاتصال."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld إصدارًا مخزّنًا في السحابة فقط. سيتعذّر تشغيلها حتى تعيد الاتصال."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "إصدار واحد مخزّن في السحابة فقط. سيتعذّر تشغيله حتى تعيد الاتصال."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld إصدار مخزّن في السحابة فقط. سيتعذّر تشغيله حتى تعيد الاتصال."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "إصداران مخزّنان في السحابة فقط. سيتعذّر تشغيلهما حتى تعيد الاتصال."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا توجد إصدارات مخزّنة في السحابة فقط."
                }
              }
            }
          }
        },
        "bg": {
