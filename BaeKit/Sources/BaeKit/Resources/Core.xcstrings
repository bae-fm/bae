    "core.import.triage.source_lengths_unknown": {
      "comment": "Import triage row: the release lists no track lengths, so the total cannot be checked.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار لا يذكر مدد المسارات"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изданието не посочва времетраене на записите"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিলিজে ট্র্যাকের দৈর্ঘ্য উল্লেখ নেই"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vydání neuvádí délky stop"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Veröffentlichung nennt keine Titellängen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The release states no track lengths"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edición no indica la duración de las pistas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’édition n’indique aucune durée de piste"
          }
        },
        "gu": {
          "stringUnit": {
