    "ui.import.sheet.disc_help": {
      "comment": "Import mapping table: tooltip on the disc-assignment control of a track sheet.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي قرص من الإصدار تمثله مدخلات هذه الورقة"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой диск от изданието са записите на този лист"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই শিটের এন্ট্রিগুলি রিলিজের কোন ডিস্ক"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kterým diskem vydání jsou položky tohoto listu"
          }
