    "core.error.cloud_setup.location_occupied": {
      "comment": "Creating a library was refused because the bucket and key prefix already belong to another library.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي هذه الحاوية وبادئة المفتاح بالفعل على مكتبة مختلفة. استخدم بادئة مفتاح فارغة، أو انضم إلى تلك المكتبة أو استعدها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази кофа и префикс на ключ вече съдържат друга библиотека. Използвайте празен префикс или се присъединете към нея, или я възстановете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বাকেট এবং কী প্রিফিক্সে ইতিমধ্যে অন্য একটি লাইব্রেরি রয়েছে। খালি কী প্রিফিক্স ব্যবহার করুন, অথবা সেই লাইব্রেরিতে যোগ দিন বা সেটি পুনরুদ্ধার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento bucket a předpona klíče už obsahují jinou knihovnu. Použijte prázdnou předponu nebo se k této knihovně připojte či ji obnovte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bucket und dieses Schlüsselpräfix enthalten bereits eine andere Mediathek. Verwende ein leeres Präfix oder tritt dieser Mediathek bei bzw. stelle sie wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bucket and key prefix already contain a different library. Use an empty key prefix, or join or restore that library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este bucket y prefijo de clave ya contienen otra biblioteca. Usa un prefijo vacío, o únete a esa biblioteca o restáurala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bucket et ce préfixe de clé contiennent déjà une autre bibliothèque. Utilisez un préfixe vide, ou rejoignez ou restaurez cette bibliothèque."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ બકેટ અને કી પ્રિફિક્સમાં પહેલેથી બીજી લાઇબ્રેરી છે. ખાલી કી પ્રિફિક્સ વાપરો અથવા તે લાઇબ્રેરીમાં જોડાઓ અથવા તેને પુનઃસ્થાપિત કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכל וקידומת המפתח האלה כבר מכילים ספרייה אחרת. השתמש בקידומת ריקה, או הצטרף לספרייה הזאת או שחזר אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बकेट और कुंजी प्रीफ़िक्स में पहले से दूसरी लाइब्रेरी है। खाली कुंजी प्रीफ़िक्स का उपयोग करें, या उस लाइब्रेरी से जुड़ें या उसे बहाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj spremnik i prefiks ključa već sadrže drugu biblioteku. Upotrijebite prazan prefiks ili se pridružite toj biblioteci ili je obnovite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo bucket e prefisso della chiave contengono già un’altra libreria. Usa un prefisso vuoto oppure unisciti a quella libreria o ripristinala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバケットとキープレフィックスには別のライブラリがあります。空のキープレフィックスを使うか、そのライブラリに参加または復元してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಕೆಟ್ ಮತ್ತು ಕೀ ಪ್ರಿಫಿಕ್ಸ್‌ನಲ್ಲಿ ಈಗಾಗಲೇ ಬೇರೆ ಲೈಬ್ರರಿ ಇದೆ. ಖಾಲಿ ಕೀ ಪ್ರಿಫಿಕ್ಸ್ ಬಳಸಿ ಅಥವಾ ಆ ಲೈಬ್ರರಿಗೆ ಸೇರಿ ಅಥವಾ ಅದನ್ನು ಮರುಸ್ಥಾಪಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버킷과 키 접두사에 이미 다른 라이브러리가 있습니다. 빈 키 접두사를 사용하거나 해당 라이브러리에 참여 또는 복원하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ബക്കറ്റിലും കീ പ്രിഫിക്സിലും ഇതിനകം മറ്റൊരു ലൈബ്രറിയുണ്ട്. ഒഴിഞ്ഞ കീ പ്രിഫിക്സ് ഉപയോഗിക്കുക, അല്ലെങ്കിൽ ആ ലൈബ്രറിയിൽ ചേരുകയോ അത് പുനഃസ്ഥാപിക്കുകയോ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या बकेट आणि की प्रीफिक्समध्ये आधीच दुसरी लायब्ररी आहे. रिकामा की प्रीफिक्स वापरा किंवा त्या लायब्ररीत सामील व्हा किंवा ती पुनर्संचयित करा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bucket en dit sleutelvoorvoegsel bevatten al een andere bibliotheek. Gebruik een leeg voorvoegsel, of neem deel aan die bibliotheek of herstel deze."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਬਕੇਟ ਅਤੇ ਕੁੰਜੀ ਅਗੇਤਰ ਵਿੱਚ ਪਹਿਲਾਂ ਹੀ ਹੋਰ ਲਾਇਬ੍ਰੇਰੀ ਹੈ। ਖਾਲੀ ਕੁੰਜੀ ਅਗੇਤਰ ਵਰਤੋ ਜਾਂ ਉਸ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਸ਼ਾਮਲ ਹੋਵੋ ਜਾਂ ਉਸਨੂੰ ਮੁੜ-ਬਹਾਲ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten zasobnik i prefiks klucza zawierają już inną bibliotekę. Użyj pustego prefiksu albo dołącz do tej biblioteki lub ją przywróć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este bucket e prefixo de chave já contêm outra biblioteca. Use um prefixo vazio ou entre nessa biblioteca ou restaure-a."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பக்கெட்டிலும் விசை முன்னொட்டிலும் ஏற்கனவே வேறு நூலகம் உள்ளது. காலியான விசை முன்னொட்டைப் பயன்படுத்தவும் அல்லது அந்த நூலகத்தில் சேரவும் அல்லது அதை மீட்டெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ బకెట్ మరియు కీ ప్రిఫిక్స్‌లో ఇప్పటికే వేరే లైబ్రరీ ఉంది. ఖాళీ కీ ప్రిఫిక్స్‌ను ఉపయోగించండి లేదా ఆ లైబ్రరీలో చేరండి లేదా దాన్ని పునరుద్ధరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บักเก็ตและคำนำหน้าคีย์นี้มีคลังอื่นอยู่แล้ว ใช้คำนำหน้าคีย์ที่ว่าง หรือเข้าร่วมหรือกู้คืนคลังนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bucket ve anahtar öneki zaten farklı bir arşiv içeriyor. Boş bir anahtar öneki kullanın ya da o arşive katılın veya onu geri yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це сховище та префікс ключа вже містять іншу медіатеку. Використайте порожній префікс або приєднайтеся до тієї медіатеки чи відновіть її."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس بکٹ اور کلید کے سابقے میں پہلے سے دوسری لائبریری موجود ہے۔ خالی کلید کا سابقہ استعمال کریں، یا اس لائبریری میں شامل ہوں یا اسے بحال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ chứa và tiền tố khóa này đã có một thư viện khác. Hãy dùng tiền tố khóa trống, hoặc tham gia hay khôi phục thư viện đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此存储桶和键前缀已包含另一个资料库。请使用空的键前缀，或加入或恢复该资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此儲存桶和金鑰前置字串已包含另一個資料庫。請使用空的金鑰前置字串，或加入或還原該資料庫。"
          }
        }
      }
    },
    "core.error.cloud_setup.permission_denied": {
      "comment": "Cloud setup failed because the credentials lack at least one required object permission.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لبيانات الاعتماد هذه بقراءة العناصر وكتابتها وإدراجها وحذفها في هذه الحاوية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешете на тези идентификационни данни да четат, записват, изброяват и изтриват обекти в тази кофа."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ক্লাউড শংসাপত্রকে এই বাকেটের অবজেক্ট পড়া, লেখা, তালিকাভুক্ত করা ও মুছে ফেলার অনুমতি দিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte těmto přihlašovacím údajům číst, zapisovat, vypisovat a mazat objekty v tomto bucketu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube diesen Zugangsdaten, Objekte in diesem Bucket zu lesen, zu schreiben, aufzulisten und zu löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow these credentials to read, write, list, and delete objects in this bucket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que estas credenciales lean, escriban, enumeren y eliminen objetos de este bucket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez ces identifiants à lire, écrire, répertorier et supprimer les objets de ce bucket."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ક્લાઉડ ઓળખપત્રોને આ બકેટમાં ઑબ્જેક્ટ વાંચવા, લખવા, સૂચિબદ્ધ કરવા અને કાઢી નાખવાની પરવાનગી આપો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לפרטי הגישה האלה לקרוא, לכתוב, להציג ולמחוק אובייקטים במכל הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन क्लाउड क्रेडेंशियल को इस बकेट में ऑब्जेक्ट पढ़ने, लिखने, सूचीबद्ध करने और मिटाने की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite ovim vjerodajnicama čitanje, pisanje, popisivanje i brisanje objekata u ovom spremniku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a queste credenziali di leggere, scrivere, elencare ed eliminare gli oggetti in questo bucket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この認証情報に、このバケット内のオブジェクトの読み取り、書き込み、一覧表示、削除を許可してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಕ್ಲೌಡ್ ರುಜುವಾತುಗಳಿಗೆ ಈ ಬಕೆಟ್‌ನಲ್ಲಿರುವ ಆಬ್ಜೆಕ್ಟ್‌ಗಳನ್ನು ಓದಲು, ಬರೆಯಲು, ಪಟ್ಟಿ ಮಾಡಲು ಮತ್ತು ಅಳಿಸಲು ಅನುಮತಿ ನೀಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자격 증명에 이 버킷의 객체 읽기, 쓰기, 나열 및 삭제 권한을 허용하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ക്ലൗഡ് ക്രെഡൻഷ്യലുകൾക്ക് ഈ ബക്കറ്റിലെ ഒബ്ജക്റ്റുകൾ വായിക്കാനും എഴുതാനും പട്ടികപ്പെടുത്താനും ഇല്ലാതാക്കാനും അനുമതി നൽകുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या क्लाउड क्रेडेन्शियल्सना या बकेटमधील ऑब्जेक्ट वाचण्याची, लिहिण्याची, सूचीबद्ध करण्याची आणि हटवण्याची परवानगी द्या."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef deze cloudgegevens toestemming om objecten in deze bucket te lezen, schrijven, weergeven en verwijderen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਨ੍ਹਾਂ ਕਲਾਊਡ ਪ੍ਰਮਾਣ ਪੱਤਰਾਂ ਨੂੰ ਇਸ ਬਕੇਟ ਵਿੱਚ ਆਬਜੈਕਟ ਪੜ੍ਹਨ, ਲਿਖਣ, ਸੂਚੀਬੱਧ ਕਰਨ ਅਤੇ ਮਿਟਾਉਣ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól tym danym logowania na odczyt, zapis, wyświetlanie i usuwanie obiektów w tym zasobniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que estas credenciais leiam, gravem, listem e excluam objetos neste bucket."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த கிளவுட் சான்றுகளுக்கு இந்த பக்கெட்டில் உள்ள பொருட்களைப் படிக்க, எழுத, பட்டியலிட மற்றும் நீக்க அனுமதி வழங்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ క్లౌడ్ ఆధారాలకు ఈ బకెట్‌లోని ఆబ్జెక్టులను చదవడానికి, వ్రాయడానికి, జాబితా చేయడానికి మరియు తొలగించడానికి అనుమతి ఇవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ข้อมูลรับรองระบบคลาวด์นี้อ่าน เขียน แสดงรายการ และลบออบเจ็กต์ในบักเก็ตนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kimlik bilgilerinin bu bucket’taki nesneleri okumasına, yazmasına, listelemesine ve silmesine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте цим обліковим даним дозвіл читати, записувати, переглядати й видаляти об’єкти в цьому сховищі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان کلاؤڈ اسناد کو اس بکٹ میں آبجیکٹس پڑھنے، لکھنے، فہرست بنانے اور حذف کرنے کی اجازت دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép thông tin đăng nhập này đọc, ghi, liệt kê và xóa các đối tượng trong bộ chứa này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许这些凭据读取、写入、列出和删除此存储桶中的对象。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許這些憑證讀取、寫入、列出及刪除此儲存桶中的物件。"
          }
        }
      }
    },
