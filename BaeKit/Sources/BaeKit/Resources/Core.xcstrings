        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಾಧನದ ಸುರಕ್ಷಿತ ಸಂಗ್ರಹಣೆಯನ್ನು ಪ್ರವೇಶಿಸಲಾಗಲಿಲ್ಲ."
