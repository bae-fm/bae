          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe pausiert zwischen den Seiten. Drehe die Schallplatte um und drücke Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
