    "core.import.reconciliation.more_files": {
      "comment": "Import slot table, the line above it: the folder holds more audio than the release's tracklist names, so some rows have no track behind them. Stated, never blocking.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ملفات، %2$lld مقطوعات: صوت لا يذكره الإصدار"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
