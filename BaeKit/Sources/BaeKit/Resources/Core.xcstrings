        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অঞ্চল বা এন্ডপয়েন্ট এই বাকেটের সঙ্গে মিলছে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblast nebo koncový bod tomuto bucketu neodpovídá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Region oder der Endpunkt passt nicht zu diesem Bucket."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The region or endpoint doesn't match this bucket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La región o el endpoint no coincide con este bucket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La région ou le point de terminaison ne correspond pas à ce bucket."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રીજન અથવા એન્ડપૉઇન્ટ આ બકેટ સાથે મેળ ખાતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האזור או נקודת הקצה אינם תואמים למכל הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षेत्र या एंडपॉइंट इस बकेट से मेल नहीं खाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regija ili krajnja točka ne odgovara ovom spremniku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La regione o l’endpoint non corrisponde a questo bucket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リージョンまたはエンドポイントがこのバケットと一致しません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರದೇಶ ಅಥವಾ ಎಂಡ್‌ಪಾಯಿಂಟ್ ಈ ಬಕೆಟ್‌ಗೆ ಹೊಂದಿಕೆಯಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리전 또는 엔드포인트가 이 버킷과 일치하지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റീജിയനോ എൻഡ്‌പോയിന്റോ ഈ ബക്കറ്റുമായി പൊരുത്തപ്പെടുന്നില്ല."
          }
