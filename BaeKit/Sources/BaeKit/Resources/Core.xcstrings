        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche CD der Veröffentlichung die Einträge dieses Blatts sind"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which disc of the release this sheet's entries are"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué disco de la edición son las entradas de esta hoja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel disque de l’édition correspondent les entrées de cette feuille"
          }
