        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld yayın yalnızca bulutta saklanıyor. Yeniden bağlanana kadar çalınamayacak."
