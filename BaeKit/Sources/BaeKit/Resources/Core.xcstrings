        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಶೀಟ್‌ನ ನಮೂದುಗಳು ಬಿಡುಗಡೆಯ ಯಾವ ಡಿಸ್ಕ್"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시트의 항목이 릴리스의 어느 디스크인지"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഷീറ്റിലെ എൻട്രികൾ റിലീസിന്റെ ഏത് ഡിസ്കാണ്"
          }
        },
        "mr": {
