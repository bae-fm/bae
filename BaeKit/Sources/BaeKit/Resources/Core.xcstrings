        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some artwork couldn’t be downloaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar parte del material gráfico."
