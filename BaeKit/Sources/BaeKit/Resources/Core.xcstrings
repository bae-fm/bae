        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੀਜਨ ਜਾਂ ਐਂਡਪੁਆਇੰਟ ਇਸ ਬਕੇਟ ਨਾਲ ਮੇਲ ਨਹੀਂ ਖਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Region lub punkt końcowy nie pasuje do tego zasobnika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A região ou o endpoint não corresponde a este bucket."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மண்டலம் அல்லது முனைப்புள்ளி இந்த பக்கெட்டுடன் பொருந்தவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రీజియన్ లేదా ఎండ్‌పాయింట్ ఈ బకెట్‌తో సరిపోలడం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภูมิภาคหรือปลายทางไม่ตรงกับบักเก็ตนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölge veya uç nokta bu bucket ile eşleşmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Регіон або кінцева точка не відповідає цьому сховищу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریجن یا اینڈ پوائنٹ اس بکٹ سے مطابقت نہیں رکھتا۔"
