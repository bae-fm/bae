    "core.artwork_cache.failed": {
      "comment": "Post-open library status: artwork required by the cache policy could not be downloaded.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تنزيل بعض صور الأغلفة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Някои обложки не можаха да бъдат изтеглени."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু আর্টওয়ার্ক ডাউনলোড করা যায়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé obaly se nepodařilo stáhnout."
