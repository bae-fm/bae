    "core.error.cloud_setup.container_not_found": {
      "comment": "Cloud setup failed because the named bucket was not visible to the provider request.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على هذه الحاوية. تحقّق من اسمها ومن وصول بيانات الاعتماد إليها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази кофа не е намерена. Проверете името ѝ и достъпа на идентификационните данни до нея."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বাকেটটি পাওয়া যায়নি। এর নাম এবং ক্লাউড শংসাপত্রের প্রবেশাধিকার যাচাই করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento bucket nebyl nalezen. Zkontrolujte jeho název a přístup přihlašovacích údajů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bucket wurde nicht gefunden. Überprüfe seinen Namen und den Zugriff der Zugangsdaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bucket wasn't found. Check its name and the credentials' access to it."
          }
        },
        "es": {
          "stringUnit": {
