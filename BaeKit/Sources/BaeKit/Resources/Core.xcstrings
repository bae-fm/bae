        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面の間で再生を一時停止しました。レコードを裏返してから再生を押してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೈಡ್‌ಗಳ ನಡುವೆ ಪ್ಲೇಬ್ಯಾಕ್ ವಿರಾಮಗೊಂಡಿದೆ. ವಿನೈಲ್ ಅನ್ನು ತಿರುಗಿಸಿ, ನಂತರ ಪ್ಲೇ ಒತ್ತಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면 사이에서 재생이 일시 정지되었습니다. 레코드를 뒤집은 다음 재생을 누르세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൈഡുകൾക്കിടയിൽ പ്ലേബാക്ക് നിർത്തി. വിനൈൽ തിരിച്ച്, തുടർന്ന് പ്ലേ അമർത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बाजूंमध्ये प्लेबॅक थांबवला आहे. विनाइल उलटा करा, मग प्ले दाबा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het afspelen is gepauzeerd tussen kanten. Draai de plaat om en druk op Afspelen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਈਡਾਂ ਵਿਚਕਾਰ ਪਲੇਬੈਕ ਰੁਕ ਗਿਆ ਹੈ। ਵਿਨਾਇਲ ਨੂੰ ਉਲਟੋ, ਫਿਰ ਪਲੇ ਦਬਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie wstrzymano między stronami. Odwróć winyl i naciśnij Odtwórz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução pausou entre os lados. Vire o vinil e toque em Reproduzir."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பக்கங்களுக்கு இடையில் இயக்கம் இடைநிறுத்தப்பட்டது. வினைலைத் திருப்பி, பிறகு இயக்கு என்பதை அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సైడ్‌ల మధ్య ప్లేబ్యాక్ నిలిపివేయబడింది. వినైల్‌ను తిప్పి, ఆపై ప్లే నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเล่นหยุดพักระหว่างด้าน พลิกแผ่นไวนิล แล้วกดเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalma yüzler arasında duraklatıldı. Plağı çevirin, sonra Oynat'a basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворення призупинено між сторонами. Переверніть вініл і натисніть Відтворити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائیڈز کے درمیان پلے بیک روک دیا گیا ہے۔ ونائل کو پلٹیں، پھر پلے دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát lại đã tạm dừng giữa các mặt. Lật đĩa vinyl rồi nhấn Phát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已在两面之间暂停。请翻转黑胶唱片，然后按播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已在兩面之間暫停。請翻轉黑膠唱片，然後按播放。"
          }
        }
      }
    },
