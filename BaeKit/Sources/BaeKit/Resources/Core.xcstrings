    "ui.import.slots.drop_help": {
      "comment": "Import mapping table: tooltip on the X of a row the release names but no audio backs — what dropping the track does.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترك هذه المقطوعة — لا يحوي هذا المجلد صوتًا لها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
