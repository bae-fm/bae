        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie okładek zatrzymano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download das imagens foi interrompido."
          }
