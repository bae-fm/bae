          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Възпроизвеждането е на пауза между страните. Обърнете плочата и натиснете Възпроизвеждане."
          }
        },
        "bn": {
          "stringUnit": {
