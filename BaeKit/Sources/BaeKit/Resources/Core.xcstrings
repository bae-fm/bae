    "core.import.evidence.disc_id_from_file": {
      "comment": "Import pane, hover over a rip log or cue sheet row: identification matched the release on a disc ID computed from this file ({value} is the disc ID).",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
