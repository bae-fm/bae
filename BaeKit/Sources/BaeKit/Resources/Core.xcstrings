          }
        },
        "pa": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ਰਿਲੀਜ਼ ਸਿਰਫ਼ ਕਲਾਉਡ ਵਿੱਚ ਸਟੋਰ ਹੈ। ਦੁਬਾਰਾ ਕਨੈਕਟ ਕਰਨ ਤੱਕ ਇਹ ਚਲਾਈ ਨਹੀਂ ਜਾ ਸਕੇਗੀ।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ਰਿਲੀਜ਼ਾਂ ਸਿਰਫ਼ ਕਲਾਉਡ ਵਿੱਚ ਸਟੋਰ ਹਨ। ਦੁਬਾਰਾ ਕਨੈਕਟ ਕਰਨ ਤੱਕ ਇਹ ਚਲਾਈਆਂ ਨਹੀਂ ਜਾ ਸਕਣਗੀਆਂ।"
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld wydania są przechowywane tylko w chmurze. Nie będzie można ich odtworzyć, dopóki nie połączysz się ponownie."
