          "stringUnit": {
            "state": "translated",
            "value": "تحتوي هذه الحاوية وبادئة المفتاح بالفعل على مكتبة مختلفة. استخدم بادئة مفتاح فارغة، أو انضم إلى تلك المكتبة أو استعدها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази кофа и префикс на ключ вече съдържат друга библиотека. Използвайте празен префикс или се присъединете към нея, или я възстановете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento bucket a předpona klíče už obsahují jinou knihovnu. Použijte prázdnou předponu nebo se k této knihovně připojte či ji obnovte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "new",
            "value": "This bucket and key prefix already contain a different library. Use an empty key prefix, or join or restore that library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bucket und dieses Schlüsselpräfix enthalten bereits eine andere Mediathek. Verwende ein leeres Präfix oder tritt dieser Mediathek bei bzw. stelle sie wieder her."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο κάδος και το πρόθεμα κλειδιού περιέχουν ήδη μια άλλη βιβλιοθήκη. Χρησιμοποιήστε κενό πρόθεμα κλειδιού ή συνδεθείτε ή επαναφέρετε εκείνη τη βιβλιοθήκη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bucket and key prefix already contain a different library. Use an empty key prefix, or join or restore that library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este bucket y prefijo de clave ya contienen otra biblioteca. Usa un prefijo vacío, o únete a esa biblioteca o restáurala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "new",
            "value": "This bucket and key prefix already contain a different library. Use an empty key prefix, or join or restore that library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bucket et ce préfixe de clé contiennent déjà une autre bibliothèque. Utilisez un préfixe vide, ou rejoignez ou restaurez cette bibliothèque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכל וקידומת המפתח האלה כבר מכילים ספרייה אחרת. השתמש בקידומת ריקה, או הצטרף לספרייה הזאת או שחזר אותה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj spremnik i prefiks ključa već sadrže drugu biblioteku. Upotrijebite prazan prefiks ili se pridružite toj biblioteci ili je obnovite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a tároló és kulcselőtag már egy másik könyvtárat tartalmaz. Használj üres kulcselőtagot, vagy csatlakozz ahhoz a könyvtárhoz, illetve állítsd vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
