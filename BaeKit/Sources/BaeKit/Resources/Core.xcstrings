        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಲವು ಮುಖಪುಟ ಚಿತ್ರಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗಲಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 아트워크를 다운로드하지 못했습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചില കവർ ചിത്രങ്ങൾ ഡൗൺലോഡ് ചെയ്യാനായില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काही कलाकृती डाउनलोड करता आल्या नाहीत."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige illustraties konden niet worden gedownload."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਕਵਰ ਤਸਵੀਰਾਂ ਡਾਊਨਲੋਡ ਨਹੀਂ ਹੋ ਸਕੀਆਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
