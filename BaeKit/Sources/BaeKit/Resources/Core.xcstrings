        "ta": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld வெளியீடு கிளவுடில் மட்டுமே சேமிக்கப்பட்டுள்ளது. மீண்டும் இணைக்கும் வரை அதை இயக்க முடியாது."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld வெளியீடுகள் கிளவுடில் மட்டுமே சேமிக்கப்பட்டுள்ளன. மீண்டும் இணைக்கும் வரை அவற்றை இயக்க முடியாது."
                }
              }
            }
          }
        },
        "te": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld విడుదల క్లౌడ్‌లో మాత్రమే నిల్వ చేయబడింది. మళ్లీ కనెక్ట్ చేసే వరకు దాన్ని ప్లే చేయలేరు."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld విడుదలలు క్లౌడ్‌లో మాత్రమే నిల్వ చేయబడ్డాయి. మళ్లీ కనెక్ట్ చేసే వరకు వాటిని ప్లే చేయలేరు."
                }
              }
            }
          }
        },
        "th": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld รายการเผยแพร่ถูกจัดเก็บไว้บนคลาวด์เท่านั้น จะเล่นไม่ได้จนกว่าคุณจะเชื่อมต่ออีกครั้ง"
