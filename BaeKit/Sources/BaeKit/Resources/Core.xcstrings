    "core.import.files.documents": {
      "comment": "Import roles table: a directory holding nothing but documents — rip logs, tracklists, playlists — shown as one row instead of one row per file.",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld مستندات"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld مستندًا"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "مستند واحد"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld مستند"
                }
              },
