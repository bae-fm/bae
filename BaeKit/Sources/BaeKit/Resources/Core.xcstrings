          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइडों के बीच प्लेबैक रोक दिया गया है। विनाइल को पलटें, फिर प्ले दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodukcija je pauzirana između strana. Okrenite vinil i pritisnite Reproduciraj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione è in pausa tra i lati. Gira il vinile, poi premi Riproduci."
