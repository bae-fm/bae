        }
      }
    },
    "core.error.identity_missing": {
      "comment": "The local library has no established device identity and cannot participate in sync.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي هذه المكتبة على هوية جهاز. أنشئ المكتبة أو انضم إليها أو استعدها من جديد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази библиотека няма идентичност на устройство. Създайте я, присъединете се към нея или я възстановете отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লাইব্রেরির কোনো ডিভাইস পরিচয় নেই। লাইব্রেরিটি আবার তৈরি করুন, এতে যোগ দিন বা এটি পুনরুদ্ধার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato knihovna nemá identitu zařízení. Znovu ji vytvořte, připojte se k ní nebo ji obnovte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Mediathek hat keine Geräteidentität. Erstelle sie neu, tritt ihr erneut bei oder stelle sie wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This library has no device identity. Create, join, or restore the library again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca no tiene identidad de dispositivo. Vuelve a crearla, unirte a ella o restaurarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette bibliothèque n’a pas d’identité d’appareil. Créez-la, rejoignez-la ou restaurez-la de nouveau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ લાઇબ્રેરી પાસે ઉપકરણ ઓળખ નથી. લાઇબ્રેરીને ફરી બનાવો, તેમાં જોડાઓ અથવા તેને પુનઃસ્થાપિત કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לספרייה הזאת אין זהות מכשיר. צור אותה, הצטרף אליה או שחזר אותה מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लाइब्रेरी की कोई डिवाइस पहचान नहीं है। लाइब्रेरी को फिर से बनाएँ, उससे जुड़ें या उसे बहाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova biblioteka nema identitet uređaja. Ponovno je stvorite, pridružite joj se ili je obnovite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa libreria non ha un’identità del dispositivo. Creala, accedi o ripristinala di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリにはデバイスIDがありません。ライブラリを作成、参加、または復元し直してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಲೈಬ್ರರಿಗೆ ಸಾಧನ ಗುರುತು ಇಲ್ಲ. ಲೈಬ್ರರಿಯನ್ನು ಮತ್ತೆ ರಚಿಸಿ, ಅದಕ್ಕೆ ಸೇರಿ ಅಥವಾ ಅದನ್ನು ಮರುಸ್ಥಾಪಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리에 기기 ID가 없습니다. 라이브러리를 다시 생성하거나 참여 또는 복원하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ലൈബ്രറിക്ക് ഉപകരണ ഐഡന്റിറ്റി ഇല്ല. ലൈബ്രറി വീണ്ടും സൃഷ്ടിക്കുകയോ അതിൽ ചേരുകയോ പുനഃസ്ഥാപിക്കുകയോ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या लायब्ररीला डिव्हाइस ओळख नाही. लायब्ररी पुन्हा तयार करा, तिच्यात सामील व्हा किंवा ती पुनर्संचयित करा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bibliotheek heeft geen apparaatidentiteit. Maak de bibliotheek opnieuw, neem er opnieuw aan deel of herstel deze."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਲਾਇਬ੍ਰੇਰੀ ਦੀ ਕੋਈ ਡੀਵਾਈਸ ਪਛਾਣ ਨਹੀਂ ਹੈ। ਲਾਇਬ੍ਰੇਰੀ ਨੂੰ ਮੁੜ ਬਣਾਓ, ਇਸ ਵਿੱਚ ਸ਼ਾਮਲ ਹੋਵੋ ਜਾਂ ਇਸਨੂੰ ਮੁੜ-ਬਹਾਲ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta biblioteka nie ma tożsamości urządzenia. Utwórz ją, dołącz do niej lub przywróć ją ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca não tem uma identidade de dispositivo. Crie-a, entre nela ou restaure-a novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நூலகத்திற்கு சாதன அடையாளம் இல்லை. நூலகத்தை மீண்டும் உருவாக்கவும், அதில் சேரவும் அல்லது அதை மீட்டெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ లైబ్రరీకి పరికర గుర్తింపు లేదు. లైబ్రరీని మళ్లీ సృష్టించండి, దానిలో చేరండి లేదా దాన్ని పునరుద్ధరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังนี้ไม่มีข้อมูลประจำตัวของอุปกรณ์ โปรดสร้าง เข้าร่วม หรือกู้คืนคลังอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arşivin cihaz kimliği yok. Arşivi yeniden oluşturun, arşive katılın veya arşivi geri yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця медіатека не має ідентифікатора пристрою. Створіть її, приєднайтеся до неї або відновіть її знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس لائبریری کی کوئی آلہ شناخت نہیں ہے۔ لائبریری کو دوبارہ بنائیں، اس میں شامل ہوں یا اسے بحال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện này không có danh tính thiết bị. Hãy tạo, tham gia hoặc khôi phục lại thư viện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此资料库没有设备身份。请重新创建、加入或恢复该资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫沒有裝置身分。請重新建立、加入或還原該資料庫。"
          }
        }
      }
    },
    "core.error.join.expired": {
      "comment": "The device-pairing join ended because the pairing code passed its deadline; a retry needs a fresh code.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية رمز الاقتران هذا. اعرض رمزًا جديدًا على الجهاز الآخر ثم أعد المحاولة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този код за сдвояване изтече. Покажете нов код на другото устройство и опитайте отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পেয়ারিং কোডের মেয়াদ শেষ হয়েছে। অন্য ডিভাইসে নতুন কোড দেখিয়ে আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento párovací kód vypršel. Zobrazte na druhém zařízení nový kód a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kopplungscode ist abgelaufen. Zeige auf dem anderen Gerät einen neuen Code an und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing code expired. Show a new code on the other device and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de emparejamiento caducó. Muestra un código nuevo en el otro dispositivo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code d’association a expiré. Affichez un nouveau code sur l’autre appareil, puis réessayez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પેરિંગ કોડની મુદત પૂરી થઈ. બીજા ઉપકરણ પર નવો કોડ બતાવો અને ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קוד הצימוד הזה פג. הצג קוד חדש במכשיר האחר ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पेयरिंग कोड समाप्त हो गया। दूसरे डिवाइस पर नया कोड दिखाएं और दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj kod za uparivanje je istekao. Prikažite novi kod na drugom uređaju i pokušajte ponovno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice di abbinamento è scaduto. Mostra un nuovo codice sull’altro dispositivo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングコードは期限切れです。もう一方のデバイスで新しいコードを表示して、もう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಜೋಡಣೆ ಕೋಡ್ ಅವಧಿ ಮುಗಿದಿದೆ. ಇನ್ನೊಂದು ಸಾಧನದಲ್ಲಿ ಹೊಸ ಕೋಡ್ ತೋರಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페어링 코드가 만료되었습니다. 다른 기기에서 새 코드를 표시한 다음 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പെയറിംഗ് കോഡിന്റെ കാലാവധി കഴിഞ്ഞു. മറ്റേ ഉപകരണത്തിൽ പുതിയ കോഡ് കാണിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा पेअरिंग संकेत कालबाह्य झाला. दुसऱ्या डिव्हाइसवर नवीन संकेत दाखवा आणि पुन्हा प्रयत्न करा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze koppelingscode is verlopen. Toon een nieuwe code op het andere apparaat en probeer het opnieuw."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਪੇਅਰਿੰਗ ਕੋਡ ਦੀ ਮਿਆਦ ਪੁੱਗ ਗਈ। ਦੂਜੇ ਡਿਵਾਈਸ ਉੱਤੇ ਨਵਾਂ ਕੋਡ ਦਿਖਾਓ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod parowania wygasł. Wyświetl nowy kod na drugim urządzeniu i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de pareamento expirou. Mostre um novo código no outro dispositivo e tente novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த இணைத்தல் குறியீடு காலாவதியானது. மற்ற சாதனத்தில் புதிய குறியீட்டைக் காட்டி மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ జత చేసే కోడ్ గడువు ముగిసింది. మరో పరికరంలో కొత్త కోడ్‌ను చూపి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสจับคู่นี้หมดอายุแล้ว แสดงรหัสใหม่บนอุปกรณ์อีกเครื่องแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eşleştirme kodunun süresi doldu. Diğer aygıtta yeni bir kod gösterip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей код сполучення застарів. Покажіть новий код на іншому пристрої та повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس جوڑی بنانے کے رمز کی میعاد ختم ہو گئی۔ دوسرے آلے پر نیا رمز دکھائیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã ghép đôi này đã hết hạn. Hãy hiện mã mới trên thiết bị kia rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配对码已过期。请在另一台设备上显示新的配对码后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此配對碼已過期。請在另一台裝置上顯示新的配對碼後再試一次。"
          }
        }
      }
    },
    "core.error.join.owner_ended": {
      "comment": "The device-pairing join ended because the inviting device withdrew the attempt.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهى الجهاز الآخر هذا الاقتران. ابدأه من هناك مرة أخرى إذا كنت لا تزال تريد الانضمام."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Другото устройство прекрати това сдвояване. Започнете го отново оттам, ако още искате да се присъедините."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ডিভাইসটি এই পেয়ারিং শেষ করেছে। এখনও যোগ দিতে চাইলে সেখান থেকে আবার শুরু করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Druhé zařízení toto párování ukončilo. Pokud se stále chcete připojit, spusťte ho tam znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das andere Gerät hat diese Kopplung beendet. Starte sie dort erneut, wenn du noch beitreten willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device ended this pairing. Start it again from there if you still want to join."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro dispositivo finalizó este emparejamiento. Vuelve a iniciarlo desde allí si aún quieres unirte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autre appareil a mis fin à cette association. Relancez-la depuis celui-ci si vous voulez toujours rejoindre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બીજા ઉપકરણે આ પેરિંગ સમાપ્ત કર્યું. જો તમે હજી જોડાવા માંગતા હો, તો ત્યાંથી ફરી શરૂ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכשיר האחר סיים את הצימוד הזה. התחל אותו שוב משם אם אתה עדיין רוצה להצטרף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे डिवाइस ने यह पेयरिंग समाप्त कर दी। अगर आप अब भी जुड़ना चाहते हैं तो इसे वहीं से दोबारा शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi uređaj je završio ovo uparivanje. Pokrenite ga ondje ponovno ako se i dalje želite pridružiti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’altro dispositivo ha terminato questo abbinamento. Riavvialo da lì se vuoi ancora unirti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスがこのペアリングを終了しました。参加を続けるなら、そちらからやり直してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೊಂದು ಸಾಧನ ಈ ಜೋಡಣೆಯನ್ನು ಕೊನೆಗೊಳಿಸಿತು. ಇನ್ನೂ ಸೇರಬೇಕಿದ್ದರೆ ಅಲ್ಲಿಂದ ಮತ್ತೆ ಪ್ರಾರಂಭಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기가 이 페어링을 종료했습니다. 계속 참여하려면 그 기기에서 다시 시작하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റേ ഉപകരണം ഈ പെയറിംഗ് അവസാനിപ്പിച്ചു. ഇനിയും ചേരണമെങ്കിൽ അവിടെ നിന്ന് വീണ്ടും ആരംഭിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दुसऱ्या डिव्हाइसने हे पेअरिंग संपवले. तुम्हाला अजूनही सामील व्हायचे असल्यास ते तिथून पुन्हा सुरू करा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het andere apparaat heeft deze koppeling beëindigd. Start hem daar opnieuw als je nog wilt deelnemen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੂਜੇ ਡਿਵਾਈਸ ਨੇ ਇਹ ਪੇਅਰਿੰਗ ਖ਼ਤਮ ਕਰ ਦਿੱਤੀ। ਜੇ ਤੁਸੀਂ ਹਾਲੇ ਵੀ ਸ਼ਾਮਲ ਹੋਣਾ ਚਾਹੁੰਦੇ ਹੋ ਤਾਂ ਉੱਥੋਂ ਦੁਬਾਰਾ ਸ਼ੁਰੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugie urządzenie zakończyło to parowanie. Rozpocznij je tam ponownie, jeśli nadal chcesz dołączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro dispositivo encerrou este pareamento. Inicie-o novamente por lá se ainda quiser entrar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்ற சாதனம் இந்த இணைத்தலை முடித்தது. இன்னும் இணைய விரும்பினால், அங்கிருந்து மீண்டும் தொடங்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో పరికరం ఈ జత చేయడాన్ని ముగించింది. ఇంకా చేరాలనుకుంటే అక్కడి నుంచి మళ్లీ ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์อีกเครื่องยุติการจับคู่นี้แล้ว หากยังต้องการเข้าร่วม ให้เริ่มใหม่จากเครื่องนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer aygıt bu eşleştirmeyi sonlandırdı. Hâlâ katılmak istiyorsanız oradan yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший пристрій завершив це сполучення. Почніть його звідти знову, якщо ще хочете приєднатися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسرے آلے نے یہ جوڑی بنانا ختم کر دیا۔ اگر آپ اب بھی شامل ہونا چاہتے ہیں تو وہاں سے دوبارہ شروع کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị kia đã kết thúc phiên ghép đôi này. Hãy bắt đầu lại từ đó nếu bạn vẫn muốn tham gia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备结束了此配对。若仍要加入，请从该设备重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台裝置結束了此配對。若仍要加入，請從該裝置重新開始。"
          }
        }
      }
    },
    "core.error.join.owner_offline": {
      "comment": "The device-pairing join ended because the inviting device never took its next step; both devices must run the join at once.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهاز الآخر لا يشغّل هذا الاقتران. افتح bae عليه واعرض رمز اقتران ثم أعد المحاولة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Другото устройство не изпълнява това сдвояване. Отворете bae на него, покажете код и опитайте отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ডিভাইসটি এই পেয়ারিং চালাচ্ছে না। সেখানে bae খুলে পেয়ারিং কোড দেখিয়ে আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Druhé zařízení toto párování neprovádí. Otevřete na něm bae, zobrazte kód a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das andere Gerät führt diese Kopplung nicht aus. Öffne bae dort, zeige einen Code an und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device isn't running this join. Open bae on it, show a pairing code, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro dispositivo no está ejecutando este emparejamiento. Abre bae en él, muestra un código y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autre appareil n’exécute pas cette association. Ouvrez bae dessus, affichez un code, puis réessayez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બીજું ઉપકરણ આ પેરિંગ ચલાવતું નથી. તેના પર bae ખોલો, પેરિંગ કોડ બતાવો અને ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכשיר האחר לא מריץ את הצימוד הזה. פתח בו את bae, הצג קוד צימוד ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा डिवाइस यह पेयरिंग नहीं चला रहा। उस पर bae खोलें, पेयरिंग कोड दिखाएं और दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi uređaj ne izvodi ovo uparivanje. Otvorite bae na njemu, prikažite kod i pokušajte ponovno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’altro dispositivo non sta eseguendo questo abbinamento. Apri bae su di esso, mostra un codice e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスでこのペアリングが実行されていません。そちらでbaeを開き、ペアリングコードを表示してから、もう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೊಂದು ಸಾಧನ ಈ ಜೋಡಣೆಯನ್ನು ನಡೆಸುತ್ತಿಲ್ಲ. ಅದರಲ್ಲಿ bae ತೆರೆದು, ಜೋಡಣೆ ಕೋಡ್ ತೋರಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 이 페어링이 실행되고 있지 않습니다. 그 기기에서 bae를 열고 페어링 코드를 표시한 다음 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റേ ഉപകരണം ഈ പെയറിംഗ് നടത്തുന്നില്ല. അതിൽ bae തുറന്ന്, പെയറിംഗ് കോഡ് കാണിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दुसरे डिव्हाइस हे पेअरिंग चालवत नाही. त्यावर bae उघडा, पेअरिंग संकेत दाखवा आणि पुन्हा प्रयत्न करा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het andere apparaat voert deze koppeling niet uit. Open bae daarop, toon een koppelingscode en probeer het opnieuw."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੂਜਾ ਡਿਵਾਈਸ ਇਹ ਪੇਅਰਿੰਗ ਨਹੀਂ ਚਲਾ ਰਿਹਾ। ਉਸ ਉੱਤੇ bae ਖੋਲ੍ਹੋ, ਪੇਅਰਿੰਗ ਕੋਡ ਦਿਖਾਓ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugie urządzenie nie prowadzi tego parowania. Otwórz na nim bae, wyświetl kod i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro dispositivo não está executando este pareamento. Abra o bae nele, mostre um código e tente novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்ற சாதனம் இந்த இணைத்தலை இயக்கவில்லை. அதில் bae-ஐத் திறந்து, இணைத்தல் குறியீட்டைக் காட்டி மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో పరికరం ఈ జత చేయడాన్ని అమలు చేయడం లేదు. దానిలో baeని తెరిచి, జత చేసే కోడ్‌ను చూపి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์อีกเครื่องไม่ได้กำลังทำการจับคู่นี้ เปิด bae บนเครื่องนั้น แสดงรหัสจับคู่ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer aygıt bu eşleştirmeyi yürütmüyor. Orada bae’yi açın, bir eşleştirme kodu gösterip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший пристрій не виконує це сполучення. Відкрийте на ньому bae, покажіть код і повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسرا آلہ یہ جوڑی بنانا نہیں چلا رہا۔ اس پر bae کھولیں، جوڑی بنانے کا رمز دکھائیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị kia không đang chạy phiên ghép đôi này. Hãy mở bae trên đó, hiện mã ghép đôi rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备未在进行此配对。请在该设备上打开 bae 并显示配对码后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台裝置未在進行此配對。請在該裝置上開啟 bae 並顯示配對碼後再試一次。"
          }
        }
      }
    },
    "core.error.keyring.locked": {
      "comment": "The OS keychain refused the read because the session is locked or the display is asleep; the key is present and the read succeeds again after unlock.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلسلة مفاتيح هذا الجهاز مقفلة. ألغِ قفل الجهاز وسيتابع bae من حيث توقف."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключодържателят на това устройство е заключен. Отключете устройството и bae ще продължи оттам, докъдето е стигнал."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসের কীচেইন লক করা আছে। ডিভাইস আনলক করুন, bae যেখানে থেমেছিল সেখান থেকেই চালিয়ে যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíčenka tohoto zařízení je uzamčená. Odemkněte zařízení a bae bude pokračovat tam, kde skončil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüsselbund dieses Geräts ist gesperrt. Entsperre das Gerät, und bae macht dort weiter, wo es aufgehört hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device's keychain is locked. Unlock the device and bae will pick up where it left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El llavero de este dispositivo está bloqueado. Desbloquea el dispositivo y bae continuará donde lo dejó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trousseau de cet appareil est verrouillé. Déverrouillez l’appareil et bae reprendra où il s’est arrêté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઉપકરણની કીચેન લૉક છે. ઉપકરણ અનલૉક કરો, bae જ્યાં અટક્યું હતું ત્યાંથી ચાલુ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחזיק המפתחות של המכשיר הזה נעול. שחרר את נעילת המכשיר ו-bae ימשיך מהנקודה שבה עצר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस का किचेन लॉक है। डिवाइस अनलॉक करें और bae वहीं से जारी रखेगा जहां छोड़ा था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privjesak ključeva ovog uređaja je zaključan. Otključajte uređaj i bae će nastaviti gdje je stao."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portachiavi di questo dispositivo è bloccato. Sblocca il dispositivo e bae riprenderà da dove si era fermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのキーチェーンがロックされています。デバイスのロックを解除すると、baeは中断したところから再開します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನದ ಕೀಚೈನ್ ಲಾಕ್ ಆಗಿದೆ. ಸಾಧನವನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಿ, bae ನಿಲ್ಲಿಸಿದಲ್ಲಿಂದ ಮುಂದುವರಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 키체인이 잠겨 있습니다. 기기를 잠금 해제하면 bae가 중단된 지점부터 이어서 진행합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിന്റെ കീചെയിൻ ലോക്ക് ചെയ്തിരിക്കുന്നു. ഉപകരണം അൺലോക്ക് ചെയ്യുക, നിർത്തിയിടത്തുനിന്ന് bae തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसची कीचेन लॉक आहे. डिव्हाइस अनलॉक करा, bae जिथे थांबले तिथून पुढे चालू ठेवेल."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutelhanger van dit apparaat is vergrendeld. Ontgrendel het apparaat, dan gaat bae verder waar het gebleven was."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਡਿਵਾਈਸ ਦੀ ਕੀਚੇਨ ਲਾਕ ਹੈ। ਡਿਵਾਈਸ ਅਨਲਾਕ ਕਰੋ, bae ਉੱਥੋਂ ਜਾਰੀ ਰੱਖੇਗਾ ਜਿੱਥੇ ਰੁਕਿਆ ਸੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pęk kluczy tego urządzenia jest zablokowany. Odblokuj urządzenie, a bae wznowi pracę w miejscu, w którym przerwał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves deste dispositivo estão bloqueadas. Desbloqueie o dispositivo e o bae continuará de onde parou."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தின் கீசெயின் பூட்டப்பட்டுள்ளது. சாதனத்தைத் திறந்தால், bae நிறுத்திய இடத்திலிருந்து தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరం కీచైన్ లాక్ చేయబడింది. పరికరాన్ని అన్‌లాక్ చేయండి, bae ఆగిన చోటి నుంచి కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พวงกุญแจของอุปกรณ์นี้ถูกล็อกอยู่ ปลดล็อกอุปกรณ์แล้ว bae จะทำต่อจากจุดที่ค้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtın anahtar zinciri kilitli. Aygıtın kilidini açın; bae kaldığı yerden devam edecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В’язку ключів цього пристрою заблоковано. Розблокуйте пристрій, і bae продовжить із того місця, де зупинився."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے کی کی چین مقفل ہے۔ آلہ اَن لاک کریں، bae وہیں سے جاری رکھے گا جہاں رکا تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi khóa của thiết bị này đang bị khóa. Hãy mở khóa thiết bị và bae sẽ tiếp tục từ chỗ đang dở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备的钥匙串已锁定。解锁设备后，bae 会从中断处继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置的鑰匙圈已鎖定。解鎖裝置後，bae 會從中斷處繼續。"
          }
        }
      }
    },
