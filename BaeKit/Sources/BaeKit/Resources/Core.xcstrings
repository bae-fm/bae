    "core.playback.pause.disc_ended.message.cd": {
      "comment": "Alert body shown when playback pauses between CDs.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف التشغيل مؤقتًا بين الأقراص. بدّل القرص المضغوط ثم اضغط تشغيل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Възпроизвеждането е на пауза между дисковете. Сменете компактдиска и натиснете Възпроизвеждане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrávání je pozastaveno mezi disky. Vyměňte CD a stiskněte Přehrát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "new",
            "value": "Playback paused between discs. Change the CD, then press Play."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe pausiert zwischen den Discs. Wechsle die CD und drücke Wiedergabe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναπαραγωγή είναι σε παύση ανάμεσα στους δίσκους. Αλλάξτε το CD και πατήστε Αναπαραγωγή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback paused between discs. Change the CD, then press Play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción se pausó entre discos. Cambia el CD y pulsa Reproducir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "new",
            "value": "Playback paused between discs. Change the CD, then press Play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture est en pause entre les disques. Changez le CD, puis appuyez sur Lecture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההשמעה הושהתה בין הדיסקים. החלף את התקליטור ואז לחץ על הפעלה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodukcija je pauzirana između diskova. Promijenite CD i pritisnite Reproduciraj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lejátszás szünetel a lemezek között. Cseréld ki a CD-t, majd nyomd meg a Lejátszás gombot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione è in pausa tra i dischi. Cambia il CD, poi premi Riproduci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの間で再生を一時停止しました。CDを交換してから再生を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 사이에서 재생이 일시 정지되었습니다. CD를 교체한 다음 재생을 누르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "new",
            "value": "Playback paused between discs. Change the CD, then press Play."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het afspelen is gepauzeerd tussen schijven. Verwissel de cd en druk op Afspelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie wstrzymano między płytami. Zmień płytę CD i naciśnij Odtwórz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução pausou entre os discos. Troque o CD e toque em Reproduzir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "new",
            "value": "Playback paused between discs. Change the CD, then press Play."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redarea este în pauză între discuri. Schimbă CD-ul, apoi apasă Redă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prehrávanie je pozastavené medzi diskami. Vymeň CD a stlač Prehrať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "new",
            "value": "Playback paused between discs. Change the CD, then press Play."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalma diskler arasında duraklatıldı. CD’yi değiştirin, sonra Oynat’a basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворення призупинено між дисками. Змініть компакт-диск і натисніть Відтворити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已在碟片之间暂停。请更换CD，然后按播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已在碟片之間暫停。請更換CD，然後按播放。"
          }
        }
      }
    },
