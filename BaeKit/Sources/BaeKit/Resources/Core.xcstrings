        },
        "kn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ಬಿಡುಗಡೆ ಕ್ಲೌಡ್‌ನಲ್ಲಿ ಮಾತ್ರ ಸಂಗ್ರಹವಾಗಿದೆ. ಮತ್ತೆ ಸಂಪರ್ಕಿಸುವವರೆಗೆ ಅದನ್ನು ಪ್ಲೇ ಮಾಡಲಾಗುವುದಿಲ್ಲ."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ಬಿಡುಗಡೆಗಳು ಕ್ಲೌಡ್‌ನಲ್ಲಿ ಮಾತ್ರ ಸಂಗ್ರಹವಾಗಿವೆ. ಮತ್ತೆ ಸಂಪರ್ಕಿಸುವವರೆಗೆ ಅವುಗಳನ್ನು ಪ್ಲೇ ಮಾಡಲಾಗುವುದಿಲ್ಲ."
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld개 릴리스가 클라우드에만 저장되어 있습니다. 다시 연결할 때까지 재생할 수 없습니다."
                }
              }
            }
          }
        },
        "ml": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld റിലീസ് ക്ലൗഡിൽ മാത്രമേ സംഭരിച്ചിട്ടുള്ളൂ. വീണ്ടും കണക്റ്റ് ചെയ്യുന്നതുവരെ അത് പ്ലേ ചെയ്യാനാകില്ല."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld റിലീസുകൾ ക്ലൗഡിൽ മാത്രമേ സംഭരിച്ചിട്ടുള്ളൂ. വീണ്ടും കണക്റ്റ് ചെയ്യുന്നതുവരെ അവ പ്ലേ ചെയ്യാനാകില്ല."
                }
              }
            }
          }
        },
        "mr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld प्रकाशन फक्त क्लाउडमध्ये संग्रहित आहे। पुन्हा कनेक्ट करेपर्यंत ते चालवता येणार नाही."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld प्रकाशने फक्त क्लाउडमध्ये संग्रहित आहेत। पुन्हा कनेक्ट करेपर्यंत ती चालवता येणार नाहीत."
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld uitgave staat alleen in de cloud. Die wordt onafspeelbaar totdat je opnieuw verbinding maakt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld uitgaven staan alleen in de cloud. Die worden onafspeelbaar totdat je opnieuw verbinding maakt."
                }
              }
