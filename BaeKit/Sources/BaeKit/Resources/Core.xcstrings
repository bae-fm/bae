          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture est en pause entre les faces. Retournez le vinyle, puis appuyez sur Lecture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાઇડ વચ્ચે પ્લેબેક રોકાયું છે. વિનાઇલને ફેરવો, પછી પ્લે દબાવો."
