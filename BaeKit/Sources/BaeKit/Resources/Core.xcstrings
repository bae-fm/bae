    "core.playback.error.sync_disconnected": {
      "comment": "Playback error: a cloud-only track isn't downloaded and sync is offline.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد الاتصال لتشغيل هذا الإصدار. لم يُنزَّل إلى هذا الجهاز بعد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържете се отново, за да възпроизведете това издание. То още не е изтеглено на това устройство."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রিলিজ চালাতে আবার সংযোগ করুন। এটি এখনও এই ডিভাইসে ডাউনলোড হয়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro přehrání tohoto vydání se znovu připojte. Ještě není staženo do tohoto zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle die Verbindung wieder her, um diese Veröffentlichung abzuspielen. Sie ist noch nicht auf dieses Gerät heruntergeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect to play this release. It isn't downloaded to this device yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectarte para reproducir esta edición: aún no se ha descargado en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous pour lire cette édition. Elle n'est pas encore téléchargée sur cet appareil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પ્રકાશન વગાડવા ફરી જોડાઓ. તે હજી આ ઉપકરણ પર ડાઉનલોડ થયું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחבר מחדש כדי לנגן את ההוצאה הזו. היא עדיין לא הורדה למכשיר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिलीज को चलाने के लिए फिर जुड़ें। यह अभी इस उपकरण पर डाउनलोड नहीं हुई है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno se povežite za reprodukciju ovog izdanja. Još nije preuzeto na ovaj uređaj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnettiti per riprodurre questa pubblicazione. Non è ancora scaricata su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリースを再生するには再接続してください。まだこのデバイスにダウンロードされていません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಿಡುಗಡೆ ಪ್ಲೇ ಮಾಡಲು ಮರುಸಂಪರ್ಕಿಸಿ. ಇದು ಇನ್ನೂ ಈ ಸಾಧನಕ್ಕೆ ಡೌನ್‌ಲೋಡ್ ಆಗಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴리스를 재생하려면 다시 연결하세요. 아직 이 기기에 다운로드되지 않았습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പതിപ്പ് പ്ലേ ചെയ്യാൻ വീണ്ടും ബന്ധിപ്പിക്കുക. ഇത് ഈ ഉപകരണത്തിലേക്ക് ഇതുവരെ ഡൗൺലോഡ് ചെയ്തിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे प्रकाशन वाजवण्यासाठी पुन्हा जोडा। ते अजून या डिव्हाइसवर डाउनलोड झालेले नाही."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak opnieuw verbinding om deze release af te spelen. Deze is nog niet naar dit apparaat gedownload."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਰਿਲੀਜ਼ ਚਲਾਉਣ ਲਈ ਮੁੜ ਜੁੜੋ। ਇਹ ਹਾਲੇ ਇਸ ਡਿਵਾਈਸ ਤੇ ਡਾਊਨਲੋਡ ਨਹੀਂ ਹੋਈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się ponownie, aby odtworzyć to wydanie. Nie zostało jeszcze pobrane na to urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte-se para reproduzir esta edição. Ela ainda não foi baixada neste dispositivo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வெளியீட்டை இயக்க மீண்டும் இணைக்கவும். இது இன்னும் இந்த சாதனத்தில் பதிவிறக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ విడుదలను ప్లే చేయడానికి మళ్లీ కనెక్ట్ చేయండి. ఇది ఇంకా ఈ పరికరానికి డౌన్‌లోడ్ కాలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อใหม่เพื่อเล่นรีลีสนี้ ยังไม่ได้ดาวน์โหลดลงอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yayını çalmak için yeniden bağlanın. Henüz bu cihaza indirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться знову, щоб відтворити це видання. Воно ще не завантажене на цей пристрій."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اشاعت چلانے کے لیے دوبارہ منسلک ہوں۔ یہ ابھی اس آلے پر ڈاؤن لوڈ نہیں ہوئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối lại để phát bản phát hành này. Nó chưa được tải xuống thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新连接以播放此发行版。。它尚未下载到此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連線以播放此發行。尚未下載到此裝置。"
          }
        }
      }
    },
    "core.playback.error.upload_pending": {
      "comment": "Playback error: a track's cloud upload is still queued.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال هذا الإصدار قيد الرفع. أعد المحاولة عند انتهائه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това издание още се качва. Опитайте отново, когато приключи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রিলিজ এখনও আপলোড হচ্ছে। শেষ হলে আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto vydání se ještě nahrává. Zkuste to znovu po dokončení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Veröffentlichung wird noch hochgeladen. Versuche es erneut, wenn sie fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This release is still uploading. Try again when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta edición todavía se está subiendo: inténtalo de nuevo cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette édition est encore en cours d'envoi. Réessayez une fois terminé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પ્રકાશન હજી અપલોડ થઈ રહ્યું છે. તે પૂર્ણ થાય પછી ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההוצאה הזו עדיין מועלית. נסה שוב כשהיא תסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रिलीज अभी अपलोड हो रही है। पूरा होने पर फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo izdanje se još učitava. Pokušajte ponovno kad završi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa pubblicazione è ancora in caricamento. Riprova al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリースはまだアップロード中です。完了してからもう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಿಡುಗಡೆ ಇನ್ನೂ ಅಪ್‌ಲೋಡ್ ಆಗುತ್ತಿದೆ. ಮುಗಿದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴리스는 아직 업로드 중입니다. 완료되면 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പതിപ്പ് ഇപ്പോഴും അപ്ലോഡ് ചെയ്യുന്നു. പൂർത്തിയായാൽ വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे प्रकाशन अजून अपलोड होत आहे। पूर्ण झाल्यावर पुन्हा प्रयत्न करा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze release wordt nog geüpload. Probeer het opnieuw wanneer dit klaar is."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਰਿਲੀਜ਼ ਹਾਲੇ ਅੱਪਲੋਡ ਹੋ ਰਹੀ ਹੈ। ਮੁਕੰਮਲ ਹੋਣ ਤੇ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wydanie jest jeszcze przesyłane. Spróbuj ponownie po zakończeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta edição ainda está sendo enviada. Tente novamente quando terminar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வெளியீடு இன்னும் பதிவேற்றப்படுகிறது. முடிந்த பிறகு மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ విడుదల ఇంకా అప్‌లోడ్ అవుతోంది. పూర్తయ్యాక మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีลีสนี้ยังกำลังอัปโหลด ลองอีกครั้งเมื่อเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yayın hâlâ yükleniyor. Bittiğinde yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видання ще вивантажується. Спробуйте знову, коли завершиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اشاعت ابھی اپ لوڈ ہو رہی ہے۔ مکمل ہونے پر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản phát hành này vẫn đang tải lên. Hãy thử lại khi hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此发行版仍在上传中。。完成后请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此發行仍在上傳。完成後再試一次。"
          }
        }
      }
    },
    "core.playback.pause.side_ended.message.cassette": {
      "comment": "Alert body shown when playback pauses between cassette sides.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف التشغيل مؤقتًا بين الجانبين. اقلب شريط الكاسيت ثم اضغط تشغيل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Възпроизвеждането е на пауза между страните. Обърнете касетата и натиснете Възпроизвеждане."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইডের মাঝে প্লেব্যাক বিরত হয়েছে। ক্যাসেটটি উল্টে দিন, তারপর প্লে চাপুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrávání je pozastaveno mezi stranami. Otočte kazetu a stiskněte Přehrát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe pausiert zwischen den Seiten. Drehe die Kassette um und drücke Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback paused between sides. Turn the cassette, then press Play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción se pausó entre lados. Dale la vuelta al casete y pulsa Reproducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture est en pause entre les faces. Retournez la cassette, puis appuyez sur Lecture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાઇડ વચ્ચે પ્લેબેક રોકાયું છે. કેસેટને ફેરવો, પછી પ્લે દબાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההשמעה הושהתה בין הצדדים. הפוך את הקלטת ואז לחץ על הפעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइडों के बीच प्लेबैक रोक दिया गया है। कैसेट को पलटें, फिर प्ले दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodukcija je pauzirana između strana. Okrenite kasetu i pritisnite Reproduciraj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione è in pausa tra i lati. Gira la cassetta, poi premi Riproduci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面の間で再生を一時停止しました。カセットを裏返してから再生を押してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೈಡ್‌ಗಳ ನಡುವೆ ಪ್ಲೇಬ್ಯಾಕ್ ವಿರಾಮಗೊಂಡಿದೆ. ಕ್ಯಾಸೆಟ್ ಅನ್ನು ತಿರುಗಿಸಿ, ನಂತರ ಪ್ಲೇ ಒತ್ತಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면 사이에서 재생이 일시 정지되었습니다. 카세트를 뒤집은 다음 재생을 누르세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൈഡുകൾക്കിടയിൽ പ്ലേബാക്ക് നിർത്തി. കാസെറ്റ് തിരിച്ച്, തുടർന്ന് പ്ലേ അമർത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बाजूंमध्ये प्लेबॅक थांबवला आहे. कॅसेट उलटी करा, मग प्ले दाबा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het afspelen is gepauzeerd tussen kanten. Draai de cassette om en druk op Afspelen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਈਡਾਂ ਵਿਚਕਾਰ ਪਲੇਬੈਕ ਰੁਕ ਗਿਆ ਹੈ। ਕੈਸੇਟ ਨੂੰ ਉਲਟੋ, ਫਿਰ ਪਲੇ ਦਬਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie wstrzymano między stronami. Odwróć kasetę i naciśnij Odtwórz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução pausou entre os lados. Vire a fita cassete e toque em Reproduzir."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பக்கங்களுக்கு இடையில் இயக்கம் இடைநிறுத்தப்பட்டது. கேசெட்டைப் திருப்பி, பிறகு இயக்கு என்பதை அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సైడ్‌ల మధ్య ప్లేబ్యాక్ నిలిపివేయబడింది. క్యాసెట్‌ను తిప్పి, ఆపై ప్లే నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเล่นหยุดพักระหว่างด้าน พลิกเทปคาสเซ็ต แล้วกดเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalma yüzler arasında duraklatıldı. Kaseti çevirin, sonra Oynat'a basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворення призупинено між сторонами. Переверніть касету і натисніть Відтворити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائیڈز کے درمیان پلے بیک روک دیا گیا ہے۔ کیسٹ کو پلٹیں، پھر پلے دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát lại đã tạm dừng giữa các mặt. Lật băng cassette rồi nhấn Phát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已在两面之间暂停。请翻转磁带，然后按播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已在兩面之間暫停。請翻轉卡帶，然後按播放。"
          }
        }
      }
    },
    "core.playback.pause.side_ended.message.vinyl": {
      "comment": "Alert body shown when playback pauses between vinyl sides.",
      "localizations": {
        "ar": {
