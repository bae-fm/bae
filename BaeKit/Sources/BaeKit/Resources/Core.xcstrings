        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस के सुरक्षित संग्रहण तक नहीं पहुँच सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće pristupiti sigurnoj pohrani vašeg uređaja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile accedere all'archivio sicuro del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの安全なストレージにアクセスできませんでした。"
