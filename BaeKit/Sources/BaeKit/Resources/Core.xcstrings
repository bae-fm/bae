    "core.playback.error.sync_disconnected": {
      "comment": "Playback error: a cloud-only track isn't downloaded and sync is offline.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد الاتصال لتشغيل هذا الإصدار. لم يُنزَّل إلى هذا الجهاز بعد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържете се отново, за да възпроизведете това издание. То още не е изтеглено на това устройство."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro přehrání tohoto vydání se znovu připojte. Ještě není staženo do tohoto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "new",
            "value": "Reconnect to play this release. It isn't downloaded to this device yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle die Verbindung wieder her, um diese Veröffentlichung abzuspielen. Sie ist noch nicht auf dieses Gerät heruntergeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επανασυνδεθείτε για να αναπαραγάγετε αυτή την κυκλοφορία. Δεν έχει ληφθεί ακόμη σε αυτή τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect to play this release. It isn't downloaded to this device yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectarte para reproducir esta edición: aún no se ha descargado en este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "new",
            "value": "Reconnect to play this release. It isn't downloaded to this device yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous pour lire cette édition. Elle n'est pas encore téléchargée sur cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחבר מחדש כדי לנגן את ההוצאה הזו. היא עדיין לא הורדה למכשיר הזה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno se povežite za reprodukciju ovog izdanja. Još nije preuzeto na ovaj uređaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiadás lejátszásához kapcsolódj újra. Erre az eszközre még nincs letöltve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnettiti per riprodurre questa pubblicazione. Non è ancora scaricata su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリースを再生するには再接続してください。まだこのデバイスにダウンロードされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴리스를 재생하려면 다시 연결하세요. 아직 이 기기에 다운로드되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "new",
            "value": "Reconnect to play this release. It isn't downloaded to this device yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak opnieuw verbinding om deze release af te spelen. Deze is nog niet naar dit apparaat gedownload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się ponownie, aby odtworzyć to wydanie. Nie zostało jeszcze pobrane na to urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte-se para reproduzir esta edição. Ela ainda não foi baixada neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "new",
            "value": "Reconnect to play this release. It isn't downloaded to this device yet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconectează-te pentru a reda această ediție. Încă nu este descărcată pe acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chceš toto vydanie prehrať, znova sa pripoj. Zatiaľ nie je stiahnuté do tohto zariadenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "new",
            "value": "Reconnect to play this release. It isn't downloaded to this device yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yayını çalmak için yeniden bağlanın. Henüz bu cihaza indirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться знову, щоб відтворити це видання. Воно ще не завантажене на цей пристрій."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新连接以播放此发行版。。它尚未下载到此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連線以播放此發行。尚未下載到此裝置。"
          }
        }
      }
    },
    "core.playback.error.upload_pending": {
      "comment": "Playback error: a track's cloud upload is still queued.",
      "localizations": {
