    "ui.import.commit.unanswered": {
      "comment": "Import commit bar: how many rows nobody has named yet. Stated, never blocking — committing anyway titles each of them after its file.",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld صفوف لا تزال بلا اسم"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld صفًا لا يزال بلا اسم"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صف واحد لا يزال بلا اسم"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld صف لا يزال بلا اسم"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفان لا يزالان بلا اسم"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا صفوف بلا اسم"
                }
              }
            }
          }
        },
        "bg": {
          "variations": {
