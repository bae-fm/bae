            "state": "translated",
            "value": "Le téléchargement des illustrations est arrêté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הורדת תמונות העטיפה הופסקה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanje omota je zaustavljeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A grafika letöltése leállt."
          }
        },
        "it": {
