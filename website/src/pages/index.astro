        word.className='cyc-word '+from.cls; word.style.color=from.col;
        var caret=document.createElement('span'); caret.className='cyc-caret';
        var buf=from.text;
        function render(){ word.textContent=buf; word.appendChild(caret); }
        render(); word.style.width='auto';                 // hug the typed text so the centered line never sits off-center
        function type(){ if(buf.length<to.text.length){ buf=to.text.slice(0,buf.length+1); render(); later(type,TYPE); } else { if(caret.parentNode)caret.parentNode.removeChild(caret); word.textContent=to.text; done(); } }
        function back(){ if(buf.length>0){ buf=buf.slice(0,-1); render(); later(back,TYPE); } else { word.className='cyc-word '+to.cls; word.style.color=to.col; type(); } }
        later(back,TYPE);
      }
      function tFade(from,to,done){
        word.classList.add('cyc-fade'); word.classList.add('cyc-out');
        later(function(){ paintPlain(to); word.classList.add('cyc-fade'); word.style.width=''; word.classList.remove('cyc-out'); later(function(){ word.classList.remove('cyc-fade'); done(); },440); },300);
      }
      function tFlip(from,to,done){
        word.className='cyc-word '+from.cls; word.style.color=from.col;
        word.style.transformOrigin='center bottom';
        word.style.transition='transform '+(FLIP/2)+'ms ease-in,opacity '+(FLIP/2)+'ms ease-in';
        word.style.transform='translateY(-.45em) rotateX(72deg)'; word.style.opacity='0';
        later(function(){
          paintPlain(to); word.style.color=to.col;
          word.style.transition='none'; word.style.transform='translateY(.45em) rotateX(-72deg)'; word.style.opacity='0';
          setWidth(to.text);                               // snap to target width while invisible: flip-out stays at the old word's width
          void word.offsetWidth;                           // force reflow so the entry runs
          word.style.transition='transform '+(FLIP/2)+'ms ease-out,opacity '+(FLIP/2)+'ms ease-out';
          word.style.transform='none'; word.style.opacity='1';
          later(function(){ word.style.transition=''; word.style.transform=''; word.style.opacity=''; word.style.transformOrigin=''; word.style.color=''; done(); },FLIP/2);
        },FLIP/2);
      }

      var POOL=[tType,tFade,tFlip];
      function pick(){ var i; do{ i=(Math.random()*POOL.length)|0; }while(i===last && POOL.length>1); last=i; return POOL[i]; }

      function step(){
        if(!running) return;
        clearTimers();                                     // never let two transitions overlap
        var from=WORDS[idx]; idx=(idx+1)%WORDS.length; var to=WORDS[idx];
        if(reduce){                                        // reduced motion: one calm cross-fade, nothing else
          word.classList.add('cyc-fade'); word.classList.add('cyc-out');
          later(function(){ paintPlain(to); word.classList.add('cyc-fade'); word.style.width=''; word.classList.remove('cyc-out'); later(function(){ word.classList.remove('cyc-fade'); later(step,RM_HOLD); },440); },420);
          return;
        }
        pick()(from,to,function(){ settle(to); later(step,HOLD); });
      }

      function start(){ if(running)return; running=true; later(step, reduce?RM_HOLD:HOLD); }
      function stop(){ running=false; clearTimers(); }     // pause when tab hidden so timers don't pile up

      document.addEventListener('visibilitychange',function(){
        if(document.hidden){ stop(); }
        else { clearTimers(); settle(WORDS[idx]); start(); } // resume: re-settle the current word, no partial frame left over
      });
      addEventListener('resize',function(){ measure(); if(running) setWidth(WORDS[idx].text); });
      if(document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ measure(); setWidth(WORDS[idx].text); });

      if(!document.hidden) start();
    })();
</script>
</body>
</html>
