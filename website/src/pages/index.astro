<script is:inline>
  (function(){
    var els=[].slice.call(document.querySelectorAll('.r'));
    els.forEach(function(e){e.classList.add('is-pre');});
    function show(e){e.classList.remove('is-pre');e.classList.remove('is-in');e.style.opacity='1';e.style.transform='none';}
    function reveal(){
      var h=window.innerHeight||document.documentElement.clientHeight;
      els=els.filter(function(e){
        if(e.getBoundingClientRect().top < h*0.92){e.classList.remove('is-pre');e.classList.add('is-in');setTimeout(function(){show(e);},1000);return false;}
        return true;
      });
    }
    requestAnimationFrame(function(){requestAnimationFrame(reveal);});
    addEventListener('scroll',reveal,{passive:true});addEventListener('resize',reveal);
    setTimeout(reveal,500);
    setTimeout(function(){els.forEach(show);els=[];},2400);
    var nav=document.getElementById('nav');
    addEventListener('scroll',function(){nav.classList.toggle('scrolled',scrollY>20);},{passive:true});
  })();

  /* end CTA: cycling final word ("home" / "everywhere") */
    /* ---- end CTA: cycling final word ("home" <-> "everywhere") ---- */
    (function(){
      var h2 = document.querySelector('.endcta h2');
      var cyc = h2 && h2.querySelector('.cyc');
      var word = cyc && cyc.querySelector('.cyc-word');
      var dot = cyc && cyc.querySelector('.cyc-dot');
      if(!h2 || !cyc || !word || !dot) return;            // guard: do nothing if missing

      var WORDS = [
        {text:'home',          cls:'cyc-pink',   col:'var(--pink)'},
        {text:'everywhere',    cls:'cyc-violet', col:'var(--violet)'},
        {text:'together',      cls:'cyc-mint',   col:'var(--mint)'},
        {text:'offline',       cls:'cyc-amber',  col:'var(--amber)'},
        {text:'under control', cls:'cyc-sky',    col:'var(--sky)'}
      ];
      var HOLD=2100, TYPE=58, FLIP=620, RM_HOLD=4200;
      var reduce = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);

      h2.classList.add('cyc-on');                          // take over from the no-JS fallback

      // measure both words with a hidden sizer in the h2 font; period stays folded in the unit
      var sizer=document.createElement('span'); sizer.className='cyc-sizer'; sizer.setAttribute('aria-hidden','true'); h2.appendChild(sizer);
      var widths={};
      function measure(){ for(var i=0;i<WORDS.length;i++){ sizer.textContent=WORDS[i].text; widths[WORDS[i].text]=sizer.getBoundingClientRect().width; } }
      measure();

      var idx=0, last=-1, running=false;
      var timers=[];                                       // every pending timer/interval lives here
      function clearTimers(){ for(var i=0;i<timers.length;i++){ clearTimeout(timers[i]); clearInterval(timers[i]); } timers=[]; }
      function later(fn,ms){ var t=setTimeout(fn,ms); timers.push(t); return t; }

      function setWidth(text){ word.style.width=Math.ceil(widths[text])+'px'; }
      function paintPlain(w){ word.className='cyc-word '+w.cls; word.style.color=''; word.textContent=w.text; }
      // settle: clean static single-word state after every transition (and on resume)
      function settle(w){ word.classList.remove('cyc-out','cyc-fade'); word.style.transition=''; word.style.transform=''; word.style.opacity=''; word.style.filter=''; word.style.transformOrigin=''; word.style.width=''; paintPlain(w); }

      settle(WORDS[idx]);                                  // markup ships "home"; lock it in

      // ---- transition pool: each calls done() when finished ----
      function tType(from,to,done){
        word.className='cyc-word '+from.cls; word.style.color=from.col;
        var caret=document.createElement('span'); caret.className='cyc-caret';
        var buf=from.text;
        function render(){ word.textContent=buf; word.appendChild(caret); }
        render(); word.style.width='auto';                 // hug the typed text so the centered line never sits off-center
        function type(){ if(buf.length<to.text.length){ buf=to.text.slice(0,buf.length+1); render(); later(type,TYPE); } else { if(caret.parentNode)caret.parentNode.removeChild(caret); word.textContent=to.text; done(); } }
        function back(){ if(buf.length>0){ buf=buf.slice(0,-1); render(); later(back,TYPE); } else { word.className='cyc-word '+to.cls; word.style.color=to.col; type(); } }
        later(back,TYPE);
      }
      function tFade(from,to,done){
        word.classList.add('cyc-fade'); word.classList.add('cyc-out');
        later(function(){ paintPlain(to); word.classList.add('cyc-fade'); word.style.width=''; word.classList.remove('cyc-out'); later(function(){ word.classList.remove('cyc-fade'); done(); },440); },300);
      }
      function tFlip(from,to,done){
        word.className='cyc-word '+from.cls; word.style.color=from.col;
        word.style.transformOrigin='center bottom';
        word.style.transition='transform '+(FLIP/2)+'ms ease-in,opacity '+(FLIP/2)+'ms ease-in';
        word.style.transform='translateY(-.45em) rotateX(72deg)'; word.style.opacity='0';
        later(function(){
          paintPlain(to); word.style.color=to.col;
          word.style.transition='none'; word.style.transform='translateY(.45em) rotateX(-72deg)'; word.style.opacity='0';
          setWidth(to.text);                               // snap to target width while invisible: flip-out stays at the old word's width
          void word.offsetWidth;                           // force reflow so the entry runs
          word.style.transition='transform '+(FLIP/2)+'ms ease-out,opacity '+(FLIP/2)+'ms ease-out';
          word.style.transform='none'; word.style.opacity='1';
          later(function(){ word.style.transition=''; word.style.transform=''; word.style.opacity=''; word.style.transformOrigin=''; word.style.color=''; done(); },FLIP/2);
        },FLIP/2);
      }

      var POOL=[tType,tFade,tFlip];
      function pick(){ var i; do{ i=(Math.random()*POOL.length)|0; }while(i===last && POOL.length>1); last=i; return POOL[i]; }

      function step(){
        if(!running) return;
        clearTimers();                                     // never let two transitions overlap
        var from=WORDS[idx]; idx=(idx+1)%WORDS.length; var to=WORDS[idx];
        if(reduce){                                        // reduced motion: one calm cross-fade, nothing else
          word.classList.add('cyc-fade'); word.classList.add('cyc-out');
          later(function(){ paintPlain(to); word.classList.add('cyc-fade'); word.style.width=''; word.classList.remove('cyc-out'); later(function(){ word.classList.remove('cyc-fade'); later(step,RM_HOLD); },440); },420);
          return;
        }
        pick()(from,to,function(){ settle(to); later(step,HOLD); });
      }

      function start(){ if(running)return; running=true; later(step, reduce?RM_HOLD:HOLD); }
      function stop(){ running=false; clearTimers(); }     // pause when tab hidden so timers don't pile up

      document.addEventListener('visibilitychange',function(){
        if(document.hidden){ stop(); }
        else { clearTimers(); settle(WORDS[idx]); start(); } // resume: re-settle the current word, no partial frame left over
      });
      addEventListener('resize',function(){ measure(); if(running) setWidth(WORDS[idx].text); });
      if(document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ measure(); setWidth(WORDS[idx].text); });

      if(!document.hidden) start();
    })();
</script>
