<script is:inline>
  (function(){
    var els=[].slice.call(document.querySelectorAll('.r'));
    els.forEach(function(e){e.classList.add('is-pre');});
    function show(e){e.classList.remove('is-pre');e.classList.remove('is-in');e.style.opacity='1';e.style.transform='none';}
    function reveal(){
      var h=window.innerHeight||document.documentElement.clientHeight;
      els=els.filter(function(e){
        if(e.getBoundingClientRect().top < h*0.92){e.classList.remove('is-pre');e.classList.add('is-in');setTimeout(function(){show(e);},1000);return false;}
        return true;
      });
    }
    requestAnimationFrame(function(){requestAnimationFrame(reveal);});
    addEventListener('scroll',reveal,{passive:true});addEventListener('resize',reveal);
    setTimeout(reveal,500);
    setTimeout(function(){els.forEach(show);els=[];},2400);
    var nav=document.getElementById('nav');
    addEventListener('scroll',function(){nav.classList.toggle('scrolled',scrollY>20);},{passive:true});
    var tg=document.getElementById('navtoggle'),nl=document.getElementById('navlinks');
    function setMenu(open){nl.classList.toggle('open',open);tg.setAttribute('aria-expanded',open?'true':'false');}
    tg.addEventListener('click',function(){setMenu(!nl.classList.contains('open'));});
    [].forEach.call(nl.querySelectorAll('a'),function(a){a.addEventListener('click',function(){setMenu(false);});});
    addEventListener('resize',function(){if(innerWidth>720)setMenu(false);});
  })();
</script>
