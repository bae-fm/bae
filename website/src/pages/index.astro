---
import { getLatest } from '../lib/releases';

// Landing CTAs point at the latest macOS build (the desktop flagship), resolved
// at build time from the newest versioned release. If there's no published
// macOS build, the CTAs fall back to the install page (which lists every
// platform's state) — logged here so an unexpectedly-missing flagship build is
// visible in the build, not silently swapped.
const macFullUrl = (await getLatest()).macos?.full?.url;
if (!macFullUrl) {
  console.warn('index: no macOS full build resolved; landing CTAs fall back to the install page');
}
const macUrl = macFullUrl ?? '/getting-started/installation';
---
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="bae is a music library for the albums you own, on your phone and desktop, synced through cloud storage you already have. bae is pre-1.0 and not ready for general use." />
<title>bae: your music everywhere</title>
<link rel="icon" type="image/png" href="/app-icon.png" />
<link rel="preload" as="image" href="/sheep.png" fetchpriority="high" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<script is:inline>
  (function(){
    var root=document.documentElement;
    root.classList.remove('no-js');
    root.classList.add('js','is-loading');
    setTimeout(function(){
      if(!root.classList.contains('is-ready')) root.classList.remove('is-loading');
    },2600);
  })();
</script>
<style is:global>
  :root{
    --night:#100e1a; --night-2:#161327; --card:#1c1830; --card-2:#231d3a;
    --cream:#fdf5ef; --fg-dim:rgba(253,245,239,.66); --fg-faint:rgba(253,245,239,.4);
    --violet:#9b6cf6; --violet-deep:#7c4ddb;
    --pink:#f7a8c4; --pink-deep:#ec6a99; --mint:#86e0c8; --amber:#f4c178; --sky:#7fb8f5;
    --line:rgba(253,245,239,.12);
    --disp:"Bricolage Grotesque",system-ui,sans-serif;
    --body:"Hanken Grotesk",system-ui,sans-serif;
    --mono:"JetBrains Mono",monospace;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--night);color:var(--cream);font-family:var(--body);-webkit-font-smoothing:antialiased;overflow-x:hidden;}
  a{color:inherit;text-decoration:none;}
  ::selection{background:var(--pink);color:#3a2230;}
  .wrap{max-width:1140px;margin:0 auto;padding:0 28px;}

  .js.is-loading .r,
  .js.is-ready .r:not(.is-in):not(.is-shown){opacity:0;transform:translateY(22px) scale(.99);will-change:opacity,transform;}
  .js.is-loading .herosheep img,
  .js.is-loading .note,
  .js.is-loading .endcta .ring img,
  .js.is-loading .dwire::before,
  .js.is-loading .core::before{animation-play-state:paused;}
  .r.is-in{animation:pop .85s cubic-bezier(.2,.8,.25,1) both;}
  .r.is-in.d1{animation-delay:.08s;} .r.is-in.d2{animation-delay:.16s;} .r.is-in.d3{animation-delay:.24s;} .r.is-in.d4{animation-delay:.32s;}
  .r.is-shown{opacity:1;transform:none;will-change:auto;}
  @keyframes pop{from{opacity:0;transform:translateY(26px) scale(.985);}to{opacity:1;transform:none;}}
  @media (prefers-reduced-motion: reduce){
    .js.is-loading .r,
    .js.is-ready .r:not(.is-in):not(.is-shown),
    .r.is-shown{opacity:1;transform:none;will-change:auto;}
    .r.is-in{animation:none;}
  }
  @keyframes bob{0%,100%{transform:translateY(0) rotate(-2deg);}50%{transform:translateY(-16px) rotate(2deg);}}
  @keyframes floaty{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}

  /* nav */
  nav{position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(16,14,26,.7);backdrop-filter:blur(14px);border-bottom:1px solid transparent;transition:border-color .3s;}
  nav.scrolled{border-bottom:1px solid var(--line);}
  .navin{display:flex;align-items:center;gap:26px;height:66px;}
  .brand{font-family:var(--disp);font-weight:800;font-size:24px;letter-spacing:-.02em;display:flex;align-items:center;gap:8px;}
  .brand img{width:30px;height:30px;}
  .navlinks{margin-left:auto;display:flex;gap:26px;align-items:center;}
  .navlinks a{font-size:14.5px;color:var(--fg-dim);font-weight:500;white-space:nowrap;}
  .navlinks a:hover{color:var(--cream);}
  .btn{font-family:var(--body);font-size:14.5px;font-weight:600;padding:11px 20px;border-radius:999px;border:1.5px solid var(--line);background:transparent;color:var(--cream);cursor:pointer;transition:transform .22s,border-color .22s,color .22s,background .22s,box-shadow .22s;}
  .btn:hover{border-color:var(--pink);color:var(--pink);}
  .btn.solid{background:var(--violet);border-color:var(--violet);color:#fff;}
  .btn.solid:hover{background:var(--violet-deep);border-color:var(--violet-deep);color:#fff;transform:translateY(-2px);box-shadow:0 12px 30px rgba(155,108,246,.45);}
  .btn.pink{background:var(--pink);border-color:var(--pink);color:#3a2230;}
  .btn.pink:hover{background:var(--pink-deep);border-color:var(--pink-deep);color:#fff;transform:translateY(-2px);box-shadow:0 12px 30px rgba(236,106,153,.4);}
  @media(max-width:560px){
    .navin{gap:12px;}
    .navlinks{gap:14px;}
    .navlinks a{font-size:13.5px;}
  }

  /* hero */
  header.hero{padding:130px 0 70px;position:relative;overflow:hidden;}
  .blob{position:absolute;border-radius:50%;filter:blur(60px);opacity:.5;pointer-events:none;}
  .blob.v{width:520px;height:520px;background:rgba(155,108,246,.4);left:-120px;top:-40px;}
  .blob.p{width:460px;height:460px;background:rgba(247,168,196,.32);right:-120px;top:80px;}
  .heroin{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:30px;align-items:center;}
  .tagpill{display:inline-flex;align-items:center;gap:8px;padding:8px 15px;border-radius:999px;background:var(--card);border:1px solid var(--line);font-family:var(--mono);font-size:11.5px;letter-spacing:.05em;color:var(--fg-dim);margin-bottom:24px;}
  .tagpill .led{width:7px;height:7px;border-radius:50%;background:var(--mint);box-shadow:0 0 8px var(--mint);}
  h1.jumbo{font-family:var(--disp);font-weight:800;font-size:clamp(46px,6.4vw,82px);line-height:.98;letter-spacing:-.03em;margin:0;margin-top:32px;}
  h1.jumbo .pink{color:var(--pink);} h1.jumbo .violet{color:var(--violet);}
  .dek{margin:26px 0 0;font-size:clamp(16px,1.4vw,18.5px);line-height:1.62;color:var(--fg-dim);max-width:48ch;}
  .dek b{color:var(--cream);font-weight:600;}
  .devstatus{position:relative;margin-top:26px;max-width:520px;overflow:hidden;border-radius:18px;border:1px solid rgba(244,193,120,.52);background:linear-gradient(180deg,rgba(244,193,120,.12),rgba(35,29,58,.88));box-shadow:0 18px 42px rgba(0,0,0,.34);}
  .devstatus::before{content:"";display:block;height:8px;background:repeating-linear-gradient(135deg,var(--amber) 0 14px,rgba(58,34,48,.9) 14px 28px);}
  .devstatus-in{display:grid;grid-template-columns:auto 1fr;gap:14px;padding:18px 20px;align-items:start;}
  .devstatus-mark{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:rgba(244,193,120,.16);border:1px solid rgba(244,193,120,.46);color:var(--amber);font-family:var(--mono);font-weight:600;font-size:20px;}
  .devstatus-kicker{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--amber);margin-bottom:6px;}
  .devstatus-led{width:7px;height:7px;border-radius:50%;background:var(--amber);box-shadow:0 0 10px var(--amber);}
  .devstatus strong{display:block;color:var(--cream);font-family:var(--disp);font-size:20px;line-height:1.08;letter-spacing:0;font-weight:700;}
  .devstatus p{margin:7px 0 0;color:var(--fg-dim);font-size:14.5px;line-height:1.5;}
  .cta{display:flex;gap:13px;margin-top:34px;flex-wrap:wrap;align-items:center;}
  .cta .meta{font-family:var(--mono);font-size:12px;color:var(--fg-faint);}

  .herosheep{position:relative;display:grid;place-items:center;}
  .sheepglow{position:absolute;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(247,168,196,.34),rgba(155,108,246,.18) 50%,transparent 72%);}
  .herosheep img{width:min(100%,400px);height:auto;position:relative;animation:bob 6s ease-in-out infinite;filter:drop-shadow(0 24px 50px rgba(155,108,246,.4));}
  @media (prefers-reduced-motion: reduce){.herosheep img{animation:none;}}
  .note{position:absolute;background:var(--card-2);border:1px solid var(--line);border-radius:14px;padding:10px 14px;font-size:12.5px;font-weight:600;box-shadow:0 12px 30px rgba(0,0,0,.4);animation:floaty 5s ease-in-out infinite;}
  .note .s{display:block;font-family:var(--mono);font-size:10.5px;color:var(--fg-faint);font-weight:400;margin-top:2px;}
  .note.one{top:8%;left:-6%;} .note.two{bottom:12%;right:-4%;animation-delay:1.2s;}
  .note .dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;}
  .note.dev{display:flex;align-items:center;gap:9px;}
  .note.dev svg{flex:none;}

  .trust{display:flex;gap:30px;flex-wrap:wrap;margin-top:54px;padding-top:26px;border-top:1px solid var(--line);position:relative;}
  .trust .t{display:flex;flex-direction:column;gap:3px;}
  .trust .t b{font-family:var(--disp);font-weight:700;font-size:23px;}
  .trust .t b .a{color:var(--pink);}
  .trust .t span{font-size:12.5px;color:var(--fg-faint);}

  /* features */
  .sec{padding:84px 0;}
  .center{text-align:center;max-width:620px;margin:0 auto 50px;}
  .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pink);margin-bottom:14px;}
  h2.sech{font-family:var(--disp);font-weight:800;font-size:clamp(32px,4.4vw,52px);letter-spacing:-.025em;margin:0 0 14px;line-height:1.02;}
  .center p{font-size:17px;color:var(--fg-dim);line-height:1.6;margin:0;}
  .cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;}
  .fcard{background:linear-gradient(180deg,var(--card),var(--night-2));border:1px solid var(--line);border-radius:22px;padding:28px;transition:transform .3s,border-color .3s,box-shadow .3s;}
  .fcard:hover{transform:translateY(-5px);border-color:rgba(247,168,196,.5);box-shadow:0 22px 50px rgba(0,0,0,.45);}
  .fcard .top{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;}
  .fcard .emoji{width:52px;height:52px;border-radius:15px;display:grid;place-items:center;}
  .fcard .no{font-family:var(--mono);font-size:12px;color:var(--fg-faint);}
  .fcard h3{font-family:var(--disp);font-weight:700;font-size:21px;letter-spacing:-.01em;margin:0 0 8px;}
  .fcard p{margin:0;font-size:14.5px;line-height:1.6;color:var(--fg-dim);}
  .fcard .tags{margin-top:16px;display:flex;gap:6px;flex-wrap:wrap;}
  .fcard .tags span{font-family:var(--mono);font-size:10.5px;padding:4px 9px;border-radius:999px;background:var(--card-2);color:var(--fg-faint);letter-spacing:.03em;}

  /* how it works diagram */
  .diagram{display:flex;align-items:stretch;gap:0;margin-top:8px;}
  .dnode{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:11px;background:linear-gradient(180deg,var(--card),var(--night-2));border:1px solid var(--line);border-radius:22px;padding:28px 18px;}
  .dnode.dhub{flex:1.18;background:radial-gradient(ellipse at 50% -10%,rgba(134,224,200,.11),transparent 62%),linear-gradient(180deg,var(--card-2),var(--night-2));border-color:rgba(134,224,200,.44);box-shadow:0 0 0 1px rgba(134,224,200,.14),0 18px 50px rgba(134,224,200,.08);animation:cloudGlow 6s ease-in-out infinite;}
  .dico{width:54px;height:54px;border-radius:16px;display:grid;place-items:center;}
  .dico.big{width:64px;height:64px;border-radius:19px;}
  .dname{font-family:var(--disp);font-weight:700;font-size:17px;letter-spacing:-.01em;}
  .dnode.dhub .dname{font-size:19px;}
  .dsub{font-family:var(--mono);font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--fg-faint);}
  .dprov{font-size:11.5px;line-height:1.5;color:var(--fg-dim);max-width:30ch;}
  .dwire{flex:0 0 auto;align-self:center;position:relative;display:grid;place-items:center;min-width:108px;min-height:50px;padding:0 6px;}
  .dwire::before{content:"";position:absolute;left:4px;right:4px;top:50%;height:2px;transform:translateY(-50%);background:repeating-linear-gradient(90deg,rgba(134,224,200,.6) 0 6px,transparent 6px 13px);animation:wireflow .9s linear infinite;}
  .dlock{position:relative;z-index:1;display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--mint);background:var(--night-2);border:1px solid rgba(134,224,200,.4);border-radius:999px;padding:6px 11px;white-space:nowrap;}
  .dlock svg{width:12px;height:12px;flex:none;}
  @keyframes wireflow{to{background-position:13px 0;}}
  @keyframes cloudGlow{0%,100%{border-color:rgba(134,224,200,.38);box-shadow:0 0 0 1px rgba(134,224,200,.12),0 18px 50px rgba(134,224,200,.08);}50%{border-color:rgba(134,224,200,.68);box-shadow:0 0 0 1px rgba(134,224,200,.22),0 24px 60px rgba(134,224,200,.14),0 0 34px rgba(134,224,200,.11);}}
  .dfoot{text-align:center;margin-top:28px;}
  .dfoot a{font-size:13.5px;color:var(--fg-faint);font-weight:500;}
  .dfoot a:hover{color:var(--mint);}
  @media (prefers-reduced-motion: reduce){.dwire::before,.dnode.dhub{animation:none;}}
  @media(max-width:860px){
    .diagram{flex-direction:column;align-items:stretch;}
    .dnode,.dnode.dhub{flex:none;}
    .dwire{width:100%;min-height:58px;}
    .dwire::before{left:50%;right:auto;top:6px;bottom:6px;height:auto;width:2px;transform:translateX(-50%);background:repeating-linear-gradient(0deg,rgba(134,224,200,.6) 0 6px,transparent 6px 13px);animation:wireflowv .9s linear infinite;}
  }
  @keyframes wireflowv{to{background-position:0 13px;}}

  /* engine: native UIs on one Rust core */
  .stack{margin-top:8px;display:flex;flex-direction:column;align-items:stretch;}
  .platerow{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  .plate{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;background:linear-gradient(180deg,var(--card),var(--night-2));border:1px solid var(--line);border-radius:18px;padding:22px 14px;transition:transform .3s,border-color .3s,box-shadow .3s;}
  .plate:hover{transform:translateY(-4px);border-color:rgba(155,108,246,.45);box-shadow:0 18px 40px rgba(0,0,0,.4);}
  .plate svg{width:25px;height:25px;color:var(--cream);}
  .plate b{font-family:var(--disp);font-weight:700;font-size:16px;letter-spacing:-.01em;}
  .legs{display:grid;grid-template-columns:repeat(4,1fr);height:24px;}
  .legs i{justify-self:center;width:2px;height:100%;background:linear-gradient(180deg,transparent,rgba(155,108,246,.55));}
  .core{position:relative;overflow:hidden;border-radius:20px;border:1px solid rgba(155,108,246,.4);background:radial-gradient(ellipse at 50% 130%,rgba(247,168,196,.22),transparent 60%),linear-gradient(180deg,var(--card-2),#191333);padding:26px 28px;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;}
  .core .ctext{display:flex;flex-direction:column;gap:5px;min-width:0;}
  .core .ctitle{font-family:var(--disp);font-weight:800;font-size:clamp(20px,2.6vw,27px);letter-spacing:-.02em;}
  .core .csub{font-family:var(--mono);font-size:11.5px;letter-spacing:.03em;color:var(--fg-dim);}
  .core .ctag{position:relative;z-index:1;font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--violet);border:1px solid rgba(155,108,246,.45);border-radius:999px;padding:8px 14px;white-space:nowrap;}
  .core::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(105deg,transparent 38%,rgba(253,245,239,.1) 50%,transparent 62%);transform:translateX(-130%);animation:sheen 3.6s ease-in-out infinite;}
  @keyframes sheen{0%{transform:translateX(-130%);}60%,100%{transform:translateX(130%);}}
  @media (prefers-reduced-motion: reduce){.core::before{display:none;}}
  .legs-down{display:grid;grid-template-columns:repeat(3,1fr);height:24px;}
  .legs-down i{justify-self:center;width:2px;height:100%;background:linear-gradient(180deg,rgba(155,108,246,.4),rgba(248,177,107,.2));}
  .deprow{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
  .dep{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;text-align:center;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:16px 12px;}
  .dep b{font-family:var(--mono);font-weight:600;font-size:13px;letter-spacing:.02em;color:var(--fg);}
  .dep span{font-family:var(--mono);font-size:11px;letter-spacing:.02em;color:var(--fg-faint);}
  @media(max-width:640px){
    .platerow{grid-template-columns:repeat(2,1fr);}
    /* 4 column-aligned legs don't map onto a 2x2 grid; collapse to one
       centered connector that also gives the plate grid room above the core. */
    .legs{display:flex;justify-content:center;height:28px;}
    .legs i:not(:first-child){display:none;}
    .core{flex-direction:column;align-items:flex-start;gap:14px;}
    .legs-down{display:flex;justify-content:center;}
    .legs-down i:not(:first-child){display:none;}
  }

  /* providers */
  .minigrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .mini{background:linear-gradient(180deg,var(--card),var(--night-2));border:1px solid var(--line);border-radius:18px;padding:24px;transition:transform .3s,border-color .3s,box-shadow .3s;}
  .mini:hover{transform:translateY(-4px);border-color:rgba(247,168,196,.45);box-shadow:0 18px 40px rgba(0,0,0,.4);}
  .mini .mico{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;margin-bottom:15px;}
  .mini h4{font-family:var(--disp);font-weight:700;font-size:17px;letter-spacing:-.01em;margin:0 0 6px;}
  .mini p{margin:0;font-size:13.5px;line-height:1.55;color:var(--fg-dim);}
  @media(max-width:860px){.minigrid{grid-template-columns:1fr;}}

  /* end */
  .endcta{text-align:center;padding:96px 0;}
  .endcta .ring{width:128px;height:128px;margin:0 auto 26px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle,rgba(247,168,196,.3),transparent 70%);}
  .endcta .ring img{width:118px;height:118px;object-fit:contain;animation:bob 6s ease-in-out infinite;}
  .endcta h2{font-family:var(--disp);font-weight:800;font-size:clamp(36px,5.2vw,68px);letter-spacing:-.03em;line-height:1;margin:0 0 16px;}
  .endcta h2 .pink{color:var(--pink);} .endcta h2 .violet{color:var(--violet);}
  /* end-CTA cycling final word ("home" / "everywhere") -- all scoped under .endcta */
  /* No-JS fallback: static "home." keeps the sentence intact.
     JS adds .cyc-on to the h2, which hides the fallback and shows the cycling unit. */
  .endcta h2 .cyc{display:none;white-space:nowrap;}
  .endcta h2.cyc-on .cyc{display:inline;}
  .endcta h2.cyc-on .cyc-fallback{display:none;}

  /* Animated word: inline-block clipped box whose width we tween so the period
     (sibling .cyc-dot) keeps hugging it with no horizontal snap. */
  /* inline-block (for the flip transform) at natural width. No overflow: that
     would move the baseline to the box's bottom edge and drop the word off the
     line. Scramble sets a fixed width itself for stability. */
  .endcta h2 .cyc-word{
    display:inline-block;vertical-align:baseline;
    white-space:nowrap;
  }
  .endcta h2 .cyc-pink{color:var(--pink);}
  .endcta h2 .cyc-violet{color:var(--violet);}
  .endcta h2 .cyc-mint{color:var(--mint);}
  .endcta h2 .cyc-amber{color:var(--amber);}
  .endcta h2 .cyc-sky{color:var(--sky);}
  /* period folded into the cycling unit; cream so it reads as punctuation, not part of the word */
  .endcta h2 .cyc-dot{color:var(--cream);}

  /* typewriter caret -- present only during the type-ahead transition; inherits the word's colour */
  .endcta h2 .cyc-caret{
    display:inline-block;width:.06em;height:.82em;margin-left:.02em;
    vertical-align:-.06em;background:currentColor;border-radius:1px;
    animation:cycBlink 1s steps(1,end) infinite;
  }
  @keyframes cycBlink{0%,49%{opacity:1;}50%,100%{opacity:0;}}

  /* cross-fade helper (also the reduced-motion path) */
  .endcta h2 .cyc-word.cyc-fade{transition:opacity .42s ease;}
  .endcta h2 .cyc-word.cyc-out{opacity:0;}

  /* hidden sizer: inherits the h2 font to measure word widths off-layout */
  .endcta h2 .cyc-sizer{
    position:absolute;left:-9999px;top:0;visibility:hidden;
    white-space:nowrap;pointer-events:none;
  }

  /* Narrow screens: drop the cycling word onto its own line so the headline
     keeps a constant line count. Otherwise the long word wraps and the short
     one does not, shifting everything below on each swap. */
  @media (max-width:860px){
    .endcta h2.cyc-on .cyc{display:block;}
  }

  /* reduced motion: one calm cross-fade only -- no caret blink, no transforms,
     no scramble/flip/shuffle; JS pins the pool to the cross-fade. */
  @media (prefers-reduced-motion: reduce){
    .endcta h2 .cyc-caret{display:none;animation:none;}
    .endcta h2 .cyc-word{transition:opacity .6s ease;}
  }
