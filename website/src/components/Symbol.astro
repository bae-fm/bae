---
// One of the design system's symbols (design/system/assets/Symbols), drawn
// as a mask in the colour of the text around it, or a list of them drawn over
// each other, such as the ring and a mark inside it. `size` is an Android icon
// size, drawn at `--icon-android-<size>`: a role, or `inline`, 1.19 times the
// text beside it, as the design system draws a glyph that leads a line.
const drawings = import.meta.glob<string>('../../../design/system/assets/Symbols/*.svg', {
  query: '?url',
  import: 'default',
  eager: true,
});

export type SymbolSize = 'badge' | 'small' | 'medium' | 'large' | 'inline';

interface Props {
  name: string | string[];
  size: SymbolSize;
  class?: string;
}

const { name, size, class: className } = Astro.props;
const mask = [name]
  .flat()
  .map((one) => {
    const url = drawings[`../../../design/system/assets/Symbols/${one}.svg`];
    if (!url) throw new Error(`the design system has no symbol \`${one}\``);
    return `url("${url}") center / contain no-repeat`;
  })
  .join(', ');
const side = `var(--icon-android-${size})`;
---
<span
  class:list={['symbol', className]}
  aria-hidden="true"
  style={`width:${side};height:${side};-webkit-mask:${mask};mask:${mask}`}
></span>

<style>
  .symbol {
    display: inline-block;
    flex: none;
    background: currentColor;
  }
</style>
