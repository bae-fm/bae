---
// One of the design system's symbols (design/system/assets/Symbols), drawn
// as a mask in the colour of the text around it, `size` pixels square.
const drawings = import.meta.glob<string>('../../../design/system/assets/Symbols/*.svg', {
  query: '?url',
  import: 'default',
  eager: true,
});

interface Props {
  name: string;
  size: number;
  class?: string;
}

const { name, size, class: className } = Astro.props;
const url = drawings[`../../../design/system/assets/Symbols/${name}.svg`];
if (!url) throw new Error(`the design system has no symbol \`${name}\``);
const mask = `url("${url}") center / contain no-repeat`;
---
<span
  class:list={['symbol', className]}
  aria-hidden="true"
  style={`width:${size}px;height:${size}px;-webkit-mask:${mask};mask:${mask}`}
></span>

<style>
  .symbol {
    display: inline-block;
    flex: none;
    background: currentColor;
  }
</style>
