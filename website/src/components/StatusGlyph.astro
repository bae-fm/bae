---
// A tone's status glyph, as the design system's StatusGlyph draws Android's:
// the tone's Material Symbol in the tone's icon colour, info in the accent.
import Symbol from './Symbol.astro';

export type Tone = 'info' | 'success' | 'warning' | 'danger';

interface Props {
  tone: Tone;
  size: number;
}

const SYMBOLS: Record<Tone, string> = {
  info: 'info',
  success: 'check_circle',
  warning: 'error',
  danger: 'error',
};
const { tone, size } = Astro.props;
---
<Symbol name={SYMBOLS[tone]} size={size} class={`status-glyph status-glyph-${tone}`} />

<style>
  :global(.status-glyph-info) { color: var(--accent); }
  :global(.status-glyph-success) { color: var(--success-icon); }
  :global(.status-glyph-warning) { color: var(--warning-icon); }
  :global(.status-glyph-danger) { color: var(--danger-icon); }
</style>
