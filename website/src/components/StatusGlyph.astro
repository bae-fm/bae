---
// A tone's status glyph, as the design system's StatusGlyph draws Android's,
// in the tone's icon colour, info in the accent: the tone's Material Symbol,
// or with `ring` the ring with the tone's mark inside it, which Android's
// notices lead with.
import Symbol, { type SymbolSize } from './Symbol.astro';

export type Tone = 'info' | 'success' | 'warning' | 'danger';

interface Props {
  tone: Tone;
  size: SymbolSize;
  ring?: boolean;
}

const SYMBOLS: Record<Tone, string> = {
  info: 'info',
  success: 'check_circle',
  warning: 'error',
  danger: 'error',
};
const MARKS: Record<Tone, string> = {
  info: 'ring-mark-info',
  success: 'ring-mark-success',
  warning: 'ring-mark-bang',
  danger: 'ring-mark-bang',
};
const { tone, size, ring = false } = Astro.props;
---
<Symbol name={ring ? ['ring', MARKS[tone]] : SYMBOLS[tone]} size={size} class={`status-glyph status-glyph-${tone}`} />

<style>
  :global(.status-glyph-info) { color: var(--accent); }
  :global(.status-glyph-success) { color: var(--success-icon); }
  :global(.status-glyph-warning) { color: var(--warning-icon); }
  :global(.status-glyph-danger) { color: var(--danger-icon); }
</style>
