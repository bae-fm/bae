---
// A download button whose href is resolved at build time to the latest
// versioned release asset for this platform (see ../lib/releases). When that
// platform hasn't shipped yet, it renders as a disabled "coming soon"
// affordance instead of a link to a non-existent asset. Windows ships one
// installer per CPU architecture, so its buttons name an arch instead of an
// edition — it publishes the full edition only.
import { getLatest, type Platform, type Edition, type WindowsArch } from '../lib/releases';

type Props =
  | { platform: Exclude<Platform, 'windows'>; edition: Edition; class?: string }
  | { platform: 'windows'; arch: WindowsArch; class?: string };

const { class: className = 'sl-button' } = Astro.props;
const latest = await getLatest();
const download =
  Astro.props.platform === 'windows'
    ? latest.windows?.[Astro.props.arch]
    : latest[Astro.props.platform]?.[Astro.props.edition];
---

{
  download ? (
    <a href={download.url} class={className}>
      <slot />
    </a>
  ) : (
    <span class={`${className} download-unavailable`} aria-disabled="true">
      <slot /> (coming soon)
    </span>
  )
}
