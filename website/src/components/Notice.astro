---
// A notice, as the design system's notices draw one: a box in its tone's
// notice fill (in dark, the neutral one), the tone's status glyph at the top
// left, level with the first line, then the title, bold over a subtitle, and
// the subtitle in secondary text. Other content goes before the title.
import StatusGlyph, { type Tone } from './StatusGlyph.astro';

interface Props {
  tone: Tone;
  title: string;
  subtitle?: string;
  label?: string;
}

const { tone, title, subtitle, label } = Astro.props;
---
<div class={`notice notice-${tone} web-body`} role="status" aria-label={label}>
  <span class="notice-icon"><StatusGlyph tone={tone} size={17} /></span>
  <div class="notice-body">
    <slot />
    <div class:list={['notice-title', { 'notice-title-strong': subtitle }]}>{title}</div>
    {subtitle && <div class="notice-subtitle">{subtitle}</div>}
  </div>
</div>

<style>
  .notice {
    display: flex;
    align-items: flex-start;
    gap: var(--space-related);
    padding: var(--space-group);
    border-radius: var(--radius-control);
    color: var(--on-notice);
    text-align: start;
    --text-secondary: color-mix(in srgb, var(--on-notice) 72%, transparent);
  }
  .notice-info { background: var(--neutral-tint); }
  .notice-success { background: var(--success-notice); }
  .notice-warning { background: var(--warning-notice); }
  .notice-danger { background: var(--danger-notice); }
  [data-theme="light"] .notice-info { background: var(--accent-tint); }
  .notice-icon { flex: none; display: flex; align-items: center; height: 1lh; }
  .notice-body { flex: 1; min-width: 0; }
  .notice-title-strong { font-weight: var(--type-web-label-weight); }
  .notice-subtitle { color: var(--text-secondary); }
</style>
