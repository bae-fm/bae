---
import '../generated/tokens.css';
import Chip from './Chip.astro';
import Logo from './Logo.astro';
import StatusGlyph from './StatusGlyph.astro';
import Symbol from './Symbol.astro';
import sheepUrl from '../../../design/system/assets/Logos/bae-sheep.svg?url';
import { getLatest } from '../lib/releases';
import { LOCALES, landing, localeInfo, localizePath } from '../lib/site-locales.mjs';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const localeMeta = localeInfo(locale);
const text = landing[locale] ?? landing.en;
const href = (path: string) => localizePath(locale, path);
const localeLinks = LOCALES.map((entry) => ({
  ...entry,
  url: entry.path ? `/${entry.path}/` : '/',
}));
const currentLocaleLabel = localeLinks.find((entry) => entry.code === locale)?.label ?? text.languageLabel;

// Landing CTAs point at the latest macOS build, resolved at build time from the
// newest versioned release. If there's no published macOS build, the CTAs fall
// back to the install page (which lists every platform's state).
const macFullUrl = (await getLatest()).macos?.full?.url;
if (!macFullUrl) {
  console.warn('index: no macOS full build resolved; landing CTAs fall back to the install page');
}
const macUrl = macFullUrl ?? href('/guide/installation');
---
<!DOCTYPE html>
<html lang={localeMeta.lang} dir={localeMeta.dir} class="no-js">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={text.metaDescription} />
<title>{text.title}</title>
<link rel="icon" type="image/svg+xml" sizes="16x16" href="/favicon-16.svg" />
<link rel="icon" type="image/svg+xml" sizes="32x32" href="/favicon-32.svg" />
<link rel="preload" as="image" href={sheepUrl} fetchpriority="high" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Mona+Sans:wght@700;800&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<script is:inline>
  (function(){
    var root=document.documentElement;
    root.classList.remove('no-js');
    root.classList.add('js','is-loading');
    setTimeout(function(){
      if(!root.classList.contains('is-ready')) root.classList.remove('is-loading');
    },2600);
  })();
</script>
<style is:global>
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--background);color:var(--text-primary);font-family:var(--font-web-body);-webkit-font-smoothing:antialiased;overflow-x:hidden;}
  a{color:inherit;text-decoration:none;}
  ::selection{background:var(--accent-pink-selection);color:var(--on-fill);}
  .wrap{max-width:1140px;margin:0 auto;padding:0 var(--space-section);}

  .js.is-loading .r,
  .js.is-ready .r:not(.is-in):not(.is-shown){opacity:0;transform:translateY(22px) scale(.99);will-change:opacity,transform;}
  .js.is-loading .note,
  .js.is-loading .dwire::before{animation-play-state:paused;}
  .r.is-in{animation:pop .85s cubic-bezier(.2,.8,.25,1) both;}
  .r.is-in.d1{animation-delay:.08s;} .r.is-in.d2{animation-delay:.16s;} .r.is-in.d3{animation-delay:.24s;} .r.is-in.d4{animation-delay:.32s;}
  .r.is-shown{opacity:1;transform:none;will-change:auto;}
  @keyframes pop{from{opacity:0;transform:translateY(26px) scale(.985);}to{opacity:1;transform:none;}}
  @media (prefers-reduced-motion: reduce){
    .js.is-loading .r,
    .js.is-ready .r:not(.is-in):not(.is-shown),
    .r.is-shown{opacity:1;transform:none;will-change:auto;}
    .r.is-in{animation:none;}
  }
  @keyframes floaty{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}

  /* nav */
  nav{position:fixed;top:0;left:0;right:0;z-index:50;background:var(--backdrop);backdrop-filter:blur(14px);border-bottom:1px solid transparent;transition:border-color .3s;}
  nav.scrolled{border-bottom:1px solid var(--hairline);}
  .navin{display:flex;align-items:center;gap:var(--space-section);height:66px;}
  .brand{flex:none;}
  .navlinks{margin-inline-start:auto;display:flex;gap:var(--space-group);align-items:center;min-width:0;}
  .navlinks a{color:var(--text-secondary);white-space:nowrap;}
  .navlinks a:hover{color:var(--text-primary);}
  .desktoplinks{display:flex;gap:var(--space-section);align-items:center;}
  .navlinks .btn.pink{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px;}
  .navpopup{position:relative;flex:none;}
  .navpopup summary{list-style:none;}
  .navpopup summary::-webkit-details-marker{display:none;}
  /* An icon button, as Android's: the symbol in the text colour on no fill, a state layer under the pointer. */
  .iconbtn{width:var(--size-android-hit-target);height:var(--size-android-hit-target);border-radius:999px;background:transparent;display:grid;place-items:center;cursor:pointer;color:var(--text-primary);transition:background .22s;}
  .iconbtn:hover,.navpopup[open] > .iconbtn{background:var(--hover);}
  .iconbtn:focus-visible,.btn:focus-visible{outline:2px solid var(--accent-pink);outline-offset:3px;}
  .languagebtn{display:flex;align-items:center;gap:var(--space-inline);max-width:170px;}
  .languagebtn span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .menubtn{display:none;}
  .navpanel,.langpanel{position:absolute;top:calc(100% + var(--space-group));right:0;width:min(320px,calc(100vw - 56px));padding:var(--space-group);border:1px solid var(--hairline);border-radius:var(--radius-panel);background:var(--elevated);backdrop-filter:blur(18px);box-shadow:0 24px 70px var(--shadow);}
  html[dir="rtl"] .navpanel,html[dir="rtl"] .langpanel{left:0;right:auto;direction:rtl;}
  .menulinks{display:grid;gap:var(--space-inline);margin-bottom:var(--space-field-inset);padding-bottom:var(--space-field-inset);border-bottom:1px solid var(--hairline);}
  .menulinks a,.langmenu a,.languageitem{display:flex;align-items:center;justify-content:space-between;gap:var(--space-group);border-radius:var(--radius-control);padding:var(--space-field-inset) var(--space-group);color:var(--text-secondary);}
  .menulinks a:hover,.langmenu a:hover,.languageitem:hover{background:var(--hover);color:var(--text-primary);}
  .menulang summary{list-style:none;}
  .menulang summary::-webkit-details-marker{display:none;}
  .languageitem{cursor:pointer;}
  .languageitem .languagemark{color:var(--text-tertiary);transition:transform .18s;}
  .menulang[open] .languageitem .languagemark{transform:rotate(180deg);}
  .langtitle{text-transform:uppercase;color:var(--text-tertiary);padding:var(--space-line) var(--space-group) var(--space-related);}
  .langmenu{display:grid;grid-template-columns:1fr;gap:var(--space-line);max-height:min(52vh,390px);overflow:auto;padding-right:var(--space-line);}
  .langmenu a[aria-current="true"]{background:var(--accent-orchid-selection);color:var(--on-fill);}
  /* Buttons as the design system draws them, as Android's: 40px tall, the action a page is for in the accent's deep fill under white words, any other outlined beside it, each with a state layer under the pointer. */
  .btn{display:inline-flex;align-items:center;padding:var(--space-field-inset) var(--space-section);border-radius:999px;border:0;background:transparent;box-shadow:inset 0 0 0 1px var(--text-secondary);color:var(--text-primary);cursor:pointer;transition:background .22s;}
  .btn:hover,.navpopup[open] > .btn{background:var(--hover);}
  .btn.pink{background:var(--accent-pink-selection);box-shadow:none;color:var(--on-fill);}
  .btn.pink:hover{background:linear-gradient(var(--hover),var(--hover)),var(--accent-pink-selection);}
  @media(max-width:760px){
    .desktoplinks,.desktoplang{display:none;}
    .menubtn{display:grid;}
    .navlinks .btn.pink{max-width:min(42vw,180px);}
    .menulang{border-bottom:0;}
    .menulang .langmenu{margin-top:var(--space-inline);padding:0 var(--space-line) 0 0;}
  }
  @media(max-width:560px){
    .navin{gap:var(--space-group);}
    .wrap{padding:0 var(--space-edge);}
    .navlinks{gap:var(--space-related);}
    .navlinks .btn.pink{padding:var(--space-field-inset) var(--space-edge);max-width:38vw;}
    .navpanel{width:calc(100vw - 2 * var(--space-edge));right:calc(-1 * var(--space-related));}
  }

  /* hero */
  header.hero{padding:130px 0 70px;position:relative;overflow:hidden;}
  .heroin{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:var(--space-page);align-items:center;}
  h1.jumbo{margin:0;margin-top:var(--space-page);}
  h1.jumbo .pink{color:var(--accent-pink);} h1.jumbo .violet{color:var(--accent-orchid);}
  .dek{margin:var(--space-section) 0 0;color:var(--text-secondary);max-width:48ch;}
  .dek b{color:var(--text-primary);font-weight:var(--type-web-label-weight);}
  .devstatus{position:relative;margin-top:var(--space-section);max-width:520px;overflow:hidden;border-radius:var(--radius-panel);border:1px solid color-mix(in srgb, var(--warning) calc(var(--opacity-tint-strong) * 100%), transparent);background:linear-gradient(180deg,color-mix(in srgb, var(--warning) calc(var(--opacity-tint) * 100%), transparent),var(--elevated));box-shadow:0 18px 42px var(--shadow);}
  .devstatus::before{content:"";display:block;height:8px;background:repeating-linear-gradient(135deg,var(--warning) 0 14px,var(--background) 14px 28px);}
  .devstatus-in{display:grid;grid-template-columns:auto 1fr;gap:14px;padding:18px 20px;align-items:start;}
  .devstatus-mark{width:42px;height:42px;border-radius:var(--radius-card);display:grid;place-items:center;background:color-mix(in srgb, var(--warning) calc(var(--opacity-tint) * 100%), transparent);border:1px solid color-mix(in srgb, var(--warning) calc(var(--opacity-tint-strong) * 100%), transparent);color:var(--warning);font-family:var(--font-web-mono);font-weight:600;font-size:20px;}
  .devstatus-kicker{display:flex;align-items:center;gap:var(--space-related);font-family:var(--font-web-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--warning);margin-bottom:var(--space-compact);}
  .devstatus-led{width:7px;height:7px;border-radius:50%;background:var(--warning);box-shadow:0 0 10px var(--warning);}
  .devstatus strong{display:block;color:var(--text-primary);font-family:var(--font-web-display);font-size:20px;line-height:1.08;letter-spacing:0;font-weight:700;}
  .devstatus p{margin:7px 0 0;color:var(--text-secondary);font-size:14.5px;line-height:1.5;}
  .cta{display:flex;gap:var(--space-group);margin-top:var(--space-page);flex-wrap:wrap;align-items:center;}
  .cta .meta{color:var(--text-tertiary);}
  .hero .cta .meta{margin-left:var(--space-related);}

  .herosheep{position:relative;display:grid;place-items:center;}
  .note{position:absolute;background:var(--elevated);border:1px solid var(--hairline);border-radius:var(--radius-card);padding:var(--space-field-inset) var(--space-group);box-shadow:0 12px 30px var(--shadow);animation:floaty 5s ease-in-out infinite;}
  .note .notehead{display:flex;align-items:center;gap:var(--space-compact);}
  .note .s{display:block;color:var(--text-tertiary);margin-top:var(--space-line);}
  .note.one{top:8%;left:-6%;} .note.two{bottom:12%;right:-4%;animation-delay:1.2s;}

  .trust{display:flex;gap:var(--space-page);flex-wrap:wrap;margin-top:var(--space-page);padding-top:var(--space-section);border-top:1px solid var(--hairline);position:relative;}
  .trust .t{display:flex;flex-direction:column;gap:var(--space-line);}
  .trust .t span{color:var(--text-tertiary);}

  /* features */
  .sec{padding:84px 0;}
  .center{text-align:center;max-width:620px;margin:0 auto 50px;}
  .eyebrow{text-transform:uppercase;color:var(--accent-pink);margin-bottom:var(--space-group);}
  h2.sech{margin:0 0 var(--space-group);}
  .center p{color:var(--text-secondary);margin:0;}
  .cards{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-edge);}
  .fcard{background:var(--surface);border:1px solid var(--hairline);border-radius:var(--radius-panel);padding:var(--space-section);}
  .fcard .top{margin-bottom:var(--space-edge);}
  .fcard .no{color:var(--text-tertiary);}
  .fcard h3{margin:0 0 var(--space-related);}
  .fcard p{margin:0;color:var(--text-secondary);}
  .fcard .tags{margin-top:var(--space-edge);display:flex;gap:var(--space-compact);flex-wrap:wrap;}

  /* how it works diagram */
  .diagram{display:flex;align-items:stretch;gap:0;margin-top:var(--space-related);}
  .dnode{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:var(--space-field-inset);background:var(--surface);border:1px solid var(--hairline);border-radius:var(--radius-panel);padding:var(--space-section) var(--space-edge);}
  .dnode.dhub{flex:1.18;background:var(--elevated);border-color:var(--accent-mint);}
  .dsub{text-transform:uppercase;color:var(--text-tertiary);}
  .dprov{color:var(--text-secondary);max-width:30ch;}
  .dwire{flex:0 0 auto;align-self:center;position:relative;display:grid;place-items:center;min-width:108px;min-height:50px;padding:0 var(--space-compact);}
  .dwire::before{content:"";position:absolute;left:var(--space-inline);right:var(--space-inline);top:50%;height:2px;transform:translateY(-50%);background:repeating-linear-gradient(90deg,color-mix(in srgb, var(--accent-mint) calc(var(--opacity-tint-strong) * 100%), transparent) 0 6px,transparent 6px 13px);animation:wireflow .9s linear infinite;}
  /* The label sits on the page's colour, so the wire stops at its edges. */
  .dlabel{position:relative;z-index:1;display:inline-flex;border-radius:var(--radius-chip);background:var(--background);}
  @keyframes wireflow{to{background-position:13px 0;}}
  html[dir="rtl"] .dwire::before{animation-name:wireflowrtl;}
  @keyframes wireflowrtl{to{background-position:-13px 0;}}
  .dfoot{text-align:center;margin-top:var(--space-section);}
  .dfoot a{color:var(--text-tertiary);}
  .dfoot a:hover{color:var(--accent-mint);}
  @media (prefers-reduced-motion: reduce){.dwire::before{animation:none;}}
  @media(max-width:860px){
    .diagram{flex-direction:column;align-items:stretch;}
    .dnode,.dnode.dhub{flex:none;}
    .dwire{width:100%;min-height:58px;}
    .dwire::before{left:50%;right:auto;top:var(--space-compact);bottom:var(--space-compact);height:auto;width:2px;transform:translateX(-50%);background:repeating-linear-gradient(0deg,color-mix(in srgb, var(--accent-mint) calc(var(--opacity-tint-strong) * 100%), transparent) 0 6px,transparent 6px 13px);animation:wireflowv .9s linear infinite;}
  }
  @keyframes wireflowv{to{background-position:0 13px;}}

  /* engine: native UIs on one Rust core */
  .stack{margin-top:var(--space-related);display:flex;flex-direction:column;align-items:stretch;}
  .platerow{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-group);}
  .plate{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:var(--surface);border:1px solid var(--hairline);border-radius:var(--radius-panel);padding:var(--space-section) var(--space-group);}
  .legs{display:grid;grid-template-columns:repeat(4,1fr);height:var(--space-section);}
  .legs i{justify-self:center;width:2px;height:100%;background:linear-gradient(180deg,transparent,color-mix(in srgb, var(--accent-orchid) calc(var(--opacity-tint-strong) * 100%), transparent));}
  .core{border-radius:var(--radius-panel);border:1px solid var(--accent-orchid);background:var(--elevated);padding:var(--space-section);display:flex;align-items:center;justify-content:space-between;gap:var(--space-edge);flex-wrap:wrap;}
  .core .ctext{display:flex;flex-direction:column;gap:var(--space-inline);min-width:0;}
  .core .csub{color:var(--text-secondary);}
  .legs-down{display:grid;grid-template-columns:repeat(3,1fr);height:var(--space-section);}
  .legs-down i{justify-self:center;width:2px;height:100%;background:linear-gradient(180deg,color-mix(in srgb, var(--accent-orchid) calc(var(--opacity-tint-strong) * 100%), transparent),color-mix(in srgb, var(--warning) calc(var(--opacity-tint) * 100%), transparent));}
  .deprow{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-group);}
  .dep{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:var(--space-inline);text-align:center;background:var(--surface);border:1px solid var(--hairline);border-radius:var(--radius-card);padding:var(--space-edge) var(--space-group);}
  .dep b{color:var(--text-primary);}
  .dep span{color:var(--text-tertiary);}
  @media(max-width:640px){
    .platerow{grid-template-columns:repeat(2,1fr);}
    /* 4 column-aligned legs don't map onto a 2x2 grid; collapse to one
       centered connector that also gives the plate grid room above the core. */
    .legs{display:flex;justify-content:center;height:var(--space-section);}
    .legs i:not(:first-child){display:none;}
    .core{flex-direction:column;align-items:flex-start;gap:var(--space-group);}
    .legs-down{display:flex;justify-content:center;}
    .legs-down i:not(:first-child){display:none;}
  }

  /* providers */
  .minigrid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-edge);}
  .mini{background:var(--surface);border:1px solid var(--hairline);border-radius:var(--radius-panel);padding:var(--space-section);}
  .mini h4{margin:0 0 var(--space-compact);}
  .mini p{margin:0;color:var(--text-secondary);}
  @media(max-width:860px){.minigrid{grid-template-columns:1fr;}}

  /* end */
  .endcta{text-align:center;padding:96px 0;}
  .endcta .sheep{display:flex;justify-content:center;margin-bottom:var(--space-section);}
  .endcta h2{margin:0 0 var(--space-edge);}
  .endcta h2 .pink{color:var(--accent-pink);} .endcta h2 .violet{color:var(--accent-orchid);}
  /* end-CTA cycling final word ("home" / "everywhere") -- all scoped under .endcta */
  /* No-JS fallback: static "home." keeps the sentence intact.
     JS adds .cyc-on to the h2, which hides the fallback and shows the cycling unit. */
  .endcta h2 .cyc{display:none;white-space:nowrap;}
  .endcta h2.cyc-on .cyc{display:inline;}
  .endcta h2.cyc-on .cyc-fallback{display:none;}

  /* Animated word: inline-block clipped box whose width we tween so the period
     (sibling .cyc-dot) keeps hugging it with no horizontal snap. */
  /* inline-block (for the flip transform) at natural width. No overflow: that
     would move the baseline to the box's bottom edge and drop the word off the
     line. Scramble sets a fixed width itself for stability. */
  .endcta h2 .cyc-word{
    display:inline-block;vertical-align:baseline;
    white-space:nowrap;
  }
  .endcta h2 .cyc-pink{color:var(--accent-pink);}
  .endcta h2 .cyc-violet{color:var(--accent-orchid);}
  .endcta h2 .cyc-mint{color:var(--accent-mint);}
  .endcta h2 .cyc-amber{color:var(--warning);}
  .endcta h2 .cyc-sky{color:var(--accent-sky);}
  /* period folded into the cycling unit; cream so it reads as punctuation, not part of the word */
  .endcta h2 .cyc-dot{color:var(--text-primary);}

  /* typewriter caret -- present only during the type-ahead transition; inherits the word's colour */
  .endcta h2 .cyc-caret{
    display:inline-block;width:.06em;height:.82em;margin-left:.02em;
    vertical-align:-.06em;background:currentColor;border-radius:var(--radius-bar);
    animation:cycBlink 1s steps(1,end) infinite;
  }
  @keyframes cycBlink{0%,49%{opacity:1;}50%,100%{opacity:0;}}

  /* cross-fade helper (also the reduced-motion path) */
  .endcta h2 .cyc-word.cyc-fade{transition:opacity .42s ease;}
  .endcta h2 .cyc-word.cyc-out{opacity:0;}

  /* hidden sizer: inherits the h2 font to measure word widths off-layout */
  .endcta h2 .cyc-sizer{
    position:fixed;left:0;top:0;visibility:hidden;
    white-space:nowrap;pointer-events:none;
  }

  /* Narrow screens: drop the cycling word onto its own line so the headline
     keeps a constant line count. Otherwise the long word wraps and the short
     one does not, shifting everything below on each swap. */
  @media (max-width:860px){
    .endcta h2.cyc-on .cyc{display:block;}
  }

  /* reduced motion: one calm cross-fade only -- no caret blink, no transforms,
     no scramble/flip/shuffle; JS pins the pool to the cross-fade. */
  @media (prefers-reduced-motion: reduce){
    .endcta h2 .cyc-caret{display:none;animation:none;}
    .endcta h2 .cyc-word{transition:opacity .6s ease;}
  }
  .endcta p{color:var(--text-secondary);margin:0 0 var(--space-page);}

  footer{border-top:1px solid var(--hairline);padding:42px 0;display:flex;justify-content:space-between;align-items:center;gap:var(--space-edge);flex-wrap:wrap;}
  footer .links{display:flex;gap:var(--space-section);flex-wrap:wrap;}
  footer a{color:var(--text-secondary);} footer a:hover{color:var(--accent-pink);}
  footer .cp{color:var(--text-tertiary);}

  @media(max-width:860px){.heroin{grid-template-columns:1fr;}.herosheep{order:-1;}.cards{grid-template-columns:1fr;}header.hero{padding-bottom:24px;}.sec{padding:52px 0;}}
  @media(max-width:560px){
    .heroin{gap:42px;}
    .dek{margin-top:var(--space-page);}
    .hero .cta{justify-content:center;}
    .cta{margin-top:46px;gap:var(--space-edge);}
    .cta .meta{flex-basis:100%;text-align:center;margin-top:var(--space-line);}
    .devstatus-in{grid-template-columns:1fr;gap:var(--space-group);}
    .devstatus-mark{width:38px;height:38px;}
    .hero .cta .meta{margin-left:0;}
    .trust{flex-direction:column;align-items:center;gap:var(--space-section);margin-top:var(--space-page);padding-top:var(--space-page);padding-bottom:var(--space-page);border-bottom:1px solid var(--hairline);}
    .trust .t{align-items:center;text-align:center;gap:var(--space-inline);}
    .trust .t span{color:var(--text-secondary);}
  }
</style>
</head>
<body>
<nav id="nav"><div class="wrap navin">
  <span class="brand"><Logo kind="inline" size={40} /></span>
  <div class="navlinks">
    <div class="desktoplinks">
