bae-ios/BaeBridgeFFI-ios.xcframework/

# Android (generated by build-android.sh)
bae-bridge/kotlin-bindings/
bae-android/app/src/main/jniLibs/
bae-android/debug-symbols/
bae-android/local.properties

# OAuth client credentials — the app's own registered OAuth client id +
# redirect URI per provider. Never committed (your credentials, not bae's).
# See notes/mobile-oauth.md.
bae-ios/bae/bae/oauth-creds.json
bae-android/app/src/main/assets/oauth-creds.json
bae-windows/oauth-creds.json
bae-android/.gradle/
bae-android/app/build/
bae-android/build/

# Build output
build/
bae-macos/bae/build/
bae-macos/bae/.build/

# Local working files
plans/
samples/

# Agent instructions (machine-local, rules now enforced via GH Actions)
CLAUDE.md
AGENTS.md

# Cross-compiled FFmpeg for mobile (regenerated by scripts/build-ffmpeg-{android,ios}.sh)
/third_party/ffmpeg-src/
/third_party/ffmpeg-android/
/third_party/ffmpeg-ios/

