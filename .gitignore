# Worktrees
.worktrees/

# Rust local installation
.rustup/
.cargo/*
# But keep config.toml for project-specific build configuration
!.cargo/config.toml

# Rust build artifacts
target/
target-macos/
target-ios/
target-android/
target-windows/
target-iso/
**/*.rs.bk

# IDE specific files
.idea/
.vscode/
.claude/
.cursor/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# Node
node_modules/

# Website build artifacts
website/dist/
website/.astro/
website/.vercel/

# Development environment
.env

# But keep example file
!.env.example

plants/

# BaeKit shared Swift package: the generated bridge bindings (installed by
# build-{macos,ios}.sh via install-swift-bindings.sh), the relocated xcframework
# outputs, the SPM compilation-conditions file, and swift build's local scratch.
BaeKit/Sources/BaeBridge/bae_bridge_*.swift
BaeKit/Frameworks/
BaeKit/.build/
BaeKit/.swiftpm/
BaeKit/Package.resolved

# macOS app (generated by xcodegen / build-macos.sh)
bae-macos/bae/bae.xcodeproj/
bae-macos/bae/bae/Info.plist
bae-bridge/swift-bindings/
bae-bridge/swift-bindings-macos/
# Localization String Catalog (loc-gen emit) and scratch emit directories
bae-macos/bae/bae/Core.xcstrings
bae-bridge/loc/generated/
# Android localization resources (loc-gen emit; copied into res/ by build-android.sh)
bae-android/app/src/main/res/values/core_strings.xml
bae-android/app/src/main/res/values-*/core_strings.xml
# Machine-specific signing team (DEVELOPMENT_TEAM), not committed
bae-macos/bae/Signing.local.xcconfig
# Swift compilation conditions derived from the bridge's cargo feature set
# (generated by build-macos.sh)
bae-macos/bae/Features.xcconfig

# sourcekit-lsp / xcode-build-server (local IDE config, machine-specific paths)
buildServer.json
bae-macos/bae/buildServer.json
bae-macos/bae/.compile

# iOS app (generated by xcodegen / build-ios.sh)
bae-ios/bae/bae.xcodeproj/
bae-bridge/swift-bindings-ios/
# Localization String Catalog (loc-gen emit)
bae-ios/bae/bae/Core.xcstrings
# Swift compilation conditions derived from the bridge's cargo feature set
# (generated by build-ios.sh)
bae-ios/bae/Features.xcconfig

# Android (generated by build-android.sh) — one bindings dir per edition: full
# carries the OAuth functions, baeium does not.
bae-bridge/kotlin-bindings-full/
bae-bridge/kotlin-bindings-baeium/
bae-android/app/src/main/jniLibs/
bae-android/debug-symbols/
bae-android/local.properties

# C# bindings for the Avalonia app, generated by build-windows.sh /
# build-linux.sh — one dir per edition: full carries the OAuth functions,
# baeium does not.
bae-bridge/csharp-bindings-full/
bae-bridge/csharp-bindings-baeium/

# OAuth client credentials — the app's own registered OAuth client id +
# redirect URI per provider. Never committed (your credentials, not bae's).
# See notes/mobile-oauth.md.
bae-ios/bae/bae/oauth-creds.json
bae-android/app/src/full/assets/oauth-creds.json
bae-android/.gradle/
bae-android/app/build/
bae-android/build/

# Build output
bae-macos/bae/build/
bae-macos/bae/.build/
# iOS derivedData (mirrors the macOS project dir; -derivedDataPath .build/derivedData)
bae-ios/bae/.build/

# Local working files
plans/
samples/

# Agent instructions (machine-local, rules now enforced via GH Actions)
CLAUDE.md
AGENTS.md

# Prebuilt FFmpeg downloaded from the bae-ffmpeg fork: dist/ (this host's
# macOS/Linux libs, via scripts/setup-ffmpeg.sh) and ios/ + android/ (the
# cross-compiled mobile libs, via scripts/build-ffmpeg-{ios,android}.sh). The
# whole dir is downloaded output, never source, and a new worktree symlinks it
# from the main checkout (post-checkout hook); ignoring the path without a
# trailing slash covers both the real directory and that symlink.
/bae-ffmpeg

# Coverage/profiling + Kotlin build cache artifacts
*.profraw
bae-android/.kotlin/
bae-ios/.build/
