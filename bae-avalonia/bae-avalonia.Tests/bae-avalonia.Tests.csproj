<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Smoke test for the Avalonia skeleton: it references the app itself, so it
    compiles against the same generated uniffi bindings, and calls through them
    into the native bridge library. That library has to be on the loader path
    (PATH on Windows, LD_LIBRARY_PATH on Linux, DYLD_LIBRARY_PATH on macOS)
    under the name the bindings import, uniffi_bae_bridge. No window opens.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bae.Desktop.Tests</RootNamespace>
    <!-- The app targets net8.0; run the tests on whatever shared runtime the host
         has (macOS dev boxes may only carry a newer major). No-op on CI, which
         installs the 8.0.x runtime. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../bae-avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
