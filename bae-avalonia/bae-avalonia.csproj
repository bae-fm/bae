<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia desktop app skeleton for Windows and Linux (x64/arm64), both
    editions: startup, single-instancing, crash capture, telemetry, the Velopack
    updater, and one window over the generated uniffi C# bindings. The desktop
    UI is not built here. This project is C#, not a cargo crate, so it is
    deliberately outside the Rust workspace.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bae.Desktop</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The generated uniffi bindings use pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- CS0168/CS0219: unused local variables promoted to errors — an unused
         local is dead code or a dropped result, not a style nit.
         IDE0051/IDE0052 (unused private members) are enforced via
         .editorconfig when EnforceCodeStyleInBuild=true is passed at build. -->
    <WarningsAsErrors>CS0168;CS0219</WarningsAsErrors>
    <!-- The smoke test lives in a sibling SDK project; keep its sources out of
         the app build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bae-avalonia.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <!--
      Installer + auto-update (cross-platform). Drives the in-app
      check/download/apply from the GitHub release assets; the vpk CLI that packs
      the release must match this version exactly.
    -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!--
      Crash reporting. The managed SDK reports the exceptions the unhandled-
      exception hooks catch; the native handler it is configured alongside
      (sentry-native + crashpad, shipped beside the executable by the release
      lane) is what survives a crash the runtime never gets to report.
    -->
    <PackageReference Include="Sentry" Version="6.6.0" />
  </ItemGroup>

  <!--
    The generated uniffi C# bindings (per edition, gitignored). Built by
    bae-bridge/build-linux.sh / build-windows.sh into csharp-bindings-<edition>;
    BridgeBindingsDir selects which edition compiles in. The app compiles only
    against generated bindings, so a build without them fails on the missing
    types rather than producing an app with no bridge.
  -->
  <PropertyGroup>
    <BridgeBindingsDir Condition="'$(BridgeBindingsDir)' == ''">..\bae-bridge\csharp-bindings-full</BridgeBindingsDir>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(BridgeBindingsDir)').Contains('csharp-bindings-full'))">
    <DefineConstants>$(DefineConstants);BAE_FULL_BRIDGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildProjectDirectory)\$(BridgeBindingsDir)\**\*.cs" Link="GeneratedBridge\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The diagnostics credentials, baked into the assembly at build from the
    release environment and read back through AppMetadata. A build that supplies
    none of them (every dev build) reads them all as absent, which is what turns
    the telemetry sink and the crash reporter off.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>bae-avalonia.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BaeDatadogSite</_Parameter1>
      <_Parameter2>$(BAE_DATADOG_SITE)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BaeDatadogClientToken</_Parameter1>
      <_Parameter2>$(BAE_DATADOG_CLIENT_TOKEN)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BaeEnvironment</_Parameter1>
      <_Parameter2>$(BAE_ENVIRONMENT)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BaeGitCommit</_Parameter1>
      <_Parameter2>$(BAE_GIT_COMMIT)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BaeSentryDsn</_Parameter1>
      <_Parameter2>$(BAE_SENTRY_DSN)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
