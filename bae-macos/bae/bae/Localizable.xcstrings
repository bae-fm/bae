    "You will not be able to recover this library without a restore code.": {
      "comment": "Welcome screen: confirmation dialog message for removing a keychain restore entry",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will not be able to recover this library without a restore code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrás recuperar esta biblioteca sin un código de restauración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez pas récupérer cette bibliothèque sans code de restauration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Wiederherstellungscode kannst du diese Bibliothek nicht wiederherstellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não conseguirá recuperar esta biblioteca sem um código de restauração."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元コードがないと、このライブラリを復元できなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有恢复代码，你将无法恢复此库。"
