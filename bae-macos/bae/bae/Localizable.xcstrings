    "Metadata only — pressing fields stay blank; just the album group is recorded.": {
      "comment": "Import confirm: note under the toggle when Metadata only is chosen",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata only — pressing fields stay blank; just the album group is recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo metadatos — los campos del prensaje quedan en blanco; solo se registra el grupo del álbum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées seules — les champs du pressage restent vides ; seul le groupe d'album est enregistré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Metadaten — Pressungsfelder bleiben leer; nur die Albumgruppe wird erfasst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente metadados — os campos de prensagem ficam em branco; apenas o grupo do álbum é registrado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータのみ — プレス欄は空欄のまま、アルバムグループだけが記録されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅元数据 — 压制版字段留空，仅记录专辑组。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيانات الوصفية فقط — تبقى حقول الطبعة فارغة؛ يُسجَّل مجموعة الألبوم فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מטא-נתונים בלבד — שדות התקליט נשארים ריקים; נרשמת רק קבוצת האלבום."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише метадані — поля видання залишаються порожніми; записується лише група альбому."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само метаданни — полетата за издание остават празни; записва се само групата на албума."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko metadane — pola tłoczenia pozostają puste; zapisywana jest jedynie grupa albumu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze metadata — pole lisu zůstanou prázdná; zaznamená se jen skupina alba."
          }
        },
        "hr": {
