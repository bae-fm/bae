        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả một thư mục để nhập, không phải tệp"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep een map om te importeren, geen bestand"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयात के लिए फोल्डर छोड़ें, फाइल नहीं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমদানির জন্য ফোল্ডার ছাড়ুন, ফাইল নয়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்பை அல்ல, இறக்குமதி செய்ய கோப்புறையை விடவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దిగుమతి కోసం ఫోల్డర్‌ను వదలండి, ఫైల్‌ను కాదు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आयात करण्यासाठी फोल्डर सोडा, फाईल नाही"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درآمد کے لیے پوشہ چھوڑیں، مسل نہیں"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આયાત કરવા ફોલ્ડર છોડો, ફાઇલ નહીં"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಮದು ಮಾಡಲು ಫೋಲ್ಡರ್ ಬಿಡಿ, ಫೈಲ್ ಅಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇറക്കുമതി ചെയ്യാൻ ഫോൾഡർ വിടുക, ഫയൽ അല്ല"
          }
        },
        "pa": {
