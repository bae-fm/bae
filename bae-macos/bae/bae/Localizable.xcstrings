    "Are you sure you want to delete this release? This cannot be undone.": {
      "comment": "Album detail: delete-release confirmation message",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this release? This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar esta edición? Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer cette édition ? Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du diese Veröffentlichung wirklich löschen? Das kann nicht rückgängig gemacht werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir este lançamento? Isso não pode ser desfeito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリースを削除してもよろしいですか？この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除此版本吗？此操作无法撤销。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من حذف هذا الإصدار؟ لا يمكن التراجع عن هذا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק את המהדורה הזו? לא ניתן לבטל פעולה זו."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити цей реліз? Цю дію не можна скасувати."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигурни ли сте, че искате да изтриете това издание? Действието е необратимо."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pewno usunąć to wydanie? Tej operacji nie można cofnąć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete toto vydání smazat? Akci nelze vrátit zpět."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste li sigurni da želite izbrisati ovo izdanje? Ovo se ne može poništiti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴리스를 삭제할까요? 되돌릴 수 없습니다."
          }
        }
      }
    },
