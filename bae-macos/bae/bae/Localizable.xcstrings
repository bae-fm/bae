            "value" : "Die Dateien des Kandidaten und die Zuordnungen bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The candidate files and mapping choices will remain unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos del candidato y las opciones de asignación no cambiarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers du candidat et les choix de correspondance resteront inchangés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובצי המועמד ובחירות המיפוי יישארו ללא שינוי."
          }
        },
        "hr" : {
          "stringUnit" : {
