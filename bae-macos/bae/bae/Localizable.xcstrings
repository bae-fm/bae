    "Restore codes saved by your other devices signed in to this Apple Account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رموز الاستعادة التي حفظتها أجهزتك الأخرى المسجّل دخولها إلى حساب Apple هذا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кодове за възстановяване, запазени от другите ви устройства, влезли в този акаунт в Apple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kódy pro obnovení uložené vašimi dalšími zařízeními přihlášenými k tomuto Apple účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendannelseskoder gemt af dine andre enheder, der er logget ind på denne Apple-konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
