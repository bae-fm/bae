    "Arrange the selected folders in playback order. Source files stay where they are." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrange the selected folders in playback order. Source files stay where they are."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رتّب المجلدات المحددة حسب ترتيب التشغيل. تبقى الملفات المصدر في مكانها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подредете избраните папки по ред на възпроизвеждане. Изходните файлове остават на място."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seřaďte vybrané složky podle pořadí přehrávání. Zdrojové soubory zůstanou na místě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arranger de valgte mapper i afspilningsrækkefølge. Kildefilerne bliver, hvor de er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordne die ausgewählten Ordner in der Wiedergabereihenfolge an. Die Quelldateien bleiben an ihrem Ort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τακτοποιήστε τους επιλεγμένους φακέλους με τη σειρά αναπαραγωγής. Τα αρχεία προέλευσης παραμένουν εκεί που είναι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordena las carpetas seleccionadas por orden de reproducción. Los archivos de origen permanecen en su ubicación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestä valitut kansiot toistojärjestykseen. Lähdetiedostot pysyvät paikoillaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classez les dossiers sélectionnés dans l’ordre de lecture. Les fichiers sources restent à leur emplacement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סדר את התיקיות שנבחרו לפי סדר ההשמעה. קובצי המקור יישארו במקומם."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poredaj odabrane mape prema redoslijedu reprodukcije. Izvorne datoteke ostaju na svojem mjestu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendezd a kijelölt mappákat lejátszási sorrendbe. A forrásfájlok a helyükön maradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordina le cartelle selezionate secondo l’ordine di riproduzione. I file di origine rimangono al loro posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォルダを再生順に並べてください。元のファイルは移動しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 폴더를 재생 순서대로 정렬하세요. 원본 파일은 그대로 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordne de valgte mappene i avspillingsrekkefølge. Kildefilene blir liggende der de er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de geselecteerde mappen in afspeelvolgorde. De bronbestanden blijven op hun plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ułóż wybrane foldery w kolejności odtwarzania. Pliki źródłowe pozostaną na miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize as pastas selecionadas na ordem de reprodução. Os arquivos de origem permanecem no lugar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponha as pastas selecionadas por ordem de reprodução. Os ficheiros de origem ficam onde estão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aranjează dosarele selectate în ordinea redării. Fișierele sursă rămân pe loc."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usporiadaj vybrané priečinky v poradí prehrávania. Zdrojové súbory zostanú tam, kde sú."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordna de markerade mapparna i uppspelningsordning. Källfilerna ligger kvar där de är."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili klasörleri çalma sırasına göre düzenleyin. Kaynak dosyalar yerlerinde kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розташуйте вибрані папки в порядку відтворення. Вихідні файли залишаться на місці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按播放顺序排列所选文件夹。源文件将保留在原位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依播放順序排列所選資料夾。來源檔案將保留在原位置。"
          }
        }
      }
    },
    "Separate the folders to change file roles or CUE bindings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
