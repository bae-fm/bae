            "value" : "Passordet lagres i nøkkelringen på denne Macen. Klientene logger inn med brukernavnet og passordet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wachtwoord wordt bewaard in de sleutelhanger van deze Mac. Clients loggen in met de gebruikersnaam en het wachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
