        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மெட்டாடேட்டாவைத் தேட ஸ்கேன் செய்யப்பட்ட கோப்புறையைத் தேர்ந்தெடுக்கவும்"
          }
