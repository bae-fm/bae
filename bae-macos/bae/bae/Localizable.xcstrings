    "Find online asks the sources that are checked here. The same checkboxes are on the Find online header." : {
      "comment" : "Settings › Import: the footer under the metadata-source checkboxes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل البحث عبر الإنترنت المصادر المحددة هنا. وتظهر خانات الاختيار نفسها في رأس البحث عبر الإنترنت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Търсене онлайн пита източниците, отметнати тук. Същите отметки има и в заглавната лента на Търсене онлайн."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najít online se ptá zdrojů zaškrtnutých zde. Stejná zaškrtávací pole jsou i v záhlaví Najít online."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå op online spørger de kilder, der er markeret her. De samme afkrydsningsfelter findes i overskriften til Slå op online."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find online asks the sources that are checked here. The same checkboxes are on the Find online header."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Online suchen“ fragt die hier angehakten Quellen ab. Dieselben Kontrollkästchen stehen in der Kopfzeile von „Online suchen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Αναζήτηση στο διαδίκτυο ρωτά τις πηγές που είναι επιλεγμένες εδώ. Τα ίδια πλαίσια ελέγχου υπάρχουν και στην κεφαλίδα της Αναζήτησης στο διαδίκτυο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar en línea consulta las fuentes marcadas aquí. Las mismas casillas están en la cabecera de Buscar en línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi verkosta kysyy tässä valituista lähteistä. Samat valintaruudut ovat Etsi verkosta -otsikossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechercher en ligne interroge les sources cochées ici. Les mêmes cases figurent dans l’en-tête de Rechercher en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיפוש באינטרנט פונה למקורות המסומנים כאן. אותן תיבות סימון נמצאות גם בכותרת של חיפוש באינטרנט."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronađi na internetu pita izvore označene ovdje. Iste kućice nalaze se i u zaglavlju Pronađi na internetu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Keresés online az itt bejelölt forrásokat kérdezi le. Ugyanezek a jelölőnégyzetek a Keresés online fejlécében is megvannak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova online interroga le fonti selezionate qui. Le stesse caselle sono nell’intestazione di Trova online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンラインで検索は、ここでチェックしたソースに問い合わせます。同じチェックボックスはオンラインで検索のヘッダーにもあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인에서 찾기는 여기에서 선택한 소스에 질의합니다. 같은 체크박스가 온라인에서 찾기 헤더에도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå opp på nettet spør kildene som er avkrysset her. De samme avkrysningsboksene finnes i overskriften til Slå opp på nettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online zoeken raadpleegt de hier aangevinkte bronnen. Dezelfde vinkjes staan in de koptekst van Online zoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajdź online odpytuje źródła zaznaczone tutaj. Te same pola wyboru są w nagłówku Znajdź online."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar online consulta as fontes marcadas aqui. As mesmas caixas estão no cabeçalho de Buscar online."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procurar online consulta as fontes assinaladas aqui. As mesmas caixas estão no cabeçalho de Procurar online."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caută online interoghează sursele bifate aici. Aceleași casete se află și în antetul Caută online."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nájsť online sa pýta zdrojov, ktoré sú zaškrtnuté tu. Tie isté zaškrtávacie polia sú v hlavičke Nájsť online."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sök på nätet frågar de källor som är ikryssade här. Samma kryssrutor finns i rubriken för Sök på nätet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimiçi bul burada işaretli kaynaklara sorar. Aynı kutular Çevrimiçi bul başlığında da yer alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знайти онлайн опитує позначені тут джерела. Ті самі позначки є в заголовку Знайти онлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“在线查找”会询问此处勾选的来源。相同的复选框也在“在线查找”的标题栏上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「在線上尋找」會詢問此處勾選的來源。相同的核取方塊也在「在線上尋找」的標題列上。"
          }
        }
      }
