          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will stop syncing and remove the cloud provider configuration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto detendrá la sincronización y quitará la configuración del proveedor de nube."
