        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু পরিবর্তন আপলোড শেষ হয়নি এবং হারিয়ে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
