          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコードをプリントするか、パスワードマネージャに保存してください。すべてのデバイスを失ったときに、ライブラリを取り戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
