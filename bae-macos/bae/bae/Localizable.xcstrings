            "value": "ब्राउज करने योग्य — बिना एन्क्रिप्शन संग्रहित"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্রাউজযোগ্য — এনক্রিপ্ট না করে সংরক্ষিত"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உலாவக்கூடியது — குறியாக்கமின்றி சேமிக்கப்பட்டது"
