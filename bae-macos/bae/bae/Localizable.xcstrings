    "The candidate files and mapping choices will remain unchanged." : {
      "comment" : "Import metadata: clear confirmation explanation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستبقى ملفات العنصر المرشّح وخيارات المطابقة دون تغيير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файловете на кандидата и изборите за съпоставяне ще останат непроменени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubory kandidáta a volby mapování zůstanou beze změny."
