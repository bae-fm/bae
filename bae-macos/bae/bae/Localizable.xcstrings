            "state": "translated",
            "value": "Přetáhněte složku k importu, ne soubor"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispustite mapu za uvoz, ne datoteku"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 아니라 가져올 폴더를 놓으세요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
