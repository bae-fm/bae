          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोडण्यासाठी, [तुमची मोफत API कळ मिळवा](https://www.discogs.com/settings/developers) आणि ती वर पेस्ट करा."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om te verbinden, [haal je gratis API-sleutel op](https://www.discogs.com/settings/developers) en plak deze hierboven."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜੁੜਨ ਲਈ, [ਆਪਣੀ ਮੁਫ਼ਤ API ਕੁੰਜੀ ਲਵੋ](https://www.discogs.com/settings/developers) ਅਤੇ ਉੱਪਰ ਪੇਸਟ ਕਰੋ।"
