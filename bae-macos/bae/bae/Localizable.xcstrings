    "Get started with your music library.": {
      "comment": "Welcome screen subtitle",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started with your music library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con tu biblioteca de música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez avec votre bibliothèque musicale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg mit deiner Musikbibliothek los."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a usar sua biblioteca de músicas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽ライブラリを始めましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用你的音乐库。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ مع مكتبتك الموسيقية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו עם ספריית המוזיקה שלכם."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть роботу зі своєю музичною бібліотекою."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Започнете с вашата музикална библиотека."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij korzystać z biblioteki muzycznej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte se svou hudební knihovnou."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Započnite sa svojom glazbenom fonotekom."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 라이브러리를 시작하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始使用你的音樂資料庫。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con la tua libreria musicale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik kitaplığınızla başlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu với thư viện nhạc của bạn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan de slag met je muziekbibliotheek."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी संगीत लाइब्रेरी शुरू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মিউজিক লাইব্রেরি দিয়ে শুরু করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இசை நூலகத்துடன் தொடங்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సంగీత లైబ్రరీతో ప్రారంభించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या संगीत लायब्ररीसह सुरू करा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی موسیقی لائبریری شروع کریں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી સંગીત લાઇબ્રેરીથી શરૂ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಂಗೀತ ಗ್ರಂಥಾಲಯದೊಂದಿಗೆ ಪ್ರಾರಂಭಿಸಿ."
          }
        },
