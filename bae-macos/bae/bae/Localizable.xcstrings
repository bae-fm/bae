    "Uses track layout to find exact matches on MusicBrainz.": {
      "comment": "Import search: info tip explaining disc-ID identification",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses track layout to find exact matches on MusicBrainz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la disposición de las pistas para encontrar coincidencias exactas en MusicBrainz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la disposition des pistes pour trouver des correspondances exactes sur MusicBrainz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das Titel-Layout, um exakte Treffer auf MusicBrainz zu finden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o layout das faixas para encontrar correspondências exatas no MusicBrainz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックレイアウトを使って MusicBrainz で完全一致を探します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利用曲目布局在 MusicBrainz 上查找精确匹配项。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم تخطيط المقطوعات للعثور على تطابقات دقيقة في MusicBrainz."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש בפריסת הרצועות כדי למצוא התאמות מדויקות ב-MusicBrainz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує розкладку треків, щоб знайти точні збіги в MusicBrainz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използва оформлението на песните, за да намери точни съвпадения в MusicBrainz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystuje układ utworów do znalezienia dokładnych dopasowań w MusicBrainz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí rozvržení skladeb najde přesné shody na MusicBrainz."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi raspored skladbi za pronalaženje točnih podudaranja na MusicBrainzu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙 레이아웃으로 MusicBrainz에서 정확한 일치를 찾습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "利用曲目布局在 MusicBrainz 上尋找精確匹配項。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la disposizione delle tracce per trovare corrispondenze esatte su MusicBrainz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz'de kesin eşleşmeleri bulmak için parça düzenini kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng bố cục bản nhạc để tìm các kết quả khớp chính xác trên MusicBrainz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt de trackindeling om exacte overeenkomsten op MusicBrainz te vinden."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैक क्रम का उपयोग करके MusicBrainz पर सटीक मिलान ढूंढता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাক বিন্যাস ব্যবহার করে MusicBrainz-এ সঠিক মিল খুঁজে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டிராக் அமைப்பைப் பயன்படுத்தி MusicBrainz-இல் துல்லியமான பொருத்தங்களை கண்டறிகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రాక్ అమరికను ఉపయోగించి MusicBrainzలో ఖచ్చితమైన సరిపోలికలను కనుగొంటుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रॅक मांडणी वापरून MusicBrainz वर अचूक जुळण्या शोधते."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹریک ترتیب استعمال کر کے MusicBrainz پر درست مماثلتیں تلاش کرتا ہے۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રેક ગોઠવણીનો ઉપયોગ કરીને MusicBrainz પર ચોક્કસ મેળ શોધે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರ್ಯಾಕ್ ವಿನ್ಯಾಸವನ್ನು ಬಳಸಿ MusicBrainz ನಲ್ಲಿ ನಿಖರ ಹೊಂದಾಣಿಕೆಗಳನ್ನು ಹುಡುಕುತ್ತದೆ."
          }
