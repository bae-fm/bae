    "Searching both MusicBrainz and Discogs helps bae recognise more of your albums automatically." : {
      "comment" : "Import settings: the note under the box of identify and source switches",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searching both MusicBrainz and Discogs helps bae recognise more of your albums automatically."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يساعد البحث في MusicBrainz وDiscogs معًا bae على التعرّف تلقائيًا على المزيد من ألبوماتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Търсенето и в MusicBrainz, и в Discogs помага на bae да разпознава автоматично повече от албумите ви."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledání v MusicBrainz i Discogs pomáhá bae automaticky rozpoznat více vašich alb."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når bae søger i både MusicBrainz og Discogs, genkender det automatisk flere af dine album."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn bae sowohl MusicBrainz als auch Discogs durchsucht, erkennt es automatisch mehr deiner Alben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναζήτηση τόσο στο MusicBrainz όσο και στο Discogs βοηθά το bae να αναγνωρίζει αυτόματα περισσότερα από τα άλμπουμ σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar tanto en MusicBrainz como en Discogs ayuda a bae a reconocer automáticamente más de tus álbumes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun haku kohdistuu sekä MusicBrainziin että Discogsiin, bae tunnistaa automaattisesti useamman albumisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
