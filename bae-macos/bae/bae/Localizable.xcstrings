    "You will not be able to recover this library without a restore code.": {
      "comment": "Welcome screen: confirmation dialog message for removing a keychain restore entry",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will not be able to recover this library without a restore code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrás recuperar esta biblioteca sin un código de restauración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez pas récupérer cette bibliothèque sans code de restauration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Wiederherstellungscode kannst du diese Bibliothek nicht wiederherstellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não conseguirá recuperar esta biblioteca sem um código de restauração."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元コードがないと、このライブラリを復元できなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有恢复代码，你将无法恢复此库。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتمكن من استعادة هذه المكتبة بدون رمز استعادة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא תוכלו לשחזר ספרייה זו ללא קוד שחזור."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не зможете відновити цю бібліотеку без коду відновлення."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма да можете да възстановите тази библиотека без код за възстановяване."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kodu przywracania nie będzie można odzyskać tej biblioteki."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kódu pro obnovení nebudete moci tuto knihovnu obnovit."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez koda za vraćanje nećete moći oporaviti ovu fonoteku."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원 코드 없이는 이 라이브러리를 복구할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有還原碼，你將無法復原此資料庫。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non potrai recuperare questa libreria senza un codice di ripristino."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir geri yükleme kodu olmadan bu kitaplığı kurtaramazsınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không thể khôi phục thư viện này nếu không có mã khôi phục."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze bibliotheek niet herstellen zonder herstelcode."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्स्थापना कोड के बिना आप इस लाइब्रेरी को पुनर्प्राप्त नहीं कर पाएंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিস্টোর কোড ছাড়া আপনি এই লাইব্রেরি পুনরুদ্ধার করতে পারবেন না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்பு குறியீடு இல்லாமல் இந்த நூலகத்தை மீட்டெடுக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరుద్ధరణ కోడ్ లేకుండా మీరు ఈ లైబ్రరీని తిరిగి పొందలేరు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्संचयित कोडशिवाय तुम्ही ही लायब्ररी परत मिळवू शकणार नाही."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بحالی کوڈ کے بغیر آپ یہ لائبریری واپس حاصل نہیں کر سکیں گے۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પુનઃસ્થાપન કોડ વિના તમે આ લાઇબ્રેરી પુનઃપ્રાપ્ત કરી શકશો નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮರುಸ್ಥಾಪನಾ ಕೋಡ್ ಇಲ್ಲದೆ ಈ ಗ್ರಂಥಾಲಯವನ್ನು ಮರುಪಡೆಯಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുനഃസ്ഥാപന കോഡ് ഇല്ലാതെ ഈ ലൈബ്രറി വീണ്ടെടുക്കാൻ നിങ്ങൾക്ക് കഴിയില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੀਸਟੋਰ ਕੋਡ ਤੋਂ ਬਿਨਾਂ ਤੁਸੀਂ ਇਹ ਲਾਇਬ੍ਰੇਰੀ ਮੁੜ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕਰ ਸਕੋਗੇ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะกู้คืนคลังนี้ไม่ได้หากไม่มีรหัสกู้คืน"
          }
        }
      }
    },
