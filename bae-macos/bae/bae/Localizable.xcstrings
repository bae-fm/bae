    "Scan the pairing code shown on a device already in your library." : {
      "comment" : "Device pairing: instruction on the joining device.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح رمز الاقتران المعروض على جهاز موجود بالفعل في مكتبتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирайте кода за сдвояване, показан на устройство, което вече е в библиотеката ви."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার লাইব্রেরিতে ইতিমধ্যে থাকা একটি ডিভাইসে দেখানো পেয়ারিং কোডটি স্ক্যান করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte párovací kód zobrazený na zařízení, které už je ve vaší knihovně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Kopplungscode, der auf einem Gerät angezeigt wird, das bereits in deiner Mediathek ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the pairing code shown on a device already in your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código de emparejamiento que se muestra en un dispositivo que ya está en tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code d’association affiché sur un appareil déjà présent dans votre bibliothèque."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી લાઇબ્રેરીમાં પહેલેથી રહેલા ઉપકરણ પર દેખાતો પેરિંગ કોડ સ્કેન કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סרקו את קוד הצימוד שמוצג במכשיר שכבר נמצא בספרייה שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी लाइब्रेरी में पहले से मौजूद उपकरण पर दिखाया गया पेयरिंग कोड स्कैन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenirajte kod za uparivanje prikazan na uređaju koji je već u vašoj fonoteci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona il codice di abbinamento mostrato su un dispositivo già nella tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでにライブラリにあるデバイスに表示されたペアリングコードをスキャンしてください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಲೈಬ್ರರಿಯಲ್ಲಿ ಈಗಾಗಲೇ ಇರುವ ಸಾಧನದಲ್ಲಿ ತೋರಿಸಲಾದ ಜೋಡಣೆ ಕೋಡ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 라이브러리에 있는 기기에 표시된 페어링 코드를 스캔하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ശേഖരത്തിൽ ഇതിനകം ഉള്ള ഉപകരണത്തിൽ കാണിച്ചിരിക്കുന്ന പെയറിംഗ് കോഡ് സ്കാൻ ചെയ്യുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या संग्रहालयात आधीपासून असलेल्या डिव्हाइसवर दाखवलेला पेअरिंग संकेत स्कॅन करा."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan de koppelingscode die wordt weergegeven op een apparaat dat al in je bibliotheek staat."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਪਹਿਲਾਂ ਤੋਂ ਮੌਜੂਦ ਡਿਵਾਈਸ ਉੱਤੇ ਦਿਖਾਇਆ ਪੇਅਰਿੰਗ ਕੋਡ ਸਕੈਨ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj kod parowania wyświetlany na urządzeniu, które jest już w Twojej bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código de pareamento exibido em um dispositivo que já está na sua biblioteca."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் நூலகத்தில் ஏற்கனவே உள்ள சாதனத்தில் காட்டப்படும் இணைத்தல் குறியீட்டை வருடவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ లైబ్రరీలో ఇప్పటికే ఉన్న పరికరంలో చూపిన జత చేసే కోడ్‌ను స్కాన్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สแกนรหัสจับคู่ที่แสดงบนอุปกรณ์ที่อยู่ในคลังของคุณแล้ว"
