            "value" : "%@ দিয়ে bae অনুমোদন করতে আপনার ব্রাউজার খোলে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře prohlížeč pro autorizaci bae u %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet deinen Browser, um bae bei %@ zu autorisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens your browser to authorize bae with %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre tu navegador para autorizar bae con %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre votre navigateur pour autoriser bae avec %@."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ સાથે bae ને અધિકૃત કરવા તમારું બ્રાઉઝર ખોલે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פותח את הדפדפן כדי לאשר את bae עם %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के साथ bae को अनुमति देने के लिए आपका ब्राउजर खोलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvara preglednik za autorizaciju aplikacije bae putem %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre il browser per autorizzare bae con %@."
          }
        },
