    "Paused files keep their place and continue when you resume. Changes to the library still sync." : {
      "comment" : "Transfers settings: caption under the two pause switches",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الملفات الموقوفة مؤقتًا بمكانها وتتابع عند الاستئناف. تستمر مزامنة التغييرات في المكتبة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файловете на пауза запазват мястото си и продължават при възобновяване. Промените в библиотеката пак се синхронизират."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastavené soubory si drží své místo a po obnovení pokračují. Změny v knihovně se stále synchronizují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer på pause beholder deres plads og fortsætter, når de genoptages. Ændringer i biblioteket synkroniseres stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausierte Dateien behalten ihren Platz und werden beim Fortsetzen weiter übertragen. Änderungen an der Bibliothek werden weiterhin synchronisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αρχεία σε παύση κρατούν τη θέση τους και συνεχίζονται κατά την επαναφορά. Οι αλλαγές στη βιβλιοθήκη εξακολουθούν να συγχρονίζονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos en pausa conservan su lugar y continúan al reanudar. Los cambios en la biblioteca se siguen sincronizando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskeytetyt tiedostot säilyttävät paikkansa ja jatkuvat, kun siirrot jatketaan. Kirjaston muutokset synkronoidaan edelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers suspendus gardent leur place et reprennent à la reprise. Les modifications de la bibliothèque continuent d’être synchronisées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קבצים מושהים שומרים על מקומם וממשיכים כשמחדשים. שינויים בספרייה עדיין מסתנכרנים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteke na pauzi zadržavaju svoje mjesto i nastavljaju se kad se nastavi. Promjene u fonoteci i dalje se sinkroniziraju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szüneteltetett fájlok megtartják a helyüket, és a folytatáskor mennek tovább. A könyvtár változásai továbbra is szinkronizálódnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file sospesi mantengono il loro posto e proseguono alla ripresa. Le modifiche alla libreria continuano a sincronizzarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止したファイルは順番を保ち、再開すると続きから転送されます。ライブラリへの変更は引き続き同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지된 파일은 순서를 유지하며 재개하면 이어집니다. 라이브러리의 변경 사항은 계속 동기화됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer på pause beholder plassen sin og fortsetter når de gjenopptas. Endringer i biblioteket synkroniseres fortsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gepauzeerde bestanden behouden hun plaats en gaan verder zodra je hervat. Wijzigingen in de bibliotheek worden nog steeds gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymane pliki zachowują swoje miejsce i są kontynuowane po wznowieniu. Zmiany w bibliotece nadal się synchronizują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos pausados mantêm o lugar e continuam ao retomar. As alterações na biblioteca continuam sendo sincronizadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ficheiros em pausa mantêm o lugar e continuam ao retomar. As alterações à biblioteca continuam a ser sincronizadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișierele întrerupte își păstrează locul și continuă la reluare. Modificările din bibliotecă se sincronizează în continuare."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastavené súbory si držia svoje miesto a po obnovení pokračujú. Zmeny v knižnici sa stále synchronizujú."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausade filer behåller sin plats och fortsätter när de återupptas. Ändringar i biblioteket synkroniseras fortfarande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatılan dosyalar yerini korur ve devam ettirildiğinde sürer. Kitaplıktaki değişiklikler yine de eşitlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупинені файли зберігають своє місце й продовжуються після відновлення. Зміни в бібліотеці й надалі синхронізуються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停的文件保持原有顺序，恢复后继续传输。资料库的更改仍会同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫停的檔案會保持原有順序，繼續後接著傳輸。資料庫的變更仍會同步。"
          }
        }
      }
    },
