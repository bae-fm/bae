          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ut denne koden eller lagre den i en passordbehandler. Den får deg tilbake til biblioteket ditt hvis du mister alle enhetene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
