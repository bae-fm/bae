    "This replaces metadata and cover choices for the selected folders. Source files and track layout are unchanged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل هذا البيانات الوصفية واختيارات الغلاف للمجلدات المحددة. تبقى الملفات المصدر وترتيب المقاطع دون تغيير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това заменя метаданните и избора на обложка за избраните папки. Изходните файлове и подредбата на песните остават непроменени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím se nahradí metadata a vybrané obaly pro zvolené složky. Zdrojové soubory a uspořádání stop se nezmění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette erstatter metadata og omslagsvalg for de valgte mapper. Kildefiler og sporopstilling er uændrede."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This replaces metadata and cover choices for the selected folders. Source files and track layout are unchanged."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ersetzt die Metadaten und die Coverauswahl der ausgewählten Ordner. Quelldateien und Titelanordnung bleiben unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό αντικαθιστά τα μεταδεδομένα και τις επιλογές εξωφύλλου για τους επιλεγμένους φακέλους. Τα αρχεία προέλευσης και η διάταξη των κομματιών παραμένουν αμετάβλητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reemplaza los metadatos y las portadas elegidas de las carpetas seleccionadas. Los archivos de origen y la disposición de las pistas no cambian."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä korvaa valittujen kansioiden metatiedot ja kansivalinnat. Lähdetiedostot ja raitojen järjestys säilyvät ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées et les pochettes choisies pour les dossiers sélectionnés seront remplacées. Les fichiers source et l’organisation des pistes resteront inchangés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו מחליפה את המטא־נתונים ובחירת העטיפה של התיקיות הנבחרות. קובצי המקור וסידור הרצועות אינם משתנים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo zamjenjuje metapodatke i odabire omota za odabrane mape. Izvorne datoteke i raspored pjesama ostaju nepromijenjeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez lecseréli a kijelölt mappák metaadatait és borítóválasztásait. A forrásfájlok és a számok elrendezése változatlan marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno sostituiti i metadati e le copertine scelte per le cartelle selezionate. I file sorgente e la disposizione delle tracce rimarranno invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォルダのメタデータとカバーの選択が置き換わります。元のファイルとトラック構成は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 폴더의 메타데이터와 커버 선택을 바꿉니다. 원본 파일과 트랙 구성은 변경되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette erstatter metadata og omslagsvalg for de valgte mappene. Kildefiler og sporoppsett er uendret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit vervangt de metagegevens en gekozen hoezen van de geselecteerde mappen. Bronbestanden en de trackindeling blijven ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to zastąpienie metadanych i wybranych okładek w zaznaczonych folderach. Pliki źródłowe i układ utworów pozostaną bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso substitui os metadados e as capas escolhidas das pastas selecionadas. Os arquivos de origem e a organização das faixas permanecem inalterados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto substitui os metadados e as escolhas de capa das pastas selecionadas. Os ficheiros de origem e a disposição das faixas mantêm-se."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta înlocuiește metadatele și alegerile de copertă pentru dosarele selectate. Fișierele sursă și dispunerea pieselor rămân neschimbate."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto nahradí metadáta a voľby obalov pre vybrané priečinky. Zdrojové súbory a rozloženie skladieb zostanú nezmenené."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta ersätter metadata och omslagsval för de markerade mapparna. Källfiler och spårlayout lämnas oförändrade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem seçili klasörlerin meta verilerini ve kapak seçimlerini değiştirir. Kaynak dosyalar ve parça düzeni değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це замінить метадані й вибір обкладинок для вибраних тек. Вихідні файли та структура треків залишаться без змін."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会替换所选文件夹的元数据和封面选择。源文件和曲目布局保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會取代所選檔案夾的中繼資料與封面選擇。來源檔案與曲目配置維持不變。"
          }
        }
      }
    },
