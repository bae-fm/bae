    "Another release of this album is in your library": {
      "comment": "Import confirm: info banner when a different release of the album is already imported",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another release of this album is in your library"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra edición de este álbum ya está en tu biblioteca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre édition de cet album est dans votre bibliothèque"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Veröffentlichung dieses Albums ist bereits in deiner Bibliothek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro lançamento deste álbum está na sua biblioteca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムの別リリースがライブラリにあります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该专辑的另一个版本已在你的库中"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد إصدار آخر من هذا الألبوم في مكتبتك"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהדורה אחרת של אלבום זה כבר נמצאת בספרייה שלכם"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вашій бібліотеці вже є інший реліз цього альбому"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Друго издание на този албум вече е в библиотеката ви"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne wydanie tego albumu jest już w bibliotece"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V knihovně máte jiné vydání tohoto alba"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugo izdanje ovog albuma već je u vašoj fonoteci"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앨범의 다른 릴리스가 라이브러리에 있습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此專輯的另一個發行版本已在你的資料庫中"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra pubblicazione di questo album è già nella tua libreria"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu albümün başka bir yayını kitaplığınızda zaten var"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bản phát hành khác của album này đã có trong thư viện của bạn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere release van dit album staat al in je bibliotheek"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस एल्बम का दूसरा रिलीज़ आपकी लाइब्रेरी में है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যালবামের আরেকটি রিলিজ আপনার লাইব্রেরিতে আছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஆல்பத்தின் மற்றொரு வெளியீடு உங்கள் நூலகத்தில் உள்ளது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఆల్బమ్ యొక్క మరో విడుదల మీ లైబ్రరీలో ఉంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या अल्बमची दुसरी आवृत्ती तुमच्या लायब्ररीमध्ये आहे"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس البم کی ایک اور ریلیز آپ کی لائبریری میں ہے"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ આલ્બમની બીજી રિલીઝ તમારી લાઇબ્રેરીમાં છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಆಲ್ಬಮ್‌ನ ಮತ್ತೊಂದು ಬಿಡುಗಡೆ ನಿಮ್ಮ ಗ್ರಂಥಾಲಯದಲ್ಲಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ആൽബത്തിന്റെ മറ്റൊരു റിലീസ് നിങ്ങളുടെ ലൈബ്രറിയിൽ ഉണ്ട്"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਐਲਬਮ ਦੀ ਹੋਰ ਰਿਲੀਜ਼ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਹੈ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีอีกรุ่นวางจำหน่ายของอัลบั้มนี้อยู่ในคลังของคุณ"
          }
        }
      }
    },
