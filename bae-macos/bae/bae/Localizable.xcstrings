    "Pick the release you have, or dismiss the signal you trust less.": {
      "comment": "Import search: conflict banner subtitle prompting a choice",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the release you have, or dismiss the signal you trust less."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la edición que tienes o descarta la señal en la que confías menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'édition que vous possédez, ou écartez le signal en lequel vous avez le moins confiance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Veröffentlichung, die du hast, oder verwirf das Signal, dem du weniger vertraust."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o lançamento que você tem ou descarte o sinal em que confia menos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お持ちのリリースを選ぶか、信頼度の低いシグナルを除外してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你拥有的版本，或忽略你不太信任的信号。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الإصدار الذي لديك، أو تجاهل الإشارة التي تثق بها أقل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו את המהדורה שברשותכם, או בטלו את האות שאתם פחות סומכים עליו."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть реліз, який у вас є, або відхиліть сигнал, якому довіряєте менше."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете изданието, което имате, или отхвърлете сигнала, на който се доверявате по-малко."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wydanie, które masz, lub odrzuć mniej zaufany sygnał."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte vydání, které máte, nebo zamítněte signál, kterému méně důvěřujete."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite izdanje koje imate ili odbacite signal kojem manje vjerujete."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가지고 있는 릴리스를 선택하거나 덜 신뢰하는 신호를 닫으세요."
          }
        }
      }
    },
