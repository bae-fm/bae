          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザを開いて、bae を %@ で認証します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ಜೊತೆ bae ಗೆ ಅನುಮತಿ ನೀಡಲು ನಿಮ್ಮ ಬ್ರೌಸರ್ ತೆರೆಯುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 bae를 인증하도록 브라우저를 엽니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ഉപയോഗിച്ച് bae-ന് അനുമതി നൽകാൻ നിങ്ങളുടെ ബ്രൗസർ തുറക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ सह bae अधिकृत करण्यासाठी तुमचा ब्राउझर उघडतो."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent je browser om bae te autoriseren met %@."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ਨਾਲ bae ਨੂੰ ਅਧਿਕਾਰਿਤ ਕਰਨ ਲਈ ਤੁਹਾਡਾ ਬ੍ਰਾਊਜ਼ਰ ਖੋਲ੍ਹਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera przeglądarkę, aby autoryzować bae w %@."
          }
        },
