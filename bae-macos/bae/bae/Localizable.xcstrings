    "Replace metadata with what the files, sheets and folder say about the release. Tracks and audio assignments will remain unchanged." : {
      "comment" : "Import metadata: reset-to-file-metadata confirmation message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replace metadata with what the files, sheets and folder say about the release. Tracks and audio assignments will remain unchanged."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استبدال البيانات الوصفية بما تقوله الملفات وأوراق المسارات والمجلد عن الإصدار. ستبقى المقاطع وتعيينات الصوت دون تغيير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замяна на метаданните с това, което файловете, листовете и папката казват за изданието. Песните и аудио съпоставянията ще останат непроменени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahradit metadata tím, co o vydání říkají soubory, listy a složka. Skladby a přiřazení zvuku zůstanou beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstat metadata med det, filerne, arkene og mappen siger om udgivelsen. Numre og lydtilknytninger forbliver uændrede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadaten durch das ersetzen, was Dateien, Cue-Sheets und Ordner über die Veröffentlichung sagen. Titel und Audiozuordnungen bleiben unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντικατάσταση των μεταδεδομένων με όσα λένε τα αρχεία, τα φύλλα και ο φάκελος για την κυκλοφορία. Τα κομμάτια και οι αντιστοιχίσεις ήχου θα παραμείνουν αμετάβλητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituir los metadatos por lo que los archivos, las hojas y la carpeta dicen de la edición. Las pistas y las asignaciones de audio no cambiarán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korvaa metatiedot sillä, mitä tiedostot, cue-arkit ja kansio kertovat julkaisusta. Kappaleet ja äänikytkennät säilyvät ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacer les métadonnées par ce que les fichiers, les feuilles et le dossier disent de l’édition. Les pistes et les associations audio resteront inchangées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלפת המטא־נתונים במה שהקבצים, הגיליונות והתיקייה אומרים על הגרסה. הרצועות ושיוכי השמע יישארו ללא שינוי."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamijeni metapodatke onime što datoteke, listovi i mapa govore o izdanju. Pjesme i dodjele zvuka ostat će nepromijenjene."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A metaadatok cseréje arra, amit a fájlok, a lemezlapok és a mappa mond a kiadásról. A számok és a hanghozzárendelések változatlanok maradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci i metadati con ciò che i file, i fogli e la cartella dicono dell’edizione. Le tracce e le associazioni audio rimarranno invariate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メタデータを、ファイル・CUE シート・フォルダがリリースについて示す内容に置き換えます。トラックと音声の割り当ては変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메타데이터를 파일과 CUE 시트, 폴더가 릴리스에 대해 말하는 내용으로 대체합니다. 트랙과 오디오 할당은 변경되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstatt metadata med det filene, arkene og mappen sier om utgivelsen. Spor og lydkoblinger forblir uendret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervang metadata door wat de bestanden, sheets en map over de uitgave zeggen. Nummers en audiotoewijzingen blijven ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastąp metadane tym, co o wydaniu mówią pliki, arkusze i folder. Utwory i przypisania dźwięku pozostaną bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitua os metadados pelo que os arquivos, as folhas e a pasta dizem sobre o lançamento. As faixas e as associações de áudio permanecerão inalteradas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir os metadados pelo que os ficheiros, as folhas e a pasta dizem sobre a edição. As faixas e as associações de áudio mantêm-se inalteradas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înlocuiește metadatele cu ceea ce spun fișierele, fișele și folderul despre ediție. Piesele și asocierile audio rămân neschimbate."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahradiť metadáta tým, čo o vydaní hovoria súbory, hárky a priečinok. Skladby a priradenia zvuku zostanú nezmenené."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersätt metadata med det som filerna, arken och mappen säger om utgåvan. Spår och ljudkopplingar lämnas oförändrade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta verileri; dosyaların, CUE sayfalarının ve klasörün sürüm hakkında söyledikleriyle değiştir. Parçalar ve ses atamaları değişmeden kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замінити метадані тим, що про видання кажуть файли, аркуші та тека. Композиції та зіставлення аудіо залишаться без змін."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用文件、CUE 表单和文件夹对该版本的描述替换元数据。曲目和音频分配将保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以檔案、CUE 表單和資料夾對該版本的描述取代中繼資料。曲目和音訊指派將維持不變。"
          }
        }
      }
    },
