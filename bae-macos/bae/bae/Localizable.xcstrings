    "Uses iCloud for sync. Requires iCloud to be enabled in System Settings.": {
      "comment": "Sync wizard: iCloud step explanation",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses iCloud for sync. Requires iCloud to be enabled in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa iCloud para sincronizar. Requiere que iCloud esté activado en los Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise iCloud pour la synchronisation. Nécessite l'activation d'iCloud dans les Réglages Système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet iCloud für die Synchronisierung. Erfordert, dass iCloud in den Systemeinstellungen aktiviert ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o iCloud para sincronizar. Requer que o iCloud esteja ativado nas Configurações do Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期に iCloud を使用します。システム設定で iCloud を有効にする必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 iCloud 进行同步。需要在系统设置中启用 iCloud。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم iCloud للمزامنة. يتطلب تمكين iCloud في إعدادات النظام."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש ב-iCloud לסנכרון. דורש ש-iCloud יהיה מופעל בהגדרות המערכת."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує iCloud для синхронізації. Потрібно увімкнути iCloud у Системних параметрах."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използва iCloud за синхронизиране. Изисква iCloud да е активиран в Системни настройки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzysta z iCloud do synchronizacji. Wymaga włączenia iCloud w Ustawieniach systemowych."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K synchronizaci používá iCloud. Vyžaduje zapnutý iCloud v Nastavení systému."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi iCloud za sinkronizaciju. Zahtijeva omogućen iCloud u Postavkama sustava."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화에 iCloud를 사용합니다. 시스템 설정에서 iCloud가 켜져 있어야 합니다."
          }
        }
      }
    },
    "Uses track layout to find perfect matches on MusicBrainz.": {
