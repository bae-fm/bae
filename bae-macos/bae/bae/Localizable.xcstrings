    "Each action applies only to eligible selected folders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق كل إجراء على المجلدات المحددة المؤهلة فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всяко действие се прилага само за допустимите избрани папки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá akce se použije jen na způsobilé vybrané složky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver handling gælder kun for de valgte mapper, der kan bruges."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each action applies only to eligible selected folders."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Aktion gilt nur für geeignete ausgewählte Ordner."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε ενέργεια εφαρμόζεται μόνο στους επιλέξιμους επιλεγμένους φακέλους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
