        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма да можете да възстановите тази библиотека без код за възстановяване."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez kódu pro obnovení nebudete moci tuto knihovnu obnovit."
