    "Pick the release you have, or dismiss the signal you trust less." : {
      "comment" : "Import search: conflict banner subtitle prompting a choice",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الإصدار الذي لديك، أو تجاهل الإشارة التي تثق بها أقل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете изданието, което имате, или отхвърлете сигнала, на който се доверявате по-малко."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার থাকা রিলিজটি বাছুন, অথবা যে সংকেত কম বিশ্বাস করেন তা সরিয়ে দিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte vydání, které máte, nebo zamítněte signál, kterému méně důvěřujete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Veröffentlichung, die du hast, oder verwirf das Signal, dem du weniger vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the release you have, or dismiss the signal you trust less."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la edición que tienes o descarta la señal en la que confías menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l'édition que vous possédez, ou écartez le signal en lequel vous avez le moins confiance."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી પાસે જે પ્રકાશન છે તે પસંદ કરો, અથવા જે સંકેત પર ઓછો ભરોસો હોય તેને બંધ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחרו את המהדורה שברשותכם, או בטלו את האות שאתם פחות סומכים עליו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पास जो रिलीज है उसे चुनें, या जिस संकेत पर कम भरोसा है उसे हटाएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite izdanje koje imate ili odbacite signal kojem manje vjerujete."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la pubblicazione che hai o ignora il segnale meno affidabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お持ちのリリースを選ぶか、信頼度の低いシグナルを除外してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮಲ್ಲಿರುವ ಬಿಡುಗಡೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ, ಅಥವಾ ನೀವು ಕಡಿಮೆ ನಂಬುವ ಸಂಕೇತವನ್ನು ತಳ್ಳಿಹಾಕಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가지고 있는 릴리스를 선택하거나 덜 신뢰하는 신호를 닫으세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളിലുള്ള പതിപ്പ് തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ കുറച്ച് വിശ്വാസമുള്ള സൂചന ഒഴിവാക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्याकडे असलेले प्रकाशन निवडा, किंवा कमी विश्वास असलेला संकेत बाद करा."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
