    "The password is stored in the keyring, not in the config file. Clients authenticate with the username and password." : {
      "comment" : "Subsonic settings: password section footer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن كلمة السر في حلقة المفاتيح، لا في ملف التكوين. تُوثِّق البرامج العميلة نفسها باسم المستخدم وكلمة السر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паролата се съхранява в ключодържателя, а не в конфигурационния файл. Клиентите се удостоверяват с потребителското име и паролата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslo je uloženo v klíčence, ne v konfiguračním souboru. Klienti se ověřují uživatelským jménem a heslem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgangskoden gemmes i nøgleringen, ikke i konfigurationsfilen. Klienterne godkendes med brugernavnet og adgangskoden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password is stored in the keyring, not in the config file. Clients authenticate with the username and password."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort liegt im Schlüsselbund, nicht in der Konfigurationsdatei. Clients authentifizieren sich mit Benutzername und Passwort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός πρόσβασης αποθηκεύεται στο μπρελόκ, όχι στο αρχείο διαμόρφωσης. Οι πελάτες πιστοποιούνται με το όνομα χρήστη και τον κωδικό πρόσβασης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña se guarda en el llavero, no en el archivo de configuración. Los clientes se autentican con el nombre de usuario y la contraseña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salasana tallennetaan avainnippuun, ei asetustiedostoon. Asiakkaat tunnistautuvat käyttäjätunnuksella ja salasanalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe est stocké dans le trousseau, pas dans le fichier de configuration. Les clients s'authentifient avec le nom d'utilisateur et le mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסיסמה נשמרת במחזיק המפתחות, לא בקובץ התצורה. לקוחות מזדהים עם שם המשתמש והסיסמה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lozinka se pohranjuje u privjesku ključeva, ne u konfiguracijskoj datoteci. Klijenti se autentificiraju korisničkim imenom i lozinkom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelszó a kulcstartóban tárolódik, nem a konfigurációs fájlban. A kliensek felhasználónévvel és jelszóval hitelesítenek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password è conservata nel portachiavi, non nel file di configurazione. I client si autenticano con nome utente e password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードは構成ファイルではなくキーリングに保存されます。クライアントはユーザー名とパスワードで認証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 구성 파일이 아닌 키링에 저장됩니다. 클라이언트는 사용자 이름과 암호로 인증합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passordet lagres i nøkkelringen, ikke i oppsettfilen. Klientene autentiseres med brukernavnet og passordet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wachtwoord staat in de sleutelring, niet in het configuratiebestand. Clients verifiëren zich met de gebruikersnaam en het wachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło jest przechowywane w pęku kluczy, nie w pliku konfiguracyjnym. Klienci uwierzytelniają się nazwą użytkownika i hasłem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha fica armazenada no chaveiro, não no arquivo de configuração. Os clientes se autenticam com o nome de usuário e a senha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A palavra-passe fica guardada no porta-chaves, não no ficheiro de configuração. Os clientes autenticam-se com o nome de utilizador e a palavra-passe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola este stocată în breloc, nu în fișierul de configurare. Clienții se autentifică cu numele de utilizator și parola."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslo je uložené v kľúčenke, nie v konfiguračnom súbore. Klienti sa overujú menom a heslom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösenordet sparas i nyckelringen, inte i konfigurationsfilen. Klienterna autentiserar sig med användarnamnet och lösenordet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola yapılandırma dosyasında değil, anahtarlıkta saklanır. İstemciler kullanıcı adı ve parolayla kimlik doğrular."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль зберігається у в'язці ключів, а не у файлі конфігурації. Клієнти автентифікуються за іменем користувача та паролем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码存储在密钥环中，而不是配置文件里。客户端使用用户名和密码进行认证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼儲存於鑰匙圈中，而非設定檔。用戶端以使用者名稱與密碼進行驗證。"
          }
        }
      }
    },
