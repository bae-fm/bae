    "Found from a previous setup on this Mac.": {
      "comment": "Welcome screen InfoTip: explains keychain-discovered restore entries",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found from a previous setup on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrada de una configuración anterior en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvé depuis une configuration précédente sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus einer früheren Einrichtung auf diesem Mac gefunden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado em uma configuração anterior neste Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの以前のセットアップから見つかりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现于此 Mac 上的先前设置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور عليه من إعداد سابق على هذا الـ Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נמצא מהתקנה קודמת ב-Mac הזה."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдено з попереднього налаштування на цьому Mac."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Открито от предишна настройка на този Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znalezione z poprzedniej konfiguracji na tym Macu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalezeno z předchozího nastavení na tomto Macu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronađeno iz prethodnog postavljanja na ovom Macu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 이전 설정에서 찾았습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此 Mac 先前的設定中找到。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovato da una configurazione precedente su questo Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'teki önceki bir kurulumdan bulundu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm thấy từ thiết lập trước đó trên máy Mac này."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gevonden uit een eerdere configuratie op deze Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर पिछले सेटअप से मिला।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এর আগের সেটআপ থেকে পাওয়া গেছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Mac-இல் முந்தைய அமைப்பிலிருந்து கண்டறியப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Mac‌లోని మునుపటి సెటప్‌లో కనబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Mac वरील आधीच्या मांडणीतून सापडले."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac پر پچھلی ترتیب سے ملا۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Mac પરના અગાઉના ગોઠવણમાંથી મળ્યું."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Mac ನಲ್ಲಿ ಹಿಂದಿನ ಹೊಂದಿಕೆಯಿಂದ ಕಂಡುಬಂದಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Mac-ലെ മുൻ സജ്ജീകരണത്തിൽ നിന്ന് കണ്ടെത്തി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ Mac ਉੱਤੇ ਪਿਛਲੇ ਸੈਟਅੱਪ ਤੋਂ ਮਿਲਿਆ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พบจากการตั้งค่าครั้งก่อนบน Mac เครื่องนี้"
          }
        }
      }
    },
