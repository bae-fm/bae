    "This library's cloud home will be bae's space in iCloud, using the Apple Account this Mac is signed in to." : {
      "comment" : "Set up sync's iCloud screen: what choosing iCloud does.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيكون المنزل السحابي لهذه المكتبة مساحة bae في iCloud، باستخدام حساب Apple المسجَّل الدخول إليه على هذا الـ Mac."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облачният дом на тази библиотека ще бъде пространството на bae в iCloud чрез акаунта в Apple, в който е влязъл този Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudovým domovem této knihovny bude prostor aplikace bae v iCloudu pod Apple účtem, ke kterému je tento Mac přihlášen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette biblioteks skyhjem bliver bae's område i iCloud med den Apple-konto, som denne Mac er logget ind på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Cloud-Zuhause dieser Mediathek ist der Bereich von bae in iCloud, mit dem Apple Account, bei dem dieser Mac angemeldet ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το σπίτι αυτής της βιβλιοθήκης στο cloud θα είναι ο χώρος του bae στο iCloud, με τον λογαριασμό Apple στον οποίο είναι συνδεδεμένο αυτό το Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This library's cloud home will be bae's space in iCloud, using the Apple Account this Mac is signed in to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El hogar en la nube de esta biblioteca será el espacio de bae en iCloud, con la cuenta de Apple con la que este Mac tiene la sesión iniciada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
