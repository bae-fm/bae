    "Print this code or save it in a password manager. It gets you back into your library if you lose all your devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطبع هذا الرمز أو احفظه في مدير كلمات مرور. يعيدك إلى مكتبتك إذا فقدت جميع أجهزتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отпечатайте този код или го запазете в мениджър на пароли. Той ви връща във вашата библиотека, ако загубите всичките си устройства."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytiskněte si tento kód nebo si ho uložte do správce hesel. Vrátí vás do knihovny, když přijdete o všechna zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udskriv denne kode, eller gem den i en adgangskodeadministrator. Den får dig tilbage til dit bibliotek, hvis du mister alle dine enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drucke diesen Code aus oder speichere ihn in einem Passwortmanager. Mit ihm kommst du wieder in deine Bibliothek, wenn du alle deine Geräte verlierst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτυπώστε αυτόν τον κωδικό ή αποθηκεύστε τον σε έναν διαχειριστή κωδικών. Σας επαναφέρει στη βιβλιοθήκη σας αν χάσετε όλες τις συσκευές σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print this code or save it in a password manager. It gets you back into your library if you lose all your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprime este código o guárdalo en un gestor de contraseñas. Te devuelve a tu biblioteca si pierdes todos tus dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulosta tämä koodi tai tallenna se salasanahallintaan. Sillä pääset takaisin kirjastoosi, jos menetät kaikki laitteesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprimez ce code ou enregistrez-le dans un gestionnaire de mots de passe. Il vous rend votre bibliothèque si vous perdez tous vos appareils."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדפס את הקוד הזה או שמור אותו במנהל סיסמאות. הוא מחזיר אותך לספרייה שלך אם תאבד את כל המכשירים שלך."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispišite ovaj kod ili ga spremite u upravitelj lozinki. Vraća vas u vašu fonoteku ako izgubite sve svoje uređaje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyomtasd ki ezt a kódot, vagy mentsd jelszókezelőbe. Visszajuttat a könyvtáradhoz, ha elveszíted az összes eszközödet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
