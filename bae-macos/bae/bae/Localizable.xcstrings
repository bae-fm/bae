          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para conectar, [obtenha sua chave de API gratuita](https://www.discogs.com/settings/developers) e cole-a acima."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இணைக்க, [உங்கள் இலவச API விசையைப் பெறவும்](https://www.discogs.com/settings/developers) மற்றும் மேலே ஒட்டவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కనెక్ట్ చేయడానికి, [మీ ఉచిత API కీ పొందండి](https://www.discogs.com/settings/developers) మరియు దాన్ని పైకి అతికించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการเชื่อมต่อ ให้[รับคีย์ API ฟรี](https://www.discogs.com/settings/developers)แล้ววางไว้ด้านบน"
