    "Enter your restore code, or an invite to a library." : {
      "comment" : "Welcome: the line under the Enter code title",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل رمز الاستعادة الخاص بك، أو دعوة إلى مكتبة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведете своя код за възстановяване или покана за библиотека."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
