    "Track count mismatch: release has %@ tracks but local files don't match" : {},
    "Track count mismatch: release has %lld tracks but local files don't match" : {
      "comment" : "Import confirm: warning that the source release track count differs from local files; %lld is the release track count",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد المقاطع غير متطابق: يحتوي الإصدار على %lld مقاطع لكن الملفات المحلية لا تطابقه"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несъответствие в броя песни: изданието има %lld песни, но локалните файлове не съвпадат"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্র্যাক সংখ্যা মিলছে না: রিলিজে %lldটি ট্র্যাক আছে কিন্তু স্থানীয় ফাইলগুলো মেলে না"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet skladeb neodpovídá: vydání má %lld skladeb, ale místní soubory neodpovídají"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titelanzahl stimmt nicht überein: Die Veröffentlichung hat %lld Titel, aber die lokalen Dateien passen nicht"
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Track count mismatch: release has %lld track but local files don't match"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Track count mismatch: release has %lld tracks but local files don't match"
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número de pistas no coincide: el lanzamiento tiene %lld pistas, pero los archivos locales no coinciden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre de pistes ne correspond pas : la sortie contient %lld pistes, mais les fichiers locaux ne correspondent pas"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ટ્રૅક સંખ્યા મેળ ખાતી નથી: રિલીઝમાં %lld ટ્રૅક્સ છે પરંતુ સ્થાનિક ફાઇલો મેળ ખાતી નથી"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספר הרצועות אינו תואם: במהדורה יש %lld רצועות, אבל הקבצים המקומיים אינם תואמים"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैक संख्या मेल नहीं खाती: रिलीज़ में %lld ट्रैक हैं लेकिन स्थानीय फ़ाइलें मेल नहीं खातीं"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broj pjesama se ne podudara: izdanje ima %lld pjesama, ali lokalne datoteke se ne podudaraju"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero di tracce non corrisponde: la pubblicazione ha %lld tracce, ma i file locali non corrispondono"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラック数が一致しません: リリースには%lld曲ありますが、ローカルファイルが一致しません"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಟ್ರ್ಯಾಕ್ ಸಂಖ್ಯೆ ಹೊಂದಿಕೆಯಾಗುತ್ತಿಲ್ಲ: ಬಿಡುಗಡೆಯಲ್ಲಿ %lld ಟ್ರ್ಯಾಕ್‌ಗಳಿವೆ, ಆದರೆ ಸ್ಥಳೀಯ ಫೈಲ್‌ಗಳು ಹೊಂದಿಕೆಯಾಗುತ್ತಿಲ್ಲ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랙 수 불일치: 릴리스에는 %lld개 트랙이 있지만 로컬 파일이 일치하지 않습니다"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ട്രാക്ക് എണ്ണം പൊരുത്തപ്പെടുന്നില്ല: റിലീസിൽ %lld ട്രാക്കുകളുണ്ട്, പക്ഷേ ലോക്കൽ ഫയലുകൾ പൊരുത്തപ്പെടുന്നില്ല"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रॅक संख्या जुळत नाही: रिलीझमध्ये %lld ट्रॅक आहेत पण स्थानिक फाइल्स जुळत नाहीत"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aantal nummers komt niet overeen: release heeft %lld nummers, maar lokale bestanden komen niet overeen"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਟਰੈਕ ਗਿਣਤੀ ਮੇਲ ਨਹੀਂ ਖਾਂਦੀ: ਰਿਲੀਜ਼ ਵਿੱਚ %lld ਟਰੈਕ ਹਨ ਪਰ ਸਥਾਨਕ ਫਾਈਲਾਂ ਮੇਲ ਨਹੀਂ ਖਾਂਦੀਆਂ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezgodna liczba utworów: wydanie ma %lld utworów, ale pliki lokalne nie pasują"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A contagem de faixas não corresponde: o lançamento tem %lld faixas, mas os arquivos locais não correspondem"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தடங்களின் எண்ணிக்கை பொருந்தவில்லை: வெளியீட்டில் %lld தடங்கள் உள்ளன, ஆனால் உள்ளூர் கோப்புகள் பொருந்தவில்லை"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
