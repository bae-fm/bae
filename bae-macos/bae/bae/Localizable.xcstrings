          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি সিঙ্ক বন্ধ করবে এবং ক্লাউড প্রদানকারীর কনফিগারেশন সরাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
