    "Metadata only — pressing fields stay blank; just the album group is recorded.": {
      "comment": "Import confirm: note under the toggle when Metadata only is chosen",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata only — pressing fields stay blank; just the album group is recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo metadatos — los campos del prensaje quedan en blanco; solo se registra el grupo del álbum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées seules — les champs du pressage restent vides ; seul le groupe d'album est enregistré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Metadaten — Pressungsfelder bleiben leer; nur die Albumgruppe wird erfasst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente metadados — os campos de prensagem ficam em branco; apenas o grupo do álbum é registrado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータのみ — プレス欄は空欄のまま、アルバムグループだけが記録されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅元数据 — 压制版字段留空，仅记录专辑组。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيانات الوصفية فقط — تبقى حقول الطبعة فارغة؛ يُسجَّل مجموعة الألبوم فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מטא-נתונים בלבד — שדות התקליט נשארים ריקים; נרשמת רק קבוצת האלבום."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише метадані — поля видання залишаються порожніми; записується лише група альбому."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само метаданни — полетата за издание остават празни; записва се само групата на албума."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko metadane — pola tłoczenia pozostają puste; zapisywana jest jedynie grupa albumu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze metadata — pole lisu zůstanou prázdná; zaznamená se jen skupina alba."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo metapodaci — polja izdanja ostaju prazna; bilježi se samo grupa albuma."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메타데이터만 — 프레싱 필드는 비워 두고 앨범 그룹만 기록합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅中繼資料 — 壓片欄位會保持空白；只會記錄專輯群組。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo metadati — i campi di stampa restano vuoti; viene registrato solo il gruppo dell'album."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca üst veri — baskı alanları boş kalır; yalnızca albüm grubu kaydedilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ siêu dữ liệu — các trường bản ép để trống; chỉ nhóm album được ghi lại."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen metadata — persingsvelden blijven leeg; alleen de albumgroep wordt vastgelegd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल मेटाडेटा — प्रेसिंग फ़ील्ड खाली रहते हैं; केवल एल्बम समूह रिकॉर्ड किया जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু মেটাডেটা — প্রেসিং ক্ষেত্রগুলো ফাঁকা থাকে; শুধু অ্যালবাম গ্রুপ রেকর্ড করা হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மெட்டாடேட்டா மட்டும் — பதிப்பு புலங்கள் காலியாகவே இருக்கும்; ஆல்பக் குழு மட்டும் பதிவு செய்யப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మెటాడేటా మాత్రమే — ప్రెస్సింగ్ ఫీల్డ్‌లు ఖాళీగా ఉంటాయి; ఆల్బమ్ సమూహం మాత్రమే నమోదు చేయబడుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त मेटाडेटा — प्रेसिंग फील्ड रिकामे राहतात; फक्त अल्बम गट नोंदवला जातो."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف میٹا ڈیٹا — پریسنگ خانے خالی رہتے ہیں؛ صرف البم گروپ ریکارڈ کیا جاتا ہے۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માત્ર મેટાડેટા — પ્રેસિંગ ફીલ્ડ્સ ખાલી રહેશે; ફક્ત આલ્બમ જૂથ નોંધાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೆಟಾಡೇಟಾ ಮಾತ್ರ — ಪ್ರೆಸ್ಸಿಂಗ್ ಕ್ಷೇತ್ರಗಳು ಖಾಲಿಯಾಗಿಯೇ ಇರುತ್ತವೆ; ಆಲ್ಬಮ್ ಗುಂಪು ಮಾತ್ರ ದಾಖಲಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മെറ്റാഡാറ്റ മാത്രം — പ്രസ്സിംഗ് ഫീൽഡുകൾ ശൂന്യമായി തുടരും; ആൽബം ഗ്രൂപ്പ് മാത്രം രേഖപ്പെടുത്തും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਮੈਟਾਡਾਟਾ — ਪ੍ਰੈਸਿੰਗ ਖੇਤਰ ਖਾਲੀ ਰਹਿੰਦੇ ਹਨ; ਸਿਰਫ਼ ਐਲਬਮ ਸਮੂਹ ਦਰਜ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเมทาดาทา — ช่องข้อมูลรุ่นกดแผ่นจะเว้นว่าง บันทึกเฉพาะกลุ่มอัลบั้ม"
          }
        }
      }
    },
