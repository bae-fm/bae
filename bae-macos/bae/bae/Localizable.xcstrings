    "The password is kept in this Mac’s keychain. Clients sign in with the username and password." : {
      "comment" : "Subsonic settings: password section footer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ كلمة السر في سلسلة مفاتيح هذا الـ Mac. تُسجّل البرامج العميلة الدخول باسم المستخدم وكلمة السر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паролата се пази в ключодържателя на този Mac. Клиентите влизат с потребителското име и паролата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslo je uloženo v klíčence tohoto Macu. Klienti se přihlašují uživatelským jménem a heslem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgangskoden opbevares i denne Macs nøglering. Klienterne logger ind med brugernavnet og adgangskoden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password is kept in this Mac’s keychain. Clients sign in with the username and password."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort wird im Schlüsselbund dieses Mac aufbewahrt. Clients melden sich mit Benutzername und Passwort an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός πρόσβασης φυλάσσεται στην Κλειδοθήκη αυτού του Mac. Οι πελάτες συνδέονται με το όνομα χρήστη και τον κωδικό πρόσβασης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña se guarda en el llavero de este Mac. Los clientes inician sesión con el nombre de usuario y la contraseña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salasana säilytetään tämän Macin avainnipussa. Asiakkaat kirjautuvat sisään käyttäjätunnuksella ja salasanalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe est conservé dans le trousseau de ce Mac. Les clients se connectent avec le nom d’utilisateur et le mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסיסמה נשמרת בצרור המפתחות של ה-Mac הזה. לקוחות מתחברים עם שם המשתמש והסיסמה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lozinka se čuva u privjesku ključeva ovog Maca. Klijenti se prijavljuju korisničkim imenom i lozinkom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelszó a Mac kulcstartójában van tárolva. A kliensek felhasználónévvel és jelszóval jelentkeznek be."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password viene conservata nel portachiavi di questo Mac. I client accedono con nome utente e password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードはこの Mac のキーチェーンに保管されます。クライアントはユーザー名とパスワードでサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 이 Mac의 키체인에 보관됩니다. 클라이언트는 사용자 이름과 암호로 로그인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
