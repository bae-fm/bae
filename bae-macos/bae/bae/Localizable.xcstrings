            "value": "Otvara preglednik za autorizaciju aplikacije bae putem %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 bae를 인증하도록 브라우저를 엽니다."
          }
        },
