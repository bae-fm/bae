    "Saved — couldn't validate yet (offline). Will retry.": {
      "comment": "Discogs settings: unvalidated key status (offline)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved — couldn't validate yet (offline). Will retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada — aún no se pudo validar (sin conexión). Se reintentará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré — validation impossible pour l'instant (hors ligne). Nouvelle tentative à venir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert — konnte noch nicht überprüft werden (offline). Wird erneut versucht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo — ainda não foi possível validar (offline). Tentaremos novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました — まだ検証できません（オフライン）。再試行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 — 暂时无法校验（离线）。将重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ — تعذّر التحقق بعد (دون اتصال). ستتم إعادة المحاولة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר — לא ניתן לאמת עדיין (לא מקוון). ינסה שוב."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено — поки не вдалося підтвердити (офлайн). Буде повторено."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазено — все още не може да се потвърди (офлайн). Ще се опита отново."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano — nie udało się jeszcze zweryfikować (offline). Ponowi próbę."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo — zatím nelze ověřit (offline). Zkusí se znovu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeno — provjera još nije moguća (izvanmrežno). Pokušat će ponovno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장됨 — 아직 검증할 수 없습니다(오프라인). 다시 시도합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存 — 尚無法驗證（離線）。將重試。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato — impossibile convalidare ora (offline). Riproverà."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedildi — henüz doğrulanamadı (çevrimdışı). Yeniden denenecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu — chưa thể xác thực (ngoại tuyến). Sẽ thử lại."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard — kon nog niet valideren (offline). Probeert opnieuw."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया — अभी सत्यापित नहीं हो सका (ऑफलाइन)। दोबारा कोशिश होगी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত — এখনও যাচাই করা যায়নি (অফলাইন)। আবার চেষ্টা করা হবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமிக்கப்பட்டது — இன்னும் சரிபார்க்க முடியவில்லை (இணையமில்லை). மீண்டும் முயற்சிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ అయింది — ఇంకా ధృవీకరించలేకపోయింది (ఆఫ్‌లైన్). మళ్లీ ప్రయత్నిస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जतन झाले — अजून वैधता तपासता आली नाही (ऑफलाइन). पुन्हा प्रयत्न करेल."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ ہو گیا — ابھی توثیق نہیں ہو سکی (آف لائن)۔ دوبارہ کوشش ہو گی۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાચવ્યું — હજી માન્ય કરી શકાયું નથી (ઑફલાઇન). ફરી પ્રયાસ થશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿಸಲಾಗಿದೆ — ಇನ್ನೂ ಮಾನ್ಯಗೊಳಿಸಲಾಗಲಿಲ್ಲ (ಆಫ್‌ಲೈನ್). ಮರುಪ್ರಯತ್ನಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംരക്ഷിച്ചു — ഇതുവരെ സാധൂകരിക്കാനായില്ല (ഓഫ്‌ലൈൻ). വീണ്ടും ശ്രമിക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੰਭਾਲਿਆ — ਹਾਲੇ ਪਰਖਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ (ਆਫਲਾਈਨ)। ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕੀਤੀ ਜਾਵੇਗੀ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแล้ว — ยังตรวจสอบไม่ได้ (ออฟไลน์) จะลองอีกครั้ง"
          }
        }
      }
    },
