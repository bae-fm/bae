    "Put the file back where it was when it was imported, then retry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد الملف إلى مكانه وقت استيراده، ثم أعد المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Върнете файла там, където беше при импортирането, и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraťte soubor tam, kde byl při importu, a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg filen tilbage, hvor den lå ved importen, og prøv så igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege die Datei wieder dorthin, wo sie beim Import war, und versuche es dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρετε το αρχείο εκεί που ήταν κατά την εισαγωγή και δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a poner el archivo donde estaba al importarlo y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauta tiedosto paikkaan, jossa se oli tuotaessa, ja yritä sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remettez le fichier là où il était lors de l’importation, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החזר את הקובץ למקום שבו היה בזמן הייבוא ואז נסה שוב."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vratite datoteku tamo gdje je bila pri uvozu, a zatim pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tedd vissza a fájlt oda, ahol az importáláskor volt, majd próbáld újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimetti il file dov’era al momento dell’importazione, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込み時にあった場所にファイルを戻してから、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져올 때 있던 위치로 파일을 되돌린 다음 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg filen tilbake der den lå ved importen, og prøv så igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet het bestand terug waar het stond bij het importeren en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywróć plik tam, gdzie był podczas importu, a potem ponów próbę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o arquivo de volta onde estava ao ser importado e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte a colocar o ficheiro onde estava quando foi importado e tente novamente."
