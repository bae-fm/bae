    "Camera access is off. Enable it in System Settings, or paste the code below." : {
      "comment" : "QR scanner: camera permission denied; offers the paste fallback",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الكاميرا متوقف. فعّله من إعدادات النظام، أو الصق الرمز أدناه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достъпът до камерата е изключен. Включете го в системните настройки или поставете кода по-долу."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup ke kameře je vypnutý. Zapněte ho v nastavení systému, nebo vložte kód níže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til kameraet er slået fra. Slå det til i Systemindstillinger, eller indsæt koden nedenfor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is off. Enable it in System Settings, or paste the code below."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kamerazugriff ist aus. Aktiviere ihn in den Systemeinstellungen oder füge den Code unten ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στην κάμερα είναι απενεργοποιημένη. Ενεργοποιήστε τη στις Ρυθμίσεις συστήματος ή επικολλήστε τον παρακάτω κωδικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está desactivado. Actívalo en Ajustes del Sistema o pega el código abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameran käyttöoikeus on pois päältä. Laita se päälle Järjestelmäasetuksissa tai liitä alla oleva koodi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la caméra est désactivé. Activez-le dans Réglages Système, ou collez le code ci-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה למצלמה כבויה. הפעל אותה בהגדרות המערכת, או הדבק את הקוד למטה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup kameri je isključen. Uključite ga u postavkama sustava ili zalijepite kôd ispod."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kamera hozzáférése ki van kapcsolva. Kapcsold be a Rendszerbeállításokban, vagy illeszd be az alábbi kódot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso alla fotocamera è disattivato. Attivalo in Impostazioni di Sistema, oppure incolla il codice qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスがオフです。システム設定で有効にするか、下にコードを貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 접근이 꺼져 있습니다. 시스템 설정에서 켜거나 아래에 코드를 붙여넣으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameratilgangen er av. Slå den på i Systeminnstillinger, eller lim inn koden nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cameratoegang staat uit. Zet dit aan in Systeeminstellingen, of plak de code hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do kamery jest wyłączony. Włącz go w Ustawieniach systemowych lub wklej kod poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmera está desativado. Ative-o nos Ajustes do Sistema ou cole o código abaixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmara está desligado. Ative-o nas Definições do Sistema ou cole o código abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesul la cameră este dezactivat. Activează-l în Configurări sistem sau lipește codul de mai jos."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prístup ku kamere je vypnutý. Zapni ho v Nastaveniach systému alebo prilep kód nižšie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraåtkomsten är avstängd. Slå på den i Systeminställningar, eller klistra in koden nedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera erişimi kapalı. Sistem Ayarları'ndan aç veya kodu aşağıya yapıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до камери вимкнено. Увімкніть його в системних налаштуваннях або вставте код нижче."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机访问权限已关闭。请在系统设置中启用，或在下方粘贴代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機取用權限已關閉。請在系統設定中啟用，或在下方貼上代碼。"
          }
        }
      }
    },
