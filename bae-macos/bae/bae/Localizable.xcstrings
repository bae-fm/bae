    "You will not be able to recover this library without a restore code." : {
      "comment" : "Welcome screen: confirmation dialog message for removing a keychain restore entry",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تتمكن من استعادة هذه المكتبة بدون رمز استعادة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма да можете да възстановите тази библиотека без код за възстановяване."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez kódu pro obnovení nebudete moci tuto knihovnu obnovit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Wiederherstellungscode kannst du diese Bibliothek nicht wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will not be able to recover this library without a restore code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No podrás recuperar esta biblioteca sin un código de restauración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pourrez pas récupérer cette bibliothèque sans code de restauration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא תוכלו לשחזר ספרייה זו ללא קוד שחזור."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez koda za vraćanje nećete moći oporaviti ovu fonoteku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visszaállítási kód nélkül nem tudod helyreállítani ezt a könyvtárat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non potrai recuperare questa libreria senza un codice di ripristino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元コードがないと、このライブラリを復元できなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원 코드 없이는 이 라이브러리를 복구할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt deze bibliotheek niet herstellen zonder herstelcode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez kodu przywracania nie będzie można odzyskać tej biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não conseguirá recuperar esta biblioteca sem um código de restauração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără un cod de restaurare nu vei putea recupera această bibliotecă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez kódu na obnovenie túto knižnicu nedokážeš obnoviť."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir geri yükleme kodu olmadan bu kitaplığı kurtaramazsınız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви не зможете відновити цю бібліотеку без коду відновлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有恢复代码，你将无法恢复此库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有還原碼，你將無法復原此資料庫。"
          }
        }
      }
    },
    "You're not signed into iCloud. Open System Settings → Apple ID to sign in, then try again." : {
      "comment" : "Sync failure: CloudKit refused because no iCloud account is signed in",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تسجّل الدخول إلى iCloud. افتح إعدادات النظام ← Apple ID لتسجيل الدخول، ثم أعد المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не сте влезли в iCloud. Отворете „Системни настройки“ → Apple ID, влезте и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejste přihlášeni k iCloudu. Otevřete Nastavení systému → Apple ID, přihlaste se a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist nicht bei iCloud angemeldet. Öffne „Systemeinstellungen“ → Apple-ID, melde dich an und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're not signed into iCloud. Open System Settings → Apple ID to sign in, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No has iniciado sesión en iCloud. Abre Ajustes del Sistema → Apple ID para iniciar sesión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'êtes pas connecté à iCloud. Ouvrez Réglages Système → Identifiant Apple pour vous connecter, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אינך מחובר ל-iCloud. פתח את הגדרות המערכת ← Apple ID כדי להתחבר, ואז נסה שוב."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niste prijavljeni na iCloud. Otvorite Postavke sustava → Apple ID i prijavite se, zatim pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem vagy bejelentkezve az iCloudba. Nyisd meg a Rendszerbeállítások → Apple-fiók menüpontot, jelentkezz be, majd próbáld újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai eseguito l'accesso a iCloud. Apri Impostazioni di Sistema → ID Apple per accedere, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudにサインインしていません。「システム設定」→「Apple ID」でサインインしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에 로그인되어 있지 않습니다. 시스템 설정 → Apple ID에서 로그인한 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent niet ingelogd bij iCloud. Open Systeeminstellingen → Apple ID om in te loggen en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zalogowano do iCloud. Otwórz Ustawienia systemowe → Apple ID, zaloguj się i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não está conectado ao iCloud. Abra Ajustes do Sistema → ID Apple para entrar e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ești conectat la iCloud. Deschide Configurări sistem → Apple ID, conectează-te, apoi încearcă din nou."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie si prihlásený do iCloudu. Otvor Nastavenia systému → Apple ID, prihlás sa a skús to znova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud'da oturum açmadınız. Oturum açmak için Sistem Ayarları → Apple Kimliği'ni açın, sonra yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви не увійшли в iCloud. Відкрийте «Системні параметри» → Apple ID, увійдіть і повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你尚未登录 iCloud。请打开“系统设置”→“Apple ID”登录后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你尚未登入 iCloud。請打開「系統設定」→「Apple ID」登入後再試一次。"
          }
        }
      }
    },
    "Your iCloud storage is full. Free up space in System Settings → Apple ID → iCloud to keep syncing." : {
      "comment" : "Sync failure: the iCloud account is out of storage",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساحة تخزين iCloud لديك ممتلئة. حرّر مساحة من إعدادات النظام ← Apple ID ← iCloud لمواصلة المزامنة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилището ви в iCloud е пълно. Освободете място в „Системни настройки“ → Apple ID → iCloud, за да продължите да синхронизирате."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše úložiště iCloud je plné. Uvolněte místo v Nastavení systému → Apple ID → iCloud, aby synchronizace pokračovala."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iCloud-Speicher ist voll. Gib in „Systemeinstellungen“ → Apple-ID → iCloud Speicher frei, um weiter zu synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iCloud storage is full. Free up space in System Settings → Apple ID → iCloud to keep syncing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu almacenamiento de iCloud está lleno. Libera espacio en Ajustes del Sistema → Apple ID → iCloud para seguir sincronizando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre stockage iCloud est plein. Libérez de l'espace dans Réglages Système → Identifiant Apple → iCloud pour continuer la synchronisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחסון ה-iCloud שלך מלא. פנה מקום בהגדרות המערכת ← Apple ID ← iCloud כדי להמשיך לסנכרן."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša iCloud pohrana je puna. Oslobodite prostor u Postavke sustava → Apple ID → iCloud kako bi se sinkronizacija nastavila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iCloud-tárhelyed megtelt. Szabadíts fel helyet a Rendszerbeállítások → Apple-fiók → iCloud alatt, hogy a szinkronizálás folytatódjon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo spazio iCloud è pieno. Libera spazio in Impostazioni di Sistema → ID Apple → iCloud per continuare la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudストレージがいっぱいです。同期を続けるには「システム設定」→「Apple ID」→「iCloud」で空き容量を作ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 저장 공간이 가득 찼습니다. 동기화를 계속하려면 시스템 설정 → Apple ID → iCloud에서 공간을 확보하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je iCloud-opslag is vol. Maak ruimte vrij in Systeeminstellingen → Apple ID → iCloud om te blijven synchroniseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja pamięć iCloud jest pełna. Zwolnij miejsce w Ustawienia systemowe → Apple ID → iCloud, aby dalej synchronizować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu armazenamento do iCloud está cheio. Libere espaço em Ajustes do Sistema → ID Apple → iCloud para continuar sincronizando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spațiul tău iCloud este plin. Eliberează spațiu în Configurări sistem → Apple ID → iCloud pentru a continua sincronizarea."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje úložisko iCloud je plné. Uvoľni miesto v Nastaveniach systému → Apple ID → iCloud, aby sa synchronizácia nezastavila."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud depolama alanınız dolu. Eşitlemeyi sürdürmek için Sistem Ayarları → Apple Kimliği → iCloud'da yer açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше сховище iCloud заповнене. Звільніть місце в «Системні параметри» → Apple ID → iCloud, щоб синхронізація тривала."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iCloud 存储空间已满。请在“系统设置”→“Apple ID”→“iCloud”中释放空间以继续同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iCloud 儲存空間已滿。請在「系統設定」→「Apple ID」→「iCloud」中釋放空間以繼續同步。"
          }
        }
      }
    },
