        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per connetterti, [ottieni la tua chiave API gratuita](https://www.discogs.com/settings/developers) e incollala sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
