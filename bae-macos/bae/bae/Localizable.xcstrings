    "Camera access is off. Enable it in System Settings, or paste the code below." : {
      "comment" : "QR scanner: camera permission denied; offers the paste fallback",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الكاميرا متوقف. فعّله من إعدادات النظام، أو الصق الرمز أدناه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достъпът до камерата е изключен. Включете го в системните настройки или поставете кода по-долу."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্যামেরা অ্যাক্সেস বন্ধ। সিস্টেম সেটিংসে এটি চালু করুন, বা নিচে কোডটি পেস্ট করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup ke kameře je vypnutý. Zapněte ho v nastavení systému, nebo vložte kód níže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kamerazugriff ist aus. Aktiviere ihn in den Systemeinstellungen oder füge den Code unten ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is off. Enable it in System Settings, or paste the code below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está desactivado. Actívalo en Ajustes del Sistema o pega el código abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la caméra est désactivé. Activez-le dans Réglages Système, ou collez le code ci-dessous."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કૅમેરા ઍક્સેસ બંધ છે. સિસ્ટમ સેટિંગ્સમાં તેને ચાલુ કરો, અથવા નીચે કોડ પેસ્ટ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה למצלמה כבויה. הפעל אותה בהגדרות המערכת, או הדבק את הקוד למטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरा एक्सेस बंद है. सिस्टम सेटिंग्स में इसे चालू करें, या नीचे कोड पेस्ट करें."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup kameri je isključen. Uključite ga u postavkama sustava ili zalijepite kôd ispod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso alla fotocamera è disattivato. Attivalo in Impostazioni di Sistema, oppure incolla il codice qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスがオフです。システム設定で有効にするか、下にコードを貼り付けてください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕ್ಯಾಮೆರಾ ಪ್ರವೇಶ ಆಫ್ ಆಗಿದೆ. ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್ಸ್‌ನಲ್ಲಿ ಅದನ್ನು ಆನ್ ಮಾಡಿ, ಅಥವಾ ಕೆಳಗೆ ಕೋಡ್ ಅಂಟಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 접근이 꺼져 있습니다. 시스템 설정에서 켜거나 아래에 코드를 붙여넣으세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ക്യാമറ ആക്സസ് ഓഫാണ്. സിസ്റ്റം സെറ്റിംഗ്സിൽ ഇത് ഓണാക്കുക, അല്ലെങ്കിൽ താഴെ കോഡ് ഒട്ടിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॅमेरा प्रवेश बंद आहे. सिस्टम सेटिंग्जमध्ये तो चालू करा, किंवा खाली कोड पेस्ट करा."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cameratoegang staat uit. Zet dit aan in Systeeminstellingen, of plak de code hieronder."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੈਮਰਾ ਪਹੁੰਚ ਬੰਦ ਹੈ। ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇਸਨੂੰ ਚਾਲੂ ਕਰੋ, ਜਾਂ ਹੇਠਾਂ ਕੋਡ ਪੇਸਟ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do kamery jest wyłączony. Włącz go w Ustawieniach systemowych lub wklej kod poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmera está desativado. Ative-o nos Ajustes do Sistema ou cole o código abaixo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கேமரா அணுகல் முடக்கப்பட்டுள்ளது. கணினி அமைப்புகளில் அதை இயக்கவும், அல்லது கீழே குறியீட்டை ஒட்டவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కెమెరా యాక్సెస్ ఆఫ్‌లో ఉంది. సిస్టమ్ సెట్టింగ్స్‌లో దాన్ని ఆన్ చేయండి, లేదా కింద కోడ్‌ను అతికించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าถึงกล้องถูกปิดอยู่ เปิดได้ในการตั้งค่าระบบ หรือวางรหัสด้านล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera erişimi kapalı. Sistem Ayarları'ndan aç veya kodu aşağıya yapıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до камери вимкнено. Увімкніть його в системних налаштуваннях або вставте код нижче."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیمرا رسائی بند ہے۔ سسٹم سیٹنگز میں اسے آن کریں، یا نیچے کوڈ پیسٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập camera đang tắt. Bật trong Cài đặt Hệ thống, hoặc dán mã bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机访问权限已关闭。请在系统设置中启用，或在下方粘贴代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機取用權限已關閉。請在系統設定中啟用，或在下方貼上代碼。"
          }
        }
      }
    },
