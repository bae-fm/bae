        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia una cartella da importare, non un file"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya değil, içe aktarmak için klasör bırakın"
          }
