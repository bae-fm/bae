    "Scan this QR code or paste the code on another device to sync this library there.": {
      "comment": "Device-pairing sheet: instructional caption",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this QR code or paste the code on another device to sync this library there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código QR o pega el código en otro dispositivo para sincronizar esta biblioteca allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce code QR ou collez le code sur un autre appareil pour y synchroniser cette bibliothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen QR-Code oder füge den Code auf einem anderen Gerät ein, um diese Bibliothek dort zu synchronisieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie este QR code ou cole o código em outro dispositivo para sincronizar esta biblioteca lá."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスでこのQRコードをスキャンするかコードを貼り付けて、このライブラリをそこに同期します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一台设备上扫描此二维码或粘贴代码，即可将此库同步到那里。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR هذا أو الصق الرمز على جهاز آخر لمزامنة هذه المكتبة هناك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרקו קוד QR זה או הדביקו את הקוד במכשיר אחר כדי לסנכרן את הספרייה הזו שם."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відскануйте цей QR-код або вставте код на іншому пристрої, щоб синхронізувати цю бібліотеку там."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирайте този QR код или поставете кода на друго устройство, за да синхронизирате тази библиотека там."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj ten kod QR lub wklej kod na innym urządzeniu, aby zsynchronizować tam tę bibliotekę."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naskenujte tento QR kód nebo vložte kód na jiném zařízení, abyste tam tuto knihovnu synchronizovali."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenirajte ovaj QR kod ili zalijepite kod na drugom uređaju kako biste tamo sinkronizirali ovu fonoteku."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 QR 코드를 스캔하거나 다른 기기에 코드를 붙여 넣어 이 라이브러리를 그곳에서 동기화하세요."
          }
        }
      }
    },
