    "Choose where this library is kept. Everything is encrypted on this Mac before it's uploaded." : {
      "comment" : "Set up sync's sheet: the line above the list of storage providers.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر المكان الذي تُحفظ فيه هذه المكتبة. يُشفَّر كل شيء على هذا الـ Mac قبل رفعه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете къде се съхранява тази библиотека. Всичко се криптира на този Mac, преди да бъде качено."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, kde se tato knihovna uchovává. Vše se na tomto Macu zašifruje před nahráním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvor dette bibliotek opbevares. Alt krypteres på denne Mac, før det uploades."
