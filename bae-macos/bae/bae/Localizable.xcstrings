    "Another copy of this device's library is syncing as this device." : {
      "comment" : "Why a change this device asked for was never made here: a copy of this device's library, such as one moved to another computer, syncs under this device's identity. That copy may still make the change.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخة أخرى من مكتبة هذا الجهاز تتزامن باسم هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Друго копие на библиотеката на това устройство се синхронизира като това устройство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiná kopie knihovny tohoto zařízení se synchronizuje jako toto zařízení."
