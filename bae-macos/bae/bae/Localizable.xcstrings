        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitaplığınızda zaten bulunan bir cihazda gösterilen eşleştirme kodunu tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відскануйте код сполучення, показаний на пристрої, який уже є у вашій бібліотеці."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے کتب خانے میں پہلے سے موجود آلے پر دکھایا گیا جوڑی بنانے کا رمز اسکین کریں۔"
          }
