    "Pick the release you have, or dismiss the signal you trust less.": {
      "comment": "Import search: conflict banner subtitle prompting a choice",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the release you have, or dismiss the signal you trust less."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la edición que tienes o descarta la señal en la que confías menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'édition que vous possédez, ou écartez le signal en lequel vous avez le moins confiance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Veröffentlichung, die du hast, oder verwirf das Signal, dem du weniger vertraust."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o lançamento que você tem ou descarte o sinal em que confia menos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お持ちのリリースを選ぶか、信頼度の低いシグナルを除外してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你拥有的版本，或忽略你不太信任的信号。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الإصدار الذي لديك، أو تجاهل الإشارة التي تثق بها أقل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו את המהדורה שברשותכם, או בטלו את האות שאתם פחות סומכים עליו."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть реліз, який у вас є, або відхиліть сигнал, якому довіряєте менше."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете изданието, което имате, или отхвърлете сигнала, на който се доверявате по-малко."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wydanie, które masz, lub odrzuć mniej zaufany sygnał."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte vydání, které máte, nebo zamítněte signál, kterému méně důvěřujete."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite izdanje koje imate ili odbacite signal kojem manje vjerujete."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가지고 있는 릴리스를 선택하거나 덜 신뢰하는 신호를 닫으세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你擁有的發行，或忽略你較不信任的訊號。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la pubblicazione che hai o ignora il segnale meno affidabile."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elinizdeki yayını seçin veya daha az güvendiğiniz sinyali kapatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn bản phát hành bạn có hoặc bỏ qua tín hiệu bạn ít tin hơn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de release die je hebt, of negeer het signaal dat je minder vertrouwt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास जो रिलीज है उसे चुनें, या जिस संकेत पर कम भरोसा है उसे हटाएं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার থাকা রিলিজটি বাছুন, অথবা যে সংকেত কম বিশ্বাস করেন তা সরিয়ে দিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களிடம் உள்ள வெளியீட்டைத் தேர்வு செய், அல்லது நீங்கள் குறைவாக நம்பும் சைகையை நீக்கு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ దగ్గర ఉన్న విడుదలను ఎంచుకోండి, లేదా మీరు తక్కువగా నమ్మే సంకేతాన్ని తొలగించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्याकडे असलेले प्रकाशन निवडा, किंवा कमी विश्वास असलेला संकेत बाद करा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی اشاعت منتخب کریں، یا جس اشارے پر کم اعتماد ہے اسے بند کریں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી પાસે જે પ્રકાશન છે તે પસંદ કરો, અથવા જે સંકેત પર ઓછો ભરોસો હોય તેને બંધ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮಲ್ಲಿರುವ ಬಿಡುಗಡೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ, ಅಥವಾ ನೀವು ಕಡಿಮೆ ನಂಬುವ ಸಂಕೇತವನ್ನು ತಳ್ಳಿಹಾಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളിലുള്ള പതിപ്പ് തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ കുറച്ച് വിശ്വാസമുള്ള സൂചന ഒഴിവാക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀ ਰਿਲੀਜ਼ ਚੁਣੋ, ਜਾਂ ਜਿਸ ਸੰਕੇਤ ਤੇ ਘੱਟ ਭਰੋਸਾ ਹੈ ਉਸਨੂੰ ਹਟਾਓ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรีลีสที่คุณมี หรือปิดสัญญาณที่คุณเชื่อถือน้อยกว่า"
          }
        }
      }
    },
