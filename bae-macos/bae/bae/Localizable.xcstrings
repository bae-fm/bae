    "Saved — couldn't validate yet (offline). Will retry.": {
      "comment": "Discogs settings: unvalidated key status (offline)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved — couldn't validate yet (offline). Will retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada — aún no se pudo validar (sin conexión). Se reintentará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré — validation impossible pour l'instant (hors ligne). Nouvelle tentative à venir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert — konnte noch nicht überprüft werden (offline). Wird erneut versucht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo — ainda não foi possível validar (offline). Tentaremos novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました — まだ検証できません（オフライン）。再試行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 — 暂时无法校验（离线）。将重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ — تعذّر التحقق بعد (دون اتصال). ستتم إعادة المحاولة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר — לא ניתן לאמת עדיין (לא מקוון). ינסה שוב."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено — поки не вдалося підтвердити (офлайн). Буде повторено."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазено — все още не може да се потвърди (офлайн). Ще се опита отново."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano — nie udało się jeszcze zweryfikować (offline). Ponowi próbę."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo — zatím nelze ověřit (offline). Zkusí se znovu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeno — provjera još nije moguća (izvanmrežno). Pokušat će ponovno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장됨 — 아직 검증할 수 없습니다(오프라인). 다시 시도합니다."
          }
        }
      }
    },
    "Saves the current track, position, queue, and volume on quit and restores them on next launch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the current track, position, queue, and volume on quit and restores them on next launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la pista actual, la posición, la cola y el volumen al salir y los restaura en el próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre la piste, la position, la file et le volume actuels à la fermeture et les restaure au prochain lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert beim Beenden den aktuellen Titel, die Position, die Warteschlange und die Lautstärke und stellt sie beim nächsten Start wieder her."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva a faixa, posição, fila e volume atuais ao sair e os restaura na próxima abertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時に現在のトラック、再生位置、キュー、音量を保存し、次回起動時に復元します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出时保存当前曲目、播放位置、队列和音量，并在下次启动时恢复。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ المقطوعة الحالية والموضع وقائمة الانتظار ومستوى الصوت عند الخروج ويستعيدها عند التشغيل التالي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר את הרצועה הנוכחית, המיקום, התור והעוצמה ביציאה ומשחזר אותם בהפעלה הבאה."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає поточний трек, позицію, чергу та гучність під час виходу й відновлює їх під час наступного запуску."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазва текущата песен, позиция, опашка и сила на звука при изход и ги възстановява при следващото стартиране."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje bieżący utwór, pozycję, kolejkę i głośność przy zamknięciu i przywraca je przy następnym uruchomieniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při ukončení uloží aktuální skladbu, pozici, frontu a hlasitost a při příštím spuštění je obnoví."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprema trenutnu skladbu, položaj, red i glasnoću pri izlasku te ih vraća pri sljedećem pokretanju."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시 현재 트랙, 위치, 대기열, 음량을 저장하고 다음 실행 때 복원합니다."
          }
        }
      }
    },
