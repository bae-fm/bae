            "state": "translated",
            "value": "復元コードを貼り付けるか、詳細を手動で入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴你的恢复代码，或手动输入详情。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رمز الاستعادة، أو أدخل التفاصيل يدويًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדביקו את קוד השחזור, או הזינו פרטים ידנית."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте код відновлення або введіть дані вручну."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставете кода си за възстановяване или въведете детайлите ръчно."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej kod przywracania lub wprowadź dane ręcznie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte kód pro obnovení nebo zadejte údaje ručně."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijepite kod za vraćanje ili unesite pojedinosti ručno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원 코드를 붙여 넣거나 세부 정보를 직접 입력하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上你的還原碼，或手動輸入詳細資料。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il tuo codice di ripristino o inserisci i dettagli manualmente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme kodunuzu yapıştırın veya ayrıntıları elle girin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán mã khôi phục của bạn hoặc nhập chi tiết thủ công."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak je herstelcode of voer gegevens handmatig in."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना बहाली कोड पेस्ट करें, या विवरण हाथ से दर्ज करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রিস্টোর কোড পেস্ট করুন, অথবা হাতে বিবরণ লিখুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மீட்டமைப்பு குறியீட்டை ஒட்டவும், அல்லது விவரங்களை கைமுறையாக உள்ளிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పునరుద్ధరణ కోడ్‌ను అతికించండి, లేదా వివరాలను చేతితో నమోదు చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा पुनर्संचयित संकेत पेस्ट करा, किंवा तपशील हाताने प्रविष्ट करा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا بحالی رمز پیسٹ کریں، یا تفصیلات ہاتھ سے درج کریں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો પુનઃસ્થાપન કોડ ચોંટાડો, અથવા વિગતો હાથેથી દાખલ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮರುಸ್ಥಾಪನೆ ಕೋಡ್ ಅಂಟಿಸಿ, ಅಥವಾ ವಿವರಗಳನ್ನು ಕೈಯಾರೆ ನಮೂದಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പുനഃസ്ഥാപന കോഡ് ഒട്ടിക്കുക, അല്ലെങ്കിൽ വിശദാംശങ്ങൾ നേരിട്ട് നൽകുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣਾ ਮੁੜ-ਬਹਾਲੀ ਕੋਡ ਪੇਸਟ ਕਰੋ, ਜਾਂ ਵੇਰਵੇ ਹੱਥੋਂ ਦਾਖਲ ਕਰੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางรหัสคืนค่าของคุณ หรือป้อนรายละเอียดด้วยตนเอง"
          }
        }
      }
    },
