        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಿಡುಗಡೆ ಈಗಾಗಲೇ ನಿಮ್ಮ ಗ್ರಂಥಾಲಯದಲ್ಲಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ റിലീസ് ഇതിനകം നിങ്ങളുടെ ലൈബ്രറിയിൽ ഉണ്ട്"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਰਿਲੀਜ਼ ਪਹਿਲਾਂ ਹੀ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਹੈ"
