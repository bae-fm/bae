    "%@'s encryption key will be removed from the keychain. This session keeps working; you'll need to re-enter the key on next launch.": {
      "comment": "Lock Library confirmation alert body; %@ is the library name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s encryption key will be removed from the keychain. This session keeps working; you'll need to re-enter the key on next launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de cifrado de %@ se quitará del llavero. Esta sesión seguirá funcionando; tendrás que volver a introducir la clave en el próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de chiffrement de %@ sera supprimée du trousseau. Cette session reste active ; vous devrez ressaisir la clé au prochain lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verschlüsselungsschlüssel von %@ wird aus dem Schlüsselbund entfernt. Diese Sitzung läuft weiter; beim nächsten Start musst du den Schlüssel erneut eingeben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de criptografia de %@ será removida do keychain. Esta sessão continua funcionando; você precisará inserir a chave novamente na próxima abertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の暗号化キーをキーチェーンから削除します。このセッションは引き続き使用できますが、次回起動時にキーの再入力が必要になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的加密密钥将从钥匙串中移除。当前会话仍可使用；下次启动时需重新输入密钥。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُزال مفتاح تشفير %@ من سلسلة المفاتيح. ستظل هذه الجلسة تعمل؛ وستحتاج إلى إعادة إدخال المفتاح عند التشغيل التالي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח ההצפנה של %@ יוסר ממחזיק המפתחות. ההפעלה הנוכחית תמשיך לעבוד; תצטרכו להזין את המפתח מחדש בהפעלה הבאה."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ шифрування «%@» буде вилучено зі сховища ключів. Поточний сеанс працюватиме далі; під час наступного запуску потрібно буде ввести ключ знову."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът за шифроване на %@ ще бъде премахнат от ключодържателя. Тази сесия продължава да работи; ще трябва да въведете ключа отново при следващото стартиране."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz szyfrujący biblioteki %@ zostanie usunięty z pęku kluczy. Ta sesja działa dalej; przy następnym uruchomieniu trzeba będzie ponownie wprowadzić klucz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovací klíč knihovny %@ bude odstraněn z klíčenky. Toto sezení dál funguje; při příštím spuštění bude nutné klíč zadat znovu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ za šifriranje fonoteke %@ uklonit će se iz privjeska ključeva. Ova sesija nastavlja raditi; pri sljedećem pokretanju morat ćete ponovno unijeti ključ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 암호화 키가 키체인에서 제거됩니다. 이 세션은 계속 작동하지만 다음 실행 때 키를 다시 입력해야 합니다."
          }
        }
      }
    },
