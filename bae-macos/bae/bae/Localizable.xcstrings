          "stringUnit": {
            "state": "translated",
            "value": "bae'yi %@ ile yetkilendirmek için tarayıcınızı açar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở trình duyệt để ủy quyền bae với %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent je browser om bae te autoriseren met %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के साथ bae को अनुमति देने के लिए आपका ब्राउजर खोलता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ দিয়ে bae অনুমোদন করতে আপনার ব্রাউজার খোলে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ உடன் bae-ஐ அங்கீகரிக்க உங்கள் உலாவியைத் திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@తో baeను అధికరించడానికి మీ బ్రౌజర్‌ను తెరుస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सह bae अधिकृत करण्यासाठी तुमचा ब्राउझर उघडतो."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "bae کو %@ کے ساتھ اجازت دینے کے لیے آپ کا براؤزر کھولتا ہے۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ સાથે bae ને અધિકૃત કરવા તમારું બ્રાઉઝર ખોલે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಜೊತೆ bae ಗೆ ಅನುಮತಿ ನೀಡಲು ನಿಮ್ಮ ಬ್ರೌಸರ್ ತೆರೆಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഉപയോഗിച്ച് bae-ന് അനുമതി നൽകാൻ നിങ്ങളുടെ ബ്രൗസർ തുറക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਨਾਲ bae ਨੂੰ ਅਧਿਕਾਰਿਤ ਕਰਨ ਲਈ ਤੁਹਾਡਾ ਬ੍ਰਾਊਜ਼ਰ ਖੋਲ੍ਹਦਾ ਹੈ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเบราว์เซอร์ของคุณเพื่ออนุญาต bae กับ %@"
          }
        }
      }
    },
