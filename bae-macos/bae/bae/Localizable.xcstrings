    "Libraries whose restore codes are saved in your keychain." : {
      "comment" : "Welcome restore list: explains which libraries appear",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
