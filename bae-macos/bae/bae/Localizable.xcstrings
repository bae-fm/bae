        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മെറ്റാഡാറ്റ തിരയാൻ സ്കാൻ ചെയ്ത ഫോൾഡർ തിരഞ്ഞെടുക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਟਾਡਾਟਾ ਖੋਜਣ ਲਈ ਸਕੈਨ ਕੀਤਾ ਫੋਲਡਰ ਚੁਣੋ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์ที่สแกนแล้วเพื่อค้นหาเมทาดาทา"
