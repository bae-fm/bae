    "Are you sure you want to delete this release? This cannot be undone.": {
      "comment": "Album detail: delete-release confirmation message",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this release? This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar esta edición? Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer cette édition ? Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du diese Veröffentlichung wirklich löschen? Das kann nicht rückgängig gemacht werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir este lançamento? Isso não pode ser desfeito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリースを削除してもよろしいですか？この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除此版本吗？此操作无法撤销。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من حذف هذا الإصدار؟ لا يمكن التراجع عن هذا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק את המהדורה הזו? לא ניתן לבטל פעולה זו."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити цей реліз? Цю дію не можна скасувати."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигурни ли сте, че искате да изтриете това издание? Действието е необратимо."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pewno usunąć to wydanie? Tej operacji nie można cofnąć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete toto vydání smazat? Akci nelze vrátit zpět."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste li sigurni da želite izbrisati ovo izdanje? Ovo se ne može poništiti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴리스를 삭제할까요? 되돌릴 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要刪除此發行嗎？此操作無法復原。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero eliminare questa pubblicazione? L'azione non può essere annullata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yayını silmek istediğinizden emin misiniz? Bu işlem geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc muốn xóa bản phát hành này không? Không thể hoàn tác."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze release wilt verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई इस रिलीज को हटाना चाहते हैं? इसे वापस नहीं किया जा सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নিশ্চিত এই রিলিজটি মুছতে চান? এটি ফেরানো যাবে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வெளியீட்டை நீக்க விரும்புகிறீர்களா? இதை மீளச் செய்ய முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ విడుదలను తొలగించాలనుకుంటున్నారా? దీన్ని తిరిగి చేయలేరు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला हे प्रकाशन हटवायचे आहे याची खात्री आहे का? हे पूर्ववत करता येणार नाही."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ واقعی یہ اشاعت حذف کرنا چاہتے ہیں؟ اسے واپس نہیں کیا جا سکے گا۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે ખરેખર આ પ્રકાશન કાઢી નાખવા માંગો છો? આ પાછું કરી શકાશે નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಿಡುಗಡೆ ಅಳಿಸಲು ಖಚಿತವೇ? ಇದನ್ನು ಹಿಂದಿರುಗಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പതിപ്പ് ഇല്ലാതാക്കണമെന്ന് ഉറപ്പാണോ? ഇത് പഴയപടിയാക്കാൻ കഴിയില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਇਹ ਰਿਲੀਜ਼ ਮਿਟਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ? ਇਹ ਵਾਪਸ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แน่ใจหรือไม่ว่าต้องการลบรีลีสนี้ การกระทำนี้ย้อนกลับไม่ได้"
          }
        }
      }
    },
