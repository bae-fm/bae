        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕೆಲವು ಬದಲಾವಣೆಗಳು ಅಪ್‌ಲೋಡ್ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ ಮತ್ತು ಕಳೆದುಹೋಗುತ್ತವೆ."
