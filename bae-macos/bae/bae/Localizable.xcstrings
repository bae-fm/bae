        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബ്രൗസ് ചെയ്യാം — എൻക്രിപ്റ്റ് ചെയ്യാതെ സൂക്ഷിച്ചിരിക്കുന്നു"
