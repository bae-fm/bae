        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બ્રાઉઝ કરી શકાય એવું — એન્ક્રિપ્ટ કર્યા વિના સંગ્રહિત"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬ್ರೌಸ್ ಮಾಡಬಹುದಾದುದು — ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡದೆ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ"
