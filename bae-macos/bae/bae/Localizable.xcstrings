        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మెటాడేటా కోసం వెతకడానికి స్కాన్ చేసిన ఫోల్డర్‌ను ఎంచుకోండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मेटाडेटा शोधण्यासाठी स्कॅन केलेले फोल्डर निवडा"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میٹا ڈیٹا تلاش کرنے کے لیے اسکین شدہ فولڈر منتخب کریں"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મેટાડેટા શોધવા માટે સ્કૅન કરેલું ફોલ્ડર પસંદ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೆಟಾಡೇಟಾ ಹುಡುಕಲು ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ"
