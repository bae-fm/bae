    "The password is stored in the keyring, not in the config file. Clients authenticate with the username and password." : {
      "comment" : "Subsonic settings: password section footer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن كلمة السر في حلقة المفاتيح، لا في ملف التكوين. تُوثِّق البرامج العميلة نفسها باسم المستخدم وكلمة السر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паролата се съхранява в ключодържателя, а не в конфигурационния файл. Клиентите се удостоверяват с потребителското име и паролата."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাসওয়ার্ড কনফিগ ফাইলে নয়, কীরিং-এ সংরক্ষিত থাকে। ক্লায়েন্টরা ইউজারনেম ও পাসওয়ার্ড দিয়ে প্রমাণীকরণ করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslo je uloženo v klíčence, ne v konfiguračním souboru. Klienti se ověřují uživatelským jménem a heslem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort liegt im Schlüsselbund, nicht in der Konfigurationsdatei. Clients authentifizieren sich mit Benutzername und Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password is stored in the keyring, not in the config file. Clients authenticate with the username and password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña se guarda en el llavero, no en el archivo de configuración. Los clientes se autentican con el nombre de usuario y la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe est stocké dans le trousseau, pas dans le fichier de configuration. Les clients s'authentifient avec le nom d'utilisateur et le mot de passe."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પાસવર્ડ કન્ફિગ ફાઇલમાં નહીં, કીરિંગમાં સંગ્રહાય છે. ક્લાયન્ટ વપરાશકર્તા નામ અને પાસવર્ડથી પ્રમાણિત થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסיסמה נשמרת במחזיק המפתחות, לא בקובץ התצורה. לקוחות מזדהים עם שם המשתמש והסיסמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड कॉन्फ़िग फ़ाइल में नहीं, कीरिंग में संग्रहीत होता है. क्लाइंट उपयोगकर्ता नाम और पासवर्ड से प्रमाणित होते हैं."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lozinka se pohranjuje u privjesku ključeva, ne u konfiguracijskoj datoteci. Klijenti se autentificiraju korisničkim imenom i lozinkom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password è conservata nel portachiavi, non nel file di configurazione. I client si autenticano con nome utente e password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードは構成ファイルではなくキーリングに保存されます。クライアントはユーザー名とパスワードで認証します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪಾಸ್‌ವರ್ಡ್ ಕಾನ್ಫಿಗ್ ಫೈಲ್‌ನಲ್ಲಿ ಅಲ್ಲ, ಕೀರಿಂಗ್‌ನಲ್ಲಿ ಸಂಗ್ರಹವಾಗುತ್ತದೆ. ಕ್ಲೈಂಟ್‌ಗಳು ಬಳಕೆದಾರ ಹೆಸರು ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್‌ನಿಂದ ದೃಢೀಕರಿಸುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 구성 파일이 아닌 키링에 저장됩니다. 클라이언트는 사용자 이름과 암호로 인증합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പാസ്‌വേഡ് കോൺഫിഗ് ഫയലിലല്ല, കീറിംഗിലാണ് സൂക്ഷിക്കുന്നത്. ക്ലയന്റുകൾ ഉപയോക്തൃനാമവും പാസ്‌വേഡും ഉപയോഗിച്ച് ഓതന്റിക്കേറ്റ് ചെയ്യുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड कॉन्फिग फाइलमध्ये नाही, कीरिंगमध्ये संग्रहित होतो. क्लायंट वापरकर्तानाव आणि पासवर्डने प्रमाणीकरण करतात."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wachtwoord staat in de sleutelring, niet in het configuratiebestand. Clients verifiëren zich met de gebruikersnaam en het wachtwoord."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪਾਸਵਰਡ ਕੌਨਫਿਗ ਫਾਈਲ ਵਿੱਚ ਨਹੀਂ, ਕੀਰਿੰਗ ਵਿੱਚ ਸਟੋਰ ਹੁੰਦਾ ਹੈ। ਕਲਾਇੰਟ ਵਰਤੋਂਕਾਰ ਨਾਮ ਅਤੇ ਪਾਸਵਰਡ ਨਾਲ ਪ੍ਰਮਾਣਿਤ ਹੁੰਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło jest przechowywane w pęku kluczy, nie w pliku konfiguracyjnym. Klienci uwierzytelniają się nazwą użytkownika i hasłem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha fica armazenada no chaveiro, não no arquivo de configuração. Os clientes se autenticam com o nome de usuário e a senha."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடவுச்சொல் கான்ஃபிக் கோப்பில் அல்ல, கீரிங்கில் சேமிக்கப்படுகிறது. கிளையன்டுகள் பயனர்பெயர் மற்றும் கடவுச்சொல்லால் அங்கீகரிக்கின்றன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పాస్‌వర్డ్ కాన్ఫిగ్ ఫైల్‌లో కాదు, కీరింగ్‌లో నిల్వ అవుతుంది. క్లయింట్‌లు వినియోగదారు పేరు మరియు పాస్‌వర్డ్‌తో ప్రమాణీకరిస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสผ่านถูกเก็บในพวงกุญแจ ไม่ใช่ในไฟล์กำหนดค่า ไคลเอนต์ยืนยันตัวตนด้วยชื่อผู้ใช้และรหัสผ่าน"
