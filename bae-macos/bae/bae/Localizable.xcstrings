          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей реліз буде остаточно видалено з ваших пристроїв і з хмари. Оригінальні файли у ваших теках не буде змінено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
