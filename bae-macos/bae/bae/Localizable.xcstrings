    "Uses iCloud for sync. Requires iCloud to be enabled in System Settings." : {
      "comment" : "Sync wizard: iCloud step explanation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم iCloud للمزامنة. يتطلب تمكين iCloud في إعدادات النظام."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използва iCloud за синхронизиране. Изисква iCloud да е активиран в Системни настройки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিঙ্কের জন্য iCloud ব্যবহার করে। সিস্টেম সেটিংসে iCloud সক্রিয় থাকতে হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K synchronizaci používá iCloud. Vyžaduje zapnutý iCloud v Nastavení systému."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet iCloud für die Synchronisierung. Erfordert, dass iCloud in den Systemeinstellungen aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses iCloud for sync. Requires iCloud to be enabled in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa iCloud para sincronizar. Requiere que iCloud esté activado en los Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise iCloud pour la synchronisation. Nécessite l'activation d'iCloud dans les Réglages Système."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સિંક માટે iCloudનો ઉપયોગ કરે છે. સિસ્ટમ સેટિંગ્સમાં iCloud સક્ષમ હોવું જરૂરી છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משתמש ב-iCloud לסנכרון. דורש ש-iCloud יהיה מופעל בהגדרות המערכת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक के लिए iCloud का उपयोग करता है। सिस्टम सेटिंग्स में iCloud सक्षम होना आवश्यक है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi iCloud za sinkronizaciju. Zahtijeva omogućen iCloud u Postavkama sustava."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa iCloud per la sincronizzazione. Richiede che iCloud sia abilitato nelle Impostazioni di Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期に iCloud を使用します。システム設定で iCloud を有効にする必要があります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಿಂಕ್‌ಗಾಗಿ iCloud ಬಳಸುತ್ತದೆ. ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ iCloud ಸಕ್ರಿಯವಾಗಿರಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화에 iCloud를 사용합니다. 시스템 설정에서 iCloud가 켜져 있어야 합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സിങ്കിന് iCloud ഉപയോഗിക്കുന്നു. സിസ്റ്റം ക്രമീകരണങ്ങളിൽ iCloud സജീവമാക്കിയിരിക്കണം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समक्रमणासाठी iCloud वापरते. सिस्टम सेटिंग्जमध्ये iCloud सक्षम असणे आवश्यक आहे."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt iCloud voor synchronisatie. Vereist dat iCloud is ingeschakeld in Systeeminstellingen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਿੰਕ ਲਈ iCloud ਵਰਤਦਾ ਹੈ। ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ ਵਿੱਚ iCloud ਚਾਲੂ ਹੋਣਾ ਲਾਜ਼ਮੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korzysta z iCloud do synchronizacji. Wymaga włączenia iCloud w Ustawieniach systemowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o iCloud para sincronizar. Requer que o iCloud esteja ativado nas Configurações do Sistema."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒத்திசைவுக்கு iCloud-ஐப் பயன்படுத்துகிறது. கணினி அமைப்புகளில் iCloud இயக்கப்பட்டிருக்க வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సింక్ కోసం iCloudను ఉపయోగిస్తుంది. సిస్టమ్ సెట్టింగ్‌లలో iCloud ప్రారంభించబడాలి."
          }
        },
        "th" : {
          "stringUnit" : {
