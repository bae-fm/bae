          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میٹا ڈیٹا تلاش کرنے کے لیے MusicBrainz یا Discogs میں تلاش کریں"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મેટાડેટા શોધવા માટે MusicBrainz અથવા Discogsમાં શોધો"
          }
        },
        "kn": {
