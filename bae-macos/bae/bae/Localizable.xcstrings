    "Use what these releases share; leave the rest as is" : {
      "comment" : "Find online pane, several pressings of one album offered: what the Not sure button does — the draft takes the fields every listed release agrees on and keeps its own for the rest",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم ما تشترك فيه هذه الإصدارات؛ واترك الباقي كما هو"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвай общото между тези издания; остави останалото както е"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použít to, co mají tato vydání společné; zbytek ponechat beze změny"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug det, disse udgivelser har til fælles; lad resten være"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übernehmen, was diese Veröffentlichungen gemeinsam haben; den Rest so lassen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρήση όσων έχουν κοινά αυτές οι κυκλοφορίες· τα υπόλοιπα μένουν ως έχουν"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use what these releases share; leave the rest as is"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar lo que comparten estos lanzamientos; dejar el resto como está"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä sitä, mikä näillä julkaisuilla on yhteistä; jätä muu ennalleen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser ce que ces sorties ont en commun ; laisser le reste tel quel"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש במה שמשותף למהדורות האלה; השאר את השאר כמו שהוא"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi ono što ova izdanja dijele; ostalo ostavi kako jest"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiadások közös adatainak használata; a többi marad"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa ciò che queste pubblicazioni hanno in comune; lascia il resto com'è"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
