    "Your keys were replaced on another of your devices." : {
      "comment" : "Why a change this device asked for was never made: another of the person's devices replaced their keys, which this device doesn't hold.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استُبدلت مفاتيحك على جهاز آخر من أجهزتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключовете ви бяха заменени на друго ваше устройство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše klíče byly nahrazeny na jiném z vašich zařízení."
