    "This release will be permanently deleted from your devices and the cloud. Original files in your folders won't be touched." : {
      "comment" : "Album detail: delete-release confirmation message",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف هذا الإصدار نهائيًا من أجهزتك ومن السحابة. لن تُمَسّ الملفات الأصلية في مجلداتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това издание ще бъде изтрито завинаги от вашите устройства и от облака. Оригиналните файлове във вашите папки няма да бъдат докоснати."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto vydání bude trvale smazáno z vašich zařízení i z cloudu. Původní soubory ve vašich složkách zůstanou nedotčené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne udgivelse slettes permanent fra dine enheder og fra skyen. De originale filer i dine mapper bliver ikke rørt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Veröffentlichung wird endgültig von deinen Geräten und aus der Cloud gelöscht. Originaldateien in deinen Ordnern werden nicht angetastet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η κυκλοφορία θα διαγραφεί οριστικά από τις συσκευές σας και από το cloud. Τα αρχικά αρχεία στους φακέλους σας δεν θα επηρεαστούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This release will be permanently deleted from your devices and the cloud. Original files in your folders won't be touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta edición se eliminará de forma permanente de tus dispositivos y de la nube. Los archivos originales de tus carpetas no se tocarán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä julkaisu poistetaan pysyvästi laitteiltasi ja pilvestä. Kansioissasi olevia alkuperäisiä tiedostoja ei kosketa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette édition sera supprimée définitivement de vos appareils et du cloud. Les fichiers originaux de vos dossiers ne seront pas modifiés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המהדורה הזו תימחק לצמיתות מהמכשירים שלך ומהענן. הקבצים המקוריים בתיקיות שלך לא ייפגעו."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo izdanje trajno će se izbrisati s vaših uređaja i iz oblaka. Izvorne datoteke u vašim mapama neće se dirati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a kiadás véglegesen törlődik az eszközeidről és a felhőből. A mappáidban lévő eredeti fájlokhoz nem nyúlunk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa pubblicazione verrà eliminata definitivamente dai tuoi dispositivi e dal cloud. I file originali nelle tue cartelle non verranno toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリリースは、お使いのデバイスとクラウドから完全に削除されます。フォルダ内の元のファイルには手を加えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 릴리스가 내 기기와 클라우드에서 영구적으로 삭제됩니다. 내 폴더의 원본 파일은 변경되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne utgivelsen slettes permanent fra enhetene dine og fra skyen. Originalfilene i mappene dine blir ikke rørt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze release wordt definitief van je apparaten en uit de cloud verwijderd. Originele bestanden in je mappen blijven ongemoeid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wydanie zostanie trwale usunięte z Twoich urządzeń i z chmury. Oryginalne pliki w Twoich folderach nie zostaną naruszone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este lançamento será excluído permanentemente dos seus dispositivos e da nuvem. Os arquivos originais nas suas pastas não serão alterados."
