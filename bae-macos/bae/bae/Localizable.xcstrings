    "Formats appear in Save As… on tracks and releases." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الصيغ في \"حفظ باسم…\" للمقاطع والإصدارات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Форматите се показват в \"Запазване като…\" за песни и издания."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফরম্যাটগুলি ট্র্যাক ও রিলিজের \"নামে সংরক্ষণ করুন…\"-এ দেখা যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formáty se zobrazují v nabídce „Uložit jako…“ u stop a vydání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formate erscheinen unter „Speichern unter …“ bei Tracks und Releases."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formats appear in Save As… on tracks and releases."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los formatos aparecen en «Guardar como…» en pistas y lanzamientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les formats apparaissent dans « Enregistrer sous… » pour les pistes et les sorties."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફોર્મેટ ટ્રૅક્સ અને પ્રકાશનો પર \"આ રીતે સાચવો…\"માં દેખાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פורמטים מופיעים ב\"שמור בשם…\" ברצועות ובהוצאות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ॉर्मैट ट्रैक और रिलीज़ पर \"इस रूप में सहेजें…\" में दिखाई देते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formati se prikazuju u \"Spremi kao…\" na pjesmama i izdanjima."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I formati compaiono in \"Salva con nome…\" su brani e pubblicazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーマットはトラックとリリースの「別名で保存…」に表示されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಫಾರ್ಮ್ಯಾಟ್‌ಗಳು ಟ್ರ್ಯಾಕ್ ಮತ್ತು ಬಿಡುಗಡೆಗಳಲ್ಲಿ \"ಹೀಗೆ ಉಳಿಸಿ…\"ನಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "형식은 트랙과 릴리스의 \"다른 이름으로 저장…\"에 표시됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ട്രാക്കുകളിലും പതിപ്പുകളിലും \"ഇങ്ങനെ സംരക്ഷിക്കുക…\" എന്നതിൽ ഫോർമാറ്റുകൾ കാണാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वरूप गाणी आणि प्रकाशनांवर \"म्हणून जतन करा…\" मध्ये दिसतात."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formaten verschijnen in \"Bewaar als…\" bij nummers en releases."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਫਾਰਮੈਟ ਟ੍ਰੈਕ ਅਤੇ ਰਿਲੀਜ਼ਾਂ ’ਤੇ \"ਇਸ ਤਰ੍ਹਾਂ ਸੰਭਾਲੋ…\" ਵਿੱਚ ਦਿਖਾਈ ਦਿੰਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formaty pojawiają się w „Zapisz jako…” przy ścieżkach i wydaniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os formatos aparecem em \"Salvar como…\" em faixas e lançamentos."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வடிவங்கள் பாடல்கள் மற்றும் வெளியீடுகளில் \"இவ்வாறு சேமி…\" இல் தோன்றும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఫార్మాట్‌లు ట్రాక్‌లు మరియు విడుదలలపై \"ఇలా సేవ్ చేయి…\"లో కనిపిస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปแบบจะปรากฏใน \"บันทึกเป็น…\" บนแทร็กและรีลีส"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biçimler, parçalarda ve yayınlarda \"Farklı Kaydet…\" içinde görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Формати з'являються в \"Зберегти як…\" для треків і релізів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فارمیٹس نغموں اور اشاعتوں پر \"بطور محفوظ کریں…\" میں ظاہر ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các định dạng xuất hiện trong \"Lưu thành…\" trên bản nhạc và bản phát hành."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "格式显示在曲目和发行的\"存储为…\"中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "格式會顯示在曲目和發行的「另存為…」中。"
          }
        }
      }
    },
