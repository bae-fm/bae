    "Discogs rejected this key — check it and save again.": {
      "comment": "Discogs settings: 401 rejection of the typed key",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs rejected this key — check it and save again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs rechazó esta clave — compruébala y guárdala de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs a rejeté cette clé — vérifiez-la et enregistrez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs hat diesen Schlüssel abgelehnt — überprüfe ihn und speichere erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Discogs rejeitou esta chave — verifique-a e salve novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogsがこのキーを拒否しました。確認してもう一度保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs 拒绝了此密钥 — 请检查后重新保存。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض Discogs هذا المفتاح — تحقق منه واحفظه مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs דחה את המפתח הזה — בדקו אותו ושמרו שוב."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs відхилив цей ключ — перевірте його та збережіть знову."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs отхвърли този ключ — проверете го и запазете отново."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs odrzucił ten klucz — sprawdź go i zapisz ponownie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs tento klíč odmítl — zkontrolujte jej a uložte znovu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs je odbio ovaj ključ — provjerite ga i ponovno spremite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs가 이 키를 거부했습니다. 확인한 뒤 다시 저장하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs 拒絕此金鑰 — 請檢查後再次儲存。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs ha rifiutato questa chiave — controllala e salva di nuovo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs bu anahtarı reddetti — kontrol edip yeniden kaydedin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs đã từ chối khóa này — hãy kiểm tra rồi lưu lại."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs heeft deze sleutel geweigerd — controleer deze en bewaar opnieuw."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs ने यह कुंजी अस्वीकार कर दी — इसे जांचें और फिर सहेजें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs এই কী প্রত্যাখ্যান করেছে — এটি পরীক্ষা করে আবার সংরক্ষণ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs இந்த விசையை நிராகரித்தது — சரிபார்த்து மீண்டும் சேமிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs ఈ కీని తిరస్కరించింది — దాన్ని తనిఖీ చేసి మళ్లీ సేవ్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs ने ही कळ नाकारली — ती तपासा आणि पुन्हा जतन करा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs نے یہ کلید مسترد کر دی — اسے جانچ کر دوبارہ محفوظ کریں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs એ આ કી નકારી — તેને તપાસો અને ફરી સાચવો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs ಈ ಕೀ ತಿರಸ್ಕರಿಸಿದೆ — ಪರಿಶೀಲಿಸಿ ಮತ್ತೆ ಉಳಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs ഈ കീ നിരസിച്ചു — അത് പരിശോധിച്ച് വീണ്ടും സംരക്ഷിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs ਨੇ ਇਹ ਕੁੰਜੀ ਰੱਦ ਕੀਤੀ — ਇਸਦੀ ਜਾਂਚ ਕਰੋ ਅਤੇ ਮੁੜ ਸੰਭਾਲੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Discogs ปฏิเสธคีย์นี้ — ตรวจสอบแล้วบันทึกอีกครั้ง"
          }
        }
      }
    },
