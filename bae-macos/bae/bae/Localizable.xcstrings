    "It takes one request a second and is sometimes unavailable." : {
      "comment" : "Import settings: popover after Search MusicBrainz, how much it takes and how often it is up",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It takes one request a second and is sometimes unavailable."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقبل طلبًا واحدًا في الثانية وقد يتعذّر الوصول إليه أحيانًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приема една заявка в секунда и понякога не е достъпна."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přijímá jeden požadavek za sekundu a občas není dostupná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tager én forespørgsel i sekundet og er indimellem utilgængelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie nimmt eine Anfrage pro Sekunde an und ist manchmal nicht erreichbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δέχεται ένα αίτημα το δευτερόλεπτο και μερικές φορές δεν είναι διαθέσιμη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admite una petición por segundo y a veces no está disponible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se käsittelee yhden pyynnön sekunnissa eikä ole joskus käytettävissä."
          }
        },
        "fr" : {
