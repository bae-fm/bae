    "The combined draft will be discarded. The original folders and their metadata drafts will return; source files are unchanged." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The combined draft will be discarded. The original folders and their metadata drafts will return; source files are unchanged."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تجاهل المسودة المدمجة. ستعود المجلدات الأصلية ومسودات بياناتها الوصفية؛ ولن تتغير الملفات المصدر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обединената чернова ще бъде отхвърлена. Оригиналните папки и черновите на метаданните им ще се върнат; изходните файлове остават непроменени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sloučený koncept bude zahozen. Původní složky a jejich koncepty metadat se obnoví; zdrojové soubory se nezmění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sammenlagte udkast kasseres. De oprindelige mapper og deres metadataudkast kommer tilbage; kildefilerne er uændrede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der zusammengefasste Entwurf wird verworfen. Die ursprünglichen Ordner und ihre Metadatenentwürfe werden wiederhergestellt; die Quelldateien bleiben unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το συνενωμένο πρόχειρο θα απορριφθεί. Οι αρχικοί φάκελοι και τα πρόχειρα μεταδεδομένων τους επιστρέφουν· τα αρχεία προέλευσης παραμένουν αμετάβλητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descartará el borrador combinado. Se recuperarán las carpetas originales y sus borradores de metadatos; los archivos de origen no cambiarán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistetty luonnos hylätään. Alkuperäiset kansiot ja niiden metatietoluonnokset palaavat; lähdetiedostot säilyvät ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le brouillon combiné sera supprimé. Les dossiers d’origine et leurs brouillons de métadonnées seront restaurés ; les fichiers sources resteront inchangés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטיוטה המשולבת תימחק. התיקיות המקוריות וטיוטות המטא־נתונים שלהן ישוחזרו; קובצי המקור לא ישתנו."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojeni nacrt bit će odbačen. Izvorne mape i njihovi nacrti metapodataka bit će vraćeni; izvorne datoteke ostaju nepromijenjene."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyesített piszkozat elvész. Az eredeti mappák és metaadat-piszkozataik visszatérnek; a forrásfájlok változatlanok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bozza combinata verrà scartata. Verranno ripristinate le cartelle originali e le relative bozze dei metadati; i file di origine rimarranno invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結合した下書きは破棄されます。元のフォルダとメタデータの下書きが復元され、元のファイルは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결합된 초안이 삭제됩니다. 원래 폴더와 메타데이터 초안이 복원되며 원본 파일은 변경되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sammenslåtte utkastet forkastes. De opprinnelige mappene og metadatautkastene deres kommer tilbake; kildefilene er uendret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gecombineerde concept wordt verwijderd. De oorspronkelijke mappen en hun metadataconcepten worden hersteld; de bronbestanden blijven ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączony szkic zostanie odrzucony. Oryginalne foldery i ich szkice metadanych zostaną przywrócone; pliki źródłowe nie ulegną zmianie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O rascunho combinado será descartado. As pastas originais e seus rascunhos de metadados serão restaurados; os arquivos de origem não serão alterados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O rascunho combinado será descartado. As pastas originais e os respetivos rascunhos de metadados voltam; os ficheiros de origem mantêm-se."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciorna combinată va fi eliminată. Dosarele originale și ciornele lor de metadate revin; fișierele sursă rămân neschimbate."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojený návrh sa zahodí. Vrátia sa pôvodné priečinky a ich návrhy metadát; zdrojové súbory zostanú nezmenené."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sammanslagna utkastet kastas. De ursprungliga mapparna och deras metadatautkast kommer tillbaka; källfilerna är oförändrade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birleştirilmiş taslak silinecek. Özgün klasörler ve meta veri taslakları geri gelecek; kaynak dosyalar değişmeyecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Об’єднану чернетку буде відкинуто. Початкові папки та їхні чернетки метаданих буде відновлено; вихідні файли не зміняться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合并的草稿将被丢弃。原始文件夹及其元数据草稿将恢复；源文件不会改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合併的草稿將被捨棄。原始資料夾及其詮釋資料草稿將恢復；來源檔案不會變更。"
          }
        }
      }
    },
