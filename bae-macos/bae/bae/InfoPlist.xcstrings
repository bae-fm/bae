    "NSCameraUsageDescription" : {
      "comment" : "System prompt explaining why code scanning needs camera access.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم bae الكاميرا لمسح رموز الاسترداد والدعوات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae използва камерата за сканиране на кодове за възстановяване и покани."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae používá kameru ke skenování kódů pro obnovení a pozvánek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae bruger kameraet til at scanne gendannelseskoder og invitationer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae uses the camera to scan recovery codes and invitations."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae verwendet die Kamera, um Wiederherstellungscodes und Einladungen zu scannen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το bae χρησιμοποιεί την κάμερα για τη σάρωση κωδικών ανάκτησης και προσκλήσεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae usa la cámara para escanear códigos de recuperación e invitaciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae käyttää kameraa palautuskoodien ja kutsujen skannaamiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae utilise la caméra pour scanner les codes de récupération et les invitations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏bae משתמשת במצלמה כדי לסרוק קודי שחזור והזמנות."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae koristi kameru za skeniranje kodova za oporavak i pozivnica."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bae a kamerával olvassa be a helyreállítási kódokat és a meghívókat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae usa la fotocamera per scansionare codici di recupero e inviti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae は、復旧コードや招待を読み取るためにカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae는 복구 코드와 초대를 스캔하기 위해 카메라를 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae bruker kameraet til å skanne gjenopprettingskoder og invitasjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae gebruikt de camera om herstelcodes en uitnodigingen te scannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae używa aparatu do skanowania kodów odzyskiwania i zaproszeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bae usa a câmera para escanear códigos de recuperação e convites."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bae utiliza a câmara para digitalizar códigos de recuperação e convites."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae folosește camera pentru a scana coduri de recuperare și invitații."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae používa kameru na skenovanie kódov na obnovenie a pozvánok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae använder kameran för att skanna återställningskoder och inbjudningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae, kurtarma kodlarını ve davetleri taramak için kamerayı kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae використовує камеру, щоб сканувати коди відновлення та запрошення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae 使用相机扫描恢复码和邀请。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae 使用相機掃描復原碼和邀請。"
          }
        }
