        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae używa aparatu do skanowania kodów podczas parowania lub odtwarzania biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
