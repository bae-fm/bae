    "NSCameraUsageDescription" : {
      "comment" : "System prompt explaining why code scanning needs camera access.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم bae الكاميرا لمسح الرموز عند إقران مكتبة أو استعادتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae използва камерата за сканиране на кодове при сдвояване или възстановяване на библиотека."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae používá fotoaparát ke skenování kódů při párování nebo obnovení knihovny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae verwendet die Kamera, um beim Koppeln oder Wiederherstellen einer Mediathek Codes zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae uses the camera to scan codes when pairing or recovering a library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae usa la cámara para escanear códigos al vincular o restaurar una biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae utilise la caméra pour scanner des codes lors de l’association ou de la restauration d’une bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏bae משתמש במצלמה כדי לסרוק קודים בעת צימוד או שחזור של ספרייה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae koristi kameru za skeniranje kodova pri uparivanju ili vraćanju biblioteke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae usa la fotocamera per scansionare i codici durante l’abbinamento o il ripristino di una libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae は、ライブラリのペアリングまたは復元時にコードをスキャンするためにカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae는 보관함을 페어링하거나 복원할 때 코드를 스캔하기 위해 카메라를 사용합니다."
