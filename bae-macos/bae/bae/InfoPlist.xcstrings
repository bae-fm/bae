        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae páruje zařízení a vyhledává reproduktory a televizory ve vaší místní síti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bae koppelt Geräte und findet Lautsprecher und Fernseher in deinem lokalen Netzwerk."
          }
