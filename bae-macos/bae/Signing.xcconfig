// macOS app signing config.
//
// The developer team is machine-specific, so it is NOT committed. To build the
// signed app locally, create Signing.local.xcconfig next to this file with your
// team:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//
// That file is gitignored. CI builds with CODE_SIGNING_ALLOWED=NO (the release
// workflow signs separately with the APPLE_TEAM_ID secret), so no team is needed
// there, and this optional include is a no-op when the local file is absent.
#include? "Signing.local.xcconfig"

// Swift compilation conditions (BAE_OAUTH_PROVIDERS / BAE_CLOUDKIT) generated by
// bae-bridge/build-macos.sh from the cargo feature set it compiled the bridge
// with, so the app's #if guards match the generated bindings. Gitignored and
// rewritten on every bridge build; absent before the first build (the optional
// include is then a no-op and the conditions stay empty, matching an S3-only
// bridge until the full default build regenerates it).
#include? "Features.xcconfig"
