// Base build configuration for the iOS app.
//
// The full build's entitlements (CloudKit/iCloud container + keychain). The
// generated Features.xcconfig included below overrides this to
// bae/bae-baeium.entitlements for a baeium (S3-only) build, which drops the
// iCloud-container keys a paid account is required to sign — so a self-build
// with free provisioning can ship. Set here, not in project.yml's
// settings.base, so the later #include can override it (a pbxproj setting would
// win over both).
CODE_SIGN_ENTITLEMENTS = bae/bae.entitlements
//
// The Swift compilation condition (BAE_OAUTH_PROVIDERS, the edition) is
// generated by bae-bridge/build-ios.sh from the cargo feature set it compiled
// the bridge with, so the app's #if guards match the generated bindings. That
// file is gitignored and rewritten on every bridge build; it's absent before
// the first build (this optional include is then a no-op and the condition
// stays unset, matching an S3-only bridge until the default
// oauth-providers,cloudkit build regenerates it).
#include? "Features.xcconfig"
