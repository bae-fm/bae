{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "System prompt explaining why code scanning needs camera access.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم bae الكاميرا لمسح الرموز عند إقران مكتبة أو استعادتها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "bae използва камерата за сканиране на кодове при сдвояване или възстановяване на библиотека."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "bae používá fotoaparát ke skenování kódů při párování nebo obnovení knihovny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "bae verwendet die Kamera, um beim Koppeln oder Wiederherstellen einer Mediathek Codes zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "bae uses the camera to scan codes when pairing or recovering a library."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το bae χρησιμοποιεί την κάμερα για σάρωση κωδικών κατά τη σύζευξη ή την ανάκτηση βιβλιοθήκης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "bae usa la cámara para escanear códigos al vincular o restaurar una biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "bae utilise la caméra pour scanner des codes lors de l’association ou de la restauration d’une bibliothèque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏bae משתמש במצלמה כדי לסרוק קודים בעת צימוד או שחזור של ספרייה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "bae koristi kameru za skeniranje kodova pri uparivanju ili vraćanju biblioteke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bae a kamerát kódok beolvasására használja párosításkor vagy könyvtár helyreállításakor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "bae usa la fotocamera per scansionare i codici durante l’abbinamento o il ripristino di una libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "bae は、ライブラリのペアリングまたは復元時にコードをスキャンするためにカメラを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "bae는 보관함을 페어링하거나 복원할 때 코드를 스캔하기 위해 카메라를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bae gebruikt de camera om codes te scannen bij het koppelen of herstellen van een bibliotheek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "bae używa aparatu do skanowania kodów podczas parowania lub odtwarzania biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bae usa a câmera para escanear códigos ao emparelhar ou restaurar uma biblioteca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O bae usa a câmara para digitalizar códigos ao emparelhar ou recuperar uma biblioteca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "bae folosește camera pentru a scana coduri la asocierea sau recuperarea unei biblioteci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "bae používa kameru na skenovanie kódov pri párovaní alebo obnove knižnice."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bae, bir arşivi eşlerken veya geri yüklerken kodları taramak için kamerayı kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "bae використовує камеру для сканування кодів під час сполучення або відновлення медіатеки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "bae 使用相机扫描用于配对或恢复资料库的代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "bae 使用相機掃描用於配對或回復資料庫的代碼。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "System prompt explaining why device pairing and local playback need access.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقترن bae بالأجهزة ويعثر على مكبرات الصوت وأجهزة التلفزيون على شبكتك المحلية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "bae сдвоява устройства и намира високоговорители и телевизори в локалната ви мрежа."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "bae páruje zařízení a vyhledává reproduktory a televizory ve vaší místní síti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "bae koppelt Geräte und findet Lautsprecher und Fernseher in deinem lokalen Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "bae pairs devices and finds speakers and TVs on your local network."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το bae συζεύγνυει συσκευές και βρίσκει ηχεία και τηλεοράσεις στο τοπικό σας δίκτυο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "bae vincula dispositivos y busca altavoces y televisores en tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "bae associe des appareils et recherche des enceintes et téléviseurs sur votre réseau local."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏bae מצמד מכשירים ומאתר רמקולים וטלוויזיות ברשת המקומית שלך."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "bae uparuje uređaje i pronalazi zvučnike i televizore na vašoj lokalnoj mreži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bae eszközöket párosít, valamint hangszórókat és tévéket keres a helyi hálózatodon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "bae abbina i dispositivi e trova altoparlanti e TV sulla rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "bae はデバイスをペアリングし、ローカルネットワーク上のスピーカーやテレビを見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "bae는 기기를 페어링하고 로컬 네트워크에서 스피커와 TV를 찾습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bae koppelt apparaten en zoekt speakers en tv’s in je lokale netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "bae paruje urządzenia oraz wyszukuje głośniki i telewizory w sieci lokalnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bae emparelha dispositivos e encontra alto-falantes e TVs na sua rede local."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O bae emparelha dispositivos e encontra colunas e televisores na sua rede local."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "bae asociază dispozitive și găsește boxe și televizoare în rețeaua ta locală."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "bae páruje zariadenia a nachádza reproduktory a televízory v tvojej lokálnej sieti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bae cihazları eşler ve yerel ağınızdaki hoparlörlerle televizyonları bulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "bae сполучає пристрої та знаходить колонки й телевізори у вашій локальній мережі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "bae 会配对设备，并查找你本地网络中的扬声器和电视。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "bae 會配對裝置，並尋找你區域網路中的喇叭和電視。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
