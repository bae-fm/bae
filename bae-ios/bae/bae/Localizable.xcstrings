        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোড ছাড়াই অনুমোদন শেষ হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அங்கீகாரம் குறியீடு இல்லாமல் முடிந்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కోడ్ లేకుండా అధికరణ పూర్తయింది."
