          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud är begränsad på den här enheten (föräldrakontroll eller MDM). bae kan inte använda den för synkronisering."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud er begrænset på denne enhed (forældrekontrol eller MDM). bae kan ikke bruge den til synkronisering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud er begrenset på denne enheten (foreldrekontroll eller MDM). bae kan ikke bruke den til synkronisering."
          }
        },
        "fi": {
