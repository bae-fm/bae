          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan slå på det igen under Inställningar › Uppspelning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu Ayarlar › Çalma bölümünden yeniden açabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
