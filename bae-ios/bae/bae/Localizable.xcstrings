    "Choose the cloud provider the library you're joining uses.": {
      "comment": "Join flow: provider picker prompt shown before generating this device's join code",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the cloud provider the library you're joining uses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el proveedor en la nube que usa la biblioteca a la que te estás uniendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le fournisseur cloud utilisé par la bibliothèque que vous rejoignez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Cloud-Anbieter aus, den die Mediathek verwendet, der du beitrittst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o provedor de nuvem usado pela biblioteca à qual você está entrando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加するライブラリで使われているクラウドプロバイダーを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여하려는 라이브러리가 사용하는 클라우드 공급자를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你要加入的曲库所使用的云服务提供商。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مزود السحابة الذي تستخدمه المكتبة التي تنضم إليها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו את ספק הענן שבו משתמשת הספרייה שאליה מצטרפים."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть хмарного провайдера, який використовує бібліотека, до якої ви приєднуєтеся."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете облачния доставчик, който използва библиотеката, към която се присъединявате."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz dostawcę chmury używanego przez bibliotekę, do której dołączasz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte cloudového poskytovatele, kterého používá knihovna, ke které se připojujete."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite pružatelja oblaka koji koristi fonoteka kojoj se pridružujete."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你要加入的資料庫所使用的雲端提供者。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il provider cloud usato dalla libreria a cui ti stai unendo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katıldığınız arşivin kullandığı bulut sağlayıcısını seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn nhà cung cấp đám mây mà thư viện bạn đang tham gia sử dụng."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de cloudprovider die wordt gebruikt door de bibliotheek waaraan je deelneemt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस लाइब्रेरी से आप जुड़ रहे हैं, उसका क्लाउड प्रदाता चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে লাইব্রেরিতে যোগ দিচ্ছেন সেটি যে ক্লাউড প্রদানকারী ব্যবহার করে তা বাছুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சேரும் நூலகம் பயன்படுத்தும் மேக வழங்குநரைத் தேர்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు చేరుతున్న లైబ్రరీ ఉపయోగించే క్లౌడ్ ప్రదాతను ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही जोडत असलेले संग्रहालय वापरत असलेला क्लाउड प्रदाता निवडा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ کلاؤڈ فراہم کنندہ منتخب کریں جسے شامل ہونے والا کتب خانہ استعمال کرتا ہے۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જોડાઈ રહ્યા છો તે લાઇબ્રેરી જે ક્લાઉડ પ્રદાતા વાપરે છે તે પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸೇರುತ್ತಿರುವ ಲೈಬ್ರರಿ ಬಳಸುವ ಕ್ಲೌಡ್ ಪೂರೈಕೆದಾರರನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ചേരുന്ന ശേഖരം ഉപയോഗിക്കുന്ന ക്ലൗഡ് ദാതാവിനെ തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਸ ਲਾਇਬ੍ਰੇਰੀ ਨਾਲ ਤੁਸੀਂ ਜੁੜ ਰਹੇ ਹੋ, ਉਹ ਵਰਤਦੀ ਕਲਾਊਡ ਪ੍ਰਦਾਤਾ ਚੁਣੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกผู้ให้บริการคลาวด์ที่คลังที่คุณกำลังเข้าร่วมใช้อยู่"
          }
        }
      }
    },
