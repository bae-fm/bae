    "Scan this code on the device joining your library.": {
      "comment": "Device pairing: instruction on the existing device.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح هذا الرمز على الجهاز الذي ينضم إلى مكتبتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирайте този код на устройството, което се присъединява към библиотеката ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইব্রেরিতে যোগ দেওয়া ডিভাইসে এই কোডটি স্ক্যান করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naskenujte tento kód na zařízení, které se připojuje k vaší knihovně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Code auf dem Gerät, das deiner Mediathek beitritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this code on the device joining your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código en el dispositivo que se va a unir a tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce code sur l’appareil qui rejoint votre bibliothèque."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી લાઇબ્રેરીમાં જોડાતા ઉપકરણ પર આ કોડ સ્કેન કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרקו את הקוד הזה במכשיר שמצטרף לספרייה שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लाइब्रेरी से जुड़ने वाले उपकरण पर यह कोड स्कैन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenirajte ovaj kod na uređaju koji se pridružuje vašoj fonoteci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona questo codice sul dispositivo che si unisce alla tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリに参加するデバイスでこのコードをスキャンしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲೈಬ್ರರಿಗೆ ಸೇರುವ ಸಾಧನದಲ್ಲಿ ಈ ಕೋಡ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리에 참여할 기기에서 이 코드를 스캔하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ശേഖരത്തിൽ ചേരുന്ന ഉപകരണത്തിൽ ഈ കോഡ് സ്കാൻ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या संग्रहालयात जोडल्या जाणाऱ्या डिव्हाइसवर हा संकेत स्कॅन करा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan deze code op het apparaat dat aan je bibliotheek deelneemt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਸ਼ਾਮਲ ਹੋਣ ਵਾਲੇ ਡਿਵਾਈਸ ਉੱਤੇ ਇਹ ਕੋਡ ਸਕੈਨ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj ten kod na urządzeniu, które dołącza do Twojej biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie este código no dispositivo que está entrando na sua biblioteca."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகத்தில் சேரும் சாதனத்தில் இந்தக் குறியீட்டை வருடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లైబ్రరీలో చేరే పరికరంలో ఈ కోడ్‌ను స్కాన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนรหัสนี้บนอุปกรณ์ที่จะเข้าร่วมคลังของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodu kitaplığınıza katılan cihazda tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відскануйте цей код на пристрої, який приєднується до вашої бібліотеки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے کتب خانے میں شامل ہونے والے آلے پر یہ رمز اسکین کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã này trên thiết bị đang tham gia thư viện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在要加入你曲库的设备上扫描此代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在要加入你資料庫的裝置上掃描此代碼。"
          }
        }
      }
    },
