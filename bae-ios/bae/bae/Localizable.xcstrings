          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கீசெயினில் மீட்டமைப்புக் குறியீட்டைச் சேமிக்க முடியவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కీచైన్‌లో పునరుద్ధరణ కోడ్‌ను సేవ్ చేయడం సాధ్యం కాలేదు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या कीचेनमध्ये पुनर्संचयन कोड जतन करता आला नाही"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی کی چین میں بحالی کوڈ محفوظ نہیں ہو سکا"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી કીચેનમાં રિસ્ટોર કોડ સાચવી શકાયો નહીં"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಕೀಚೈನ್‌ನಲ್ಲಿ ಮರುಸ್ಥಾಪನೆ ಕೋಡ್ ಉಳಿಸಲಾಗಲಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുനഃസ്ഥാപന കോഡ് നിങ്ങളുടെ കീചെയിനിൽ സംരക്ഷിക്കാനായില്ല"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਕੀਚੇਨ ਵਿੱਚ ਰੀਸਟੋਰ ਕੋਡ ਸੰਭਾਲਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกรหัสกู้คืนลงในพวงกุญแจของคุณได้"
          }
        }
      }
    },
    "Couldn't check iCloud account status.": {
      "comment": "Sync setup: the iCloud account pre-flight failed and CloudKit gave no reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check iCloud account status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar el estado de la cuenta de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier l'état du compte iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Accountstatus konnte nicht geprüft werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o estado da conta do iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudアカウントの状況を確認できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查 iCloud 账户状态。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من حالة حساب iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לבדוק את מצב חשבון ה-iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити стан облікового запису iCloud."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Състоянието на профила в iCloud не можа да бъде проверено."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sprawdzić stanu konta iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se ověřit stav účtu iCloud."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće provjeriti stanje iCloud računa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 계정 상태를 확인할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查 iCloud 帳戶狀態。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare lo stato dell'account iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hesabının durumu denetlenemedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kiểm tra trạng thái tài khoản iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de status van de iCloud-account niet controleren."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud खाते की स्थिति जाँची नहीं जा सकी."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud অ্যাকাউন্টের অবস্থা যাচাই করা যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud கணக்கின் நிலையைச் சரிபார்க்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ఖాతా స్థితిని తనిఖీ చేయడం సాధ్యం కాలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud खात्याची स्थिती तपासता आली नाही."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud اکاؤنٹ کی صورتحال جانچی نہیں جا سکی۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ખાતાની સ્થિતિ ચકાસી શકાઈ નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ಖಾತೆಯ ಸ್ಥಿತಿಯನ್ನು ಪರಿಶೀಲಿಸಲಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud അക്കൗണ്ട് നില പരിശോധിക്കാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ਖਾਤੇ ਦੀ ਸਥਿਤੀ ਜਾਂਚੀ ਨਹੀਂ ਜਾ ਸਕੀ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบสถานะบัญชี iCloud ไม่ได้"
          }
        }
      }
    },
