          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa zastaví synchronizácia a odstráni sa konfigurácia poskytovateľa cloudu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
