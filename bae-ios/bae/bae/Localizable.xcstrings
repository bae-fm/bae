          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് %@ ലേക്കുള്ള കാസ്റ്റിംഗ് നിർത്തും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
