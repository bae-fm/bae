    "iCloud is restricted on this device (parental controls or MDM). bae can't use it for sync.": {
      "comment": "Sync setup: iCloud is restricted by parental controls or device management",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is restricted on this device (parental controls or MDM). bae can't use it for sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está restringido en este dispositivo (controles parentales o MDM). bae no puede usarlo para sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est restreint sur cet appareil (contrôle parental ou MDM). bae ne peut pas l'utiliser pour la synchronisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist auf diesem Gerät eingeschränkt (Kindersicherung oder MDM). bae kann es nicht zur Synchronisierung verwenden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está restrito neste dispositivo (controles parentais ou MDM). O bae não pode usá-lo para sincronizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではiCloudが制限されています（ペアレンタルコントロールまたはMDM）。baeは同期に使用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的 iCloud 受限（家长控制或 MDM）。bae 无法用它同步。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud مقيَّد على هذا الجهاز (الرقابة الأبوية أو إدارة الأجهزة). لا يستطيع bae استخدامه للمزامنة."
