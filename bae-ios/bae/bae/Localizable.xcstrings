          "stringUnit": {
            "state": "translated",
            "value": "No albums yet. Sincronizzazioneing from the cloud…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "No albums yet. Eşzamanlamaing from the cloud…"
          }
