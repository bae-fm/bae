          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozłączono, ale nie udało się usunąć kodu przywracania: %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojeno, ale obnovovací kód se nepodařilo odstranit: %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
