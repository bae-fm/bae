    "Check that this matches the fingerprint shown on the new device before approving.": {
      "comment": "Device pairing: instruction before the owner approves the displayed identity.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من أن هذا يطابق البصمة المعروضة على الجهاز الجديد قبل الموافقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди одобряване проверете дали това съвпада с отпечатъка, показан на новото устройство."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před schválením zkontrolujte, že se shoduje s otiskem zobrazeným na novém zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller, at det stemmer overens med fingeraftrykket på den nye enhed, før du godkender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that this matches the fingerprint shown on the new device before approving."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe vor dem Genehmigen, dass dies mit dem Fingerabdruck auf dem neuen Gerät übereinstimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν εγκρίνετε, ελέγξτε ότι ταιριάζει με το αποτύπωμα που εμφανίζεται στη νέα συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que coincida con la huella mostrada en el dispositivo nuevo antes de aprobarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista ennen hyväksymistä, että tämä vastaa uudessa laitteessa näkyvää sormenjälkeä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que cela correspond à l’empreinte affichée sur le nouvel appareil avant d’approuver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפני האישור, בדקו שזה תואם לטביעת האצבע שמוצגת במכשיר החדש."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prije odobravanja provjerite podudara li se ovo s otiskom prikazanim na novom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jóváhagyás előtt ellenőrizd, hogy megegyezik-e az új eszközön látható ujjlenyomattal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di approvare, verifica che corrisponda all\\'impronta mostrata sul nuovo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認する前に、新しいデバイスに表示されているフィンガープリントと一致することを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하기 전에 새 기기에 표시된 지문과 일치하는지 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller at det stemmer med fingeravtrykket som vises på den nye enheten, før du godkjenner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer vóór goedkeuring of dit overeenkomt met de vingerafdruk op het nieuwe apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed zatwierdzeniem sprawdź, czy zgadza się z odciskiem wyświetlanym na nowym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se isto corresponde à impressão digital mostrada no novo dispositivo antes de aprovar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se corresponde à impressão digital apresentada no novo dispositivo antes de aprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică dacă se potrivește cu amprenta afișată pe dispozitivul nou înainte de a aproba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred schválením over, či sa to zhoduje s odtlačkom zobrazeným na novom zariadení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera att det stämmer med fingeravtrycket som visas på den nya enheten innan du godkänner."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamadan önce bunun yeni cihazda gösterilen parmak iziyle eşleştiğini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед схваленням перевірте, що це збігається з відбитком, показаним на новому пристрої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准前，请确认这与新设备上显示的指纹一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准前，請確認這與新裝置顯示的指紋相符。"
          }
        }
      }
    },
