    "Disconnected, but couldn't remove the restore code: %@": {
      "comment": "Sync settings: the provider was disconnected but the keychain refused to delete the restore code; %@ is the reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected, but couldn't remove the restore code: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desconectó, pero no se pudo quitar el código de restauración: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté, mais impossible de supprimer le code de restauration : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung getrennt, aber der Wiederherstellungscode konnte nicht entfernt werden: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado, mas não foi possível remover o código de restauração: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を解除しましたが、復元コードを削除できませんでした: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开连接，但无法移除恢复码：%@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قطع الاتصال، لكن تعذّرت إزالة رمز الاستعادة: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור נותק, אך לא ניתן היה להסיר את קוד השחזור‏: %@"
          }
        },
        "uk": {
          "stringUnit": {
