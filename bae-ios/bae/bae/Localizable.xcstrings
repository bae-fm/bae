    "Paste your recovery code. Use this only when you have no other device available to approve this one.": {
      "comment": "Onboarding: when to use the recovery code instead of approving from another device",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste your recovery code. Use this only when you have no other device available to approve this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega tu código de recuperación. Úsalo solo cuando no tengas otro dispositivo disponible para aprobar este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez votre code de récupération. Ne l’utilisez que si aucun autre appareil n’est disponible pour approuver celui-ci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen Wiederherstellungscode ein. Nutze das nur, wenn kein anderes Gerät zum Genehmigen verfügbar ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole seu código de recuperação. Use isto apenas quando não houver outro dispositivo disponível para aprovar este."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元コードを貼り付けてください。これは、このデバイスを承認できる他のデバイスがない場合にのみ使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴你的恢复码。仅当你没有其他设备可用于批准此设备时才使用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رمز الاستعادة. استخدم هذا فقط عندما لا يتوفر جهاز آخر للموافقة على هذا الجهاز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדביקו את קוד השחזור שלכם. השתמשו בזה רק כשאין מכשיר אחר זמין לאישור המכשיר הזה."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте свій код відновлення. Використовуйте це лише тоді, коли немає іншого пристрою, щоб схвалити цей."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставете кода си за възстановяване. Използвайте това само когато нямате друго устройство, което да одобри това."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej swój kod odzyskiwania. Użyj tego tylko wtedy, gdy nie masz innego urządzenia, które mogłoby to zatwierdzić."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte svůj obnovovací kód. Použijte to jen tehdy, když nemáte k dispozici jiné zařízení, které by toto schválilo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijepite svoj kôd za oporavak. Koristite ovo samo kad nemate drugi uređaj dostupan za odobravanje ovoga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 코드를 붙여넣으세요. 이 기기를 승인할 다른 기기가 없을 때만 사용하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上你的還原碼。僅當你沒有其他裝置可用於批准此裝置時才使用。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il tuo codice di recupero. Usalo solo quando non hai un altro dispositivo disponibile per approvare questo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma kodunuzu yapıştırın. Bunu yalnızca bu aygıtı onaylayacak başka bir aygıtınız yokken kullanın."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak je herstelcode. Gebruik dit alleen als je geen ander apparaat hebt om dit apparaat goed te keuren."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilep svoj obnovovací kód. Použi to len vtedy, keď nemáš k dispozícii iné zariadenie, ktoré by toto schválilo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illeszd be a helyreállítási kódodat. Csak akkor használd, ha nincs más eszközöd ennek jóváhagyásához."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește codul tău de recuperare. Folosește-l doar când nu ai alt dispozitiv care să îl aprobe pe acesta."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικολλήστε τον κωδικό ανάκτησής σας. Χρησιμοποιήστε τον μόνο όταν δεν έχετε άλλη συσκευή για να εγκρίνει αυτή."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o seu código de recuperação. Use isto apenas quando não tiver outro dispositivo disponível para aprovar este."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in din återställningskod. Använd detta bara när du inte har någon annan enhet som kan godkänna den här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt din gendannelseskode. Brug kun dette, når du ikke har andre enheder til at godkende denne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn gjenopprettingskoden din. Bruk dette bare når du ikke har noen annen enhet som kan godkjenne denne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä palautuskoodisi. Käytä tätä vain, kun sinulla ei ole muuta laitetta hyväksymään tätä."
          }
        }
      }
    },
