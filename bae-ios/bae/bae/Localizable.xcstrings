          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisatie voltooid zonder code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति कोड के बिना पूरी हुई।"
