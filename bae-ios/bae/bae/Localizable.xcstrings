    "Camera access is denied. Enable it in Settings to scan QR codes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is denied. Enable it in Settings to scan QR codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está denegado. Actívalo en Ajustes para escanear códigos QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la caméra est refusé. Activez-le dans les Réglages pour scanner des codes QR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerazugriff ist verweigert. Aktiviere ihn in den Einstellungen, um QR-Codes zu scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera foi negado. Ative-o nas Configurações para escanear QR codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスが拒否されています。QRコードをスキャンするには設定で有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机访问被拒绝。请在设置中启用以扫描二维码。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول إلى الكاميرا. فعّله في الإعدادات لمسح رموز QR."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למצלמה נדחתה. הפעילו אותה בהגדרות כדי לסרוק קודי QR."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до камери заборонено. Увімкніть його в Параметрах, щоб сканувати QR-коди."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достъпът до камерата е отказан. Активирайте го в Настройки, за да сканирате QR кодове."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do aparatu jest zabroniony. Włącz go w Ustawieniach, aby skanować kody QR."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup ke kameře je odepřen. Pro skenování QR kódů jej povolte v Nastavení."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup kameri je odbijen. Omogućite ga u Postavkama za skeniranje QR kodova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 거부되었습니다. QR 코드를 스캔하려면 설정에서 허용하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機存取遭拒。請在設定中啟用，以掃描 QR 碼。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso alla fotocamera negato. Abilitalo in Impostazioni per scansionare codici QR."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera erişimi reddedildi. QR kodlarını taramak için Ayarlar'da etkinleştirin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameratoegang is geweigerd. Schakel dit in Instellingen in om QR-codes te scannen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístup ku kamere je zamietnutý. Zapni ho v Nastaveniach, aby si mohol skenovať QR kódy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kamera hozzáférése le van tiltva. Engedélyezd a Beállításokban a QR-kódok beolvasásához."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la cameră este refuzat. Activează-l în Configurări pentru a scana coduri QR."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στην κάμερα έχει απορριφθεί. Ενεργοποιήστε τη στις Ρυθμίσεις για σάρωση κωδικών QR."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmara foi recusado. Ative-o nas Definições para digitalizar códigos QR."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraåtkomsten är nekad. Slå på den i Inställningar för att skanna QR-koder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til kameraet er nægtet. Slå det til i Indstillinger for at scanne QR-koder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameratilgang er avvist. Slå den på i Innstillinger for å skanne QR-koder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameran käyttö on estetty. Salli se Asetuksissa, jotta voit skannata QR-koodeja."
          }
        }
      }
    },
