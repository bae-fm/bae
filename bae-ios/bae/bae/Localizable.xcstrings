    "This will stop casting to %@.": {
      "comment": "Casting settings: confirmation body, %@ is the device currently being cast to",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إيقاف الإرسال إلى ‏%@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще спре предаването към %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি %@-এ কাস্ট করা বন্ধ করবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se ukončí odesílání do %@."
