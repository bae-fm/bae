    "Cloud sign-in isn't configured on this build (no oauth-creds.json).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud sign-in isn't configured on this build (no oauth-creds.json)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión en la nube no está configurado en esta versión (sin oauth-creds.json)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au cloud n'est pas configurée sur cette version (pas de oauth-creds.json)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Anmeldung ist in diesem Build nicht konfiguriert (keine oauth-creds.json)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login na nuvem não está configurado nesta versão (sem oauth-creds.json)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドではクラウドサインインが設定されていません（oauth-creds.json がありません）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未配置云登录（无 oauth-creds.json）。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول السحابي غير مُعدّ في هذه النسخة (لا يوجد oauth-creds.json)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כניסה לענן אינה מוגדרת בגרסה זו (אין oauth-creds.json)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хмарний вхід не налаштовано в цій збірці (немає oauth-creds.json)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влизането в облака не е конфигурирано в тази версия (липсва oauth-creds.json)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie do chmury nie jest skonfigurowane w tej wersji (brak oauth-creds.json)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení k cloudu není v tomto sestavení nakonfigurováno (chybí oauth-creds.json)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava u oblak nije konfigurirana u ovoj verziji (nema oauth-creds.json)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 클라우드 로그인이 설정되어 있지 않습니다(oauth-creds.json 없음)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此建置未設定雲端登入（沒有 oauth-creds.json）。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso cloud non è configurato in questa build (nessun oauth-creds.json)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu derlemede bulut oturumu yapılandırılmamış (oauth-creds.json yok)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập đám mây chưa được cấu hình trong bản dựng này (không có oauth-creds.json)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudaanmelding is niet geconfigureerd in deze build (geen oauth-creds.json)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बिल्ड पर क्लाउड साइन-इन कॉन्फिगर नहीं है (oauth-creds.json नहीं)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বিল্ডে ক্লাউড সাইন-ইন কনফিগার করা নেই (oauth-creds.json নেই)।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உருவாக்கத்தில் மேக உள்நுழைவு அமைக்கப்படவில்லை (oauth-creds.json இல்லை)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ బిల్డ్‌లో క్లౌడ్ సైన్-ఇన్ కాన్ఫిగర్ చేయబడలేదు (oauth-creds.json లేదు)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या बिल्डमध्ये क्लाउड प्रवेश संरचित केलेला नाही (oauth-creds.json नाही)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس بلڈ میں کلاؤڈ سائن ان ترتیب نہیں دیا گیا (oauth-creds.json نہیں)۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ બિલ્ડ પર ક્લાઉડ સાઇન-ઇન ગોઠવાયેલું નથી (oauth-creds.json નથી)."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ನಿರ್ಮಾಣದಲ್ಲಿ ಕ್ಲೌಡ್ ಸೈನ್-ಇನ್ ಸಂರಚಿಸಲಾಗಿಲ್ಲ (oauth-creds.json ಇಲ್ಲ)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ബിൽഡിൽ ക്ലൗഡ് പ്രവേശനം ക്രമീകരിച്ചിട്ടില്ല (oauth-creds.json ഇല്ല)."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਬਿਲਡ ਉੱਤੇ ਕਲਾਊਡ ਸਾਇਨ-ਇਨ ਸੰਰਚਿਤ ਨਹੀਂ ਹੈ (oauth-creds.json ਨਹੀਂ ਹੈ)।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้คลาวด์ไม่ได้ตั้งค่าไว้ในบิลด์นี้ (ไม่มี oauth-creds.json)"
          }
        }
      }
