    "Your library in the cloud is untouched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library in the cloud is untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca en la nube no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque dans le cloud n'est pas touchée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek in der Cloud bleibt unberührt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca na nuvem permanece intacta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド上のライブラリはそのまま残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在云端的库不受影响。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتأثر مكتبتك في السحابة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה שלכם בענן לא תיפגע."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша бібліотека в хмарі залишається незмінною."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотеката ви в облака остава непокътната."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja biblioteka w chmurze pozostaje nienaruszona."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše knihovna v cloudu zůstane nedotčena."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša fonoteka u oblaku ostaje netaknuta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드의 라이브러리는 그대로입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在雲端的資料庫不會受影響。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria nel cloud rimane intatta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buluttaki kitaplığınıza dokunulmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện của bạn trên đám mây vẫn được giữ nguyên."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bibliotheek in de cloud blijft ongewijzigd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड में आपकी लाइब्रेरी अपरिवर्तित रहती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লাউডে আপনার লাইব্রেরি অপরিবর্তিত আছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேகத்தில் உள்ள உங்கள் நூலகம் மாற்றப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్లౌడ్‌లోని మీ లైబ్రరీ మారలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउडमधील तुमची लायब्ररी बदलली जात नाही."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلاؤڈ میں آپ کی لائبریری برقرار ہے۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્લાઉડમાં તમારી લાઇબ્રેરી અસ્પર્શિત છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಲೌಡ್‌ನಲ್ಲಿರುವ ನಿಮ್ಮ ಗ್ರಂಥಾಲಯ ಬದಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ലൗഡിലെ നിങ്ങളുടെ ലൈബ്രറിയിൽ മാറ്റമൊന്നുമില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਲਾਊਡ ਵਿੱਚ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਅਣਛੁੱਤੀ ਹੈ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังของคุณในคลาวด์จะไม่ถูกเปลี่ยนแปลง"
          }
        }
      }
    },
