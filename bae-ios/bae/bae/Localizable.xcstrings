    "The encryption key for this library is not in the keyring. Enter the 64-character hex key to unlock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encryption key for this library is not in the keyring. Enter the 64-character hex key to unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de cifrado de esta biblioteca no está en el llavero. Introduce la clave hexadecimal de 64 caracteres para desbloquearla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de chiffrement de cette bibliothèque n'est pas dans le trousseau. Saisissez la clé hexadécimale de 64 caractères pour déverrouiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verschlüsselungsschlüssel für diese Bibliothek ist nicht im Schlüsselbund. Gib den 64-stelligen Hex-Schlüssel zum Entsperren ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de criptografia desta biblioteca não está no chaveiro. Insira a chave hexadecimal de 64 caracteres para desbloquear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリの暗号化キーがキーリングにありません。ロックを解除するには16進数64文字のキーを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此库的加密密钥不在密钥环中。请输入 64 位十六进制密钥以解锁。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح التشفير لهذه المكتبة غير موجود في حلقة المفاتيح. أدخل المفتاح السداسي العشري المكوّن من 64 حرفًا لإلغاء القفل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח ההצפנה של ספרייה זו אינו במחזיק המפתחות. הזינו את המפתח ההקסדצימלי באורך 64 תווים כדי לפתוח."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключа шифрування цієї бібліотеки немає у сховищі ключів. Введіть 64-символьний шістнадцятковий ключ, щоб розблокувати."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът за шифроване на тази библиотека не е в ключодържателя. Въведете 64-знаковия шестнадесетичен ключ за отключване."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucza szyfrującego tej biblioteki nie ma w pęku kluczy. Wprowadź 64-znakowy klucz szesnastkowy, aby odblokować."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovací klíč této knihovny není v klíčence. Pro odemčení zadejte šestnáctkový klíč o 64 znacích."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ za šifriranje ove fonoteke nije u privjesku ključeva. Unesite 64-znamenkasti heksadecimalni ključ za otključavanje."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리의 암호화 키가 키링에 없습니다. 잠금을 해제하려면 64자 16진수 키를 입력하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫的加密金鑰不在鑰匙圈中。請輸入 64 字元十六進位金鑰以解鎖。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "The Crittografia key for this Libreria is not in the keyring. Enter the 64-character hex key to unlock."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "The Şifreleme key for this Kitaplık is not in the keyring. Enter the 64-character hex key to unlock."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mã hóa key for this Thư viện is not in the keyring. Enter the 64-character hex key to unlock."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "The Versleuteling key for this Bibliotheek is not in the keyring. Enter the 64-character hex key to unlock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लाइब्रेरी की एन्क्रिप्शन कुंजी कीरिंग में नहीं है। अनलॉक करने के लिए 64-वर्ण वाली हेक्स कुंजी दर्ज करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লাইব্রেরির এনক্রিপশন কী কীরিংয়ে নেই। আনলক করতে ৬৪-অক্ষরের হেক্স কী লিখুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நூலகத்திற்கான குறியாக்க விசை சாவிக்கொத்தில் இல்லை. திறக்க 64 எழுத்துகள் கொண்ட hex விசையை உள்ளிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ లైబ్రరీకి గుప్తీకరణ కీ కీరింగ్‌లో లేదు. అన్‌లాక్ చేయడానికి 64-అక్షరాల హెక్స్ కీని నమోదు చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या लायब्ररीची कूटबद्धीकरण कळ कीरिंगमध्ये नाही. अनलॉक करण्यासाठी 64-अक्षरी hex कळ द्या."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس لائبریری کی خفیہ کاری کلید کی رنگ میں نہیں ہے۔ کھولنے کے لیے 64 حروف والی hex کلید درج کریں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ લાઇબ્રેરી માટેની એન્ક્રિપ્શન કી કીરિંગમાં નથી. અનલૉક કરવા માટે 64 અક્ષરની હેક્સ કી દાખલ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಗ್ರಂಥಾಲಯದ ಎನ್‌ಕ್ರಿಪ್ಷನ್ ಕೀಲಿ ಕೀರಿಂಗ್‌ನಲ್ಲಿಲ್ಲ. ಅನ್ಲಾಕ್ ಮಾಡಲು 64 ಅಕ್ಷರಗಳ ಹೆಕ್ಸ್ ಕೀಲಿಯನ್ನು ನಮೂದಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ലൈബ്രറിയുടെ എൻക്രിപ്ഷൻ കീ കീരിംഗിൽ ഇല്ല. അൺലോക്ക് ചെയ്യാൻ 64 അക്ഷരമുള്ള ഹെക്സ് കീ നൽകുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਲਾਇਬ੍ਰੇਰੀ ਦੀ ਇਨਕ੍ਰਿਪਸ਼ਨ ਕੁੰਜੀ ਕੀਰਿੰਗ ਵਿੱਚ ਨਹੀਂ ਹੈ। ਅਨਲਾਕ ਕਰਨ ਲਈ 64-ਅੱਖਰੀ ਹੈਕਸ ਕੁੰਜੀ ਦਰਜ ਕਰੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์เข้ารหัสสำหรับคลังนี้ไม่อยู่ในพวงกุญแจ ป้อนคีย์เลขฐานสิบหก 64 อักขระเพื่อปลดล็อก"
          }
        }
      }
    },
