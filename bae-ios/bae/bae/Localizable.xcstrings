            "value": "Ez a könyvtár olyan szolgáltatót használ, amelyhez ez a build nem tud kapcsolódni."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această bibliotecă folosește un furnizor la care această versiune nu se poate conecta."
