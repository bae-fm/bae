    "You can turn this back on in Settings › Playback." : {
      "comment" : "Pause-between-sides prompt: shown under the checkbox once it is unchecked; names where the setting lives",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can turn this back on in Settings › Playback."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إعادة تفعيل هذا من الإعدادات › التشغيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можете да включите това отново от Настройки › Възпроизвеждане."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu to můžete zapnout v Nastavení › Přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan slå det til igen under Indstillinger › Afspilning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das unter Einstellungen › Wiedergabe wieder einschalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να το ενεργοποιήσετε ξανά από Ρυθμίσεις › Αναπαραγωγή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes volver a activarlo en Ajustes › Reproducción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit ottaa tämän uudelleen käyttöön kohdassa Asetukset › Toisto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez le réactiver dans Réglages › Lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להפעיל זאת שוב בהגדרות › השמעה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo možete ponovno uključiti u Postavke › Reprodukcija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt újra bekapcsolhatod itt: Beállítások › Lejátszás."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi riattivarlo in Impostazioni › Riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 › 再生」でもう一度オンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › 재생에서 다시 켤 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan slå dette på igjen under Innstillinger › Avspilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt dit weer aanzetten via Instellingen › Afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz to ponownie włączyć w Ustawienia › Odtwarzanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode reativar isso em Configurações › Reprodução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode voltar a ativar isto em Definições › Reprodução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poți reactiva asta din Setări › Redare."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
