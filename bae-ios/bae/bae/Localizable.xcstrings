    },
    "The iCloud sync zone is gone. Reconnect in sync settings to recreate it.": {
      "comment": "Sync failure: the CloudKit zone bae syncs through no longer exists",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud sync zone is gone. Reconnect in sync settings to recreate it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona de sincronización de iCloud ha desaparecido. Vuelve a conectar en los ajustes de sincronización para recrearla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone de synchronisation iCloud a disparu. Reconnectez-vous dans les réglages de synchronisation pour la recréer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Sync-Zone ist verschwunden. Verbinde dich in den Sync-Einstellungen neu, um sie wieder anzulegen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A zona de sincronização do iCloud não existe mais. Reconecte nos ajustes de sincronização para recriá-la."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudの同期ゾーンがなくなりました。同期設定で再接続すると作り直されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步区域已不存在。请在同步设置中重新连接以重新创建。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختفت منطقة مزامنة iCloud. أعد الاتصال من إعدادات المزامنة لإنشائها من جديد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אזור הסנכרון של iCloud נעלם. התחבר מחדש בהגדרות הסנכרון כדי ליצור אותו מחדש."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зона синхронізації iCloud зникла. Під’єднайтеся знову в налаштуваннях синхронізації, щоб створити її наново."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Зоната за синхронизиране в iCloud я няма. Свържете се отново в настройките за синхронизиране, за да я създадете наново."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strefa synchronizacji iCloud zniknęła. Połącz ponownie w ustawieniach synchronizacji, aby ją odtworzyć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zóna synchronizace iCloud zmizela. Znovu se připojte v nastavení synchronizace, aby se vytvořila."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud zona sinkronizacije više ne postoji. Ponovno se povežite u postavkama sinkronizacije da biste je stvorili."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화 영역이 사라졌습니다. 동기화 설정에서 다시 연결하면 새로 만들어집니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步區域已不存在。請在同步設定中重新連接以重新建立。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona di sincronizzazione iCloud non esiste più. Riconnettiti nelle impostazioni di sincronizzazione per ricrearla."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud eşitleme bölgesi kayboldu. Yeniden oluşturmak için eşitleme ayarlarından yeniden bağlanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng đồng bộ iCloud không còn nữa. Hãy kết nối lại trong cài đặt đồng bộ để tạo lại."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De iCloud-synczone bestaat niet meer. Maak opnieuw verbinding in de sync-instellingen om hem opnieuw aan te maken."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud सिंक ज़ोन मौजूद नहीं है. इसे दोबारा बनाने के लिए सिंक सेटिंग्स में फिर से कनेक्ट करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud সিঙ্ক জোন আর নেই। এটি আবার তৈরি করতে সিঙ্ক সেটিংসে পুনরায় সংযোগ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ஒத்திசைவு மண்டலம் இல்லை. அதை மீண்டும் உருவாக்க ஒத்திசைவு அமைப்புகளில் மீண்டும் இணைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud సింక్ జోన్ లేదు. దాన్ని మళ్లీ సృష్టించడానికి సింక్ సెట్టింగ్‌లలో మళ్లీ కనెక్ట్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud सिंक झोन उरलेला नाही. तो पुन्हा तयार करण्यासाठी सिंक सेटिंग्जमध्ये पुन्हा कनेक्ट करा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud سِنک زون موجود نہیں رہا۔ اسے دوبارہ بنانے کے لیے سِنک سیٹنگز میں دوبارہ منسلک ہوں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud સિંક ઝોન રહ્યો નથી. તેને ફરી બનાવવા સિંક સેટિંગ્સમાં ફરી કનેક્ટ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ಸಿಂಕ್ ವಲಯ ಇಲ್ಲವಾಗಿದೆ. ಅದನ್ನು ಮತ್ತೆ ರಚಿಸಲು ಸಿಂಕ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಮರುಸಂಪರ್ಕಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud സമന്വയ സോൺ ഇല്ലാതായി. അത് വീണ്ടും സൃഷ്ടിക്കാൻ സമന്വയ ക്രമീകരണങ്ങളിൽ വീണ്ടും കണക്റ്റ് ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ਸਿੰਕ ਜ਼ੋਨ ਹੁਣ ਨਹੀਂ ਹੈ। ਇਸਨੂੰ ਦੁਬਾਰਾ ਬਣਾਉਣ ਲਈ ਸਿੰਕ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਮੁੜ-ਕਨੈਕਟ ਕਰੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โซนซิงค์ iCloud หายไปแล้ว เชื่อมต่อใหม่ในการตั้งค่าการซิงค์เพื่อสร้างขึ้นใหม่"
          }
        }
      }
    },
