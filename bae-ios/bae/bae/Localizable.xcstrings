    "This library isn't synced. Removing it permanently deletes its catalog from this device." : {
      "comment" : "Settings: footer under Remove this library from this device, for a library with no cloud home.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
