      }
    },
    "Removes this device from the library's members, then deletes the library and its downloaded files from this device. Your library in the cloud is untouched. Removing needs a connection to your storage." : {
      "comment" : "Settings: footer under Remove this library from this device, for a library that syncs.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل هذا الجهاز من أعضاء المكتبة، ثم يحذف المكتبة وملفاتها التي تم تنزيلها من هذا الجهاز. تبقى مكتبتك في السحابة دون تغيير. تتطلب الإزالة اتصالًا بالتخزين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Премахва това устройство от членовете на библиотеката, след което изтрива от него библиотеката и изтеглените ѝ файлове. Библиотеката ви в облака остава незасегната. Премахването изисква връзка с хранилището ви."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebere toto zařízení ze členů knihovny a pak z něj smaže knihovnu a její stažené soubory. Vaše knihovna v cloudu zůstane nedotčená. Odebrání vyžaduje připojení k vašemu úložišti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner denne enhed fra bibliotekets medlemmer og sletter derefter biblioteket og dets hentede filer fra den. Dit bibliotek i skyen forbliver uberørt. Fjernelsen kræver forbindelse til dit lager."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt dieses Gerät aus den Mitgliedern der Bibliothek und löscht dann die Bibliothek und ihre geladenen Dateien von diesem Gerät. Deine Bibliothek in der Cloud bleibt unverändert. Zum Entfernen ist eine Verbindung zu deinem Speicher nötig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί αυτή τη συσκευή από τα μέλη της βιβλιοθήκης και μετά διαγράφει από αυτήν τη βιβλιοθήκη και τα ληφθέντα αρχεία της. Η βιβλιοθήκη σας στο cloud μένει ανέπαφη. Η αφαίρεση χρειάζεται σύνδεση με τον χώρο αποθήκευσής σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita este dispositivo de los miembros de la biblioteca y luego elimina la biblioteca y sus archivos descargados de este dispositivo. Tu biblioteca en la nube no se modifica. Para quitarla se necesita conexión con tu almacenamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa tämän laitteen kirjaston jäsenistä ja poistaa sitten siltä kirjaston ja sen ladatut tiedostot. Pilvessä oleva kirjastosi säilyy ennallaan. Poistaminen vaatii yhteyden tallennustilaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire cet appareil des membres de la bibliothèque, puis supprime la bibliothèque et ses fichiers téléchargés de cet appareil. Votre bibliothèque dans le cloud reste intacte. Le retrait nécessite une connexion à votre stockage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסיר את המכשיר הזה מחברי הספרייה ואז מוחק ממנו את הספרייה ואת הקבצים שהורדו. הספרייה שלכם בענן לא נפגעת. ההסרה דורשת חיבור לאחסון שלכם."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja ovaj uređaj iz članova fonoteke, a zatim s njega briše fonoteku i njezine preuzete datoteke. Vaša fonoteka u oblaku ostaje netaknuta. Za uklanjanje je potrebna veza s vašom pohranom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja ezt az eszközt a könyvtár tagjai közül, majd törli róla a könyvtárat és a letöltött fájljait. A felhőben lévő könyvtárad érintetlen marad. Az eltávolításhoz kapcsolat kell a tárhelyeddel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove questo dispositivo dai membri della libreria, poi elimina la libreria e i suoi file scaricati da questo dispositivo. La tua libreria nel cloud resta intatta. La rimozione richiede una connessione al tuo spazio di archiviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスをライブラリのメンバーから外してから、このデバイスからライブラリとダウンロード済みファイルを削除します。クラウド上のライブラリはそのままです。削除にはストレージへの接続が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기를 라이브러리 멤버에서 제외한 다음 이 기기에서 라이브러리와 다운로드된 파일을 삭제합니다. 클라우드의 라이브러리는 그대로 유지됩니다. 제거하려면 스토리지에 연결되어 있어야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner denne enheten fra bibliotekets medlemmer og sletter deretter biblioteket og de nedlastede filene fra den. Biblioteket ditt i skyen forblir urørt. Fjerningen krever tilkobling til lagringen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert dit apparaat uit de leden van de bibliotheek en verwijdert daarna de bibliotheek en de gedownloade bestanden van dit apparaat. Je bibliotheek in de cloud blijft onaangeroerd. Voor verwijderen is een verbinding met je opslag nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa to urządzenie z członków biblioteki, a następnie usuwa z niego bibliotekę i jej pobrane pliki. Twoja biblioteka w chmurze pozostaje nietknięta. Usunięcie wymaga połączenia z magazynem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove este dispositivo dos membros da biblioteca e depois exclui a biblioteca e os arquivos baixados deste dispositivo. Sua biblioteca na nuvem não é alterada. Remover requer conexão com o seu armazenamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove este dispositivo dos membros da biblioteca e depois elimina a biblioteca e os ficheiros transferidos deste dispositivo. A sua biblioteca na nuvem não é alterada. Remover requer ligação ao seu armazenamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimină acest dispozitiv dintre membrii bibliotecii, apoi șterge biblioteca și fișierele ei descărcate de pe acest dispozitiv. Biblioteca ta din cloud rămâne neatinsă. Eliminarea necesită o conexiune la stocarea ta."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstráni toto zariadenie z členov knižnice a potom z neho vymaže knižnicu a jej stiahnuté súbory. Vaša knižnica v cloude zostane nedotknutá. Odstránenie vyžaduje pripojenie k vášmu úložisku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort den här enheten från bibliotekets medlemmar och raderar sedan biblioteket och dess hämtade filer från den. Ditt bibliotek i molnet påverkas inte. Borttagningen kräver anslutning till din lagring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazı kitaplığın üyelerinden çıkarır, ardından kitaplığı ve indirilen dosyalarını bu cihazdan siler. Buluttaki kitaplığınıza dokunulmaz. Kaldırmak için depolamanıza bağlantı gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вилучає цей пристрій з учасників бібліотеки, а потім видаляє з нього бібліотеку та її завантажені файли. Ваша бібліотека в хмарі залишається недоторканою. Для вилучення потрібне з’єднання з вашим сховищем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此设备从库的成员中移除，然后从此设备删除该库及其已下载的文件。云端的库不受影响。移除需要连接到你的存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此裝置從資料庫的成員中移除，然後從此裝置刪除該資料庫及其已下載的檔案。雲端的資料庫不受影響。移除需要連線到你的儲存空間。"
          }
        }
      }
    },
