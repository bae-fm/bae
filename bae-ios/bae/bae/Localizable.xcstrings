            "state": "translated",
            "value": "Αυτή η βιβλιοθήκη χρησιμοποιεί πάροχο με τον οποίο αυτή η έκδοση δεν μπορεί να συνδεθεί."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca usa um fornecedor a que esta versão não se consegue ligar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här biblioteket använder en leverantör som den här versionen inte kan ansluta till."
          }
