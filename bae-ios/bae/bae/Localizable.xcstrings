        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time će se prekinuti emitiranje na %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trasmissione a %@ verrà interrotta."
          }
        },
        "ja": {
