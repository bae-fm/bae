          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest ograniczony na tym urządzeniu (kontrola rodzicielska lub MDM). bae nie może go użyć do synchronizacji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je na tomto zařízení omezen (rodičovská kontrola nebo MDM). bae jej nemůže použít k synchronizaci."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je ograničen na ovom uređaju (roditeljski nadzor ili MDM). bae ga ne može koristiti za sinkronizaciju."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 iCloud가 제한되어 있습니다(자녀 보호 기능 또는 MDM). bae는 동기화에 사용할 수 없습니다."
          }
        },
        "zh-Hant": {
