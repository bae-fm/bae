            "state": "translated",
            "value": "Plak je herstelcode"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पुनर्प्राप्ति कोड पेस्ट करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পুনরুদ্ধার কোড পেস্ট করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மீட்புக் குறியீட்டை ஒட்டவும்"
          }
