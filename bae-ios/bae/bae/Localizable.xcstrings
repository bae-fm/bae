    "This library uses a provider this build can't connect to.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This library uses a provider this build can't connect to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca usa un proveedor al que esta versión no puede conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette bibliothèque utilise un fournisseur auquel cette version ne peut pas se connecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bibliothek nutzt einen Anbieter, mit dem sich dieser Build nicht verbinden kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca usa um provedor ao qual esta build não consegue se conectar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリは、このビルドが接続できないプロバイダを使用しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此资料库使用了此构建无法连接的服务商。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم هذه المكتبة مزوّدًا لا يمكن لهذا الإصدار الاتصال به."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספרייה זו משתמשת בספק שגרסה זו אינה יכולה להתחבר אליו."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця бібліотека використовує постачальника, до якого ця збірка не може під'єднатися."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази библиотека използва доставчик, към който тази версия не може да се свърже."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta biblioteka używa dostawcy, z którym ta kompilacja nie może się połączyć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato knihovna používá poskytovatele, ke kterému se toto sestavení nedokáže připojit."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova knjižnica koristi pružatelja s kojim se ova verzija ne može povezati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보관함은 이 빌드가 연결할 수 없는 제공자를 사용합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫使用了此版本無法連線的服務商。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa libreria usa un provider a cui questa build non può connettersi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitaplık, bu derlemenin bağlanamadığı bir sağlayıcı kullanıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện này dùng một nhà cung cấp mà bản dựng này không thể kết nối."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bibliotheek gebruikt een provider waarmee deze build geen verbinding kan maken."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लाइब्रेरी ऐसे प्रदाता का उपयोग करती है जिससे यह बिल्ड कनेक्ट नहीं हो सकता."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লাইব্রেরি এমন একটি প্রোভাইডার ব্যবহার করে যার সাথে এই বিল্ড সংযোগ করতে পারে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த லைப்ரரி இந்த பில்ட் இணைக்க முடியாத வழங்குநரைப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ లైబ్రరీ ఈ బిల్డ్ కనెక్ట్ కాలేని ప్రొవైడర్‌ను ఉపయోగిస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही लायब्ररी अशा प्रोव्हायडरचा वापर करते ज्याच्याशी हे बिल्ड जोडले जाऊ शकत नाही."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ لائبریری ایسا فراہم کنندہ استعمال کرتی ہے جس سے یہ بلڈ منسلک نہیں ہو سکتا۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ લાઇબ્રેરી એવા પ્રોવાઇડરનો ઉપયોગ કરે છે જેની સાથે આ બિલ્ડ કનેક્ટ થઈ શકતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಲೈಬ್ರರಿ ಈ ಬಿಲ್ಡ್ ಸಂಪರ್ಕಿಸಲಾಗದ ಪೂರೈಕೆದಾರರನ್ನು ಬಳಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ലൈബ്രറി ഈ ബിൽഡിന് കണക്റ്റ് ചെയ്യാനാവാത്ത ഒരു പ്രൊവൈഡർ ഉപയോഗിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਲਾਇਬ੍ਰੇਰੀ ਅਜਿਹੇ ਪ੍ਰਦਾਤਾ ਦੀ ਵਰਤੋਂ ਕਰਦੀ ਹੈ ਜਿਸ ਨਾਲ ਇਹ ਬਿਲਡ ਜੁੜ ਨਹੀਂ ਸਕਦਾ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังนี้ใช้ผู้ให้บริการที่บิลด์นี้เชื่อมต่อไม่ได้"
          }
        }
      }
    },
