    "Add this device to a library you already have, or to one you were invited to." : {
      "comment" : "Onboarding: the first screen's explanation under the bae wordmark, above Restore with your code and Join a library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف هذا الجهاز إلى مكتبة لديك بالفعل، أو إلى مكتبة دُعيت إليها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете това устройство към библиотека, която вече имате, или към такава, в която сте поканени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte toto zařízení do knihovny, kterou už máte, nebo do té, do které vás někdo pozval."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føj denne enhed til et bibliotek, du allerede har, eller til et, du er inviteret til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge dieses Gerät einer Bibliothek hinzu, die du schon hast, oder einer, zu der du eingeladen wurdest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε αυτή τη συσκευή σε μια βιβλιοθήκη που έχετε ήδη ή σε μια στην οποία σας προσκάλεσαν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade este dispositivo a una biblioteca que ya tienes o a una a la que te han invitado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää tämä laite kirjastoon, joka sinulla jo on, tai kirjastoon, johon sinut on kutsuttu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez cet appareil à une bibliothèque que vous avez déjà, ou à une bibliothèque à laquelle vous avez été invité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסיפו את המכשיר הזה לספרייה שכבר יש לכם, או לספרייה שהוזמנתם אליה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte ovaj uređaj u fonoteku koju već imate ili u onu u koju ste pozvani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add hozzá ezt az eszközt egy könyvtárhoz, amely már megvan, vagy amelybe meghívtak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi questo dispositivo a una libreria che hai già o a una a cui sei stato invitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスを、すでに持っているライブラリか、招待されたライブラリに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 가지고 있는 라이브러리나 초대받은 라이브러리에 이 기기를 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til denne enheten i et bibliotek du allerede har, eller i et du er invitert til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg dit apparaat toe aan een bibliotheek die je al hebt, of aan een bibliotheek waarvoor je bent uitgenodigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj to urządzenie do biblioteki, którą już masz, albo do takiej, do której Cię zaproszono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione este dispositivo a uma biblioteca que você já tem ou a uma para a qual foi convidado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione este dispositivo a uma biblioteca que já tenha ou a uma para a qual foi convidado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă acest dispozitiv la o bibliotecă pe care o ai deja sau la una la care ai fost invitat."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte toto zariadenie do knižnice, ktorú už máte, alebo do tej, do ktorej vás niekto pozval."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till den här enheten i ett bibliotek du redan har, eller i ett du har bjudits in till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazı zaten sahip olduğunuz bir kitaplığa ya da davet edildiğiniz bir kitaplığa ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте цей пристрій до бібліотеки, яку ви вже маєте, або до тієї, до якої вас запросили."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此设备添加到你已有的库，或你受邀加入的库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此裝置加入你已有的資料庫，或你受邀加入的資料庫。"
          }
        }
      }
    },
