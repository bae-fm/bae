    "Check that this matches the fingerprint shown on the new device before approving.": {
      "comment": "Device pairing: instruction before the owner approves the displayed identity.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من أن هذا يطابق البصمة المعروضة على الجهاز الجديد قبل الموافقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди одобряване проверете дали това съвпада с отпечатъка, показан на новото устройство."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমোদনের আগে এটি নতুন ডিভাইসে দেখানো ফিঙ্গারপ্রিন্টের সঙ্গে মেলে কিনা পরীক্ষা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před schválením zkontrolujte, že se shoduje s otiskem zobrazeným na novém zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe vor dem Genehmigen, dass dies mit dem Fingerabdruck auf dem neuen Gerät übereinstimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that this matches the fingerprint shown on the new device before approving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que coincida con la huella mostrada en el dispositivo nuevo antes de aprobarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que cela correspond à l’empreinte affichée sur le nouvel appareil avant d’approuver."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મંજૂર કરતાં પહેલાં તપાસો કે આ નવા ઉપકરણ પર દેખાતા ફિંગરપ્રિન્ટ સાથે મેળ ખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפני האישור, בדקו שזה תואם לטביעת האצבע שמוצגת במכשיר החדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मंजूर करने से पहले जांचें कि यह नए उपकरण पर दिखाए गए फिंगरप्रिंट से मेल खाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prije odobravanja provjerite podudara li se ovo s otiskom prikazanim na novom uređaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di approvare, verifica che corrisponda all\\'impronta mostrata sul nuovo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認する前に、新しいデバイスに表示されているフィンガープリントと一致することを確認してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನುಮೋದಿಸುವ ಮೊದಲು ಇದು ಹೊಸ ಸಾಧನದಲ್ಲಿ ತೋರಿಸಲಾದ fingerprint ಗೆ ಹೊಂದುತ್ತದೆಯೇ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하기 전에 새 기기에 표시된 지문과 일치하는지 확인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അംഗീകരിക്കുന്നതിന് മുമ്പ് ഇത് പുതിയ ഉപകരണത്തിൽ കാണുന്ന വിരലടയാളവുമായി പൊരുത്തപ്പെടുന്നുണ്ടോ എന്ന് പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मंजूर करण्यापूर्वी हे नवीन डिव्हाइसवर दिसणाऱ्या fingerprint शी जुळते का ते तपासा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer vóór goedkeuring of dit overeenkomt met de vingerafdruk op het nieuwe apparaat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਨਜ਼ੂਰ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਜਾਂਚੋ ਕਿ ਇਹ ਨਵੇਂ ਡਿਵਾਈਸ ਉੱਤੇ ਦਿਖਾਏ fingerprint ਨਾਲ ਮਿਲਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed zatwierdzeniem sprawdź, czy zgadza się z odciskiem wyświetlanym na nowym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se isto corresponde à impressão digital mostrada no novo dispositivo antes de aprovar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒப்புதல் அளிக்கும் முன் இது புதிய சாதனத்தில் காட்டப்படும் கைரேகையுடன் பொருந்துகிறதா எனச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆమోదించే ముందు ఇది కొత్త పరికరంలో చూపిన ఫింగర్‌ప్రింట్‌తో సరిపోతుందో చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบว่าสิ่งนี้ตรงกับลายนิ้วมือที่แสดงบนอุปกรณ์ใหม่ก่อนอนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamadan önce bunun yeni cihazda gösterilen parmak iziyle eşleştiğini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед схваленням перевірте, що це збігається з відбитком, показаним на новому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منظوری سے پہلے جانچیں کہ یہ نئے آلے پر دکھائے گئے فنگرپرنٹ سے ملتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra giá trị này khớp với dấu vân tay hiển thị trên thiết bị mới trước khi phê duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准前，请确认这与新设备上显示的指纹一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准前，請確認這與新裝置顯示的指紋相符。"
          }
        }
      }
    },
