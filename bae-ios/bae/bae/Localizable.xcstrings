        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud geçici olarak kullanılamıyor. Birazdan yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud tạm thời không khả dụng. Hãy thử lại sau giây lát."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is tijdelijk niet beschikbaar. Probeer het zo meteen opnieuw."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud अस्थायी रूप से अनुपलब्ध है. थोड़ी देर में दोबारा कोशिश करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud সাময়িকভাবে অনুপলব্ধ। একটু পরে আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud தற்காலிகமாகக் கிடைக்கவில்லை. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud తాత్కాలికంగా అందుబాటులో లేదు. కొద్దిసేపటి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud तात्पुरते अनुपलब्ध आहे. थोड्या वेळाने पुन्हा प्रयत्न करा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud عارضی طور پر دستیاب نہیں ہے۔ تھوڑی دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud અસ્થાયી રૂપે ઉપલબ્ધ નથી. થોડી વારમાં ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ತಾತ್ಕಾಲಿಕವಾಗಿ ಲಭ್ಯವಿಲ್ಲ. ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud താൽക്കാലികമായി ലഭ്യമല്ല. അൽപ്പസമയത്തിനു ശേഷം വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ਆਰਜ਼ੀ ਤੌਰ ਉੱਤੇ ਉਪਲਬਧ ਨਹੀਂ ਹੈ। ਥੋੜ੍ਹੀ ਦੇਰ ਬਾਅਦ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ใช้งานไม่ได้ชั่วคราว ลองอีกครั้งในอีกสักครู่"
          }
        }
      }
    },
