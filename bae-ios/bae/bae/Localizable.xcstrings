    "Restore codes saved by your other devices signed in to this Apple Account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رموز الاستعادة التي حفظتها أجهزتك الأخرى المسجّل دخولها إلى حساب Apple هذا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кодове за възстановяване, запазени от другите ви устройства, влезли в този акаунт в Apple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kódy pro obnovení uložené vašimi dalšími zařízeními přihlášenými k tomuto Apple účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendannelseskoder gemt af dine andre enheder, der er logget ind på denne Apple-konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederherstellungscodes, die deine anderen Geräte mit diesem Apple Account gespeichert haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κωδικοί επαναφοράς που αποθηκεύτηκαν από τις άλλες συσκευές σας συνδεδεμένες σε αυτόν τον λογαριασμό Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Códigos de restauración guardados por tus otros dispositivos con sesión iniciada en esta cuenta de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautuskoodit, jotka muut tähän Apple-tiliin kirjautuneet laitteesi ovat tallentaneet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codes de restauration enregistrés par vos autres appareils connectés à ce compte Apple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קודי שחזור שנשמרו על ידי המכשירים האחרים שלכם המחוברים לחשבון Apple הזה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodovi za vraćanje koje su spremili vaši drugi uređaji prijavljeni na ovaj Apple račun."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
