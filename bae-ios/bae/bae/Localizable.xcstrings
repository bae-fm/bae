    "Create an access key for them in your storage provider's console. The invitation carries it to their device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ مفتاح وصول لهذا الشخص في وحدة تحكم موفّر التخزين. تنقله الدعوة إلى جهازه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създайте ключ за достъп за човека в конзолата на доставчика на хранилище. Поканата го пренася до устройството му."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte pro tuto osobu přístupový klíč v konzoli poskytovatele úložiště. Pozvánka ho přenese do jejího zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en adgangsnøgle til personen i din lagerudbyders konsol. Invitationen bringer den til personens enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle in der Konsole deines Speicheranbieters einen Zugriffsschlüssel für die Person. Die Einladung bringt ihn auf ihr Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε ένα κλειδί πρόσβασης για το άτομο στην κονσόλα του παρόχου αποθήκευσης. Η πρόσκληση το μεταφέρει στη συσκευή του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una clave de acceso para esa persona en la consola de tu proveedor de almacenamiento. La invitación la lleva a su dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo henkilölle käyttöoikeusavain tallennuspalvelusi konsolissa. Kutsu vie sen hänen laitteelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez une clé d’accès pour cette personne dans la console de votre fournisseur de stockage. L’invitation la transmet à son appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צרו מפתח גישה עבור האדם במסוף של ספק האחסון. ההזמנה מעבירה אותו למכשיר שלו."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izradite pristupni ključ za tu osobu u konzoli pružatelja pohrane. Pozivnica ga prenosi na njezin uređaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozz létre számára hozzáférési kulcsot a tárhelyszolgáltatód konzolján. A meghívó eljuttatja az eszközére."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una chiave di accesso per questa persona nella console del tuo provider di archiviazione. L’invito la porta sul suo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレージプロバイダのコンソールで、その人用のアクセスキーを作成してください。招待によってその人のデバイスに届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스토리지 제공업체 콘솔에서 그 사람을 위한 액세스 키를 만드세요. 초대가 키를 그 사람의 기기로 전달합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opprett en tilgangsnøkkel for personen i lagringsleverandørens konsoll. Invitasjonen bringer den til personens enhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak in de console van je opslagprovider een toegangssleutel voor deze persoon. De uitnodiging brengt hem naar het apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz dla tej osoby klucz dostępu w konsoli dostawcy magazynu. Zaproszenie przekaże go na jej urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie uma chave de acesso para a pessoa no console do seu provedor de armazenamento. O convite a leva até o dispositivo dela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie uma chave de acesso para a pessoa na consola do seu fornecedor de armazenamento. O convite leva-a para o dispositivo dela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează o cheie de acces pentru persoana respectivă în consola furnizorului de stocare. Invitația o duce pe dispozitivul ei."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorte pre túto osobu prístupový kľúč v konzole poskytovateľa úložiska. Pozvánka ho prenesie do jej zariadenia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa en åtkomstnyckel åt personen i lagringsleverantörens konsol. Inbjudan för den till personens enhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depolama sağlayıcınızın konsolunda bu kişi için bir erişim anahtarı oluşturun. Davet onu kişinin aygıtına taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть ключ доступу для цієї людини в консолі постачальника сховища. Запрошення передасть його на її пристрій."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在存储提供商的控制台中为对方创建访问密钥。邀请会将其带到对方的设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在儲存空間供應商的主控台中為對方建立存取金鑰。邀請會將其帶到對方的裝置。"
          }
        }
      }
    },
