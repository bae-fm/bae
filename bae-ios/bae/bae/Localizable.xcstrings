            "state": "translated",
            "value": "మీ పునరుద్ధరణ కోడ్‌ను అతికించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा पुनर्प्राप्ती कोड पेस्ट करा"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا بازیابی کوڈ پیسٹ کریں"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો પુનઃપ્રાપ્તિ કોડ ચોંટાડો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮರುಪಡೆಯುವಿಕೆ ಕೋಡ್ ಅಂಟಿಸಿ"
