    "Devices that share this library. Approve a new device, or remove one.": {
      "comment": "Settings: what the Members section is for",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices that share this library. Approve a new device, or remove one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos que comparten esta biblioteca. Aprueba uno nuevo o quita alguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareils qui partagent cette bibliothèque. Approuvez un nouvel appareil ou retirez-en un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte, die diese Mediathek teilen. Genehmige ein neues Gerät oder entferne eines."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos que compartilham esta biblioteca. Aprove um novo dispositivo ou remova um."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリを共有しているデバイスです。新しいデバイスを承認するか、削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享此资料库的设备。批准新设备，或移除某个设备。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجهزة التي تشارك هذه المكتبة. وافق على جهاز جديد أو أزل جهازًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשירים שמשתפים את הספרייה הזו. אשרו מכשיר חדש או הסירו אחד."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрої, які спільно використовують цю бібліотеку. Схваліть новий пристрій або вилучіть якийсь."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства, които споделят тази библиотека. Одобрете ново устройство или премахнете някое."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenia, które współdzielą tę bibliotekę. Zatwierdź nowe urządzenie lub usuń któreś."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení, která sdílejí tuto knihovnu. Schvalte nové zařízení nebo některé odeberte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaji koji dijele ovu fonoteku. Odobrite novi uređaj ili neki uklonite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리를 공유하는 기기입니다. 새 기기를 승인하거나 기기를 제거하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享此資料庫的裝置。批准新裝置，或移除某個裝置。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivi che condividono questa libreria. Approvane uno nuovo o rimuovine uno."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitaplığı paylaşan aygıtlar. Yeni bir aygıt onaylayın veya birini kaldırın."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaten die deze bibliotheek delen. Keur een nieuw apparaat goed of verwijder er een."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zariadenia, ktoré zdieľajú túto knižnicu. Schváľ nové zariadenie alebo niektoré odstráň."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek az eszközök osztoznak a könyvtáron. Hagyj jóvá egy új eszközt, vagy távolíts el egyet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispozitivele care partajează această bibliotecă. Aprobă un dispozitiv nou sau elimină unul."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συσκευές που μοιράζονται αυτή τη βιβλιοθήκη. Εγκρίνετε μια νέα συσκευή ή αφαιρέστε κάποια."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos que partilham esta biblioteca. Aprove um dispositivo novo ou remova um."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheter som delar det här biblioteket. Godkänn en ny enhet eller ta bort en."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheder, der deler dette bibliotek. Godkend en ny enhed, eller fjern en."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheter som deler dette biblioteket. Godkjenn en ny enhet, eller fjern en."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä kirjastoa jakavat laitteet. Hyväksy uusi laite tai poista jokin."
          }
        }
      }
    },
