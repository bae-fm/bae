        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的 iCloud 受限（家长控制或 MDM）。bae 无法用它同步。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud مقيَّد على هذا الجهاز (الرقابة الأبوية أو إدارة الأجهزة). لا يستطيع bae استخدامه للمزامنة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud מוגבל במכשיר הזה (בקרת הורים או MDM). bae לא יכול להשתמש בו לסנכרון."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud обмежено на цьому пристрої (батьківський контроль або MDM). bae не може використовувати його для синхронізації."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud е ограничен на това устройство (родителски контрол или MDM). bae не може да го използва за синхронизиране."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest ograniczony na tym urządzeniu (kontrola rodzicielska lub MDM). bae nie może go użyć do synchronizacji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je na tomto zařízení omezen (rodičovská kontrola nebo MDM). bae jej nemůže použít k synchronizaci."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je ograničen na ovom uređaju (roditeljski nadzor ili MDM). bae ga ne može koristiti za sinkronizaciju."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 iCloud가 제한되어 있습니다(자녀 보호 기능 또는 MDM). bae는 동기화에 사용할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的 iCloud 受限（家長控制或 MDM）。bae 無法用它同步。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud è limitato su questo dispositivo (controlli parentali o MDM). bae non può usarlo per la sincronizzazione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtta iCloud kısıtlanmış (ebeveyn denetimleri veya MDM). bae bunu eşitleme için kullanamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud bị hạn chế trên thiết bị này (kiểm soát của phụ huynh hoặc MDM). bae không thể dùng nó để đồng bộ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is beperkt op dit apparaat (ouderlijk toezicht of MDM). bae kan het niet gebruiken om te synchroniseren."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर iCloud प्रतिबंधित है (पैरेंटल कंट्रोल या MDM). bae इसे सिंक के लिए उपयोग नहीं कर सकता."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে iCloud সীমাবদ্ধ (প্যারেন্টাল কন্ট্রোল বা MDM)। bae এটি সিঙ্কের জন্য ব্যবহার করতে পারে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் iCloud கட்டுப்படுத்தப்பட்டுள்ளது (பெற்றோர் கட்டுப்பாடு அல்லது MDM). bae அதை ஒத்திசைவுக்குப் பயன்படுத்த முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరంలో iCloud పరిమితం చేయబడింది (పేరెంటల్ కంట్రోల్స్ లేదా MDM). baeకి దాన్ని సింక్ కోసం ఉపయోగించడం సాధ్యం కాదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवर iCloud मर्यादित आहे (पालक नियंत्रण किंवा MDM). bae ते सिंकसाठी वापरू शकत नाही."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے پر iCloud محدود ہے (پیرنٹل کنٹرولز یا MDM)۔ bae اسے سِنک کے لیے استعمال نہیں کر سکتا۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઉપકરણ પર iCloud પ્રતિબંધિત છે (પેરેન્ટલ કંટ્રોલ અથવા MDM). bae તેને સિંક માટે વાપરી શકતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನದಲ್ಲಿ iCloud ನಿರ್ಬಂಧಿತವಾಗಿದೆ (ಪೋಷಕ ನಿಯಂತ್ರಣ ಅಥವಾ MDM). bae ಅದನ್ನು ಸಿಂಕ್‌ಗಾಗಿ ಬಳಸಲಾಗದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിൽ iCloud നിയന്ത്രിച്ചിരിക്കുന്നു (രക്ഷാകർതൃ നിയന്ത്രണം അല്ലെങ്കിൽ MDM). bae-ക്ക് അത് സമന്വയത്തിന് ഉപയോഗിക്കാനാവില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਡਿਵਾਈਸ ਉੱਤੇ iCloud ਸੀਮਿਤ ਹੈ (ਮਾਪਿਆਂ ਦਾ ਕੰਟਰੋਲ ਜਾਂ MDM)। bae ਇਸਨੂੰ ਸਿੰਕ ਲਈ ਨਹੀਂ ਵਰਤ ਸਕਦਾ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ถูกจำกัดบนอุปกรณ์นี้ (การควบคุมโดยผู้ปกครองหรือ MDM) bae ใช้สำหรับซิงค์ไม่ได้"
          }
        }
      }
    },
    "Couldn't determine iCloud account status. Check your network and try again.": {
      "comment": "Sync setup: iCloud could not report an account status, usually a network problem",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't determine iCloud account status. Check your network and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo determinar el estado de la cuenta de iCloud. Comprueba tu red e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déterminer l'état du compte iCloud. Vérifiez votre réseau, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Accountstatus konnte nicht ermittelt werden. Prüfe dein Netzwerk und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível determinar o estado da conta do iCloud. Verifique sua rede e tente novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudアカウントの状況を判断できませんでした。ネットワークを確認してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定 iCloud 账户状态。请检查网络后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد حالة حساب iCloud. تحقّق من الشبكة وأعد المحاولة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקבוע את מצב חשבון ה-iCloud. בדוק את הרשת ונסה שוב."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити стан облікового запису iCloud. Перевірте мережу та повторіть спробу."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Състоянието на профила в iCloud не можа да бъде определено. Проверете мрежата и опитайте отново."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ustalić stanu konta iCloud. Sprawdź sieć i spróbuj ponownie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se zjistit stav účtu iCloud. Zkontrolujte síť a zkuste to znovu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće utvrditi stanje iCloud računa. Provjerite mrežu i pokušajte ponovno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 계정 상태를 확인할 수 없습니다. 네트워크를 확인한 다음 다시 시도하십시오."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法判斷 iCloud 帳戶狀態。請檢查網路後再試一次。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile determinare lo stato dell'account iCloud. Controlla la rete e riprova."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hesabının durumu belirlenemedi. Ağınızı denetleyip yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác định trạng thái tài khoản iCloud. Hãy kiểm tra mạng và thử lại."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de status van de iCloud-account niet bepalen. Controleer je netwerk en probeer het opnieuw."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud खाते की स्थिति निर्धारित नहीं की जा सकी. अपना नेटवर्क जाँचें और दोबारा कोशिश करें."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud অ্যাকাউন্টের অবস্থা নির্ধারণ করা যায়নি। আপনার নেটওয়ার্ক পরীক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud கணக்கின் நிலையைத் தீர்மானிக்க முடியவில்லை. உங்கள் நெட்வொர்க்கைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ఖాతా స్థితిని నిర్ధారించడం సాధ్యం కాలేదు. మీ నెట్‌వర్క్‌ను తనిఖీ చేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud खात्याची स्थिती निश्चित करता आली नाही. तुमचे नेटवर्क तपासा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud اکاؤنٹ کی صورتحال متعین نہیں ہو سکی۔ اپنا نیٹ ورک جانچیں اور دوبارہ کوشش کریں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ખાતાની સ્થિતિ નક્કી કરી શકાઈ નહીં. તમારું નેટવર્ક તપાસો અને ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ಖಾತೆಯ ಸ್ಥಿತಿಯನ್ನು ನಿರ್ಧರಿಸಲಾಗಲಿಲ್ಲ. ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ಪರಿಶೀಲಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud അക്കൗണ്ട് നില നിർണ്ണയിക്കാനായില്ല. നിങ്ങളുടെ നെറ്റ്‌വർക്ക് പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ਖਾਤੇ ਦੀ ਸਥਿਤੀ ਪਤਾ ਨਹੀਂ ਲੱਗ ਸਕੀ। ਆਪਣਾ ਨੈੱਟਵਰਕ ਜਾਂਚੋ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุสถานะบัญชี iCloud ไม่ได้ ตรวจสอบเครือข่ายของคุณแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "iCloud is temporarily unavailable. Try again in a moment.": {
      "comment": "Sync setup: iCloud reports itself temporarily unavailable",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is temporarily unavailable. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no está disponible temporalmente. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est temporairement indisponible. Réessayez dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist vorübergehend nicht verfügbar. Versuche es gleich noch einmal."
          }
