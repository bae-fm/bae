          }
        }
      }
    },
    "Your iCloud storage is full. Free up space in System Settings → Apple ID → iCloud to keep syncing.": {
      "comment": "Sync failure: the iCloud account is out of storage",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iCloud storage is full. Free up space in System Settings → Apple ID → iCloud to keep syncing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu almacenamiento de iCloud está lleno. Libera espacio en Ajustes del Sistema → Apple ID → iCloud para seguir sincronizando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre stockage iCloud est plein. Libérez de l'espace dans Réglages Système → Identifiant Apple → iCloud pour continuer la synchronisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iCloud-Speicher ist voll. Gib in „Systemeinstellungen“ → Apple-ID → iCloud Speicher frei, um weiter zu synchronisieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu armazenamento do iCloud está cheio. Libere espaço em Ajustes do Sistema → ID Apple → iCloud para continuar sincronizando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudストレージがいっぱいです。同期を続けるには「システム設定」→「Apple ID」→「iCloud」で空き容量を作ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iCloud 存储空间已满。请在“系统设置”→“Apple ID”→“iCloud”中释放空间以继续同步。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة تخزين iCloud لديك ممتلئة. حرّر مساحة من إعدادات النظام ← Apple ID ← iCloud لمواصلة المزامنة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחסון ה-iCloud שלך מלא. פנה מקום בהגדרות המערכת ← Apple ID ← iCloud כדי להמשיך לסנכרן."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше сховище iCloud заповнене. Звільніть місце в «Системні параметри» → Apple ID → iCloud, щоб синхронізація тривала."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилището ви в iCloud е пълно. Освободете място в „Системни настройки“ → Apple ID → iCloud, за да продължите да синхронизирате."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja pamięć iCloud jest pełna. Zwolnij miejsce w Ustawienia systemowe → Apple ID → iCloud, aby dalej synchronizować."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše úložiště iCloud je plné. Uvolněte místo v Nastavení systému → Apple ID → iCloud, aby synchronizace pokračovala."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša iCloud pohrana je puna. Oslobodite prostor u Postavke sustava → Apple ID → iCloud kako bi se sinkronizacija nastavila."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 저장 공간이 가득 찼습니다. 동기화를 계속하려면 시스템 설정 → Apple ID → iCloud에서 공간을 확보하십시오."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iCloud 儲存空間已滿。請在「系統設定」→「Apple ID」→「iCloud」中釋放空間以繼續同步。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo spazio iCloud è pieno. Libera spazio in Impostazioni di Sistema → ID Apple → iCloud per continuare la sincronizzazione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
