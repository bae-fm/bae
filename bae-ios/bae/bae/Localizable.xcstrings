    "Devices that share this library. Approve a new device, or remove one.": {
      "comment": "Settings: what the Members section is for",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices that share this library. Approve a new device, or remove one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos que comparten esta biblioteca. Aprueba uno nuevo o quita alguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareils qui partagent cette bibliothèque. Approuvez un nouvel appareil ou retirez-en un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte, die diese Mediathek teilen. Genehmige ein neues Gerät oder entferne eines."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos que compartilham esta biblioteca. Aprove um novo dispositivo ou remova um."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリを共有しているデバイスです。新しいデバイスを承認するか、削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享此资料库的设备。批准新设备，或移除某个设备。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجهزة التي تشارك هذه المكتبة. وافق على جهاز جديد أو أزل جهازًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשירים שמשתפים את הספרייה הזו. אשרו מכשיר חדש או הסירו אחד."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрої, які спільно використовують цю бібліотеку. Схваліть новий пристрій або вилучіть якийсь."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства, които споделят тази библиотека. Одобрете ново устройство или премахнете някое."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenia, które współdzielą tę bibliotekę. Zatwierdź nowe urządzenie lub usuń któreś."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení, která sdílejí tuto knihovnu. Schvalte nové zařízení nebo některé odeberte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaji koji dijele ovu fonoteku. Odobrite novi uređaj ili neki uklonite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리를 공유하는 기기입니다. 새 기기를 승인하거나 기기를 제거하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享此資料庫的裝置。批准新裝置，或移除某個裝置。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivi che condividono questa libreria. Approvane uno nuovo o rimuovine uno."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitaplığı paylaşan aygıtlar. Yeni bir aygıt onaylayın veya birini kaldırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thiết bị dùng chung thư viện này. Phê duyệt thiết bị mới, hoặc gỡ bớt một thiết bị."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaten die deze bibliotheek delen. Keur een nieuw apparaat goed of verwijder er een."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे डिवाइस जो यह लाइब्रेरी साझा करते हैं। नया डिवाइस स्वीकृत करें, या कोई हटाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব ডিভাইস এই লাইব্রেরি ভাগ করে। নতুন ডিভাইস অনুমোদন করুন, বা একটি সরান।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நூலகத்தைப் பகிரும் சாதனங்கள். புதிய சாதனத்தை அங்கீகரிக்கவும், அல்லது ஒன்றை அகற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ లైబ్రరీని పంచుకునే పరికరాలు. కొత్త పరికరాన్ని ఆమోదించండి, లేదా ఒకదాన్ని తీసివేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे संग्रहालय सामायिक करणारी डिव्हाइस. नवीन डिव्हाइस मंजूर करा, किंवा एक काढा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ آلات جو یہ لائبریری شیئر کرتے ہیں۔ نیا آلہ منظور کریں، یا کوئی ہٹا دیں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ લાઇબ્રેરી શેર કરતાં ઉપકરણો. નવું ઉપકરણ મંજૂર કરો, અથવા એક દૂર કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಲೈಬ್ರರಿಯನ್ನು ಹಂಚಿಕೊಳ್ಳುವ ಸಾಧನಗಳು. ಹೊಸ ಸಾಧನವನ್ನು ಅನುಮೋದಿಸಿ, ಅಥವಾ ಒಂದನ್ನು ತೆಗೆದುಹಾಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ശേഖരം പങ്കിടുന്ന ഉപകരണങ്ങൾ. ഒരു പുതിയ ഉപകരണം അംഗീകരിക്കുക, അല്ലെങ്കിൽ ഒന്ന് നീക്കംചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਡਿਵਾਈਸ ਜੋ ਇਹ ਲਾਇਬ੍ਰੇਰੀ ਸਾਂਝੀ ਕਰਦੇ ਹਨ। ਨਵਾਂ ਡਿਵਾਈਸ ਮਨਜ਼ੂਰ ਕਰੋ, ਜਾਂ ਕੋਈ ਹਟਾਓ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์ที่ใช้คลังนี้ร่วมกัน อนุมัติอุปกรณ์ใหม่ หรือนำออกสักเครื่อง"
          }
        }
      }
    },
