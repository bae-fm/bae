    "Scan this code on the device joining your library.": {
      "comment": "Device pairing: instruction on the existing device.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح هذا الرمز على الجهاز الذي ينضم إلى مكتبتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирайте този код на устройството, което се присъединява към библиотеката ви."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naskenujte tento kód na zařízení, které se připojuje k vaší knihovně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan denne kode på den enhed, der deltager i dit bibliotek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this code on the device joining your library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Code auf dem Gerät, das deiner Mediathek beitritt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαρώστε αυτόν τον κωδικό στη συσκευή που συνδέεται στη βιβλιοθήκη σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código en el dispositivo que se va a unir a tu biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaa tämä koodi laitteella, joka liittyy kirjastoosi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce code sur l’appareil qui rejoint votre bibliothèque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרקו את הקוד הזה במכשיר שמצטרף לספרייה שלכם."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenirajte ovaj kod na uređaju koji se pridružuje vašoj fonoteci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvastasd be ezt a kódot a könyvtáradhoz csatlakozó eszközzel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona questo codice sul dispositivo che si unisce alla tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリに参加するデバイスでこのコードをスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리에 참여할 기기에서 이 코드를 스캔하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skann denne koden på enheten som blir med i biblioteket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan deze code op het apparaat dat aan je bibliotheek deelneemt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj ten kod na urządzeniu, które dołącza do Twojej biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie este código no dispositivo que está entrando na sua biblioteca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalize este código no dispositivo que vai aderir à sua biblioteca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanează acest cod pe dispozitivul care se alătură bibliotecii tale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naskenuj tento kód na zariadení, ktoré sa pripája ku tvojej knižnici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna den här koden på enheten som ansluter sig till ditt bibliotek."
