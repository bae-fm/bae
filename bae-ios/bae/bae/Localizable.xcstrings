    "This library needs cloud sign-in, which isn't configured on this build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This library needs cloud sign-in, which isn't configured on this build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca necesita iniciar sesión en la nube, que no está configurado en esta versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette bibliothèque nécessite une connexion au cloud, qui n'est pas configurée sur cette version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bibliothek erfordert eine Cloud-Anmeldung, die in diesem Build nicht konfiguriert ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca precisa de login na nuvem, que não está configurado nesta versão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリにはクラウドサインインが必要ですが、このビルドでは設定されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此库需要云登录，但此版本未配置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج هذه المكتبة إلى تسجيل دخول سحابي، وهو غير مُعدّ في هذه النسخة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספרייה זו דורשת כניסה לענן, שאינה מוגדרת בגרסה זו."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї бібліотеки потрібен хмарний вхід, який не налаштовано в цій збірці."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази библиотека изисква влизане в облака, което не е конфигурирано в тази версия."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta biblioteka wymaga logowania do chmury, które nie jest skonfigurowane w tej wersji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato knihovna vyžaduje přihlášení k cloudu, které není v tomto sestavení nakonfigurováno."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova fonoteka zahtijeva prijavu u oblak, koja nije konfigurirana u ovoj verziji."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리는 클라우드 로그인이 필요하지만 이 빌드에는 설정되어 있지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫需要雲端登入，但此建置尚未設定。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa libreria richiede l'accesso cloud, che non è configurato in questa build."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitaplık, bu derlemede yapılandırılmamış bir bulut oturumu gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện này cần đăng nhập đám mây, nhưng chưa được cấu hình trong bản dựng này."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bibliotheek heeft cloudaanmelding nodig, die niet is geconfigureerd in deze build."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लाइब्रेरी को क्लाउड साइन-इन चाहिए, जो इस बिल्ड पर कॉन्फ़िगर नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লাইব্রেরির জন্য ক্লাউড সাইন-ইন দরকার, যা এই বিল্ডে কনফিগার করা নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நூலகத்திற்கு மேக உள்நுழைவு தேவை; அது இந்த உருவாக்கத்தில் அமைக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ లైబ్రరీకి క్లౌడ్ సైన్-ఇన్ అవసరం, ఇది ఈ బిల్డ్‌లో కాన్ఫిగర్ చేయబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या लायब्ररीसाठी क्लाउड साइन-इन आवश्यक आहे, जे या बिल्डवर कॉन्फिगर केलेले नाही."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس لائبریری کو کلاؤڈ سائن اِن درکار ہے، جو اس بلڈ پر ترتیب نہیں دیا گیا۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ લાઇબ્રેરીને ક્લાઉડ સાઇન-ઇન જોઈએ છે, જે આ બિલ્ડ પર કન્ફિગર કરેલું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಗ್ರಂಥಾಲಯಕ್ಕೆ ಕ್ಲೌಡ್ ಸೈನ್-ಇನ್ ಅಗತ್ಯವಿದೆ, ಅದನ್ನು ಈ ಬಿಲ್ಡ್‌ನಲ್ಲಿ ಸಂರಚಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ലൈബ്രറിക്ക് ക്ലൗഡ് സൈൻ-ഇൻ വേണം; അത് ഈ ബിൽഡിൽ ക്രമീകരിച്ചിട്ടില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਲਾਇਬ੍ਰੇਰੀ ਨੂੰ ਕਲਾਊਡ ਸਾਈਨ-ਇਨ ਦੀ ਲੋੜ ਹੈ, ਜੋ ਇਸ ਬਿਲਡ ਤੇ ਸੰਰਚਿਤ ਨਹੀਂ ਹੈ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังนี้ต้องลงชื่อเข้าใช้คลาวด์ ซึ่งยังไม่ได้ตั้งค่าไว้ในบิลด์นี้"
          }
        }
      }
    },
