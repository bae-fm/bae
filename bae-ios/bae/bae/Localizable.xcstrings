    "Uses iCloud for sync. Requires iCloud to be turned on in Settings." : {
      "comment" : "Settings › Set Up Sync › iCloud: explanation above Use iCloud.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم iCloud للمزامنة. يتطلب تشغيل iCloud في الإعدادات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използва iCloud за синхронизиране. Изисква iCloud да е включен в Настройки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K synchronizaci používá iCloud. Vyžaduje zapnutý iCloud v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger iCloud til synkronisering. Kræver, at iCloud er slået til i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
