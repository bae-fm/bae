    "Removes this library and its downloaded files from this device. Your library in the cloud is untouched — you can re-pair this device later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this library and its downloaded files from this device. Your library in the cloud is untouched — you can re-pair this device later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita esta biblioteca y sus archivos descargados de este dispositivo. Tu biblioteca en la nube no se toca — puedes volver a emparejar este dispositivo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime cette bibliothèque et ses fichiers téléchargés de cet appareil. Votre bibliothèque dans le cloud n'est pas touchée — vous pourrez réassocier cet appareil plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt diese Bibliothek und ihre heruntergeladenen Dateien von diesem Gerät. Deine Bibliothek in der Cloud bleibt unberührt — du kannst dieses Gerät später erneut koppeln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove esta biblioteca e seus arquivos baixados deste dispositivo. Sua biblioteca na nuvem permanece intacta — você pode parear este dispositivo novamente mais tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリとそのダウンロード済みファイルをこのデバイスから削除します。クラウド上のライブラリはそのまま残ります。このデバイスは後で再ペアリングできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此设备移除此库及其已下载文件。你在云端的库不受影响 — 你可以稍后重新配对此设备。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذه المكتبة وملفاتها المنزّلة من هذا الجهاز. لن تتأثر مكتبتك في السحابة — يمكنك إعادة ربط هذا الجهاز لاحقًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיר ספרייה זו ואת הקבצים שהורדו ממנה מהמכשיר הזה. הספרייה שלכם בענן לא תיפגע — תוכלו לצמד מחדש את המכשיר הזה מאוחר יותר."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучає цю бібліотеку та її завантажені файли з цього пристрою. Ваша бібліотека в хмарі залишається незмінною — ви можете повторно підключити цей пристрій пізніше."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Премахва тази библиотека и изтеглените ѝ файлове от това устройство. Библиотеката ви в облака остава непокътната — можете да сдвоите това устройство отново по-късно."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa tę bibliotekę i pobrane pliki z tego urządzenia. Twoja biblioteka w chmurze pozostaje nienaruszona — możesz później ponownie sparować to urządzenie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebere tuto knihovnu a její stažené soubory z tohoto zařízení. Vaše knihovna v cloudu zůstane nedotčena — toto zařízení můžete později znovu spárovat."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja ovu fonoteku i njezine preuzete datoteke s ovog uređaja. Vaša fonoteka u oblaku ostaje netaknuta — ovaj uređaj možete kasnije ponovno upariti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리와 다운로드된 파일을 이 기기에서 제거합니다. 클라우드의 라이브러리는 그대로이며 나중에 이 기기를 다시 연결할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此裝置移除此資料庫及其已下載檔案。你在雲端的資料庫不會受影響 — 你可以稍後重新配對此裝置。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this Libreria and its downloaded files from this device. Your Libreria in the cloud is untouched — you can re-pair this device later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this Kitaplık and its downloaded files from this device. Your Kitaplık in the cloud is untouched — you can re-pair this device later."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this Thư viện and its downloaded files from this device. Your Thư viện in the cloud is untouched — you can re-pair this device later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this Bibliotheek and its downloaded files from this device. Your Bibliotheek in the cloud is untouched — you can re-pair this device later."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लाइब्रेरी और इसकी डाउनलोड की गई फ़ाइलों को इस डिवाइस से हटाता है। क्लाउड में आपकी लाइब्रेरी अपरिवर्तित रहती है — आप बाद में इस डिवाइस को फिर से पेयर कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইস থেকে এই লাইব্রেরি এবং এর ডাউনলোড করা ফাইল সরায়। ক্লাউডে আপনার লাইব্রেরি অপরিবর্তিত থাকে — পরে এই ডিভাইস আবার জোড়া লাগাতে পারবেন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்திலிருந்து இந்த நூலகத்தையும் அதன் பதிவிறக்கப்பட்ட கோப்புகளையும் அகற்றும். மேகத்தில் உள்ள உங்கள் நூலகம் மாற்றப்படாது — இந்தச் சாதனத்தை பின்னர் மீண்டும் இணைக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరం నుండి ఈ లైబ్రరీని మరియు దాని డౌన్‌లోడ్ చేసిన ఫైల్‌లను తీసివేస్తుంది. క్లౌడ్‌లోని మీ లైబ్రరీ మారదు — మీరు తర్వాత ఈ పరికరాన్ని మళ్లీ జత చేయవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवरून ही लायब्ररी आणि तिच्या डाउनलोड केलेल्या फाइल्स काढते. क्लाउडमधील तुमची लायब्ररी बदलली जात नाही — तुम्ही हे डिव्हाइस नंतर पुन्हा जोडू शकता."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اس لائبریری اور اس کی ڈاؤن لوڈ شدہ فائلوں کو اس آلے سے ہٹاتا ہے۔ کلاؤڈ میں آپ کی لائبریری برقرار رہتی ہے — آپ بعد میں اس آلے کو دوبارہ جوڑ سکتے ہیں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઉપકરણમાંથી આ લાઇબ્રેરી અને તેની ડાઉનલોડ કરેલી ફાઇલો દૂર કરે છે. ક્લાઉડમાં તમારી લાઇબ્રેરી અસ્પર્શિત રહેશે — તમે આ ઉપકરણને પછી ફરી જોડી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನದಿಂದ ಈ ಗ್ರಂಥಾಲಯ ಮತ್ತು ಅದರ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಫೈಲ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ. ಕ್ಲೌಡ್‌ನಲ್ಲಿರುವ ನಿಮ್ಮ ಗ್ರಂಥಾಲಯ ಬದಲಾಗುವುದಿಲ್ಲ — ನಂತರ ಈ ಸಾಧನವನ್ನು ಮತ್ತೆ ಜೋಡಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിൽ നിന്ന് ഈ ലൈബ്രറിയും അതിന്റെ ഡൗൺലോഡ് ചെയ്ത ഫയലുകളും നീക്കംചെയ്യുന്നു. ക്ലൗഡിലെ നിങ്ങളുടെ ലൈബ്രറിയിൽ മാറ്റമൊന്നുമില്ല — ഈ ഉപകരണം പിന്നീട് വീണ്ടും ജോടിയാക്കാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਡਿਵਾਈਸ ਤੋਂ ਇਹ ਲਾਇਬ੍ਰੇਰੀ ਅਤੇ ਇਸ ਦੀਆਂ ਡਾਊਨਲੋਡ ਕੀਤੀਆਂ ਫਾਈਲਾਂ ਹਟਾਉਂਦਾ ਹੈ। ਕਲਾਊਡ ਵਿੱਚ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਅਣਛੁੱਤੀ ਰਹਿੰਦੀ ਹੈ — ਤੁਸੀਂ ਬਾਅਦ ਵਿੱਚ ਇਸ ਡਿਵਾਈਸ ਨੂੰ ਮੁੜ ਜੋੜ ਸਕਦੇ ਹੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำคลังนี้และไฟล์ที่ดาวน์โหลดไว้ออกจากอุปกรณ์นี้ คลังของคุณในคลาวด์จะไม่ถูกเปลี่ยนแปลง — คุณสามารถจับคู่อุปกรณ์นี้ใหม่ได้ภายหลัง"
          }
        }
      }
    },
