    "Camera access is denied. Enable it in Settings to scan QR codes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is denied. Enable it in Settings to scan QR codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está denegado. Actívalo en Ajustes para escanear códigos QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la caméra est refusé. Activez-le dans les Réglages pour scanner des codes QR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerazugriff ist verweigert. Aktiviere ihn in den Einstellungen, um QR-Codes zu scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera foi negado. Ative-o nas Configurações para escanear QR codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスが拒否されています。QRコードをスキャンするには設定で有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机访问被拒绝。请在设置中启用以扫描二维码。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول إلى الكاميرا. فعّله في الإعدادات لمسح رموز QR."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למצלמה נדחתה. הפעילו אותה בהגדרות כדי לסרוק קודי QR."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до камери заборонено. Увімкніть його в Параметрах, щоб сканувати QR-коди."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достъпът до камерата е отказан. Активирайте го в Настройки, за да сканирате QR кодове."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do aparatu jest zabroniony. Włącz go w Ustawieniach, aby skanować kody QR."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup ke kameře je odepřen. Pro skenování QR kódů jej povolte v Nastavení."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup kameri je odbijen. Omogućite ga u Postavkama za skeniranje QR kodova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 거부되었습니다. QR 코드를 스캔하려면 설정에서 허용하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機存取遭拒。請在設定中啟用，以掃描 QR 碼。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso alla fotocamera negato. Abilitalo in Impostazioni per scansionare codici QR."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera erişimi reddedildi. QR kodlarını taramak için Ayarlar'da etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập camera bị từ chối. Bật trong Cài đặt để quét mã QR."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameratoegang is geweigerd. Schakel dit in Instellingen in om QR-codes te scannen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे की पहुंच अस्वीकृत है। QR कोड स्कैन करने के लिए सेटिंग्स में इसे चालू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরা ব্যবহারের অনুমতি অস্বীকৃত। QR কোড স্ক্যান করতে সেটিংসে এটি চালু করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேமரா அணுகல் மறுக்கப்பட்டது. QR குறியீடுகளை வருட அமைப்புகளில் அதை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కెమెరా ప్రవేశం నిరాకరించబడింది. QR కోడ్‌లను స్కాన్ చేయడానికి సెట్టింగ్‌లలో దీన్ని ప్రారంభించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅमेरा प्रवेश नाकारला आहे. QR संकेत स्कॅन करण्यासाठी सेटिंग्जमध्ये तो सक्षम करा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیمرے کی رسائی مسترد ہے۔ QR رمز اسکین کرنے کے لیے ترتیبات میں اسے فعال کریں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેમેરા ઍક્સેસ નકારવામાં આવ્યો છે. QR કોડ સ્કેન કરવા સેટિંગ્સમાં તેને સક્ષમ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಯಾಮೆರಾ ಪ್ರವೇಶ ನಿರಾಕರಿಸಲಾಗಿದೆ. QR ಕೋಡ್‌ಗಳನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്യാമറ പ്രവേശനം നിരസിച്ചു. QR കോഡുകൾ സ്കാൻ ചെയ്യാൻ ക്രമീകരണങ്ങളിൽ അത് പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਮਰੇ ਦੀ ਪਹੁੰਚ ਅਸਵੀਕਾਰ ਹੈ। QR ਕੋਡ ਸਕੈਨ ਕਰਨ ਲਈ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇਸਨੂੰ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงกล้องถูกปฏิเสธ เปิดใช้งานในการตั้งค่าเพื่อสแกนรหัส QR"
          }
        }
      }
    },
