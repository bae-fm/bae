        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje úložisko iCloud je plné. Uvoľni miesto v Nastaveniach systému → Apple ID → iCloud, aby sa synchronizácia nezastavila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud-tárhelyed megtelt. Szabadíts fel helyet a Rendszerbeállítások → Apple-fiók → iCloud alatt, hogy a szinkronizálás folytatódjon."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul tău iCloud este plin. Eliberează spațiu în Configurări sistem → Apple ID → iCloud pentru a continua sincronizarea."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αποθηκευτικός χώρος iCloud είναι πλήρης. Ελευθερώστε χώρο στις Ρυθμίσεις συστήματος → Apple ID → iCloud για να συνεχιστεί ο συγχρονισμός."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu armazenamento do iCloud está cheio. Liberte espaço em Definições do Sistema → ID Apple → iCloud para continuar a sincronizar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt iCloud-utrymme är fullt. Frigör utrymme i Systeminställningar → Apple-ID → iCloud för att fortsätta synkronisera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din iCloud-lagring er fuld. Frigør plads i Systemindstillinger → Apple-id → iCloud for at fortsætte synkroniseringen."
          }
