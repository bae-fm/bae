        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iCloud నిల్వ నిండింది. సింక్ కొనసాగించడానికి సిస్టమ్ సెట్టింగ్‌లు → Apple ID → iCloudలో స్థలం ఖాళీ చేయండి."
          }
