    "Remove this device?": {
      "comment": "Library members section: confirmation title before revoking a device",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this device?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar este dispositivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cet appareil ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät entfernen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover este dispositivo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを削除しますか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此设备？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إزالة هذا الجهاز؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להסיר מכשיר זה?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цей пристрій?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да се премахне ли това устройство?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć to urządzenie?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat toto zařízení?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloniti ovaj uređaj?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 제거하시겠습니까?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此裝置？"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere questo dispositivo?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz kaldırılsın mı?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ thiết bị này?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat verwijderen?"
          }
