          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي oauth-creds.json على أي بيانات اعتماد مزوّد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏oauth-creds.json אינו מכיל אישורי ספק כלשהם."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json не містить облікових даних жодного постачальника."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json не съдържа идентификационни данни за доставчик."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json nie zawiera żadnych poświadczeń dostawcy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json neobsahuje žádné přihlašovací údaje poskytovatele."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json ne sadrži vjerodajnice nijednog pružatelja usluge."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json에 제공자 자격 증명이 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json 不包含任何提供者認證。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json non contiene credenziali di provider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json hiçbir sağlayıcı kimlik bilgisi içermiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json không chứa thông tin xác thực của nhà cung cấp nào."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json bevat geen providerreferenties."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json में कोई प्रदाता क्रेडेंशियल नहीं हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json-এ কোনো প্রদানকারীর পরিচয়পত্র নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json எந்த வழங்குநர் சான்றுகளையும் கொண்டிருக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.jsonలో ఏ ప్రదాత ఆధారాలు లేవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json मध्ये कोणतीही प्रदाता ओळखमाहिती नाही."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json میں کسی فراہم کنندہ کی اسناد نہیں ہیں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json માં કોઈ પ્રદાતા ઓળખપત્રો નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json ಯಾವುದೇ ಪೂರೈಕೆದಾರ ರುಜುವಾತುಗಳನ್ನು ಹೊಂದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json-ൽ ദാതാവിന്റെ യോഗ്യതാ വിവരങ്ങളൊന്നുമില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json ਵਿੱਚ ਕਿਸੇ ਪ੍ਰਦਾਤਾ ਦੇ ਪ੍ਰਮਾਣ-ਪੱਤਰ ਨਹੀਂ ਹਨ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json ไม่มีข้อมูลเข้าสู่ระบบของผู้ให้บริการใดๆ"
          }
        }
      }
    },
