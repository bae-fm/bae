    "Applies to new plays. Earlier plays keep who could see them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق على عمليات التشغيل الجديدة. تحتفظ عمليات التشغيل السابقة بمن كان يمكنه رؤيتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Важи за новите изпълнения. По-ранните запазват кой можеше да ги вижда."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pro nová přehrání. Dřívější si ponechají, kdo je mohl vidět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder nye afspilninger. Tidligere afspilninger beholder, hvem der kunne se dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für neue Wiedergaben. Frühere Wiedergaben behalten, wer sie sehen konnte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει για νέες αναπαραγωγές. Οι προηγούμενες διατηρούν ποιος μπορούσε να τις δει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a las nuevas reproducciones. Las anteriores conservan quién podía verlas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koskee uusia toistoja. Aiemmat toistot säilyttävät, kuka ne näki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux nouvelles écoutes. Les écoutes précédentes gardent leur visibilité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חל על השמעות חדשות. השמעות קודמות שומרות על מי שיכול היה לראות אותן."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odnosi se na nova slušanja. Ranija zadržavaju tko ih je mogao vidjeti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új lejátszásokra vonatkozik. A korábbiak megtartják, ki láthatta őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica ai nuovi ascolti. Quelli precedenti mantengono chi poteva vederli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい再生に適用されます。以前の再生は、見られる相手がそのまま保たれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 재생에 적용됩니다. 이전 재생은 볼 수 있던 사람이 그대로 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjelder nye avspillinger. Tidligere avspillinger beholder hvem som kunne se dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor nieuwe afspeelbeurten. Eerdere houden wie ze kon zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy nowych odtworzeń. Wcześniejsze zachowują to, kto mógł je widzieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para novas reproduções. As anteriores mantêm quem podia vê-las."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se a novas reproduções. As anteriores mantêm quem as podia ver."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplică redărilor noi. Redările anterioare păstrează cine le putea vedea."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pre nové prehrania. Skoršie si ponechajú, kto ich mohol vidieť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller nya uppspelningar. Tidigare uppspelningar behåller vem som kunde se dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni dinlemelere uygulanır. Önceki dinlemeler, onları kimin görebildiğini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосовується до нових прослуховувань. Попередні зберігають, хто міг їх бачити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于新的播放记录。之前的播放记录保留原来的可见范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於新的播放記錄。先前的播放記錄保留原本的可見範圍。"
          }
        }
      }
    },
