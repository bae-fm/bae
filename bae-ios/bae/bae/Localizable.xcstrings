    "oauth-creds.json does not contain any provider credentials.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json does not contain any provider credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json no contiene credenciales de ningún proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json ne contient aucune information d'identification de fournisseur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json enthält keine Anbieter-Anmeldedaten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "oauth-creds.json não contém credenciais de provedor."
          }
        },
