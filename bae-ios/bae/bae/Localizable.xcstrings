    "Restores the last session's track, position, queue, and volume when the app opens.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعيد المقطع والموضع وقائمة الانتظار ومستوى الصوت من الجلسة الأخيرة عند فتح التطبيق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "При отваряне на приложението възстановява песента, позицията, опашката и силата на звука от последната сесия."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při otevření aplikace obnoví skladbu, pozici, frontu a hlasitost z poslední relace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendanner sporet, positionen, køen og lydstyrken fra sidste session, når appen åbnes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores the last session's track, position, queue, and volume when the app opens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt beim Öffnen der App den Titel, die Position, die Warteschlange und die Lautstärke der letzten Sitzung wieder her."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει το κομμάτι, τη θέση, την ουρά και την ένταση της τελευταίας συνεδρίας όταν ανοίγει η εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura la pista, la posición, la cola y el volumen de la última sesión al abrir la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauttaa edellisen istunnon raidan, kohdan, jonon ja äänenvoimakkuuden, kun ohjelma avataan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure la piste, la position, la file et le volume de la dernière session à l'ouverture de l'app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משחזר את הרצועה, המיקום, התור ועוצמת השמע מההפעלה הקודמת עם פתיחת האפליקציה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri otvaranju aplikacije vraća pjesmu, poziciju, red čekanja i glasnoću zadnje sesije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app megnyitásakor visszaállítja az előző munkamenet számát, pozícióját, sorát és hangerejét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina traccia, posizione, coda e volume dell'ultima sessione all'apertura dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開いたときに、前回のセッションのトラック、再生位置、キュー、音量を復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열 때 마지막 세션의 트랙, 위치, 대기열, 음량을 복원합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenoppretter sporet, posisjonen, køen og volumet fra forrige økt når appen åpnes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt de track, positie, wachtrij en het volume van de laatste sessie bij het openen van de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca utwór, pozycję, kolejkę i głośność z ostatniej sesji przy otwarciu aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura a faixa, a posição, a fila e o volume da última sessão ao abrir o app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura a faixa, a posição, a fila e o volume da última sessão quando a app abre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurează piesa, poziția, coada și volumul din ultima sesiune când se deschide aplicația."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri otvorení aplikácie obnoví skladbu, pozíciu, poradie a hlasitosť z poslednej relácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställer den senaste sessionens spår, position, kö och volym när appen öppnas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama açıldığında son oturumun parçasını, konumunu, kuyruğunu ve ses düzeyini geri yükler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час відкриття застосунку відновлює трек, позицію, чергу та гучність останнього сеансу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用时恢复上次会话的曲目、播放位置、队列和音量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 App 時還原上次工作階段的曲目、播放位置、佇列與音量。"
          }
        }
      }
