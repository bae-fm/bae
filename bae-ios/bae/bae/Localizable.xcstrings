    "Add this device to a library you already have on another device.": {
      "comment": "Onboarding: what the join flow does",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this device to a library you already have on another device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade este dispositivo a una biblioteca que ya tienes en otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez cet appareil à une bibliothèque que vous avez déjà sur un autre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge dieses Gerät zu einer Mediathek hinzu, die du bereits auf einem anderen Gerät hast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione este dispositivo a uma biblioteca que você já tem em outro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに別のデバイスにあるライブラリに、このデバイスを追加します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此设备添加到你已在另一台设备上拥有的资料库。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف هذا الجهاز إلى مكتبة موجودة لديك بالفعل على جهاز آخر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו את המכשיר הזה לספרייה שכבר יש לכם במכשיר אחר."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте цей пристрій до бібліотеки, яку ви вже маєте на іншому пристрої."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете това устройство към библиотека, която вече имате на друго устройство."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj to urządzenie do biblioteki, którą już masz na innym urządzeniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte toto zařízení do knihovny, kterou už máte na jiném zařízení."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte ovaj uređaj u fonoteku koju već imate na drugom uređaju."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에 이미 있는 라이브러리에 이 기기를 추가하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此裝置加入你已在另一台裝置上擁有的資料庫。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questo dispositivo a una libreria che hai già su un altro dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtı, başka bir aygıtta zaten sahip olduğunuz bir kitaplığa ekleyin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg dit apparaat toe aan een bibliotheek die je al op een ander apparaat hebt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridaj toto zariadenie ku knižnici, ktorú už máš na inom zariadení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá ezt az eszközt egy könyvtárhoz, ami már megvan egy másik eszközödön."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă acest dispozitiv la o bibliotecă pe care o ai deja pe alt dispozitiv."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε αυτή τη συσκευή σε βιβλιοθήκη που έχετε ήδη σε άλλη συσκευή."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione este dispositivo a uma biblioteca que já tenha noutro dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till den här enheten i ett bibliotek som du redan har på en annan enhet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Føj denne enhed til et bibliotek, du allerede har på en anden enhed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg denne enheten til et bibliotek du allerede har på en annen enhet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tämä laite kirjastoon, joka sinulla on jo toisella laitteella."
          }
        }
      }
    },
    "Anyone with this code has full access to your library. Keep it secret. Use it only to restore on a new device when you have no other device available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with this code has full access to your library. Keep it secret. Use it only to restore on a new device when you have no other device available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera con este código tiene acceso completo a tu biblioteca. Mantenlo en secreto. Úsalo solo para restaurar en un dispositivo nuevo cuando no tengas otro dispositivo disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque possède ce code a un accès complet à votre bibliothèque. Gardez-le secret. Utilisez-le uniquement pour restaurer sur un nouvel appareil quand aucun autre appareil n'est disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder mit diesem Code hat vollen Zugriff auf deine Bibliothek. Halte ihn geheim. Nutze ihn nur zur Wiederherstellung auf einem neuen Gerät, wenn kein anderes Gerät verfügbar ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com este código tem acesso total à sua biblioteca. Mantenha-o em segredo. Use-o apenas para restaurar em um dispositivo novo quando você não tiver outro dispositivo disponível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードを持つ人は誰でもライブラリに完全にアクセスできます。秘密にしてください。他のデバイスが使えないときに、新しいデバイスで復元する場合にのみ使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拥有此代码的人都能完全访问你的资料库。请保密。仅在没有其他设备可用时，用它在新设备上恢复。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي شخص يملك هذا الرمز له وصول كامل إلى مكتبتك. أبقِه سرًّا. استخدمه فقط للاستعادة على جهاز جديد عندما لا يتوفر لديك جهاز آخر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכל מי שיש קוד זה יש גישה מלאה לספרייה שלך. שמור אותו בסוד. השתמש בו רק לשחזור במכשיר חדש כשאין לך מכשיר אחר זמין."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-хто з цим кодом має повний доступ до вашої бібліотеки. Тримайте його в таємниці. Використовуйте лише для відновлення на новому пристрої, коли немає іншого доступного пристрою."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки с този код има пълен достъп до библиотеката ви. Пазете го в тайна. Използвайте го само за възстановяване на ново устройство, когато нямате друго налично устройство."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy, kto ma ten kod, ma pełny dostęp do Twojej biblioteki. Trzymaj go w tajemnicy. Używaj go tylko do przywracania na nowym urządzeniu, gdy nie masz dostępnego innego urządzenia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdokoli s tímto kódem má plný přístup k vaší knihovně. Udržujte ho v tajnosti. Použijte ho jen k obnově v novém zařízení, když nemáte žádné jiné zařízení k dispozici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svatko s ovim kodom ima puni pristup vašoj knjižnici. Čuvajte ga u tajnosti. Koristite ga samo za obnovu na novom uređaju kad nemate drugi dostupan uređaj."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드를 가진 사람은 누구나 보관함에 완전히 접근할 수 있습니다. 비밀로 유지하세요. 다른 기기를 사용할 수 없을 때 새 기기에서 복원하는 용도로만 사용하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何擁有此代碼的人都能完整存取你的資料庫。請保密。僅在沒有其他裝置可用時，用它在新裝置上還原。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque abbia questo codice ha pieno accesso alla tua libreria. Tienilo segreto. Usalo solo per ripristinare su un nuovo dispositivo quando non hai altri dispositivi disponibili."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu koda sahip olan herkes kitaplığına tam erişim kazanır. Gizli tut. Yalnızca başka bir cihazın yokken yeni bir cihazda geri yüklemek için kullan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen met deze code heeft volledige toegang tot je bibliotheek. Houd hem geheim. Gebruik hem alleen om te herstellen op een nieuw apparaat als je geen ander apparaat beschikbaar hebt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktokoľvek s týmto kódom má plný prístup k tvojej knižnici. Nechaj si ho pre seba. Použi ho len na obnovenie na novom zariadení, keď nemáš k dispozícii žiadne iné."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aki ismeri ezt a kódot, teljes hozzáférést kap a könyvtáradhoz. Tartsd titokban. Csak akkor használd új eszközön történő visszaállításhoz, ha nincs másik eszközöd."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine are acest cod are acces complet la biblioteca ta. Păstrează-l secret. Folosește-l doar pentru a restaura pe un dispozitiv nou, când nu ai altul la îndemână."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όποιος έχει αυτόν τον κωδικό αποκτά πλήρη πρόσβαση στη βιβλιοθήκη σας. Κρατήστε τον μυστικό. Χρησιμοποιήστε τον μόνο για επαναφορά σε νέα συσκευή, όταν δεν έχετε άλλη διαθέσιμη."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem tiver este código tem acesso total à sua biblioteca. Mantenha-o secreto. Use-o apenas para restaurar num dispositivo novo, quando não tiver outro disponível."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla som har den här koden får full åtkomst till ditt bibliotek. Håll den hemlig. Använd den bara för att återställa på en ny enhet när du inte har någon annan enhet tillgänglig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle med denne kode har fuld adgang til dit bibliotek. Hold den hemmelig. Brug den kun til at gendanne på en ny enhed, når du ikke har andre enheder til rådighed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle som har denne koden, får full tilgang til biblioteket ditt. Hold den hemmelig. Bruk den bare til å gjenopprette på en ny enhet når du ikke har noen annen enhet tilgjengelig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka tahansa, jolla on tämä koodi, pääsee kirjastoosi täysin. Pidä se salassa. Käytä sitä vain palauttamiseen uudelle laitteelle, kun sinulla ei ole muuta laitetta käytettävissä."
          }
        }
      }
    },
    "Approve": {
      "comment": "Approve-device sheet: button confirming the new device joins",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genehmigen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموافقة"
          }
        },
