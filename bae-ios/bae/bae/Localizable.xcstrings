        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અધિકૃતતા કોડ વગર પૂર્ણ થઈ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನುಮತಿ ಕೋಡ್ ಇಲ್ಲದೆ ಮುಗಿದಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കോഡ് ഇല്ലാതെ അനുമതി പൂർത്തിയായി."
          }
        },
        "pa": {
