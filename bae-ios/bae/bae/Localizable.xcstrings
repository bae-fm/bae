        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "No albums yet. Đồng bộing from the cloud…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "No albums yet. Synchronisatieing from the cloud…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई एल्बम नहीं। क्लाउड से सिंक हो रहा है…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো অ্যালবাম নেই। ক্লাউড থেকে সিঙ্ক হচ্ছে…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் ஆல்பங்கள் இல்லை. மேகத்திலிருந்து ஒத்திசைக்கிறது…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా ఆల్బమ్‌లు లేవు. క్లౌడ్ నుండి సింక్ చేస్తోంది…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून अल्बम नाहीत. क्लाउडवरून समक्रमण होत आहे…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی البم نہیں۔ کلاؤڈ سے مطابقت پذیری ہو رہی ہے…"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજુ કોઈ આલ્બમ નથી. ક્લાઉડમાંથી સિંક થઈ રહ્યું છે…"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
