        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लाइब्रेरी को इस डिवाइस से हटाएं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইস থেকে এই লাইব্রেরি সরান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த சாதனத்திலிருந்து இந்த நூலகத்தை அகற்று"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరం నుండి ఈ లైబ్రరీని తీసివేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवरून ही लायब्ररी काढा"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ لائبریری اس آلے سے ہٹائیں"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઉપકરણમાંથી આ લાઇબ્રેરી દૂર કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನದಿಂದ ಈ ಗ್ರಂಥಾಲಯವನ್ನು ತೆಗೆದುಹಾಕಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിൽ നിന്ന് ഈ ലൈബ്രറി നീക്കംചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਡਿਵਾਈਸ ਤੋਂ ਇਹ ਲਾਇਬ੍ਰੇਰੀ ਹਟਾਓ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำคลังนี้ออกจากอุปกรณ์นี้"
          }
        }
      }
    },
