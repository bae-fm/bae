    "It will lose access and the library key will be rotated. Devices still in the library re-key automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will lose access and the library key will be rotated. Devices still in the library re-key automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderá el acceso y la clave de la biblioteca se rotará. Los dispositivos que sigan en la biblioteca reciben la clave nueva automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il perdra l'accès et la clé de la bibliothèque sera changée. Les appareils encore dans la bibliothèque reçoivent la nouvelle clé automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es verliert den Zugriff und der Bibliotheksschlüssel wird gewechselt. Geräte, die in der Bibliothek bleiben, erhalten den neuen Schlüssel automatisch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele perderá o acesso e a chave da biblioteca será trocada. Os dispositivos que continuam na biblioteca recebem a nova chave automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス権が失われ、ライブラリの鍵が交換されます。ライブラリに残っているデバイスは自動的に新しい鍵を受け取ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将失去访问权限，资料库密钥将被更换。仍在资料库中的设备会自动获得新密钥。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيفقد الوصول وسيُبدَّل مفتاح المكتبة. الأجهزة التي ما زالت في المكتبة تحصل على المفتاح الجديد تلقائيًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא יאבד גישה ומפתח הספרייה יוחלף. מכשירים שעדיין בספרייה מקבלים את המפתח החדש אוטומטית."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він втратить доступ, а ключ бібліотеки буде змінено. Пристрої, що залишаються в бібліотеці, отримують новий ключ автоматично."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "То ще загуби достъп и ключът на библиотеката ще бъде сменен. Устройствата, които са още в библиотеката, получават новия ключ автоматично."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Straci dostęp, a klucz biblioteki zostanie wymieniony. Urządzenia pozostające w bibliotece automatycznie otrzymują nowy klucz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ztratí přístup a klíč knihovny bude vyměněn. Zařízení, která v knihovně zůstávají, dostanou nový klíč automaticky."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgubit će pristup i ključ knjižnice bit će promijenjen. Uređaji koji su još u knjižnici automatski dobivaju novi ključ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 접근 권한이 사라지고 보관함 키가 교체됩니다. 보관함에 남아 있는 기기는 자동으로 새 키를 받습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它將失去存取權，資料庫金鑰將被更換。仍在資料庫中的裝置會自動取得新金鑰。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderà l'accesso e la chiave della libreria verrà cambiata. I dispositivi ancora nella libreria ricevono la nuova chiave automaticamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişimini kaybedecek ve kitaplık anahtarı değiştirilecek. Kitaplıkta kalan cihazlar yeni anahtarı otomatik alır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị sẽ mất quyền truy cập và khóa thư viện sẽ được thay. Các thiết bị còn trong thư viện tự động nhận khóa mới."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verliest de toegang en de bibliotheeksleutel wordt gewisseld. Apparaten die in de bibliotheek blijven, krijgen automatisch de nieuwe sleutel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी पहुंच समाप्त हो जाएगी और लाइब्रेरी की कुंजी बदल दी जाएगी. लाइब्रेरी में मौजूद डिवाइस अपने आप नई कुंजी पा लेते हैं."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি অ্যাক্সেস হারাবে এবং লাইব্রেরির চাবি বদলানো হবে। লাইব্রেরিতে থাকা ডিভাইসগুলি স্বয়ংক্রিয়ভাবে নতুন চাবি পায়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதன் அணுகல் நீங்கும், லைப்ரரி சாவி மாற்றப்படும். லைப்ரரியில் உள்ள சாதனங்கள் தானாக புதிய சாவியைப் பெறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అది యాక్సెస్ కోల్పోతుంది మరియు లైబ్రరీ కీ మార్చబడుతుంది. లైబ్రరీలో ఉన్న పరికరాలు స్వయంచాలకంగా కొత్త కీని పొందుతాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्याचा प्रवेश जाईल आणि लायब्ररीची की बदलली जाईल. लायब्ररीत असलेली डिव्हाइस आपोआप नवीन की मिळवतात."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کی رسائی ختم ہو جائے گی اور لائبریری کی کنجی بدل دی جائے گی۔ لائبریری میں موجود آلات خود بخود نئی کنجی حاصل کر لیتے ہیں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તે ઍક્સેસ ગુમાવશે અને લાઇબ્રેરીની ચાવી બદલાશે. લાઇબ્રેરીમાં રહેલા ડિવાઇસ આપમેળે નવી ચાવી મેળવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅದು ಪ್ರವೇಶ ಕಳೆದುಕೊಳ್ಳುತ್ತದೆ ಮತ್ತು ಲೈಬ್ರರಿ ಕೀ ಬದಲಾಗುತ್ತದೆ. ಲೈಬ್ರರಿಯಲ್ಲಿ ಉಳಿದ ಸಾಧನಗಳು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಹೊಸ ಕೀ ಪಡೆಯುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അതിന് ആക്സസ് നഷ്ടപ്പെടും, ലൈബ്രറി കീ മാറ്റപ്പെടും. ലൈബ്രറിയിൽ തുടരുന്ന ഉപകരണങ്ങൾക്ക് പുതിയ കീ സ്വയമേവ ലഭിക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਪਹੁੰਚ ਗੁਆ ਦੇਵੇਗੀ ਅਤੇ ਲਾਇਬ੍ਰੇਰੀ ਦੀ ਕੁੰਜੀ ਬਦਲ ਦਿੱਤੀ ਜਾਵੇਗੀ। ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਮੌਜੂਦ ਡਿਵਾਈਸਾਂ ਆਪਣੇ ਆਪ ਨਵੀਂ ਕੁੰਜੀ ਲੈ ਲੈਂਦੀਆਂ ਹਨ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์จะสูญเสียการเข้าถึงและกุญแจคลังจะถูกเปลี่ยน อุปกรณ์ที่ยังอยู่ในคลังจะได้กุญแจใหม่โดยอัตโนมัติ"
          }
        }
      }
    },
