        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无专辑。正在从云端同步…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ألبومات بعد. جارٍ المزامنة من السحابة…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין אלבומים. מסנכרן מהענן…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки немає альбомів. Синхронізація з хмари…"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още няма албуми. Синхронизиране от облака…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak albumów. Synchronizowanie z chmury…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádná alba. Synchronizace z cloudu…"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema albuma. Sinkronizacija iz oblaka…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 앨범이 없습니다. 클라우드에서 동기화 중…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無專輯。正在從雲端同步…"
