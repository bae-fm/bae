    "Scan the code shown by a device already in your library.": {
      "comment": "Onboarding: instruction above the QR scanner",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the code shown by a device already in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código que muestra un dispositivo que ya está en tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code affiché par un appareil déjà présent dans votre bibliothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code, der auf einem Gerät angezeigt wird, das bereits in deiner Mediathek ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código exibido em um dispositivo que já está na sua biblioteca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにライブラリにあるデバイスに表示されたコードをスキャンしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描已加入你资料库的设备上显示的代码。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح الرمز المعروض على جهاز موجود بالفعل في مكتبتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרקו את הקוד שמוצג במכשיר שכבר נמצא בספרייה שלכם."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відскануйте код, показаний на пристрої, який уже є у вашій бібліотеці."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирайте кода, показан от устройство, което вече е в библиотеката ви."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj kod wyświetlany na urządzeniu, które jest już w Twojej bibliotece."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naskenujte kód zobrazený na zařízení, které už je ve vaší knihovně."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenirajte kod prikazan na uređaju koji je već u vašoj fonoteci."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 라이브러리에 있는 기기에 표시된 코드를 스캔하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描已加入你資料庫的裝置上顯示的代碼。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice mostrato da un dispositivo già nella tua libreria."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınızda zaten bulunan bir aygıtta gösterilen kodu tarayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã hiển thị trên một thiết bị đã có trong thư viện của bạn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan de code die wordt weergegeven op een apparaat dat al in je bibliotheek staat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लाइब्रेरी में पहले से मौजूद डिवाइस पर दिखाया गया कोड स्कैन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইব্রেরিতে ইতিমধ্যে থাকা একটি ডিভাইসে দেখানো কোডটি স্ক্যান করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகத்தில் ஏற்கனவே உள்ள சாதனத்தில் காட்டப்படும் குறியீட்டை வருடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లైబ్రరీలో ఇప్పటికే ఉన్న పరికరంలో చూపిన కోడ్‌ను స్కాన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या संग्रहालयात आधीपासून असलेल्या डिव्हाइसवर दाखवलेला कोड स्कॅन करा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی لائبریری میں پہلے سے موجود آلے پر دکھایا گیا کوڈ اسکین کریں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી લાઇબ્રેરીમાં પહેલેથી રહેલા ઉપકરણ પર દેખાતો કોડ સ્કેન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲೈಬ್ರರಿಯಲ್ಲಿ ಈಗಾಗಲೇ ಇರುವ ಸಾಧನದಲ್ಲಿ ತೋರಿಸಲಾದ ಕೋಡ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ശേഖരത്തിൽ ഇതിനകം ഉള്ള ഉപകരണത്തിൽ കാണിച്ചിരിക്കുന്ന കോഡ് സ്കാൻ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਪਹਿਲਾਂ ਤੋਂ ਮੌਜੂਦ ਡਿਵਾਈਸ ਉੱਤੇ ਦਿਖਾਇਆ ਕੋਡ ਸਕੈਨ ਕਰੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนรหัสที่แสดงบนอุปกรณ์ที่อยู่ในคลังของคุณแล้ว"
          }
        }
      }
    },
