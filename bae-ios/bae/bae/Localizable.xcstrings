        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstránením knižnice z tohto zariadenia sa zahodia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om biblioteket tas bort från den här enheten går de förlorade."
          }
