            "value": "חפש אלבומים, רצועות, מלחינים ויצירות"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук альбомів, треків, композиторів і творів"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Търсене в албуми, песни, композитори и произведения"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj albumów, ścieżek, kompozytorów i dzieł"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledat alba, stopy, skladatele a díla"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretraži albume, pjesme, skladatelje i djela"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범, 트랙, 작곡가, 작품 검색"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋專輯、曲目、作曲者和作品"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca album, brani, compositori e opere"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Albüm, parça, besteci ve eser ara"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm album, bản nhạc, nhà soạn nhạc và tác phẩm"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek albums, nummers, componisten en werken"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एल्बम, ट्रैक, संगीतकार और कृतियां खोजें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালবাম, ট্র্যাক, সুরকার ও কাজ অনুসন্ধান করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆல்பங்கள், பாடல்கள், இசையமைப்பாளர்கள், படைப்புகளைத் தேடு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆల్బమ్‌లు, ట్రాక్‌లు, సంగీతరచయితలు, కృతులను వెతుకు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अल्बम, गाणी, संगीतकार आणि कृती शोधा"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "البمز، نغمے، موسیقار، اور کام تلاش کریں"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આલ્બમો, ટ્રૅક્સ, સંગીતકારો અને કૃતિઓ શોધો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಲ್ಬಮ್‌ಗಳು, ಟ್ರ್ಯಾಕ್‌ಗಳು, ಸಂಗೀತ ಸಂಯೋಜಕರು ಮತ್ತು ಕೃತಿಗಳನ್ನು ಹುಡುಕಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആൽബങ്ങൾ, ട്രാക്കുകൾ, സംഗീതരചയിതാക്കൾ, കൃതികൾ എന്നിവ തിരയുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਲਬਮਾਂ, ਟ੍ਰੈਕ, ਸੰਗੀਤਕਾਰ ਅਤੇ ਰਚਨਾਵਾਂ ਖੋਜੋ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาอัลบั้ม แทร็ก ผู้ประพันธ์ และผลงาน"
          }
        }
      },
      "comment": "iOS library search prompt"
    },
