    "The encryption key for this library is not in the keyring. Enter the 64-character hex key to unlock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encryption key for this library is not in the keyring. Enter the 64-character hex key to unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de cifrado de esta biblioteca no está en el llavero. Introduce la clave hexadecimal de 64 caracteres para desbloquearla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de chiffrement de cette bibliothèque n'est pas dans le trousseau. Saisissez la clé hexadécimale de 64 caractères pour déverrouiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verschlüsselungsschlüssel für diese Bibliothek ist nicht im Schlüsselbund. Gib den 64-stelligen Hex-Schlüssel zum Entsperren ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de criptografia desta biblioteca não está no chaveiro. Insira a chave hexadecimal de 64 caracteres para desbloquear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリの暗号化キーがキーリングにありません。ロックを解除するには16進数64文字のキーを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此库的加密密钥不在密钥环中。请输入 64 位十六进制密钥以解锁。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح التشفير لهذه المكتبة غير موجود في حلقة المفاتيح. أدخل المفتاح السداسي العشري المكوّن من 64 حرفًا لإلغاء القفل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח ההצפנה של ספרייה זו אינו במחזיק המפתחות. הזינו את המפתח ההקסדצימלי באורך 64 תווים כדי לפתוח."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключа шифрування цієї бібліотеки немає у сховищі ключів. Введіть 64-символьний шістнадцятковий ключ, щоб розблокувати."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът за шифроване на тази библиотека не е в ключодържателя. Въведете 64-знаковия шестнадесетичен ключ за отключване."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucza szyfrującego tej biblioteki nie ma w pęku kluczy. Wprowadź 64-znakowy klucz szesnastkowy, aby odblokować."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovací klíč této knihovny není v klíčence. Pro odemčení zadejte šestnáctkový klíč o 64 znacích."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ za šifriranje ove fonoteke nije u privjesku ključeva. Unesite 64-znamenkasti heksadecimalni ključ za otključavanje."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리의 암호화 키가 키링에 없습니다. 잠금을 해제하려면 64자 16진수 키를 입력하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫的加密金鑰不在鑰匙圈中。請輸入 64 字元十六進位金鑰以解鎖。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di crittografia per questa libreria non è nel portachiavi. Inserisci la chiave esadecimale a 64 caratteri per sbloccare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitaplığın şifreleme anahtarı anahtarlıkta yok. Kilidi açmak için 64 karakterlik onaltılık anahtarı girin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versleutelingssleutel voor deze bibliotheek staat niet in de sleutelhanger. Voer de hexadecimale sleutel van 64 tekens in om te ontgrendelen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovací kľúč tejto knižnice nie je v kľúčenke. Na odomknutie zadaj 64-znakový šestnástkový kľúč."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a könyvtárnak a titkosítási kulcsa nincs a kulcstartóban. A feloldáshoz add meg a 64 karakteres hexadecimális kulcsot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia de criptare a acestei biblioteci nu se află în breloc. Introdu cheia hexazecimală de 64 de caractere pentru a debloca."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί κρυπτογράφησης αυτής της βιβλιοθήκης δεν βρίσκεται στο μπρελόκ. Εισαγάγετε το δεκαεξαδικό κλειδί 64 χαρακτήρων για ξεκλείδωμα."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de encriptação desta biblioteca não está no porta-chaves. Introduza a chave hexadecimal de 64 carateres para desbloquear."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypteringsnyckeln för det här biblioteket finns inte i nyckelringen. Ange den 64 tecken långa hexadecimala nyckeln för att låsa upp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypteringsnøglen til dette bibliotek er ikke i nøgleringen. Indtast den 64 tegn lange hexadecimale nøgle for at låse op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypteringsnøkkelen for dette biblioteket er ikke i nøkkelringen. Oppgi den 64 tegn lange heksadesimale nøkkelen for å låse opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kirjaston salausavainta ei ole avainnipussa. Avaa lukitus antamalla 64 merkin heksadesimaaliavain."
          }
        }
      }
    },
