          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "This Bibliotheek needs cloud sign-in, which isn't configured on this build."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लाइब्रेरी को क्लाउड साइन-इन चाहिए, जो इस बिल्ड पर कॉन्फ़िगर नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লাইব্রেরির জন্য ক্লাউড সাইন-ইন দরকার, যা এই বিল্ডে কনফিগার করা নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நூலகத்திற்கு மேக உள்நுழைவு தேவை; அது இந்த உருவாக்கத்தில் அமைக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ లైబ్రరీకి క్లౌడ్ సైన్-ఇన్ అవసరం, ఇది ఈ బిల్డ్‌లో కాన్ఫిగర్ చేయబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या लायब्ररीसाठी क्लाउड साइन-इन आवश्यक आहे, जे या बिल्डवर कॉन्फिगर केलेले नाही."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس لائبریری کو کلاؤڈ سائن اِن درکار ہے، جو اس بلڈ پر ترتیب نہیں دیا گیا۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ લાઇબ્રેરીને ક્લાઉડ સાઇન-ઇન જોઈએ છે, જે આ બિલ્ડ પર કન્ફિગર કરેલું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಗ್ರಂಥಾಲಯಕ್ಕೆ ಕ್ಲೌಡ್ ಸೈನ್-ಇನ್ ಅಗತ್ಯವಿದೆ, ಅದನ್ನು ಈ ಬಿಲ್ಡ್‌ನಲ್ಲಿ ಸಂರಚಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ലൈബ്രറിക്ക് ക്ലൗഡ് സൈൻ-ഇൻ വേണം; അത് ഈ ബിൽഡിൽ ക്രമീകരിച്ചിട്ടില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਲਾਇਬ੍ਰੇਰੀ ਨੂੰ ਕਲਾਊਡ ਸਾਈਨ-ਇਨ ਦੀ ਲੋੜ ਹੈ, ਜੋ ਇਸ ਬਿਲਡ ਤੇ ਸੰਰਚਿਤ ਨਹੀਂ ਹੈ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังนี้ต้องลงชื่อเข้าใช้คลาวด์ ซึ่งยังไม่ได้ตั้งค่าไว้ในบิลด์นี้"
          }
        }
      }
    },
