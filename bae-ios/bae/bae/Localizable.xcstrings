    "Couldn't read bucket versioning." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة تعيين الإصدارات للحاوية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
