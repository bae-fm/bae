    "Their device scans or pastes this code, then asks to join. Approve it under Waiting to join." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمسح جهاز الشخص هذا الرمز أو يلصقه، ثم يطلب الانضمام. وافق على ذلك ضمن «بانتظار الانضمام»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройството му сканира или поставя този код и след това иска да се присъедини. Одобрете го в „Чакат присъединяване“."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení této osoby kód naskenuje nebo vloží a pak požádá o připojení. Schvalte to v části „Čeká na připojení“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personens enhed scanner eller indsætter koden og beder derefter om at deltage. Godkend det under “Venter på at deltage”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Gerät scannt diesen Code oder fügt ihn ein und bittet dann um Beitritt. Genehmige das unter „Wartet auf Beitritt“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συσκευή του σαρώνει ή επικολλά αυτόν τον κωδικό και μετά ζητά να συμμετάσχει. Εγκρίνετέ το στην ενότητα «Αναμονή συμμετοχής»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su dispositivo escanea o pega este código y luego pide unirse. Apruébalo en «Esperando para unirse»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henkilön laite skannaa tai liittää tämän koodin ja pyytää sitten liittymistä. Hyväksy se kohdassa ”Odottaa liittymistä”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son appareil scanne ou colle ce code, puis demande à rejoindre la bibliothèque. Approuvez la demande sous « En attente d’adhésion »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המכשיר שלו סורק או מדביק את הקוד הזה ואז מבקש להצטרף. אשרו זאת תחת ״ממתינים להצטרפות״."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njihov uređaj skenira ili zalijepi ovaj kôd, a zatim zatraži pridruživanje. Odobrite to pod „Čekaju pridruživanje”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszköze beolvassa vagy beilleszti ezt a kódot, majd csatlakozást kér. Hagyd jóvá a „Csatlakozásra vár” részben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo dispositivo scansiona o incolla questo codice, poi chiede di unirsi. Approva la richiesta in «In attesa di unirsi»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手のデバイスがこのコードをスキャンまたは貼り付けて、参加をリクエストします。「参加待ち」で承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상대 기기가 이 코드를 스캔하거나 붙여넣은 다음 참여를 요청합니다. '참여 대기 중'에서 승인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personens enhet skanner eller limer inn koden og ber deretter om å bli med. Godkjenn det under «Venter på å bli med»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hun apparaat scant of plakt deze code en vraagt dan om lid te worden. Keur het goed onder ‘Wachtend op toegang’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenie tej osoby zeskanuje lub wklei ten kod, a potem poprosi o dołączenie. Zatwierdź to w sekcji „Czekają na dołączenie”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo da pessoa escaneia ou cola este código e depois pede para entrar. Aprove em “Aguardando para entrar”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo da pessoa digitaliza ou cola este código e depois pede para aderir. Aprove em “A aguardar adesão”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispozitivul persoanei scanează sau lipește acest cod, apoi cere să se alăture. Aprobă cererea la „Așteaptă să se alăture”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zariadenie tejto osoby kód naskenuje alebo vloží a potom požiada o pripojenie. Schváľte to v časti „Čaká na pripojenie“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personens enhet skannar eller klistrar in koden och ber sedan att få gå med. Godkänn det under ”Väntar på att gå med”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişinin aygıtı bu kodu tarar veya yapıştırır, ardından katılmak ister. \"Katılmayı bekleyenler\" altında onaylayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пристрій людини сканує або вставляє цей код, а потім просить приєднатися. Схваліть це в розділі «Очікують на приєднання»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方的设备扫描或粘贴此代码后会请求加入。请在“等待加入”中批准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方的裝置掃描或貼上此代碼後會請求加入。請在「等待加入」中核准。"
          }
        }
      }
    },
    "They lose access to the library. Their private history and private playlists are deleted; what they shared stays." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفقد الشخص إمكانية الوصول إلى المكتبة. يُحذف سجله الخاص وقوائم التشغيل الخاصة به؛ ويبقى ما شاركه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Човекът губи достъп до библиотеката. Личната му история и личните му плейлисти се изтриват; споделеното остава."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba ztratí přístup ke knihovně. Její soukromá historie a soukromé seznamy skladeb se smažou; co sdílela, zůstane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen mister adgangen til biblioteket. Den private historik og de private playlister slettes; det delte bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person verliert den Zugriff auf die Bibliothek. Ihr privater Verlauf und ihre privaten Playlists werden gelöscht; was sie geteilt hat, bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άτομο χάνει την πρόσβαση στη βιβλιοθήκη. Το ιδιωτικό του ιστορικό και οι ιδιωτικές λίστες του διαγράφονται· ό,τι μοιράστηκε παραμένει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierde el acceso a la biblioteca. Su historial privado y sus listas privadas se eliminan; lo que compartió se mantiene."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henkilö menettää pääsyn kirjastoon. Hänen yksityinen historiansa ja yksityiset soittolistansa poistetaan; jaettu jää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne perd l’accès à la bibliothèque. Son historique privé et ses listes de lecture privées sont supprimés ; ce qu’elle a partagé reste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האדם מאבד את הגישה לספרייה. ההיסטוריה הפרטית ופלייליסטים פרטיים שלו נמחקים; מה ששיתף נשאר."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba gubi pristup fonoteci. Njezina privatna povijest i privatni popisi za reprodukciju brišu se; ono što je podijelila ostaje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elveszíti a hozzáférést a könyvtárhoz. A privát előzményei és privát lejátszási listái törlődnek; amit megosztott, megmarad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perde l’accesso alla libreria. La sua cronologia privata e le sue playlist private vengono eliminate; ciò che ha condiviso resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この人はライブラリにアクセスできなくなります。プライベートな履歴とプレイリストは削除され、共有したものは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사람은 라이브러리에 접근할 수 없게 됩니다. 비공개 기록과 비공개 재생 목록은 삭제되고, 공유한 항목은 남습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen mister tilgangen til biblioteket. Privat historikk og private spillelister slettes; det som er delt, blir værende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze persoon verliest toegang tot de bibliotheek. De privégeschiedenis en privéafspeellijsten worden verwijderd; wat gedeeld is, blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba traci dostęp do biblioteki. Jej prywatna historia i prywatne playlisty zostaną usunięte; to, co udostępniła, pozostanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pessoa perde o acesso à biblioteca. O histórico e as playlists privados dela são excluídos; o que ela compartilhou permanece."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pessoa perde o acesso à biblioteca. O histórico e as playlists privados são eliminados; o que partilhou mantém-se."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persoana pierde accesul la bibliotecă. Istoricul și playlisturile ei private sunt șterse; ce a partajat rămâne."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba stratí prístup ku knižnici. Jej súkromná história a súkromné playlisty sa vymažú; čo zdieľala, zostane."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen förlorar åtkomsten till biblioteket. Den privata historiken och de privata spellistorna raderas; det som delats finns kvar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişi kitaplığa erişimini kaybeder. Özel geçmişi ve özel çalma listeleri silinir; paylaştıkları kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Людина втрачає доступ до бібліотеки. Її особиста історія та особисті плейлисти видаляються; те, чим вона поділилася, залишається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方将无法再访问此库。其私人记录和私人播放列表将被删除；已共享的内容会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方將無法再存取此資料庫。其私人記錄和私人播放列表將被刪除；已共享的內容會保留。"
          }
        }
      }
    },
    "This change needs a storage admin's credentials. They're used once and never saved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج هذا التغيير إلى بيانات اعتماد مسؤول التخزين. تُستخدم مرة واحدة ولا تُحفظ أبدًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази промяна изисква идентификационните данни на администратор на хранилището. Използват се веднъж и никога не се запазват."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato změna vyžaduje přihlašovací údaje správce úložiště. Použijí se jednou a nikdy se neuloží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændringen kræver en lageradministrators loginoplysninger. De bruges én gang og gemmes aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Änderung braucht die Zugangsdaten eines Speicher-Admins. Sie werden einmal verwendet und nie gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η αλλαγή χρειάζεται τα διαπιστευτήρια ενός διαχειριστή αποθήκευσης. Χρησιμοποιούνται μία φορά και δεν αποθηκεύονται ποτέ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cambio necesita las credenciales de un administrador del almacenamiento. Se usan una sola vez y nunca se guardan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä muutos vaatii tallennustilan ylläpitäjän tunnistetiedot. Niitä käytetään kerran eikä niitä tallenneta koskaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette modification nécessite les identifiants d’un administrateur du stockage. Ils ne servent qu’une fois et ne sont jamais enregistrés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השינוי הזה דורש את פרטי ההתחברות של מנהל האחסון. הם משמשים פעם אחת ולעולם לא נשמרים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za ovu promjenu potrebne su vjerodajnice administratora pohrane. Koriste se jednom i nikad se ne spremaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehhez a módosításhoz egy tárhelyadminisztrátor hitelesítő adatai kellenek. Csak egyszer használjuk őket, és soha nem mentjük el."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa modifica richiede le credenziali di un amministratore dello spazio di archiviazione. Vengono usate una sola volta e mai salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この変更にはストレージ管理者の認証情報が必要です。認証情報は一度だけ使用され、保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 변경에는 스토리지 관리자의 자격 증명이 필요합니다. 자격 증명은 한 번만 사용되고 저장되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endringen krever påloggingsinformasjonen til en lagringsadministrator. Den brukes én gang og lagres aldri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor deze wijziging zijn de inloggegevens van een opslagbeheerder nodig. Ze worden één keer gebruikt en nooit bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta zmiana wymaga danych logowania administratora magazynu. Są użyte raz i nigdy nie są zapisywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta alteração precisa das credenciais de um administrador do armazenamento. Elas são usadas uma vez e nunca são salvas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta alteração precisa das credenciais de um administrador do armazenamento. São usadas uma vez e nunca são guardadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această modificare necesită datele de autentificare ale unui administrator al stocării. Sunt folosite o singură dată și nu sunt salvate niciodată."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto zmena vyžaduje prihlasovacie údaje správcu úložiska. Použijú sa raz a nikdy sa neuložia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändringen kräver en lagringsadministratörs inloggningsuppgifter. De används en gång och sparas aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu değişiklik bir depolama yöneticisinin kimlik bilgilerini gerektirir. Bunlar bir kez kullanılır ve asla kaydedilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для цієї зміни потрібні облікові дані адміністратора сховища. Вони використовуються один раз і ніколи не зберігаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此更改需要存储管理员的凭据。凭据只使用一次，绝不会保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此變更需要儲存空間管理員的憑證。憑證只使用一次，絕不會儲存。"
          }
        }
      }
    },
    "This device leaves the library, then its copy is deleted. Your library in the cloud is untouched." : {
      "comment" : "Settings: message of the Remove this library from this device? confirmation, for a library that syncs.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغادر هذا الجهاز المكتبة، ثم تُحذف نسخته. تبقى مكتبتك في السحابة دون تغيير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това устройство напуска библиотеката, след което копието му се изтрива. Библиотеката ви в облака остава незасегната."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení opustí knihovnu a pak se jeho kopie smaže. Vaše knihovna v cloudu zůstane nedotčená."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed forlader biblioteket, og derefter slettes dens kopi. Dit bibliotek i skyen forbliver uberørt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät verlässt die Bibliothek, dann wird seine Kopie gelöscht. Deine Bibliothek in der Cloud bleibt unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή αποχωρεί από τη βιβλιοθήκη και μετά διαγράφεται το αντίγραφό της. Η βιβλιοθήκη σας στο cloud μένει ανέπαφη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo abandona la biblioteca y luego se elimina su copia. Tu biblioteca en la nube no se modifica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä laite poistuu kirjastosta, ja sitten sen kopio poistetaan. Pilvessä oleva kirjastosi säilyy ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil quitte la bibliothèque, puis sa copie est supprimée. Votre bibliothèque dans le cloud reste intacte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המכשיר הזה עוזב את הספרייה ואז העותק שלו נמחק. הספרייה שלכם בענן לא נפגעת."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj napušta fonoteku, a zatim se njegova kopija briše. Vaša fonoteka u oblaku ostaje netaknuta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz kilép a könyvtárból, majd a másolata törlődik. A felhőben lévő könyvtárad érintetlen marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo lascia la libreria, poi la sua copia viene eliminata. La tua libreria nel cloud resta intatta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはライブラリから抜け、そのあとコピーが削除されます。クラウド上のライブラリはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기가 라이브러리에서 나간 다음 사본이 삭제됩니다. 클라우드의 라이브러리는 그대로 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheten forlater biblioteket, og deretter slettes kopien. Biblioteket ditt i skyen forblir urørt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat verlaat de bibliotheek en daarna wordt de kopie verwijderd. Je bibliotheek in de cloud blijft onaangeroerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie opuści bibliotekę, a potem jego kopia zostanie usunięta. Twoja biblioteka w chmurze pozostaje nietknięta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo sai da biblioteca e depois a cópia dele é excluída. Sua biblioteca na nuvem não é alterada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo sai da biblioteca e depois a sua cópia é eliminada. A sua biblioteca na nuvem não é alterada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest dispozitiv părăsește biblioteca, apoi copia lui este ștearsă. Biblioteca ta din cloud rămâne neatinsă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zariadenie opustí knižnicu a potom sa jeho kópia vymaže. Vaša knižnica v cloude zostane nedotknutá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten lämnar biblioteket och sedan raderas dess kopia. Ditt bibliotek i molnet påverkas inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz kitaplıktan ayrılır, ardından kopyası silinir. Buluttaki kitaplığınıza dokunulmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пристрій залишає бібліотеку, а потім його копію буде видалено. Ваша бібліотека в хмарі залишається недоторканою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备将退出该库，然后删除其副本。云端的库不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置將退出該資料庫，然後刪除其副本。雲端的資料庫不受影響。"
          }
        }
      }
    },
    "This device stops syncing and removes its storage credentials. Sign in again to resume syncing." : {
      "comment" : "Settings › Sync: message of the Disconnect sync? confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف هذا الجهاز عن المزامنة ويزيل بيانات اعتماد التخزين الخاصة به. سجّل الدخول مجددًا لاستئناف المزامنة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това устройство спира синхронизирането и премахва идентификационните си данни за хранилището. Влезте отново, за да възобновите синхронизирането."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení přestane synchronizovat a odstraní své přihlašovací údaje k úložišti. Pro obnovení synchronizace se znovu přihlaste."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed stopper synkroniseringen og fjerner sine loginoplysninger til lageret. Log ind igen for at genoptage synkroniseringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät beendet die Synchronisierung und entfernt seine Speicher-Zugangsdaten. Melde dich erneut an, um weiter zu synchronisieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή σταματά τον συγχρονισμό και αφαιρεί τα διαπιστευτήρια αποθήκευσής της. Συνδεθείτε ξανά για να συνεχιστεί ο συγχρονισμός."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo deja de sincronizar y elimina sus credenciales del almacenamiento. Vuelve a iniciar sesión para reanudar la sincronización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä laite lopettaa synkronoinnin ja poistaa tallennustilan tunnistetietonsa. Jatka synkronointia kirjautumalla uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil arrête de synchroniser et supprime ses identifiants de stockage. Reconnectez-vous pour reprendre la synchronisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המכשיר הזה מפסיק לסנכרן ומסיר את פרטי ההתחברות שלו לאחסון. התחברו שוב כדי להמשיך לסנכרן."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj prestaje sinkronizirati i uklanja svoje vjerodajnice za pohranu. Ponovno se prijavite da biste nastavili sinkronizaciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz leállítja a szinkronizálást, és eltávolítja a tárhely hitelesítő adatait. A folytatáshoz jelentkezz be újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo smette di sincronizzare e rimuove le sue credenziali di archiviazione. Accedi di nuovo per riprendere la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは同期を停止し、ストレージの認証情報を削除します。同期を再開するには、もう一度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 동기화를 중지하고 스토리지 자격 증명을 제거합니다. 동기화를 다시 시작하려면 다시 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheten slutter å synkronisere og fjerner påloggingsinformasjonen for lagringen. Logg på igjen for å fortsette synkroniseringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat stopt met synchroniseren en verwijdert zijn inloggegevens voor de opslag. Log opnieuw in om verder te synchroniseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie przestanie synchronizować i usunie swoje dane logowania do magazynu. Zaloguj się ponownie, aby wznowić synchronizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo para de sincronizar e remove as credenciais de armazenamento. Entre novamente para retomar a sincronização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo deixa de sincronizar e remove as credenciais de armazenamento. Inicie sessão novamente para retomar a sincronização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest dispozitiv oprește sincronizarea și elimină datele sale de autentificare pentru stocare. Conectează-te din nou pentru a relua sincronizarea."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zariadenie prestane synchronizovať a odstráni svoje prihlasovacie údaje k úložisku. Na obnovenie synchronizácie sa znova prihláste."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten slutar synkronisera och tar bort sina inloggningsuppgifter för lagringen. Logga in igen för att återuppta synkroniseringen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz eşzamanlamayı durdurur ve depolama kimlik bilgilerini kaldırır. Eşzamanlamayı sürdürmek için yeniden oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пристрій припиняє синхронізацію та вилучає свої облікові дані сховища. Увійдіть знову, щоб продовжити синхронізацію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备将停止同步并移除其存储凭据。重新登录即可恢复同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
