            "value": "QR कोड स्कैन करने के लिए कैमरा अनुमति आवश्यक है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "QR কোড স্ক্যান করতে ক্যামেরার অনুমতি প্রয়োজন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "QR குறியீடுகளை வருட கேமரா அனுமதி தேவை"
