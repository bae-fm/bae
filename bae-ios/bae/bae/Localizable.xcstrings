    "Removes this library and its downloaded files from this device. Your library in the cloud is untouched. You can re-pair this device later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this library and its downloaded files from this device. Your library in the cloud is untouched. You can re-pair this device later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita esta biblioteca y sus archivos descargados de este dispositivo. Tu biblioteca en la nube no se toca. Puedes volver a emparejar este dispositivo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime cette bibliothèque et ses fichiers téléchargés de cet appareil. Votre bibliothèque dans le cloud n'est pas touchée. Vous pourrez réassocier cet appareil plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt diese Bibliothek und ihre heruntergeladenen Dateien von diesem Gerät. Deine Bibliothek in der Cloud bleibt unberührt. Du kannst dieses Gerät später erneut koppeln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove esta biblioteca e seus arquivos baixados deste dispositivo. Sua biblioteca na nuvem permanece intacta. Você pode parear este dispositivo novamente mais tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリとそのダウンロード済みファイルをこのデバイスから削除します。クラウド上のライブラリはそのまま残ります。このデバイスは後で再ペアリングできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此设备移除此库及其已下载文件。你在云端的库不受影响。你可以稍后重新配对此设备。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذه المكتبة وملفاتها المنزّلة من هذا الجهاز. لن تتأثر مكتبتك في السحابة. يمكنك إعادة ربط هذا الجهاز لاحقًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיר ספרייה זו ואת הקבצים שהורדו ממנה מהמכשיר הזה. הספרייה שלכם בענן לא תיפגע. תוכלו לצמד מחדש את המכשיר הזה מאוחר יותר."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучає цю бібліотеку та її завантажені файли з цього пристрою. Ваша бібліотека в хмарі залишається незмінною. Ви можете повторно підключити цей пристрій пізніше."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Премахва тази библиотека и изтеглените ѝ файлове от това устройство. Библиотеката ви в облака остава непокътната. Можете да сдвоите това устройство отново по-късно."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa tę bibliotekę i pobrane pliki z tego urządzenia. Twoja biblioteka w chmurze pozostaje nienaruszona. Możesz później ponownie sparować to urządzenie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebere tuto knihovnu a její stažené soubory z tohoto zařízení. Vaše knihovna v cloudu zůstane nedotčena. Toto zařízení můžete později znovu spárovat."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja ovu fonoteku i njezine preuzete datoteke s ovog uređaja. Vaša fonoteka u oblaku ostaje netaknuta. Ovaj uređaj možete kasnije ponovno upariti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리와 다운로드된 파일을 이 기기에서 제거합니다. 클라우드의 라이브러리는 그대로이며 나중에 이 기기를 다시 연결할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此裝置移除此資料庫及其已下載檔案。你在雲端的資料庫不會受影響。你可以稍後重新配對此裝置。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove questa libreria e i relativi file scaricati da questo dispositivo. La tua libreria nel cloud rimane intatta. Potrai riabbinare questo dispositivo in seguito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitaplığı ve indirilen dosyalarını bu cihazdan kaldırır. Buluttaki kitaplığınıza dokunulmaz. Bu cihazı daha sonra yeniden eşleyebilirsiniz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert deze bibliotheek en de gedownloade bestanden van dit apparaat. Je bibliotheek in de cloud blijft ongewijzigd. Je kunt dit apparaat later opnieuw koppelen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni túto knižnicu a jej stiahnuté súbory z tohto zariadenia. Tvoja knižnica v cloude zostane nedotknutá. Toto zariadenie môžeš neskôr znova spárovať."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja ezt a könyvtárat és letöltött fájljait erről az eszközről. A felhőben lévő könyvtárad érintetlen marad. Az eszközt később újra párosíthatod."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină această bibliotecă și fișierele descărcate de pe acest dispozitiv. Biblioteca ta din cloud rămâne neatinsă. Poți reasocia acest dispozitiv mai târziu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί αυτή τη βιβλιοθήκη και τα ληφθέντα αρχεία της από αυτή τη συσκευή. Η βιβλιοθήκη σας στο cloud παραμένει ανέπαφη. Μπορείτε να συζεύξετε ξανά αυτή τη συσκευή αργότερα."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove esta biblioteca e os respetivos ficheiros transferidos deste dispositivo. A sua biblioteca na nuvem fica intacta. Pode voltar a emparelhar este dispositivo mais tarde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort det här biblioteket och dess hämtade filer från den här enheten. Ditt bibliotek i molnet är orört. Du kan parkoppla den här enheten igen senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner dette bibliotek og dets hentede filer fra denne enhed. Dit bibliotek i skyen er urørt. Du kan parre denne enhed igen senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner dette biblioteket og de nedlastede filene fra denne enheten. Biblioteket ditt i skyen er urørt. Du kan pare denne enheten på nytt senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa tämän kirjaston ja sen ladatut tiedostot tältä laitteelta. Kirjastosi pilvessä säilyy koskemattomana. Voit muodostaa pariliitoksen uudelleen myöhemmin."
          }
        }
      }
    },
