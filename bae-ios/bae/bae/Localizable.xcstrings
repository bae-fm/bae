        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud обмежено на цьому пристрої (батьківський контроль або MDM). bae не може використовувати його для синхронізації."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
