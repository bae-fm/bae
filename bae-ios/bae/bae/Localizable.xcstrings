    "It will lose access and the library key will be rotated. Devices still in the library re-key automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will lose access and the library key will be rotated. Devices still in the library re-key automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderá el acceso y la clave de la biblioteca se rotará. Los dispositivos que sigan en la biblioteca reciben la clave nueva automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il perdra l'accès et la clé de la bibliothèque sera changée. Les appareils encore dans la bibliothèque reçoivent la nouvelle clé automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es verliert den Zugriff und der Bibliotheksschlüssel wird gewechselt. Geräte, die in der Bibliothek bleiben, erhalten den neuen Schlüssel automatisch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele perderá o acesso e a chave da biblioteca será trocada. Os dispositivos que continuam na biblioteca recebem a nova chave automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス権が失われ、ライブラリの鍵が交換されます。ライブラリに残っているデバイスは自動的に新しい鍵を受け取ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将失去访问权限，资料库密钥将被更换。仍在资料库中的设备会自动获得新密钥。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيفقد الوصول وسيُبدَّل مفتاح المكتبة. الأجهزة التي ما زالت في المكتبة تحصل على المفتاح الجديد تلقائيًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא יאבד גישה ומפתח הספרייה יוחלף. מכשירים שעדיין בספרייה מקבלים את המפתח החדש אוטומטית."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він втратить доступ, а ключ бібліотеки буде змінено. Пристрої, що залишаються в бібліотеці, отримують новий ключ автоматично."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "То ще загуби достъп и ключът на библиотеката ще бъде сменен. Устройствата, които са още в библиотеката, получават новия ключ автоматично."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Straci dostęp, a klucz biblioteki zostanie wymieniony. Urządzenia pozostające w bibliotece automatycznie otrzymują nowy klucz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ztratí přístup a klíč knihovny bude vyměněn. Zařízení, která v knihovně zůstávají, dostanou nový klíč automaticky."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgubit će pristup i ključ knjižnice bit će promijenjen. Uređaji koji su još u knjižnici automatski dobivaju novi ključ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 접근 권한이 사라지고 보관함 키가 교체됩니다. 보관함에 남아 있는 기기는 자동으로 새 키를 받습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它將失去存取權，資料庫金鑰將被更換。仍在資料庫中的裝置會自動取得新金鑰。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderà l'accesso e la chiave della libreria verrà cambiata. I dispositivi ancora nella libreria ricevono la nuova chiave automaticamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişimini kaybedecek ve kitaplık anahtarı değiştirilecek. Kitaplıkta kalan cihazlar yeni anahtarı otomatik alır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verliest de toegang en de bibliotheeksleutel wordt gewisseld. Apparaten die in de bibliotheek blijven, krijgen automatisch de nieuwe sleutel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stratí prístup a kľúč knižnice sa vymení. Zariadenia, ktoré v knižnici zostanú, si kľúč vymenia automaticky."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elveszíti a hozzáférését, és a könyvtár kulcsa cserélődik. A könyvtárban maradó eszközök automatikusan új kulcsot kapnak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Va pierde accesul, iar cheia bibliotecii va fi rotită. Dispozitivele rămase în bibliotecă primesc automat cheia nouă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα χάσει την πρόσβαση και το κλειδί της βιβλιοθήκης θα αντικατασταθεί. Οι συσκευές που παραμένουν στη βιβλιοθήκη λαμβάνουν αυτόματα νέο κλειδί."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderá o acesso e a chave da biblioteca será substituída. Os dispositivos que continuam na biblioteca recebem a nova chave automaticamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den förlorar åtkomsten och bibliotekets nyckel byts ut. Enheter som är kvar i biblioteket får en ny nyckel automatiskt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den mister adgangen, og bibliotekets nøgle udskiftes. Enheder, der bliver i biblioteket, får automatisk en ny nøgle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den mister tilgangen, og bibliotekets nøkkel byttes ut. Enheter som blir værende i biblioteket, får ny nøkkel automatisk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se menettää käyttöoikeuden, ja kirjaston avain vaihdetaan. Kirjastoon jäävät laitteet saavat uuden avaimen automaattisesti."
          }
        }
      }
    },
