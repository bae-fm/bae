    "This library needs a signed-in provider. Go back and choose the provider it uses.": {
      "comment": "Join flow: the picked provider does not match the library's OAuth provider",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This library needs a signed-in provider. Go back and choose the provider it uses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca necesita un proveedor con sesión iniciada. Vuelve atrás y elige el proveedor que usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette bibliothèque nécessite un fournisseur connecté. Revenez en arrière et choisissez le fournisseur qu’elle utilise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bibliothek benötigt einen angemeldeten Anbieter. Gehe zurück und wähle den Anbieter aus, den sie verwendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca precisa de um provedor com sessão iniciada. Volte e escolha o provedor que ela usa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリにはサインイン済みのプロバイダーが必要です。戻って、このライブラリが使用するプロバイダーを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리에는 로그인된 제공업체가 필요합니다. 돌아가서 이 라이브러리가 사용하는 제공업체를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此资料库需要已登录的提供方。请返回并选择它使用的提供方。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج هذه المكتبة إلى موفر تم تسجيل الدخول إليه. ارجع واختر الموفر الذي تستخدمه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה הזו צריכה ספק שמחוברים אליו. חזור ובחר את הספק שהיא משתמשת בו."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї бібліотеки потрібен постачальник із виконаним входом. Поверніться та виберіть постачальника, якого вона використовує."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази библиотека изисква доставчик с влязъл профил. Върнете се и изберете доставчика, който използва."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta biblioteka wymaga zalogowanego dostawcy. Wróć i wybierz dostawcę, którego używa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato knihovna vyžaduje přihlášeného poskytovatele. Vraťte se a vyberte poskytovatele, kterého používá."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova biblioteka zahtijeva prijavljenog pružatelja. Vratite se i odaberite pružatelja kojeg koristi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫需要已登入的提供者。請返回並選擇它使用的提供者。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa libreria richiede un provider con accesso effettuato. Torna indietro e scegli il provider che usa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arşiv, oturum açılmış bir sağlayıcı gerektirir. Geri dönüp kullandığı sağlayıcıyı seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện này cần một nhà cung cấp đã đăng nhập. Hãy quay lại và chọn nhà cung cấp mà thư viện sử dụng."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bibliotheek heeft een ingelogde provider nodig. Ga terug en kies de provider die deze gebruikt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लाइब्रेरी के लिए साइन-इन किया हुआ प्रदाता चाहिए। वापस जाएँ और वह प्रदाता चुनें जिसका यह उपयोग करती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লাইব্রেরির জন্য সাইন-ইন করা প্রদানকারী দরকার। ফিরে যান এবং এটি যে প্রদানকারী ব্যবহার করে সেটি বেছে নিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நூலகத்திற்கு உள்நுழைந்த வழங்குநர் தேவை. திரும்பிச் சென்று இது பயன்படுத்தும் வழங்குநரைத் தேர்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ లైబ్రరీకి సైన్ ఇన్ చేసిన ప్రొవైడర్ అవసరం. తిరిగి వెళ్లి ఇది ఉపయోగించే ప్రొవైడర్‌ను ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या लायब्ररीसाठी साइन-इन केलेला प्रदाता आवश्यक आहे. मागे जा आणि ती वापरत असलेला प्रदाता निवडा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس لائبریری کو سائن اِن شدہ فراہم کنندہ درکار ہے۔ واپس جائیں اور وہ فراہم کنندہ منتخب کریں جو یہ استعمال کرتی ہے۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ લાઇબ્રેરીને સાઇન-ઇન કરેલા પ્રોવાઇડરની જરૂર છે. પાછા જાઓ અને તે જે પ્રોવાઇડરનો ઉપયોગ કરે છે તે પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಲೈಬ್ರರಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದ ಪ್ರೊವೈಡರ್ ಅಗತ್ಯವಿದೆ. ಹಿಂದಿರುಗಿ ಇದು ಬಳಸುವ ಪ್ರೊವೈಡರ್ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ലൈബ്രറിയ്ക്ക് സൈൻ ഇൻ ചെയ്ത പ്രൊവൈഡർ വേണം. തിരികെ പോയി ഇത് ഉപയോഗിക്കുന്ന പ്രൊവൈഡർ തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਲਾਇਬ੍ਰੇਰੀ ਨੂੰ ਸਾਈਨ-ਇਨ ਕੀਤਾ ਪ੍ਰੋਵਾਈਡਰ ਚਾਹੀਦਾ ਹੈ। ਵਾਪਸ ਜਾਓ ਅਤੇ ਉਹ ਪ੍ਰੋਵਾਈਡਰ ਚੁਣੋ ਜੋ ਇਹ ਵਰਤਦੀ ਹੈ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไลบรารีนี้ต้องใช้ผู้ให้บริการที่ลงชื่อเข้าใช้แล้ว กลับไปและเลือกผู้ให้บริการที่ไลบรารีนี้ใช้"
          }
        }
      }
    }
  },
  "version": "1.0"
}
