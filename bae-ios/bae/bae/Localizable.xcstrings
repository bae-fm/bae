    "Couldn't present cloud sign-in from the current window.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't present cloud sign-in from the current window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo mostrar el inicio de sesión en la nube desde la ventana actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'afficher la connexion au cloud depuis la fenêtre actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Anmeldung konnte nicht aus dem aktuellen Fenster angezeigt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível apresentar o login na nuvem a partir da janela atual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のウィンドウからクラウドサインインを表示できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从当前窗口呈现云登录。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر عرض تسجيل الدخول السحابي من النافذة الحالية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להציג כניסה לענן מהחלון הנוכחי."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося показати хмарний вхід із поточного вікна."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влизането в облака не може да бъде показано от текущия прозорец."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wyświetlić logowania do chmury z bieżącego okna."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze zobrazit přihlášení k cloudu z aktuálního okna."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće prikazati prijavu u oblak iz trenutnog prozora."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 창에서 클라우드 로그인을 표시할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從目前視窗顯示雲端登入。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile mostrare l'accesso cloud dalla finestra corrente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli pencereden bulut oturumu açma gösterilemedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hiển thị đăng nhập đám mây từ cửa sổ hiện tại."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan cloudaanmelding niet vanuit het huidige venster tonen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा विंडो से क्लाउड साइन-इन नहीं दिखाया जा सका।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমান উইন্ডো থেকে ক্লাউড সাইন-ইন দেখানো যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்போதைய சாளரத்திலிருந்து மேக உள்நுழைவை காட்ட முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుత విండో నుంచి క్లౌడ్ సైన్-ఇన్ చూపించలేకపోయింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्याच्या विंडोमधून क्लाउड प्रवेश दाखवता आला नाही."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ دریچے سے کلاؤڈ سائن ان نہیں دکھایا جا سکا۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાલની વિંડોમાંથી ક્લાઉડ સાઇન-ઇન બતાવી શકાયું નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಸ್ತುತ ವಿಂಡೋದಿಂದ ಕ್ಲೌಡ್ ಸೈನ್-ಇನ್ ತೋರಿಸಲಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിലവിലെ വിൻഡോയിൽ നിന്ന് ക്ലൗഡ് പ്രവേശനം കാണിക്കാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੌਜੂਦਾ ਵਿੰਡੋ ਤੋਂ ਕਲਾਊਡ ਸਾਇਨ-ਇਨ ਨਹੀਂ ਦਿਖਾਇਆ ਜਾ ਸਕਿਆ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถแสดงการลงชื่อเข้าใช้คลาวด์จากหน้าต่างปัจจุบันได้"
          }
        }
      }
    },
