    "Add this device to a library you already have on another device.": {
      "comment": "Onboarding: what the join flow does",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this device to a library you already have on another device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade este dispositivo a una biblioteca que ya tienes en otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez cet appareil à une bibliothèque que vous avez déjà sur un autre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge dieses Gerät zu einer Mediathek hinzu, die du bereits auf einem anderen Gerät hast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione este dispositivo a uma biblioteca que você já tem em outro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに別のデバイスにあるライブラリに、このデバイスを追加します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此设备添加到你已在另一台设备上拥有的资料库。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف هذا الجهاز إلى مكتبة موجودة لديك بالفعل على جهاز آخر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו את המכשיר הזה לספרייה שכבר יש לכם במכשיר אחר."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте цей пристрій до бібліотеки, яку ви вже маєте на іншому пристрої."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете това устройство към библиотека, която вече имате на друго устройство."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj to urządzenie do biblioteki, którą już masz na innym urządzeniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte toto zařízení do knihovny, kterou už máte na jiném zařízení."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte ovaj uređaj u fonoteku koju već imate na drugom uređaju."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에 이미 있는 라이브러리에 이 기기를 추가하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此裝置加入你已在另一台裝置上擁有的資料庫。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questo dispositivo a una libreria che hai già su un altro dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtı, başka bir aygıtta zaten sahip olduğunuz bir kitaplığa ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thiết bị này vào thư viện bạn đã có trên một thiết bị khác."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg dit apparaat toe aan een bibliotheek die je al op een ander apparaat hebt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस को उस लाइब्रेरी में जोड़ें जो आपके पास पहले से किसी दूसरे डिवाइस पर है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ডিভাইসে আপনার ইতিমধ্যে থাকা একটি লাইব্রেরিতে এই ডিভাইসটি যোগ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறு சாதனத்தில் ஏற்கனவே உள்ள நூலகத்தில் இந்தச் சாதனத்தைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో పరికరంలో మీకు ఇప్పటికే ఉన్న లైబ్రరీకి ఈ పరికరాన్ని జోడించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दुसऱ्या डिव्हाइसवर तुमच्याकडे आधीपासून असलेल्या संग्रहालयात हे डिव्हाइस जोडा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے کو اس لائبریری میں شامل کریں جو آپ کے پاس پہلے سے کسی دوسرے آلے پر ہے۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા બીજા ઉપકરણ પર પહેલેથી રહેલી લાઇબ્રેરીમાં આ ઉપકરણ ઉમેરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೊಂದು ಸಾಧನದಲ್ಲಿ ಈಗಾಗಲೇ ಇರುವ ಲೈಬ್ರರಿಗೆ ಈ ಸಾಧನವನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു ഉപകരണത്തിൽ നിങ്ങൾക്ക് ഇതിനകം ഉള്ള ഒരു ശേഖരത്തിലേക്ക് ഈ ഉപകരണം ചേർക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਡਿਵਾਈਸ ਨੂੰ ਉਸ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਸ਼ਾਮਲ ਕਰੋ ਜੋ ਤੁਹਾਡੇ ਕੋਲ ਪਹਿਲਾਂ ਹੀ ਕਿਸੇ ਹੋਰ ਡਿਵਾਈਸ ਉੱਤੇ ਹੈ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มอุปกรณ์นี้เข้าคลังที่คุณมีอยู่แล้วบนอุปกรณ์อื่น"
          }
        }
      }
    },
    "Anyone with this code has full access to your library. Keep it secret. Use it only to restore on a new device when you have no other device available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with this code has full access to your library. Keep it secret. Use it only to restore on a new device when you have no other device available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera con este código tiene acceso completo a tu biblioteca. Mantenlo en secreto. Úsalo solo para restaurar en un dispositivo nuevo cuando no tengas otro dispositivo disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque possède ce code a un accès complet à votre bibliothèque. Gardez-le secret. Utilisez-le uniquement pour restaurer sur un nouvel appareil quand aucun autre appareil n'est disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder mit diesem Code hat vollen Zugriff auf deine Bibliothek. Halte ihn geheim. Nutze ihn nur zur Wiederherstellung auf einem neuen Gerät, wenn kein anderes Gerät verfügbar ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com este código tem acesso total à sua biblioteca. Mantenha-o em segredo. Use-o apenas para restaurar em um dispositivo novo quando você não tiver outro dispositivo disponível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードを持つ人は誰でもライブラリに完全にアクセスできます。秘密にしてください。他のデバイスが使えないときに、新しいデバイスで復元する場合にのみ使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拥有此代码的人都能完全访问你的资料库。请保密。仅在没有其他设备可用时，用它在新设备上恢复。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي شخص يملك هذا الرمز له وصول كامل إلى مكتبتك. أبقِه سرًّا. استخدمه فقط للاستعادة على جهاز جديد عندما لا يتوفر لديك جهاز آخر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכל מי שיש קוד זה יש גישה מלאה לספרייה שלך. שמור אותו בסוד. השתמש בו רק לשחזור במכשיר חדש כשאין לך מכשיר אחר זמין."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-хто з цим кодом має повний доступ до вашої бібліотеки. Тримайте його в таємниці. Використовуйте лише для відновлення на новому пристрої, коли немає іншого доступного пристрою."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки с този код има пълен достъп до библиотеката ви. Пазете го в тайна. Използвайте го само за възстановяване на ново устройство, когато нямате друго налично устройство."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy, kto ma ten kod, ma pełny dostęp do Twojej biblioteki. Trzymaj go w tajemnicy. Używaj go tylko do przywracania na nowym urządzeniu, gdy nie masz dostępnego innego urządzenia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdokoli s tímto kódem má plný přístup k vaší knihovně. Udržujte ho v tajnosti. Použijte ho jen k obnově v novém zařízení, když nemáte žádné jiné zařízení k dispozici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svatko s ovim kodom ima puni pristup vašoj knjižnici. Čuvajte ga u tajnosti. Koristite ga samo za obnovu na novom uređaju kad nemate drugi dostupan uređaj."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드를 가진 사람은 누구나 보관함에 완전히 접근할 수 있습니다. 비밀로 유지하세요. 다른 기기를 사용할 수 없을 때 새 기기에서 복원하는 용도로만 사용하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何擁有此代碼的人都能完整存取你的資料庫。請保密。僅在沒有其他裝置可用時，用它在新裝置上還原。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque abbia questo codice ha pieno accesso alla tua libreria. Tienilo segreto. Usalo solo per ripristinare su un nuovo dispositivo quando non hai altri dispositivi disponibili."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu koda sahip olan herkes kitaplığına tam erişim kazanır. Gizli tut. Yalnızca başka bir cihazın yokken yeni bir cihazda geri yüklemek için kullan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ ai có mã này đều có toàn quyền truy cập thư viện của bạn. Hãy giữ bí mật. Chỉ dùng để khôi phục trên thiết bị mới khi bạn không còn thiết bị nào khác."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen met deze code heeft volledige toegang tot je bibliotheek. Houd hem geheim. Gebruik hem alleen om te herstellen op een nieuw apparaat als je geen ander apparaat beschikbaar hebt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसके पास यह कोड है, उसे आपकी लाइब्रेरी की पूरी पहुंच है. इसे गुप्त रखें. इसका उपयोग केवल तब करें जब कोई दूसरा डिवाइस उपलब्ध न हो और नए डिवाइस पर पुनर्स्थापित करना हो."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কোড যার কাছে আছে সে আপনার লাইব্রেরিতে সম্পূর্ণ অ্যাক্সেস পায়। এটি গোপন রাখুন। অন্য কোনো ডিভাইস না থাকলে কেবল নতুন ডিভাইসে পুনরুদ্ধারের জন্য এটি ব্যবহার করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் குறியீடு உள்ள எவருக்கும் உங்கள் லைப்ரரிக்கு முழு அணுகல் உண்டு. இதை ரகசியமாக வைத்திருங்கள். வேறு சாதனம் இல்லாதபோது புதிய சாதனத்தில் மீட்டமைக்க மட்டுமே பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ కోడ్ ఉన్న ఎవరికైనా మీ లైబ్రరీకి పూర్తి యాక్సెస్ ఉంటుంది. దీన్ని రహస్యంగా ఉంచండి. మరో పరికరం అందుబాటులో లేనప్పుడు కొత్త పరికరంలో పునరుద్ధరించడానికి మాత్రమే ఉపయోగించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा कोड असलेल्या कोणालाही तुमच्या लायब्ररीचा पूर्ण प्रवेश मिळतो. तो गुप्त ठेवा. दुसरे कोणतेही डिव्हाइस उपलब्ध नसताना नवीन डिव्हाइसवर पुनर्संचयित करण्यासाठीच त्याचा वापर करा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جس کے پاس یہ کوڈ ہو اسے آپ کی لائبریری تک مکمل رسائی حاصل ہے۔ اسے خفیہ رکھیں۔ صرف اس وقت نئے آلے پر بحالی کے لیے استعمال کریں جب کوئی اور آلہ دستیاب نہ ہو۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ કોડ ધરાવનાર કોઈપણને તમારી લાઇબ્રેરીની સંપૂર્ણ ઍક્સેસ મળે છે. તેને ગુપ્ત રાખો. બીજું કોઈ ડિવાઇસ ઉપલબ્ધ ન હોય ત્યારે જ નવા ડિવાઇસ પર પુનઃસ્થાપિત કરવા તેનો ઉપયોગ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಕೋಡ್ ಇರುವ ಯಾರಿಗಾದರೂ ನಿಮ್ಮ ಲೈಬ್ರರಿಗೆ ಪೂರ್ಣ ಪ್ರವೇಶವಿದೆ. ಇದನ್ನು ರಹಸ್ಯವಾಗಿಡಿ. ಬೇರೆ ಸಾಧನ ಲಭ್ಯವಿಲ್ಲದಾಗ ಹೊಸ ಸಾಧನದಲ್ಲಿ ಮರುಸ್ಥಾಪಿಸಲು ಮಾತ್ರ ಬಳಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ കോഡ് ഉള്ള ആർക്കും നിങ്ങളുടെ ലൈബ്രറിയിലേക്ക് പൂർണ്ണ ആക്സസ് ഉണ്ട്. ഇത് രഹസ്യമായി സൂക്ഷിക്കുക. മറ്റൊരു ഉപകരണവും ലഭ്യമല്ലാത്തപ്പോൾ പുതിയ ഉപകരണത്തിൽ പുനഃസ്ഥാപിക്കാൻ മാത്രം ഉപയോഗിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਸ ਕੋਲ ਇਹ ਕੋਡ ਹੈ, ਉਸ ਕੋਲ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਦੀ ਪੂਰੀ ਪਹੁੰਚ ਹੈ। ਇਸਨੂੰ ਗੁਪਤ ਰੱਖੋ। ਜਦੋਂ ਕੋਈ ਹੋਰ ਡਿਵਾਈਸ ਉਪਲਬਧ ਨਾ ਹੋਵੇ ਤਾਂ ਸਿਰਫ਼ ਨਵੀਂ ਡਿਵਾਈਸ 'ਤੇ ਰੀਸਟੋਰ ਕਰਨ ਲਈ ਇਸਦੀ ਵਰਤੋਂ ਕਰੋ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครก็ตามที่มีรหัสนี้จะเข้าถึงคลังของคุณได้ทั้งหมด เก็บเป็นความลับ ใช้เฉพาะกู้คืนบนอุปกรณ์ใหม่เมื่อคุณไม่มีอุปกรณ์อื่นให้ใช้"
          }
        }
      }
    },
