          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta stoppar synkroniseringen och tar bort molnleverantörens konfiguration."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette stopper synkroniseringen og fjerner skyudbyderens konfiguration."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette stopper synkroniseringen og fjerner oppsettet for skyleverandøren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lopettaa synkronoinnin ja poistaa pilvipalveluntarjoajan määritykset."
          }
        }
      }
