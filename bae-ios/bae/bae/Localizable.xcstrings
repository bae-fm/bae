    "You're not signed into iCloud. Open System Settings → Apple ID to sign in, then try again.": {
      "comment": "Sync failure: CloudKit refused because no iCloud account is signed in",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're not signed into iCloud. Open System Settings → Apple ID to sign in, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has iniciado sesión en iCloud. Abre Ajustes del Sistema → Apple ID para iniciar sesión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'êtes pas connecté à iCloud. Ouvrez Réglages Système → Identifiant Apple pour vous connecter, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht bei iCloud angemeldet. Öffne „Systemeinstellungen“ → Apple-ID, melde dich an und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não está conectado ao iCloud. Abra Ajustes do Sistema → ID Apple para entrar e tente novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudにサインインしていません。「システム設定」→「Apple ID」でサインインしてから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未登录 iCloud。请打开“系统设置”→“Apple ID”登录后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تسجّل الدخول إلى iCloud. افتح إعدادات النظام ← Apple ID لتسجيل الدخول، ثم أعد المحاولة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אינך מחובר ל-iCloud. פתח את הגדרות המערכת ← Apple ID כדי להתחבר, ואז נסה שוב."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не увійшли в iCloud. Відкрийте «Системні параметри» → Apple ID, увійдіть і повторіть спробу."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сте влезли в iCloud. Отворете „Системни настройки“ → Apple ID, влезте и опитайте отново."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zalogowano do iCloud. Otwórz Ustawienia systemowe → Apple ID, zaloguj się i spróbuj ponownie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejste přihlášeni k iCloudu. Otevřete Nastavení systému → Apple ID, přihlaste se a zkuste to znovu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niste prijavljeni na iCloud. Otvorite Postavke sustava → Apple ID i prijavite se, zatim pokušajte ponovno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인되어 있지 않습니다. 시스템 설정 → Apple ID에서 로그인한 다음 다시 시도하십시오."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未登入 iCloud。請打開「系統設定」→「Apple ID」登入後再試一次。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai eseguito l'accesso a iCloud. Apri Impostazioni di Sistema → ID Apple per accedere, poi riprova."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud'da oturum açmadınız. Oturum açmak için Sistem Ayarları → Apple Kimliği'ni açın, sonra yeniden deneyin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent niet ingelogd bij iCloud. Open Systeeminstellingen → Apple ID om in te loggen en probeer het opnieuw."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie si prihlásený do iCloudu. Otvor Nastavenia systému → Apple ID, prihlás sa a skús to znova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem vagy bejelentkezve az iCloudba. Nyisd meg a Rendszerbeállítások → Apple-fiók menüpontot, jelentkezz be, majd próbáld újra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ești conectat la iCloud. Deschide Configurări sistem → Apple ID, conectează-te, apoi încearcă din nou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχετε συνδεθεί στο iCloud. Ανοίξτε Ρυθμίσεις συστήματος → Apple ID, συνδεθείτε και δοκιμάστε ξανά."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não tem sessão iniciada no iCloud. Abra Definições do Sistema → ID Apple para iniciar sessão e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är inte inloggad på iCloud. Öppna Systeminställningar → Apple-ID för att logga in och försök sedan igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er ikke logget ind på iCloud. Åbn Systemindstillinger → Apple-id for at logge ind, og prøv så igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er ikke logget på iCloud. Åpne Systeminnstillinger → Apple-ID for å logge på, og prøv på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
