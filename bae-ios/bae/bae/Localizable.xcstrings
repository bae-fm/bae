          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לבדוק מהדורות בענן בלבד: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити релізи, що зберігаються лише в хмарі: %@"
