            "state": "translated",
            "value": "Dein iCloud-Speicher ist voll. Gib in „Systemeinstellungen“ → Apple-ID → iCloud Speicher frei, um weiter zu synchronisieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
