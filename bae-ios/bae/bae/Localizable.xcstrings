          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ব্যবহারের অনুমতি bae-এর নেই। সিস্টেম সেটিংস → Apple ID → iCloud → iCloud ব্যবহারকারী অ্যাপ খুলে bae চালু করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-ஐப் பயன்படுத்த bae-க்கு அனுமதி இல்லை. கணினி அமைப்புகள் → Apple ID → iCloud → iCloud-ஐப் பயன்படுத்தும் ஆப்ஸ் ஐத் திறந்து bae-ஐ இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
