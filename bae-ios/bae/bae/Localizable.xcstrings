    "The encryption key for this library is not in the keyring. Enter the 64-character hex key to unlock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encryption key for this library is not in the keyring. Enter the 64-character hex key to unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de cifrado de esta biblioteca no está en el llavero. Introduce la clave hexadecimal de 64 caracteres para desbloquearla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de chiffrement de cette bibliothèque n'est pas dans le trousseau. Saisissez la clé hexadécimale de 64 caractères pour déverrouiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verschlüsselungsschlüssel für diese Bibliothek ist nicht im Schlüsselbund. Gib den 64-stelligen Hex-Schlüssel zum Entsperren ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de criptografia desta biblioteca não está no chaveiro. Insira a chave hexadecimal de 64 caracteres para desbloquear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリの暗号化キーがキーリングにありません。ロックを解除するには16進数64文字のキーを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此库的加密密钥不在密钥环中。请输入 64 位十六进制密钥以解锁。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح التشفير لهذه المكتبة غير موجود في حلقة المفاتيح. أدخل المفتاح السداسي العشري المكوّن من 64 حرفًا لإلغاء القفل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח ההצפנה של ספרייה זו אינו במחזיק המפתחות. הזינו את המפתח ההקסדצימלי באורך 64 תווים כדי לפתוח."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключа шифрування цієї бібліотеки немає у сховищі ключів. Введіть 64-символьний шістнадцятковий ключ, щоб розблокувати."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът за шифроване на тази библиотека не е в ключодържателя. Въведете 64-знаковия шестнадесетичен ключ за отключване."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucza szyfrującego tej biblioteki nie ma w pęku kluczy. Wprowadź 64-znakowy klucz szesnastkowy, aby odblokować."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovací klíč této knihovny není v klíčence. Pro odemčení zadejte šestnáctkový klíč o 64 znacích."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ za šifriranje ove fonoteke nije u privjesku ključeva. Unesite 64-znamenkasti heksadecimalni ključ za otključavanje."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리의 암호화 키가 키링에 없습니다. 잠금을 해제하려면 64자 16진수 키를 입력하세요."
          }
        }
      }
    },
    "The provider returned an invalid authorization URL.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider returned an invalid authorization URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor devolvió una URL de autorización no válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a renvoyé une URL d'autorisation non valide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat eine ungültige Autorisierungs-URL zurückgegeben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor retornou uma URL de autorização inválida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダが無効な認証URLを返しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商返回了无效的授权 URL。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرجع المزوّد رابط تفويض غير صالح."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספק החזיר כתובת אישור לא חוקית."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постачальник повернув недійсну URL-адресу авторизації."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Доставчикът върна невалиден URL за оторизация."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostawca zwrócił nieprawidłowy adres URL autoryzacji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskytovatel vrátil neplatnou autorizační URL."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pružatelj usluge vratio je nevažeći URL za autorizaciju."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 잘못된 인증 URL을 반환했습니다."
          }
        }
      }
    },
    "This library needs cloud sign-in, which isn't configured on this build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This library needs cloud sign-in, which isn't configured on this build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca necesita iniciar sesión en la nube, que no está configurado en esta versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette bibliothèque nécessite une connexion au cloud, qui n'est pas configurée sur cette version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bibliothek erfordert eine Cloud-Anmeldung, die in diesem Build nicht konfiguriert ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca precisa de login na nuvem, que não está configurado nesta versão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリにはクラウドサインインが必要ですが、このビルドでは設定されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此库需要云登录，但此版本未配置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج هذه المكتبة إلى تسجيل دخول سحابي، وهو غير مُعدّ في هذه النسخة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספרייה זו דורשת כניסה לענן, שאינה מוגדרת בגרסה זו."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї бібліотеки потрібен хмарний вхід, який не налаштовано в цій збірці."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази библиотека изисква влизане в облака, което не е конфигурирано в тази версия."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta biblioteka wymaga logowania do chmury, które nie jest skonfigurowane w tej wersji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato knihovna vyžaduje přihlášení k cloudu, které není v tomto sestavení nakonfigurováno."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova fonoteka zahtijeva prijavu u oblak, koja nije konfigurirana u ovoj verziji."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리는 클라우드 로그인이 필요하지만 이 빌드에는 설정되어 있지 않습니다."
          }
        }
      }
    },
